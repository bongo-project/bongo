[Unit]
Description=Bongo-Go mail and calendar server
Documentation=https://github.com/bongo-project/bongo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bongo
Group=bongo
ExecStart=/usr/local/bin/bongo-go serve --config /etc/bongo/bongo.hcl

# Secrets (e.g. BONGO_WEB_SESSION_SECRET) live here, root-only (chmod 600).
EnvironmentFile=/etc/bongo/bongo.env

Restart=on-failure
RestartSec=5s

# Allow binding privileged ports (25, 110, 143, 443, etc.) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bongo-go /var/log/bongo-go

[Install]
WantedBy=multi-user.target
