# Copy to .env and fill in. Never commit the real .env.
#
#   cp .env.example .env
#   # generate a session secret:
#   openssl rand -base64 32

# --- Secrets ---------------------------------------------------------------
# HMAC key for session cookies. REQUIRED. Generate with: openssl rand -base64 32
BONGO_WEB_SESSION_SECRET=

# --- Hostname --------------------------------------------------------------
# Public hostname for the web UI AND the mail server (A record + PTR + cert).
# This is also the HostSNI used for the IMAPS (993) TCP router.
WEB_HOST=mail.example.com

# The email domain (the part after @ in addresses). Client autoconfiguration
# (Thunderbird/Outlook/Apple Mail) is served on this domain and its
# autoconfig./autodiscover. subdomains. Defaults to example.com if unset.
MAIL_DOMAIN=example.com

# Multi-tenant autoconfiguration: to also self-configure additional email
# domains hosted on this server, append them as Traefik rule fragments here.
# Both default to empty, so single-domain deployments can ignore them. Each
# extra domain also needs its DNS/records (and, for the *-sub subdomains,
# autoconfig.<domain> / autodiscover.<domain> A/AAAA records). Example for a
# second domain `example.org`:
#   AUTOCONFIG_EXTRA_HOST_RULE=|| Host(`example.org`)
#   AUTOCONFIG_SUB_EXTRA_HOST_RULE=|| Host(`autoconfig.example.org`) || Host(`autodiscover.example.org`)
# Add more domains by repeating the `|| Host(...)` fragments on the same line.
AUTOCONFIG_EXTRA_HOST_RULE=
AUTOCONFIG_SUB_EXTRA_HOST_RULE=

# --- Traefik wiring --------------------------------------------------------
# The external Docker network Traefik is attached to. For a compose project
# named `foo` with a network `web` this is `foo_web`. Confirm with:
#   docker network ls
TRAEFIK_NETWORK=traefik_web
# ACME certresolver name defined in Traefik.
TRAEFIK_CERTRESOLVER=letsencrypt
