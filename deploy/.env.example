# Copy to .env and fill in. Never commit the real .env.
#
#   cp .env.example .env
#   # generate a session secret:
#   openssl rand -base64 32

# --- Secrets ---------------------------------------------------------------
# HMAC key for session cookies. REQUIRED. Generate with: openssl rand -base64 32
BONGO_WEB_SESSION_SECRET=

# --- Hostname --------------------------------------------------------------
# Public hostname for the web UI AND the mail server (A record + PTR + cert).
# This is also the HostSNI used for the IMAPS (993) TCP router.
WEB_HOST=mail.example.com

# --- Traefik wiring (from your hostbox stack) -------------------------------
# The external Docker network Traefik is attached to (compose project `hostbox`
# network `web` -> `traefik_web`). Confirm with: docker network ls
TRAEFIK_NETWORK=traefik_web
# ACME certresolver name defined in Traefik.
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Log shipping (Grafana Alloy -> Loki) ----------------------------------
# Loki push URL reachable from THIS box. The Nomad/Pi cluster is not directly
# on Tailscale, so you must first give the hostbox box a route to Loki (a
# Tailscale subnet router, or Tailscale on the Loki node). See deploy/LOGGING.md.
# Use an IP, not a MagicDNS name (the Alloy container has no tailnet DNS).
LOKI_ENDPOINT=http://100.x.y.z:3100/loki/api/v1/push
