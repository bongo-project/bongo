package templates

import (
	"fmt"
	"html"
	"strings"
	"time"
)

// Attachment represents a downloadable attachment.
type Attachment struct {
	Filename    string
	ContentType string
	Size        int64
	Hash        string
}

// MessageDetail holds data for the message detail view.
type MessageDetail struct {
	UID              uint32
	Mailbox          string
	MessageID        string
	Subject          string
	From             string
	To               []string
	Cc               []string
	Date             time.Time
	HTMLBody         string
	TextBody         string
	Attachments      []Attachment
	Seen             bool
	Flagged          bool
	Answered         bool
	IsContact        bool
	HasBlockedImages bool
}

templ MessagePage(msg MessageDetail, mailboxes []MailboxInfo) {
	<div class="toolbar">
		<a
			href={ templ.SafeURL("/mail/" + msg.Mailbox) }
			role="button"
			class="outline secondary"
			hx-get={ "/mail/" + msg.Mailbox }
			hx-target="#main-content"
			hx-push-url="true"
		>
			Back
		</a>
		<a href={ templ.SafeURL(fmt.Sprintf("/compose/reply/%s/%d", msg.Mailbox, msg.UID)) } role="button" class="outline">Reply</a>
		<a href={ templ.SafeURL(fmt.Sprintf("/compose/forward/%s/%d", msg.Mailbox, msg.UID)) } role="button" class="outline">Forward</a>
		<button
			class="outline secondary"
			hx-post={ fmt.Sprintf("/mail/%s/%d/delete", msg.Mailbox, msg.UID) }
			hx-target="#main-content"
			hx-confirm="Delete this message?"
		>
			Delete
		</button>
		<a href={ templ.SafeURL(fmt.Sprintf("/mail/%s/%d/export", msg.Mailbox, msg.UID)) } role="button" class="outline secondary">Export</a>
		<button type="button" class="outline secondary print-btn" onclick="window.print()">Print</button>
		<select
			name="destination"
			hx-post={ fmt.Sprintf("/mail/%s/%d/move", msg.Mailbox, msg.UID) }
			hx-target="#main-content"
			hx-trigger="change"
			style="width:auto;display:inline;padding:0.3rem 0.7rem;font-size:0.85rem"
		>
			<option value="">Move to...</option>
			for _, mb := range mailboxes {
				if mb.Name != msg.Mailbox {
					<option value={ mb.Name }>{ mb.Name }</option>
				}
			}
		</select>
	</div>
	<div class="message-header">
		<h2>{ msg.Subject }</h2>
		<div class="meta">
			<div>
				<strong>From:</strong> { msg.From }
				if !msg.IsContact {
					<form method="post" action="/contacts/quick-add" style="display:inline;margin:0">
						<input type="hidden" name="from_email" value={ msg.From }/>
						<input type="hidden" name="from_name" value={ msg.From }/>
						<input type="hidden" name="return_to" value={ fmt.Sprintf("/mail/%s/%d", msg.Mailbox, msg.UID) }/>
						<button type="submit" class="outline secondary" style="font-size:0.75rem;padding:0.1rem 0.4rem;margin-left:0.5rem">Add to Contacts</button>
					</form>
				}
			</div>
			<div><strong>To:</strong> { joinStrings(msg.To) }</div>
			if len(msg.Cc) > 0 {
				<div><strong>Cc:</strong> { joinStrings(msg.Cc) }</div>
			}
			<div><strong>Date:</strong> { msg.Date.Format("Mon, Jan 2 2006 3:04 PM") }</div>
		</div>
	</div>
	<div class="message-body">
		if msg.HasBlockedImages {
			<div class="blocked-images-banner">
				<span>Remote images have been blocked for your privacy.</span>
				<button
					type="button"
					class="outline secondary"
					style="font-size:0.8rem;padding:0.2rem 0.5rem"
					@click="
						document.querySelectorAll('.blocked-image').forEach(el => {
							const img = document.createElement('img');
							img.src = el.dataset.src;
							img.style.maxWidth = '100%';
							el.replaceWith(img);
						});
						$el.closest('.blocked-images-banner').remove();
					"
					aria-label="Load blocked remote images"
				>
					Load remote images
				</button>
			</div>
		}
		if msg.HTMLBody != "" {
			<div class="email-body">
				@templ.Raw(msg.HTMLBody)
			</div>
		} else {
			<pre class="text-body" style="white-space:pre-wrap;font-family:inherit">
				@templ.Raw(formatQuotedText(msg.TextBody))
			</pre>
		}
	</div>
	if len(msg.Attachments) > 0 {
		@attachmentList(msg.Attachments)
	}
}

templ MessagePaneContent(msg MessageDetail) {
	<div class="pane-toolbar">
		<a href={ templ.SafeURL(fmt.Sprintf("/compose/reply/%s/%d", msg.Mailbox, msg.UID)) } role="button" class="outline" style="font-size:0.8rem;padding:0.2rem 0.5rem">Reply</a>
		<a href={ templ.SafeURL(fmt.Sprintf("/compose/forward/%s/%d", msg.Mailbox, msg.UID)) } role="button" class="outline" style="font-size:0.8rem;padding:0.2rem 0.5rem">Forward</a>
		<button
			class="outline secondary"
			style="font-size:0.8rem;padding:0.2rem 0.5rem"
			hx-post={ fmt.Sprintf("/mail/%s/%d/delete", msg.Mailbox, msg.UID) }
			hx-target="#main-content"
			hx-confirm="Delete this message?"
		>
			Delete
		</button>
	</div>
	<div class="message-header">
		<h3 style="margin-bottom:0.3rem">{ msg.Subject }</h3>
		<div class="meta">
			<div><strong>From:</strong> { msg.From }</div>
			<div><strong>To:</strong> { joinStrings(msg.To) }</div>
			if len(msg.Cc) > 0 {
				<div><strong>Cc:</strong> { joinStrings(msg.Cc) }</div>
			}
			<div><strong>Date:</strong> { msg.Date.Format("Mon, Jan 2 2006 3:04 PM") }</div>
		</div>
	</div>
	<div class="message-body">
		if msg.HasBlockedImages {
			<div class="blocked-images-banner">
				<span>Remote images have been blocked for your privacy.</span>
				<button
					type="button"
					class="outline secondary"
					style="font-size:0.8rem;padding:0.2rem 0.5rem"
					@click="
						document.querySelectorAll('.blocked-image').forEach(el => {
							const img = document.createElement('img');
							img.src = el.dataset.src;
							img.style.maxWidth = '100%';
							el.replaceWith(img);
						});
						$el.closest('.blocked-images-banner').remove();
					"
					aria-label="Load blocked remote images"
				>
					Load remote images
				</button>
			</div>
		}
		if msg.HTMLBody != "" {
			<div class="email-body">
				@templ.Raw(msg.HTMLBody)
			</div>
		} else {
			<pre class="text-body" style="white-space:pre-wrap;font-family:inherit">
				@templ.Raw(formatQuotedText(msg.TextBody))
			</pre>
		}
	</div>
	if len(msg.Attachments) > 0 {
		@attachmentList(msg.Attachments)
	}
}

templ attachmentList(attachments []Attachment) {
	<div class="attachment-list">
		<strong>Attachments:</strong>
		for _, att := range attachments {
			if isImageType(att.ContentType) && att.Hash != "" {
				<div class="attachment-preview" x-data="{expanded: false}">
					<img
						class="attachment-thumbnail"
						src={ inlineBlobURL(att.Hash, att.ContentType) }
						alt={ att.Filename }
						loading="lazy"
						@click="expanded = true"
					/>
					<div x-show="expanded" x-cloak class="lightbox" @click.self="expanded = false" @keydown.escape.window="expanded = false">
						<div class="lightbox-content">
							<img src={ inlineBlobURL(att.Hash, att.ContentType) } alt={ att.Filename }/>
							<button class="lightbox-close" @click="expanded = false" type="button">X</button>
						</div>
					</div>
					<a class="attachment-item" href={ templ.SafeURL("/mail/blob/" + att.Hash) } download={ att.Filename } aria-label={ fmt.Sprintf("Download %s (%s)", att.Filename, formatSize(att.Size)) }>
						{ att.Filename }
						<small>({ formatSize(att.Size) })</small>
					</a>
				</div>
			} else if att.ContentType == "application/pdf" && att.Hash != "" {
				<div class="attachment-preview">
					<iframe
						src={ inlineBlobURL(att.Hash, att.ContentType) }
						class="pdf-preview"
						sandbox=""
						title={ att.Filename }
					></iframe>
					<a class="attachment-item" href={ templ.SafeURL("/mail/blob/" + att.Hash) } download={ att.Filename } aria-label={ fmt.Sprintf("Download %s (%s)", att.Filename, formatSize(att.Size)) }>
						{ att.Filename }
						<small>({ formatSize(att.Size) })</small>
					</a>
				</div>
			} else if isTextType(att.ContentType) && att.Hash != "" {
				<div class="attachment-preview">
					<div
						class="text-preview"
						hx-get={ fmt.Sprintf("/mail/blob/%s?inline=1&ct=%s", att.Hash, att.ContentType) }
						hx-trigger="load"
						hx-swap="innerHTML"
					>
						Loading preview...
					</div>
					<a class="attachment-item" href={ templ.SafeURL("/mail/blob/" + att.Hash) } download={ att.Filename } aria-label={ fmt.Sprintf("Download %s (%s)", att.Filename, formatSize(att.Size)) }>
						{ att.Filename }
						<small>({ formatSize(att.Size) })</small>
					</a>
				</div>
			} else {
				<a class="attachment-item" href={ templ.SafeURL("/mail/blob/" + att.Hash) } download={ att.Filename } aria-label={ fmt.Sprintf("Download %s (%s)", att.Filename, formatSize(att.Size)) }>
					{ att.Filename }
					<small>({ formatSize(att.Size) })</small>
				</a>
			}
		}
	</div>
}

func joinStrings(ss []string) string {
	result := ""
	for i, s := range ss {
		if i > 0 {
			result += ", "
		}
		result += s
	}
	return result
}

func formatQuotedText(text string) string {
	lines := strings.Split(html.EscapeString(text), "\n")
	var buf strings.Builder
	for _, line := range lines {
		if strings.HasPrefix(line, "&gt;") {
			buf.WriteString(`<span class="quoted">`)
			buf.WriteString(line)
			buf.WriteString("</span>\n")
		} else {
			buf.WriteString(line)
			buf.WriteByte('\n')
		}
	}
	return buf.String()
}

func isImageType(ct string) bool {
	return ct == "image/jpeg" || ct == "image/png" || ct == "image/gif" || ct == "image/webp"
}

func isTextType(ct string) bool {
	return ct == "text/plain" || ct == "text/csv" || ct == "text/html" || ct == "application/json" || ct == "application/xml"
}

func inlineBlobURL(hash, contentType string) string {
	return fmt.Sprintf("/mail/blob/%s?inline=1&ct=%s", hash, contentType)
}

func formatSize(bytes int64) string {
	if bytes < 1024 {
		return fmt.Sprintf("%d B", bytes)
	}
	if bytes < 1024*1024 {
		return fmt.Sprintf("%.1f KB", float64(bytes)/1024)
	}
	return fmt.Sprintf("%.1f MB", float64(bytes)/(1024*1024))
}
