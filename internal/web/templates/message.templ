package templates

import (
	"fmt"
	"html"
	"strings"
	"time"
)

// Attachment represents a downloadable attachment.
type Attachment struct {
	Filename    string
	ContentType string
	Size        int64
	Hash        string
}

// MessageDetail holds data for the message detail view.
type MessageDetail struct {
	UID              uint32
	Mailbox          string
	MessageID        string
	Subject          string
	From             string
	To               []string
	Cc               []string
	Date             time.Time
	HTMLBody         string
	TextBody         string
	Attachments      []Attachment
	Seen             bool
	Flagged          bool
	Answered         bool
	IsContact        bool
	HasBlockedImages bool
}

templ MessagePage(msg MessageDetail, mailboxes []MailboxInfo) {
	<div class="toolbar" role="toolbar" aria-label="Thread actions">
		<a
			href={ templ.SafeURL(mailboxURL(msg.Mailbox)) }
			class="tool-btn"
			hx-get={ mailboxURL(msg.Mailbox) }
			hx-target="#main-content"
			hx-push-url="true"
			aria-label="Back to Inbox"
		>
			&larr; { t(ctx, "mail.back") }
		</a>
		<div class="tool-separator" aria-hidden="true"></div>
		<a href={ templ.SafeURL(fmt.Sprintf("/compose/reply/%s/%d", msg.Mailbox, msg.UID)) } class="tool-btn primary">{ t(ctx, "mail.reply") }</a>
		<a href={ templ.SafeURL(fmt.Sprintf("/compose/forward/%s/%d", msg.Mailbox, msg.UID)) } class="tool-btn">{ t(ctx, "mail.forward") }</a>
		<div class="tool-separator" aria-hidden="true"></div>
		<button
			class="tool-btn danger"
			hx-post={ fmt.Sprintf("/mail/%s/%d/delete", encMailbox(msg.Mailbox), msg.UID) }
			hx-target="#main-content"
			hx-confirm="Delete this message?"
		>
			{ t(ctx, "mail.delete") }
		</button>
		<a href={ templ.SafeURL(fmt.Sprintf("/mail/%s/%d/export", encMailbox(msg.Mailbox), msg.UID)) } class="tool-btn">{ t(ctx, "mail.export") }</a>
		<button type="button" class="tool-btn" onclick="window.print()">{ t(ctx, "mail.print") }</button>
		<select
			class="move-select"
			name="destination"
			hx-post={ fmt.Sprintf("/mail/%s/%d/move", encMailbox(msg.Mailbox), msg.UID) }
			hx-target="#main-content"
			hx-trigger="change"
			aria-label="Move to folder"
		>
			<option value="">{ t(ctx, "mail.moveTo") }</option>
			for _, mb := range mailboxes {
				if mb.Name != msg.Mailbox {
					<option value={ mb.Name }>{ mb.Name }</option>
				}
			}
		</select>
	</div>
	<div class="thread-header">
		<h1 class="thread-subject">{ msg.Subject }</h1>
	</div>
	<div class="thread-messages">
		<article class="message">
			<div class="msg-card">
				<div class="msg-head">
					<span class="msg-sender">{ msg.From }</span>
					if !msg.IsContact {
						<form method="post" action="/contacts/quick-add" style="display:inline;margin:0">
							<input type="hidden" name="from_email" value={ msg.From }/>
							<input type="hidden" name="from_name" value={ msg.From }/>
							<input type="hidden" name="return_to" value={ fmt.Sprintf("/mail/%s/%d", encMailbox(msg.Mailbox), msg.UID) }/>
							<button type="submit" class="msg-action-btn">{ t(ctx, "mail.addToContacts") }</button>
						</form>
					}
					<span class="msg-recipients">{ t(ctx, "mail.to") }: { joinStrings(msg.To) }</span>
					if len(msg.Cc) > 0 {
						<span class="msg-recipients">Cc: { joinStrings(msg.Cc) }</span>
					}
					<span class="msg-head-spacer"></span>
					<span class="msg-date">{ msg.Date.Format("Mon, Jan 2 2006 3:04 PM") }</span>
				</div>
				if msg.HasBlockedImages {
					<div class="blocked-banner" role="alert">
						<span>&#9888; { t(ctx, "mail.remoteImagesBlocked") }</span>
						<button
							type="button"
							@click="
								document.querySelectorAll('.blocked-image').forEach(el => {
									const img = document.createElement('img');
									img.src = el.dataset.src;
									img.style.maxWidth = '100%';
									el.replaceWith(img);
								});
								$el.closest('.blocked-banner').remove();
							"
							aria-label={ t(ctx, "mail.loadRemoteImages") }
						>
							{ t(ctx, "mail.loadRemoteImages") }
						</button>
					</div>
				}
				<div class="msg-body">
					if msg.HTMLBody != "" {
						<div class="email-body">
							@templ.Raw(msg.HTMLBody)
						</div>
					} else {
						<pre class="text-body" style="white-space:pre-wrap;font-family:inherit">
							@templ.Raw(formatQuotedText(msg.TextBody))
						</pre>
					}
				</div>
				if len(msg.Attachments) > 0 {
					@attachmentList(msg.Attachments)
				}
			</div>
		</article>
	</div>
}

templ MessagePaneContent(msg MessageDetail) {
	<div class="toolbar" style="padding:6px 12px">
		<a href={ templ.SafeURL(fmt.Sprintf("/compose/reply/%s/%d", msg.Mailbox, msg.UID)) } class="tool-btn">{ t(ctx, "mail.reply") }</a>
		<a href={ templ.SafeURL(fmt.Sprintf("/compose/forward/%s/%d", msg.Mailbox, msg.UID)) } class="tool-btn">{ t(ctx, "mail.forward") }</a>
		<button
			class="tool-btn danger"
			hx-post={ fmt.Sprintf("/mail/%s/%d/delete", encMailbox(msg.Mailbox), msg.UID) }
			hx-target="#main-content"
			hx-confirm="Delete this message?"
		>
			{ t(ctx, "mail.delete") }
		</button>
	</div>
	<div class="thread-header" style="padding:12px 16px 8px">
		<h3 class="thread-subject" style="font-size:1.1rem">{ msg.Subject }</h3>
	</div>
	<div class="thread-messages" style="padding:10px 16px">
		<article class="message">
			<div class="msg-card" style="border:none">
				<div class="msg-head">
					<span class="msg-sender">{ msg.From }</span>
					<span class="msg-recipients">{ t(ctx, "mail.to") }: { joinStrings(msg.To) }</span>
					if len(msg.Cc) > 0 {
						<span class="msg-recipients">Cc: { joinStrings(msg.Cc) }</span>
					}
					<span class="msg-head-spacer"></span>
					<span class="msg-date">{ msg.Date.Format("Mon, Jan 2 2006 3:04 PM") }</span>
				</div>
				if msg.HasBlockedImages {
					<div class="blocked-banner" role="alert">
						<span>&#9888; { t(ctx, "mail.remoteImagesBlocked") }</span>
						<button
							type="button"
							@click="
								document.querySelectorAll('.blocked-image').forEach(el => {
									const img = document.createElement('img');
									img.src = el.dataset.src;
									img.style.maxWidth = '100%';
									el.replaceWith(img);
								});
								$el.closest('.blocked-banner').remove();
							"
							aria-label={ t(ctx, "mail.loadRemoteImages") }
						>
							{ t(ctx, "mail.loadRemoteImages") }
						</button>
					</div>
				}
				<div class="msg-body">
					if msg.HTMLBody != "" {
						<div class="email-body">
							@templ.Raw(msg.HTMLBody)
						</div>
					} else {
						<pre class="text-body" style="white-space:pre-wrap;font-family:inherit">
							@templ.Raw(formatQuotedText(msg.TextBody))
						</pre>
					}
				</div>
				if len(msg.Attachments) > 0 {
					@attachmentList(msg.Attachments)
				}
			</div>
		</article>
	</div>
}

templ attachmentList(attachments []Attachment) {
	<div class="msg-attachments">
		<strong>{ t(ctx, "mail.attachments") }:</strong>
		for _, att := range attachments {
			if isImageType(att.ContentType) && att.Hash != "" {
				<div class="attachment-preview" x-data="{expanded: false}">
					<img
						class="attachment-thumbnail"
						src={ inlineBlobURL(att.Hash, att.ContentType) }
						alt={ att.Filename }
						loading="lazy"
						@click="expanded = true"
					/>
					<div x-show="expanded" x-cloak class="lightbox" @click.self="expanded = false" @keydown.escape.window="expanded = false">
						<div class="lightbox-content">
							<img src={ inlineBlobURL(att.Hash, att.ContentType) } alt={ att.Filename }/>
							<button class="lightbox-close" @click="expanded = false" type="button">X</button>
						</div>
					</div>
					<a class="attachment-chip" href={ templ.SafeURL("/mail/blob/" + att.Hash) } download={ att.Filename } aria-label={ fmt.Sprintf("Download %s (%s)", att.Filename, formatSize(att.Size)) }>
						<span class="attachment-icon" aria-hidden="true">&#128196;</span>
						{ att.Filename }
						<span class="attachment-size">{ formatSize(att.Size) }</span>
					</a>
				</div>
			} else if att.ContentType == "application/pdf" && att.Hash != "" {
				<div class="attachment-preview">
					<iframe
						src={ inlineBlobURL(att.Hash, att.ContentType) }
						class="pdf-preview"
						sandbox=""
						title={ att.Filename }
					></iframe>
					<a class="attachment-chip" href={ templ.SafeURL("/mail/blob/" + att.Hash) } download={ att.Filename } aria-label={ fmt.Sprintf("Download %s (%s)", att.Filename, formatSize(att.Size)) }>
						<span class="attachment-icon" aria-hidden="true">&#128196;</span>
						{ att.Filename }
						<span class="attachment-size">{ formatSize(att.Size) }</span>
					</a>
				</div>
			} else if isTextType(att.ContentType) && att.Hash != "" {
				<div class="attachment-preview">
					<div
						class="text-preview"
						hx-get={ fmt.Sprintf("/mail/blob/%s?inline=1&ct=%s", att.Hash, att.ContentType) }
						hx-trigger="load"
						hx-swap="innerHTML"
					>
						{ t(ctx, "common.loading") }...
					</div>
					<a class="attachment-chip" href={ templ.SafeURL("/mail/blob/" + att.Hash) } download={ att.Filename } aria-label={ fmt.Sprintf("Download %s (%s)", att.Filename, formatSize(att.Size)) }>
						<span class="attachment-icon" aria-hidden="true">&#128196;</span>
						{ att.Filename }
						<span class="attachment-size">{ formatSize(att.Size) }</span>
					</a>
				</div>
			} else {
				<a class="attachment-chip" href={ templ.SafeURL("/mail/blob/" + att.Hash) } download={ att.Filename } aria-label={ fmt.Sprintf("Download %s (%s)", att.Filename, formatSize(att.Size)) }>
					<span class="attachment-icon" aria-hidden="true">&#128196;</span>
					{ att.Filename }
					<span class="attachment-size">{ formatSize(att.Size) }</span>
				</a>
			}
		}
	</div>
}

func joinStrings(ss []string) string {
	result := ""
	for i, s := range ss {
		if i > 0 {
			result += ", "
		}
		result += s
	}
	return result
}

func formatQuotedText(text string) string {
	lines := strings.Split(html.EscapeString(text), "\n")
	var buf strings.Builder
	for _, line := range lines {
		if strings.HasPrefix(line, "&gt;") {
			buf.WriteString(`<span class="quoted">`)
			buf.WriteString(line)
			buf.WriteString("</span>\n")
		} else {
			buf.WriteString(line)
			buf.WriteByte('\n')
		}
	}
	return buf.String()
}

func isImageType(ct string) bool {
	return ct == "image/jpeg" || ct == "image/png" || ct == "image/gif" || ct == "image/webp"
}

func isTextType(ct string) bool {
	return ct == "text/plain" || ct == "text/csv" || ct == "text/html" || ct == "application/json" || ct == "application/xml"
}

func inlineBlobURL(hash, contentType string) string {
	return fmt.Sprintf("/mail/blob/%s?inline=1&ct=%s", hash, contentType)
}

func formatSize(bytes int64) string {
	if bytes < 1024 {
		return fmt.Sprintf("%d B", bytes)
	}
	if bytes < 1024*1024 {
		return fmt.Sprintf("%.1f KB", float64(bytes)/1024)
	}
	return fmt.Sprintf("%.1f MB", float64(bytes)/(1024*1024))
}
