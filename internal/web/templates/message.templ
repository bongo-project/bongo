package templates

import (
	"context"
	"fmt"
	"html"
	"net/mail"
	"strings"
	"time"
)

// Attachment represents a downloadable attachment.
type Attachment struct {
	Filename    string
	ContentType string
	Size        int64
	Hash        string
	// URL is the download endpoint for this attachment. Sent mail points at the
	// content-addressed blob (/mail/blob/{hash}); inbound mail, whose parts are
	// not stored as separate blobs, points at the message-scoped attachment
	// route (/mail/{mailbox}/{uid}/attachment/{idx}) served from the raw message.
	URL string
}

// TagInfo holds display data for a single tag.
type TagInfo struct {
	Name        string
	ColourIndex int32
}

// MessageDetail holds data for the message detail view.
type MessageDetail struct {
	UID              uint32
	Mailbox          string
	MessageID        string
	Subject          string
	From             string
	To               []string
	Cc               []string
	Date             time.Time
	HTMLBody         string
	TextBody         string
	MIMETooComplex   bool
	Attachments      []Attachment
	Seen             bool
	Flagged          bool
	Answered         bool
	IsContact        bool
	HasBlockedImages bool
	Tags             []TagInfo
	AllTags          []TagInfo
	Thread           []MessageDetail
}

// tagPaletteColours maps colour_index (0-15) to a CSS hex colour.
// These are used for the tag chip background and text colouring.
var tagPaletteColours = [16]string{
	"#3b82f6", // 0  blue
	"#22c55e", // 1  green
	"#ef4444", // 2  red
	"#f59e0b", // 3  amber
	"#8b5cf6", // 4  violet
	"#06b6d4", // 5  cyan
	"#f97316", // 6  orange
	"#ec4899", // 7  pink
	"#14b8a6", // 8  teal
	"#6366f1", // 9  indigo
	"#84cc16", // 10 lime
	"#eab308", // 11 yellow
	"#64748b", // 12 slate
	"#a855f7", // 13 purple
	"#10b981", // 14 emerald
	"#f43f5e", // 15 rose
}

// tagColourCSS returns the CSS colour hex for a given palette index.
func tagColourCSS(index int32) string {
	if index < 0 || int(index) >= len(tagPaletteColours) {
		return tagPaletteColours[0]
	}
	return tagPaletteColours[index]
}

// MessageFullPage renders the message view as a complete document (layout,
// <head>/CSS, and sidebar) for a direct navigation or browser refresh of
// /mail/{mailbox}/{uid}. HTMX clicks instead receive just MessagePage, which is
// swapped into the existing page's #main-content. Without this wrapper a refresh
// returned the bare content with no stylesheet and lost all styling.
templ MessageFullPage(msg MessageDetail, mailboxes []MailboxInfo, tags []SidebarTagInfo, email string) {
	@LayoutWithContent(msg.Subject, email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@Sidebar(mailboxes, tags, msg.Mailbox)
		</aside>
		<main class="content" id="main-content" data-selected-mailbox={ msg.Mailbox }>
			@MessagePage(msg, mailboxes)
		</main>
	}
}

templ MessagePage(msg MessageDetail, mailboxes []MailboxInfo) {
	<div class="toolbar" role="toolbar" aria-label={ t(ctx, "mail.threadActions") }>
		<a
			href={ templ.SafeURL(mailboxURL(msg.Mailbox)) }
			class="tool-btn"
			hx-get={ mailboxURL(msg.Mailbox) }
			hx-target="#main-content"
			hx-push-url="true"
			aria-label={ t(ctx, "mail.backToInbox") }
		>
			&larr; { t(ctx, "mail.back") }
		</a>
	</div>
	@messageHeader(msg, "h1")
	<div class="thread-messages">
		@messageView(msg, mailboxes, viewOpts{Top: true})
		for _, threadMsg := range msg.Thread {
			@ThreadMessageArticle(threadMsg, mailboxes, false)
		}
		@quickReply(msg)
	</div>
}

templ MessagePaneContent(msg MessageDetail, mailboxes []MailboxInfo) {
	@messageHeader(msg, "h2")
	<div class="thread-messages">
		@messageView(msg, mailboxes, viewOpts{Top: true, Pane: true, Borderless: true})
		for _, threadMsg := range msg.Thread {
			@ThreadMessageArticle(threadMsg, mailboxes, true)
		}
		@quickReply(msg)
	</div>
}

templ ThreadMessageArticle(msg MessageDetail, mailboxes []MailboxInfo, borderless bool) {
	@messageView(msg, mailboxes, viewOpts{Borderless: borderless})
}

// viewOpts selects the variant of messageView. Top is the message the page was
// opened on (it alone offers Add to contacts); Pane is the compact reading
// pane variant.
type viewOpts struct {
	Top        bool
	Pane       bool
	Borderless bool
}

// messageHeader is the large subject and the tag chip row, shown once above
// the messages. level is the heading element ("h1" on the full page, "h2" in
// the reading pane).
templ messageHeader(msg MessageDetail, level string) {
	<div class="thread-header">
		if level == "h1" {
			<h1 class="thread-subject">{ msg.Subject }</h1>
		} else {
			<h2 class="thread-subject">{ msg.Subject }</h2>
		}
		@messageTags(msg)
	</div>
}

// messageView renders one message: sender bar, remote-image banner, body and
// attachments. The full page, the reading pane and every thread entry use it.
templ messageView(msg MessageDetail, mailboxes []MailboxInfo, opts viewOpts) {
	<article class="message">
		<div class={ "msg-card", templ.KV("u-border-none", opts.Borderless) }>
			@senderBar(msg, mailboxes, opts)
			if msg.HasBlockedImages {
				<div class="blocked-banner" role="alert" x-data="remoteImages">
					<span class="inline-icon">@Icon("alert", "") { t(ctx, "mail.remoteImagesBlocked") }</span>
					<button
						type="button"
						@click="load()"
						aria-label={ t(ctx, "mail.loadRemoteImages") }
					>
						{ t(ctx, "mail.loadRemoteImages") }
					</button>
				</div>
			}
			<div class="msg-body">
				if msg.MIMETooComplex {
					<p><em>{ t(ctx, "mail.tooComplex") }</em></p>
				}
				if msg.HTMLBody != "" {
					<div class="email-body">
						@templ.Raw(msg.HTMLBody)
					</div>
				} else {
					<pre class="text-body u-white-space-prewrap u-font-inherit">
						@templ.Raw(formatQuotedText(msg.TextBody))
					</pre>
				}
			</div>
			if len(msg.Attachments) > 0 {
				@attachmentList(msg.Attachments)
			}
		</div>
	</article>
}

// senderBar is the tinted avatar, name, address, recipients and date, with the
// icon actions and the More menu on the right.
templ senderBar(msg MessageDetail, mailboxes []MailboxInfo, opts viewOpts) {
	{{ name, addr := senderParts(msg.From) }}
	{{ replyURL := fmt.Sprintf("/compose/reply/%s/%d", encMailbox(msg.Mailbox), msg.UID) }}
	<div class="msg-sender-bar">
		<span class={ "msg-avatar", "avatar-tint", avatarClass(name, addr) } aria-hidden="true">{ avatarInitials(name, addr) }</span>
		<div class="msg-sender-id">
			<div class="msg-sender-line">
				<span class="msg-sender">{ name }</span>
				if addr != "" && addr != name {
					<span class="msg-sender-email">&lt;{ addr }&gt;</span>
				}
			</div>
			<div class="msg-recipients">
				{ t(ctx, "mail.to") }: { joinStrings(msg.To) }
				if len(msg.Cc) > 0 {
					<span class="msg-recipients-cc">{ t(ctx, "mail.cc") }: { joinStrings(msg.Cc) }</span>
				}
			</div>
		</div>
		<div class={ "msg-sender-actions", templ.KV("pane-toolbar", opts.Pane) }>
			<span class="msg-date">{ msg.Date.Format("Mon, Jan 2 2006 3:04 PM") }</span>
			<a href={ templ.SafeURL(replyURL) } class="msg-act msg-act-text" aria-label={ t(ctx, "mail.reply") } title={ t(ctx, "mail.reply") }>
				@Icon("reply", "")
				<span class="msg-act-label">{ t(ctx, "mail.reply") }</span>
			</a>
			<a href={ templ.SafeURL(replyURL + "?all=1") } class="msg-act" aria-label={ t(ctx, "mail.replyAll") } title={ t(ctx, "mail.replyAll") }>
				@Icon("reply_all", "")
			</a>
			<a href={ templ.SafeURL(fmt.Sprintf("/compose/forward/%s/%d", encMailbox(msg.Mailbox), msg.UID)) } class="msg-act" aria-label={ t(ctx, "mail.forward") } title={ t(ctx, "mail.forward") }>
				@Icon("forward", "")
			</a>
			<span class="msg-act-sep" aria-hidden="true"></span>
			if hasArchiveTarget(msg.Mailbox, mailboxes) {
				<button
					type="button"
					class="msg-act"
					hx-post={ fmt.Sprintf("/mail/%s/%d/move", encMailbox(msg.Mailbox), msg.UID) }
					hx-vals={ `{"destination":"Archive"}` }
					hx-target="#main-content"
					aria-label={ t(ctx, "mail.archive") }
					title={ t(ctx, "mail.archive") }
				>
					@Icon("archive", "")
				</button>
			}
			<button
				type="button"
				class="msg-act msg-act-danger"
				hx-post={ fmt.Sprintf("/mail/%s/%d/delete", encMailbox(msg.Mailbox), msg.UID) }
				hx-target="#main-content"
				hx-confirm={ t(ctx, "mail.confirmDelete") }
				aria-label={ t(ctx, "mail.delete") }
				title={ t(ctx, "mail.delete") }
			>
				@Icon("trash", "")
			</button>
			@moreMenu(msg, mailboxes, opts)
		</div>
	</div>
}

// moreMenu holds the less common actions. Keyboard: Enter and Space open it
// (native button), Escape closes it and returns focus, an outside click closes
// it. The panel id carries the mailbox and UID because a thread renders one
// menu per message.
templ moreMenu(msg MessageDetail, mailboxes []MailboxInfo, opts viewOpts) {
	{{ menuID := moreMenuID(msg) }}
	<div class="msg-more" x-data="messageMore" x-on:keydown.escape="close()" x-on:click.outside="dismiss()">
		<button
			type="button"
			class="msg-act"
			x-ref="button"
			aria-haspopup="true"
			aria-expanded="false"
			x-bind:aria-expanded="open"
			aria-controls={ menuID }
			aria-label={ t(ctx, "mail.more") }
			title={ t(ctx, "mail.more") }
			x-on:click="toggle()"
		>
			@Icon("more", "")
		</button>
		<div class="msg-more-menu" id={ menuID } hidden x-bind:hidden="!open" x-cloak="">
			<a href={ templ.SafeURL(fmt.Sprintf("/mail/%s/%d/export", encMailbox(msg.Mailbox), msg.UID)) } class="msg-more-item">{ t(ctx, "mail.export") }</a>
			<a href={ templ.SafeURL(fmt.Sprintf("/mail/%s/%d/source", encMailbox(msg.Mailbox), msg.UID)) } class="msg-more-item">{ t(ctx, "mail.viewSource") }</a>
			<button type="button" class="msg-more-item" data-print-page="true">{ t(ctx, "mail.print") }</button>
			if opts.Top && !msg.IsContact {
				<form method="post" action="/contacts/quick-add" class="msg-more-form">
					<input type="hidden" name="from_email" value={ msg.From }/>
					<input type="hidden" name="from_name" value={ msg.From }/>
					<input type="hidden" name="return_to" value={ fmt.Sprintf("/mail/%s/%d", encMailbox(msg.Mailbox), msg.UID) }/>
					<button type="submit" class="msg-more-item">{ t(ctx, "mail.addToContacts") }</button>
				</form>
			}
			<select
				class="move-select"
				name="destination"
				hx-post={ fmt.Sprintf("/mail/%s/%d/move", encMailbox(msg.Mailbox), msg.UID) }
				hx-target="#main-content"
				hx-trigger="change"
				aria-label={ t(ctx, "mail.moveToFolder") }
			>
				<option value="">{ t(ctx, "mail.moveTo") }</option>
				for _, mb := range mailboxes {
					if mb.Name != msg.Mailbox {
						<option value={ mb.Name }>{ mb.Name }</option>
					}
				}
			</select>
		</div>
	</div>
}

// quickReply is a hand-off to the composer, not an inline send: the form POSTs
// to the reply route (so the text never lands in a URL) and the typed text
// seeds the composer body. One card
// per thread, replying to the message the page was opened on.
templ quickReply(msg MessageDetail) {
	{{ replyURL := fmt.Sprintf("/compose/reply/%s/%d", encMailbox(msg.Mailbox), msg.UID) }}
	<form class="quick-reply" method="post" action={ replyURL }>
		<input type="hidden" name="_csrf" value={ csrfToken(ctx) }/>
		<textarea
			class="quick-reply-textarea"
			name="quick"
			rows="3"
			maxlength="2000"
			placeholder={ fmt.Sprintf(t(ctx, "mail.quickReplyPlaceholder"), senderFirstName(msg.From)) }
			aria-label={ fmt.Sprintf(t(ctx, "mail.quickReplyPlaceholder"), senderFirstName(msg.From)) }
		></textarea>
		<div class="quick-reply-footer">
			<button type="submit" class="quick-reply-send">
				@Icon("send", "")
				{ t(ctx, "mail.quickReplyContinue") }
			</button>
			<span class="reply-spacer"></span>
			<a href={ templ.SafeURL(replyURL) } class="reply-attach-btn" aria-label={ t(ctx, "mail.attachFiles") } title={ t(ctx, "mail.attachFiles") }>
				@Icon("paperclip", "")
			</a>
		</div>
	</form>
}

// senderParts splits a From header into display name and address. When the
// header does not parse, the raw text is the name and the address is empty.
func senderParts(from string) (name, addr string) {
	if strings.TrimSpace(from) == "" {
		return "", ""
	}
	a, err := mail.ParseAddress(from)
	if err != nil {
		return from, ""
	}
	if a.Name == "" {
		return a.Address, a.Address
	}
	return a.Name, a.Address
}

// senderFirstName is the first word of the sender's name, for the quick reply
// placeholder.
func senderFirstName(from string) string {
	name, _ := senderParts(from)
	if f := strings.Fields(name); len(f) > 0 {
		return f[0]
	}
	return name
}

// hasArchiveTarget reports whether an Archive mailbox exists and the message
// is not already in it. Archive is not a default mailbox, so the button must
// not be offered to users who do not have one.
func hasArchiveTarget(current string, mailboxes []MailboxInfo) bool {
	if current == "Archive" {
		return false
	}
	for _, mb := range mailboxes {
		if mb.Name == "Archive" {
			return true
		}
	}
	return false
}

// moreMenuID returns a DOM id unique per message within a thread. The mailbox
// is reduced to id-safe characters; the UID keeps messages apart.
func moreMenuID(msg MessageDetail) string {
	safe := strings.Map(func(r rune) rune {
		switch {
		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9', r == '-', r == '_':
			return r
		}
		return '_'
	}, msg.Mailbox)
	return fmt.Sprintf("msg-more-%s-%d", safe, msg.UID)
}

// messageTags renders the tag chips row with add/remove controls.
// The Alpine.js component "messageTags" (registered in bongo.js) manages state.
templ messageTags(msg MessageDetail) {
	<div
		class="msg-tags-row"
		x-data={ fmt.Sprintf(`messageTags(%s, %s, %q, %d)`,
			tagsToJSON(msg.Tags),
			tagsToJSON(msg.AllTags),
			encMailbox(msg.Mailbox),
			msg.UID,
		) }
		data-view-tag-label={ t(ctx, "mail.viewTag") }
		data-remove-tag-label={ t(ctx, "mail.removeTag") }
	>
		<div class="msg-tags-chips" role="list" aria-label={ t(ctx, "mail.messageTags") }>
			<template x-for="tag in tags" :key="tag.name">
				<span
					class="tag-chip"
					:class="messageTagColourClass(tag.colourIndex)"
					role="listitem"
				>
					<a
						:href="tagHref(tag)"
						class="tag-chip-name"
						:aria-label="viewLabel(tag)"
						x-text="tag.name"
					></a>
					<button
						type="button"
						class="tag-chip-remove"
						@click="removeTag(tag.name)"
						:aria-label="removeLabel(tag)"
					>@Icon("x", "")</button>
				</span>
			</template>
		</div>
		<div class="tag-add-wrapper" x-ref="addWrapper">
			<button
				type="button"
				class="tag-add-btn"
				@click="openDropdown = !openDropdown"
				aria-haspopup="listbox"
				:aria-expanded="openDropdown"
				aria-label={ t(ctx, "mail.addTag") }
			>+ { t(ctx, "mail.addTag") }</button>
			<div
				x-bind:hidden="!openDropdown"
				x-cloak
				class="tag-dropdown"
				role="listbox"
				aria-label={ t(ctx, "mail.availableTags") }
				@click.outside="openDropdown = false"
				@keydown.escape.window="openDropdown = false"
			>
				<input
					type="text"
					class="tag-search-input"
					x-model="newTagName"
					@keydown.enter.prevent="addTagByInput()"
					placeholder={ t(ctx, "mail.tagNamePlaceholder") }
					aria-label={ t(ctx, "mail.tagNamePlaceholder") }
					x-ref="tagInput"
					@focus="openDropdown = true"
				/>
				<template x-if="filteredAllTags.length > 0">
					<ul class="tag-dropdown-list">
						<template x-for="opt in filteredAllTags" :key="opt.name">
							<li>
								<button
									type="button"
									class="tag-dropdown-item"
									:class="{'tag-dropdown-item--active': isTagged(opt.name)}"
									@click="toggleTag(opt.name)"
									:aria-selected="isTagged(opt.name)"
									role="option"
								>
									<span class="tag-swatch" :class="messageTagBGClass(opt.colourIndex)"></span>
									<span x-text="opt.name"></span>
									<span x-bind:hidden="!isTagged(opt.name)" class="tag-check" aria-hidden="true">&#10003;</span>
								</button>
							</li>
						</template>
					</ul>
				</template>
				<template x-if="newTagName.trim() && !exactMatch">
					<div class="tag-dropdown-create">
						<button
							type="button"
							class="tag-dropdown-item tag-dropdown-item--create"
							@click="addTagByInput()"
						>
							{ t(ctx, "mail.createTag") } &ldquo;<span x-text="newTagName.trim()"></span>&rdquo;
						</button>
					</div>
				</template>
			</div>
		</div>
	</div>
}

// tagsToJSON serialises []TagInfo into a JSON array literal for Alpine.js x-data initialisation.
func tagsToJSON(tags []TagInfo) string {
	if len(tags) == 0 {
		return "[]"
	}
	var b strings.Builder
	b.WriteString("[")
	for i, tag := range tags {
		if i > 0 {
			b.WriteString(",")
		}
		b.WriteString(`{"name":`)
		b.WriteString(`"`)
		b.WriteString(strings.ReplaceAll(tag.Name, `"`, `\"`))
		b.WriteString(`"`)
		b.WriteString(`,"colourIndex":`)
		b.WriteString(fmt.Sprint(tagPaletteSafeIndexMessage(tag.ColourIndex)))
		b.WriteString(`}`)
	}
	b.WriteString("]")
	return b.String()
}

func tagPaletteSafeIndexMessage(index int32) int32 {
	if index < 0 || int(index) >= len(tagPaletteColours) {
		return 0
	}
	return index
}

templ attachmentList(attachments []Attachment) {
	<div class="msg-attachments" x-data="{ showImages: false }">
		<div class="att-label">
			{ attachmentsHeading(ctx, attachments) }
			if hasDisplayableImages(attachments) {
				<button
					type="button"
					class="attachment-reveal"
					x-show="!showImages"
					@click="showImages = true"
				>
					{ t(ctx, "mail.showImages") }
				</button>
			}
		</div>
		<div class="att-list">
			for _, att := range attachments {
				if isImageType(att.ContentType) {
					<!-- Image attachments are not auto-loaded: a tracker or malformed
					     image should not be fetched until the user opts in. The <img>
					     only enters the DOM once showImages is set, via x-if. -->
					<template x-if="showImages">
						<div class="attachment-preview" x-data="{ expanded: false }">
							<img
								class="attachment-thumbnail"
								src={ attachmentInlineURL(att) }
								alt={ att.Filename }
								loading="lazy"
								@click="expanded = true"
							/>
							<div x-bind:hidden="!expanded" x-cloak class="lightbox" @click.self="expanded = false" @keydown.escape.window="expanded = false">
								<div class="lightbox-content">
									<img src={ attachmentInlineURL(att) } alt={ att.Filename }/>
									<button class="lightbox-close" @click="expanded = false" type="button" aria-label={ t(ctx, "common.close") }>@Icon("x", "")</button>
								</div>
							</div>
							@attachmentTile(att)
						</div>
					</template>
					<template x-if="!showImages">
						<span class="attachment-chip attachment-chip-hidden" title={ t(ctx, "mail.imageHidden") }>
							@attachmentTileBody(att)
						</span>
					</template>
				} else if att.ContentType == "application/pdf" {
					<div class="attachment-preview">
						<iframe
							src={ attachmentInlineURL(att) }
							class="pdf-preview"
							sandbox=""
							title={ att.Filename }
						></iframe>
						@attachmentTile(att)
					</div>
				} else if isTextType(att.ContentType) && att.Hash != "" {
					<div class="attachment-preview">
						<div
							class="text-preview"
							hx-get={ fmt.Sprintf("/mail/blob/%s?inline=1&ct=%s", att.Hash, att.ContentType) }
							hx-trigger="load"
							hx-swap="innerHTML"
						>
							{ t(ctx, "common.loading") }...
						</div>
						@attachmentTile(att)
					</div>
				} else {
					@attachmentTile(att)
				}
			}
		</div>
	</div>
}

// attachmentTile is the download link: extension badge, name and size.
templ attachmentTile(att Attachment) {
	<a class="attachment-chip" href={ templ.SafeURL(att.URL) } download={ att.Filename } aria-label={ fmt.Sprintf(t(ctx, "mail.downloadAttachment"), att.Filename, formatSize(att.Size)) }>
		@attachmentTileBody(att)
	</a>
}

templ attachmentTileBody(att Attachment) {
	<span class="att-ico" aria-hidden="true">{ attachmentExt(att.Filename, att.ContentType) }</span>
	<span class="att-name">{ att.Filename }</span>
	<span class="att-size">{ formatSize(att.Size) }</span>
}

// attachmentsHeading reads "Attachments . 2 files . 4.6 MB" with a singular
// form for one file.
func attachmentsHeading(ctx context.Context, attachments []Attachment) string {
	var total int64
	for _, a := range attachments {
		total += a.Size
	}
	summary := fmt.Sprintf(t(ctx, "mail.attachmentsMany"), len(attachments), formatSize(total))
	if len(attachments) == 1 {
		summary = fmt.Sprintf(t(ctx, "mail.attachmentsOne"), formatSize(total))
	}
	return t(ctx, "mail.attachments") + " \u00b7 " + summary
}

// attachmentExt returns the short badge text for an attachment: the lowercase
// filename extension cut to four characters, else the content-type subtype,
// else "file". A leading dot (".bashrc") is a hidden file, not an extension.
func attachmentExt(filename, contentType string) string {
	if i := strings.LastIndexByte(filename, '.'); i > 0 {
		if ext := strings.ToLower(filename[i+1:]); ext != "" {
			return truncateBadge(ext)
		}
	}
	if _, sub, ok := strings.Cut(contentType, "/"); ok && sub != "" {
		sub, _, _ = strings.Cut(sub, ";")
		sub = strings.ToLower(strings.TrimSpace(sub))
		if i := strings.LastIndexByte(sub, '+'); i >= 0 && i < len(sub)-1 {
			sub = sub[i+1:] // application/vnd.api+json -> json
		}
		if short, ok := subtypeBadges[sub]; ok {
			return short
		}
		return truncateBadge(sub)
	}
	return "file"
}

// subtypeBadges shortens content-type subtypes that read badly cut to four
// characters.
var subtypeBadges = map[string]string{
	"plain":        "txt",
	"octet-stream": "bin",
	"jpeg":         "jpg",
}

func truncateBadge(s string) string {
	if r := []rune(s); len(r) > 4 {
		return string(r[:4])
	}
	return s
}

func joinStrings(ss []string) string {
	result := ""
	for i, s := range ss {
		if i > 0 {
			result += ", "
		}
		result += s
	}
	return result
}

func formatQuotedText(text string) string {
	lines := strings.Split(html.EscapeString(text), "\n")
	var buf strings.Builder
	for _, line := range lines {
		if strings.HasPrefix(line, "&gt;") {
			buf.WriteString(`<span class="quoted">`)
			buf.WriteString(line)
			buf.WriteString("</span>\n")
		} else {
			buf.WriteString(line)
			buf.WriteByte('\n')
		}
	}
	return buf.String()
}

func isImageType(ct string) bool {
	return ct == "image/jpeg" || ct == "image/png" || ct == "image/gif" || ct == "image/webp"
}

// hasDisplayableImages reports whether any attachment is a safe raster image, so
// the "Show images" reveal control is only rendered when it has something to do.
func hasDisplayableImages(attachments []Attachment) bool {
	for _, att := range attachments {
		if isImageType(att.ContentType) {
			return true
		}
	}
	return false
}

// attachmentInlineURL returns the inline-display URL for an image attachment.
// Sent mail (with its own blob) uses the blob endpoint; inbound mail uses the
// message-scoped attachment route with ?inline=1, where the server serves the
// bytes with the safe content type derived from the parsed message.
func attachmentInlineURL(att Attachment) string {
	if att.Hash != "" {
		return inlineBlobURL(att.Hash, att.ContentType)
	}
	return att.URL + "?inline=1"
}

func isTextType(ct string) bool {
	// text/html is deliberately excluded: the text preview swaps the fetched
	// blob into the page via hx-swap="innerHTML", so an HTML attachment would
	// execute its markup/handlers in our authenticated origin (stored XSS).
	// HTML attachments fall through to a download-only chip.
	return ct == "text/plain" || ct == "text/csv" || ct == "application/json" || ct == "application/xml"
}

func inlineBlobURL(hash, contentType string) string {
	return fmt.Sprintf("/mail/blob/%s?inline=1&ct=%s", hash, contentType)
}

func formatSize(bytes int64) string {
	if bytes < 1024 {
		return fmt.Sprintf("%d B", bytes)
	}
	if bytes < 1024*1024 {
		return fmt.Sprintf("%.1f KB", float64(bytes)/1024)
	}
	return fmt.Sprintf("%.1f MB", float64(bytes)/(1024*1024))
}
