package templates

import (
	"bytes"
	"encoding/json"
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/emersion/go-vcard"

	bongov1 "github.com/bongo-project/bongo/proto/bongo/v1"
)

// contactExtraField is a labelled read-only value parsed from a contact's vCard
// for display (the label is an i18n key).
type contactExtraField struct {
	LabelKey string
	Value    string
}

// contactVCardDetails parses the stored vCard and returns the notable fields
// beyond the primary name/email/phone/company already shown in the header and
// edit form: additional emails and phones, postal address, job title, birthday,
// website and nickname. Returns nil when there is no vCard or it fails to parse.
func contactVCardDetails(c *bongov1.Contact) []contactExtraField {
	if len(c.VcardRaw) == 0 {
		return nil
	}
	card, err := vcard.NewDecoder(bytes.NewReader(c.VcardRaw)).Decode()
	if err != nil {
		return nil
	}

	var out []contactExtraField
	for i, v := range card.Values(vcard.FieldEmail) {
		if i == 0 || strings.TrimSpace(v) == "" {
			continue // first email is already shown
		}
		out = append(out, contactExtraField{"contacts.email", v})
	}
	for i, v := range card.Values(vcard.FieldTelephone) {
		if i == 0 || strings.TrimSpace(v) == "" {
			continue
		}
		out = append(out, contactExtraField{"contacts.phone", v})
	}
	if v := card.Value(vcard.FieldTitle); v != "" {
		out = append(out, contactExtraField{"contacts.title", v})
	}
	for _, a := range card.Addresses() {
		if s := formatVCardAddress(a); s != "" {
			out = append(out, contactExtraField{"contacts.address", s})
		}
	}
	if v := card.Value(vcard.FieldBirthday); v != "" {
		out = append(out, contactExtraField{"contacts.birthday", v})
	}
	if v := card.Value(vcard.FieldURL); v != "" {
		out = append(out, contactExtraField{"contacts.website", v})
	}
	if v := card.Value(vcard.FieldNickname); v != "" {
		out = append(out, contactExtraField{"contacts.nickname", v})
	}
	return out
}

// contactDetailFields returns the labelled values for the read-only detail
// card: primary email, phone, company and notes, then the vCard extras.
// Empty and whitespace-only values are dropped so the grid has no blank rows.
func contactDetailFields(c *bongov1.Contact) []contactExtraField {
	all := []contactExtraField{
		{"contacts.email", c.Email},
		{"contacts.phone", c.Phone},
		{"contacts.company", c.Company},
		{"contacts.notes", c.Notes},
	}
	all = append(all, contactVCardDetails(c)...)
	var out []contactExtraField
	for _, f := range all {
		if strings.TrimSpace(f.Value) != "" {
			out = append(out, f)
		}
	}
	return out
}

// contactFormRow is one editable multi-valued entry (email or phone).
type contactFormRow struct {
	Value string
	Type  string
}

// contactAddressRow is one editable postal address with its type.
type contactAddressRow struct {
	Type       string
	Street     string
	City       string
	Region     string
	PostalCode string
	Country    string
}

// contactFormData is the pre-filled state for the full contact edit form,
// derived from the stored vCard (falling back to the quick fields).
type contactFormData struct {
	Guid        string
	DisplayName string
	Emails      []contactFormRow
	Phones      []contactFormRow
	Company     string
	Title       string
	Addresses   []contactAddressRow
	Birthday    string
	Website     string
	Nickname    string
	Timezone    string
	Notes       string
}

func newContactFormData(c *bongov1.Contact) contactFormData {
	fd := contactFormData{Guid: c.Guid, DisplayName: c.DisplayName, Company: c.Company, Notes: c.Notes}

	card, err := decodeContactCard(c)
	if err != nil || card == nil {
		if c.Email != "" {
			fd.Emails = []contactFormRow{{Value: c.Email}}
		}
		if c.Phone != "" {
			fd.Phones = []contactFormRow{{Value: c.Phone}}
		}
		return fd
	}

	if fn := card.PreferredValue(vcard.FieldFormattedName); fn != "" {
		fd.DisplayName = fn
	}
	for _, f := range card[vcard.FieldEmail] {
		fd.Emails = append(fd.Emails, contactFormRow{Value: f.Value, Type: normalizeVCardType(f)})
	}
	for _, f := range card[vcard.FieldTelephone] {
		fd.Phones = append(fd.Phones, contactFormRow{Value: f.Value, Type: normalizeVCardType(f)})
	}
	fd.Company = card.PreferredValue(vcard.FieldOrganization)
	fd.Title = card.Value(vcard.FieldTitle)
	fd.Birthday = normalizeBirthday(card.Value(vcard.FieldBirthday))
	fd.Website = card.Value(vcard.FieldURL)
	fd.Nickname = card.Value(vcard.FieldNickname)
	fd.Timezone = card.Value(vcard.FieldTimezone)
	fd.Notes = card.Value(vcard.FieldNote)
	for _, a := range card.Addresses() {
		fd.Addresses = append(fd.Addresses, contactAddressRow{
			Type:       normalizeVCardType(a.Field),
			Street:     a.StreetAddress,
			City:       a.Locality,
			Region:     a.Region,
			PostalCode: a.PostalCode,
			Country:    a.Country,
		})
	}
	return fd
}

func decodeContactCard(c *bongov1.Contact) (vcard.Card, error) {
	if len(c.VcardRaw) == 0 {
		return nil, nil
	}
	return vcard.NewDecoder(bytes.NewReader(c.VcardRaw)).Decode()
}

// normalizeVCardType returns a lower-cased type for the field, mapping common
// synonyms to the editor's options (home/work/cell) and otherwise returning the
// first raw type so non-standard values are preserved through a round-trip.
func normalizeVCardType(f *vcard.Field) string {
	if f == nil || f.Params == nil {
		return ""
	}
	types := f.Params[vcard.ParamType]
	for _, t := range types {
		switch strings.ToLower(strings.TrimSpace(t)) {
		case "home":
			return "home"
		case "work":
			return "work"
		case "cell", "mobile":
			return "cell"
		}
	}
	if len(types) > 0 {
		return strings.ToLower(strings.TrimSpace(types[0]))
	}
	return ""
}

// normalizeBirthday coerces a vCard BDAY into the YYYY-MM-DD form an HTML date
// input needs, handling the common YYYYMMDD and date-time variants. Values it
// cannot interpret are returned unchanged.
func normalizeBirthday(s string) string {
	s = strings.TrimSpace(s)
	if s == "" {
		return ""
	}
	if i := strings.IndexAny(s, "T "); i > 0 {
		s = s[:i]
	}
	if len(s) == 8 && !strings.Contains(s, "-") {
		return s[0:4] + "-" + s[4:6] + "-" + s[6:8]
	}
	return s
}

// contactRowsJSON seeds the contactEditor component's email or phone rows,
// as JSON in a data attribute: the Alpine CSP build cannot evaluate an
// expression built from the values. An empty list gets one blank row.
func contactRowsJSON(list []contactFormRow) string {
	type row struct {
		Value string `json:"value"`
		Type  string `json:"type"`
	}
	out := []row{}
	for _, r := range list {
		out = append(out, row{r.Value, r.Type})
	}
	if len(out) == 0 {
		out = append(out, row{})
	}
	b, _ := json.Marshal(out)
	return string(b)
}

// contactAddressesJSON seeds the contactEditor component's address blocks.
func contactAddressesJSON(list []contactAddressRow) string {
	type addr struct {
		Type    string `json:"type"`
		Street  string `json:"street"`
		City    string `json:"city"`
		Region  string `json:"region"`
		Postal  string `json:"postal"`
		Country string `json:"country"`
	}
	out := []addr{}
	for _, a := range list {
		out = append(out, addr{a.Type, a.Street, a.City, a.Region, a.PostalCode, a.Country})
	}
	b, _ := json.Marshal(out)
	return string(b)
}

// timezoneInList reports whether tz is one of the curated options.
func timezoneInList(tz string) bool {
	for _, z := range commonTimezones() {
		if z == tz {
			return true
		}
	}
	return false
}

func formatVCardAddress(a *vcard.Address) string {
	var parts []string
	for _, p := range []string{a.StreetAddress, a.ExtendedAddress, a.Locality, a.Region, a.PostalCode, a.Country} {
		if s := strings.TrimSpace(p); s != "" {
			parts = append(parts, s)
		}
	}
	return strings.Join(parts, ", ")
}

templ ContactsPage(contacts []*bongov1.Contact, page, totalPages int, email string, flash string) {
	@LayoutWithContent(t(ctx, "contacts.contacts"), email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@ContactsSidebar()
		</aside>
		<main class="content" id="main-content">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<div class="page-head contacts-head">
				<h1>{ t(ctx, "contacts.contacts") }</h1>
				<div class="spacer"></div>
				<form class="import-form" method="post" action="/contacts/import" enctype="multipart/form-data" aria-label={ t(ctx, "contacts.importContacts") }>
					<input type="hidden" name="_csrf" value={ csrfToken(ctx) }/>
					<label class="tool-btn outline">
						<span>{ t(ctx, "contacts.importVcard") }</span>
						<input type="file" name="vcf" accept=".vcf" class="sr-only" aria-label={ t(ctx, "contacts.selectVcf") }/>
					</label>
					<button type="submit" class="sr-only">{ t(ctx, "contacts.import") }</button>
				</form>
				<a href="/contacts/export" class="tool-btn outline">{ t(ctx, "contacts.exportVcard") }</a>
				<button type="button" class="tool-btn primary" data-contact-form-toggle="toggle">{ t(ctx, "contacts.newContact") }</button>
			</div>
			<div id="create-form" hidden>
				<div class="settings-card u-mt-1">
					<form method="post" action="/contacts" class="u-p-18">
						<div class="form-grid-two">
							<label>
								<span class="settings-row-title">{ t(ctx, "contacts.name") }</span>
								<input type="text" name="display_name" class="settings-input u-w-full" required/>
							</label>
							<label>
								<span class="settings-row-title">{ t(ctx, "contacts.email") }</span>
								<input type="email" name="email" class="settings-input u-w-full"/>
							</label>
							<label>
								<span class="settings-row-title">{ t(ctx, "contacts.phone") }</span>
								<input type="tel" name="phone" class="settings-input u-w-full"/>
							</label>
							<label>
								<span class="settings-row-title">{ t(ctx, "contacts.company") }</span>
								<input type="text" name="company" class="settings-input u-w-full"/>
							</label>
						</div>
						<label class="u-mt-075 u-block">
							<span class="settings-row-title">{ t(ctx, "contacts.notes") }</span>
							<textarea name="notes" rows="2" class="settings-input u-w-full"></textarea>
						</label>
						<div class="form-inline-actions">
							<button type="submit" class="btn-send">{ t(ctx, "contacts.create") }</button>
							<button type="button" class="btn-secondary" data-contact-form-toggle="hide">{ t(ctx, "contacts.cancel") }</button>
						</div>
					</form>
				</div>
			</div>
			if len(contacts) == 0 {
				@EmptyState(t(ctx, "contacts.noContacts"), t(ctx, "contacts.addContacts"))
			} else {
				<div class="contacts-panes" id="contacts-panes">
					<div class="contact-list-pane">
						<div class="contact-scroll" role="list" aria-label={ t(ctx, "contacts.contactList") }>
							for _, c := range contacts {
								@ContactRow(c)
							}
						</div>
						@Pagination(page, totalPages, "/contacts")
					</div>
					<div class="contact-detail-pane" id="contact-detail">
						<div class="detail-placeholder detail-placeholder-center">
							{ t(ctx, "contacts.selectToView") }
						</div>
					</div>
				</div>
			}
		</main>
	}
}

templ ContactRow(c *bongov1.Contact) {
	<a
		href={ templ.SafeURL("/contacts/" + c.Guid) }
		hx-get={ "/contacts/" + c.Guid + "/detail" }
		hx-target="#contact-detail"
		hx-swap="innerHTML"
		class="contact-card"
		id={ "contact-" + c.Guid }
		data-guid={ c.Guid }
		role="listitem"
		tabindex="0"
		data-contact-select="true"
	>
		<div class={ "contact-avatar", avatarClass(c.DisplayName, c.Email) } aria-hidden="true">
			{ avatarInitials(c.DisplayName, c.Email) }
		</div>
		<div class="contact-info">
			<div class="contact-name">{ c.DisplayName }</div>
			<div class="contact-email">{ c.Email }</div>
		</div>
	</a>
}

templ ContactDetailPage(c *bongov1.Contact, email string) {
	@LayoutWithContent(t(ctx, "contacts.contact"), email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@ContactsSidebar()
		</aside>
		<main class="content" id="main-content">
			<div class="toolbar">
				<a href="/contacts" class="tool-btn">&larr; { t(ctx, "common.back") }</a>
			</div>
			<div class="contact-detail-pane">
				@contactCard(c, true)
			</div>
		</main>
	}
}

// ContactDetailPartial renders the detail card for the HTMX reading pane.
// ContactEditForm renders the full contact editor: every standard vCard field,
// with dynamic add/remove rows for emails and phones (Alpine CSP build, mirroring
// the rules form). Unmodelled properties are preserved by the handler on save.
templ ContactEditForm(fd contactFormData, isNew bool) {
	<form
		method="post"
		if isNew {
			action="/contacts"
		} else {
			action={ templ.SafeURL("/contacts/" + fd.Guid) }
		}
		x-data="contactEditor"
		data-emails={ contactRowsJSON(fd.Emails) }
		data-phones={ contactRowsJSON(fd.Phones) }
		data-addresses={ contactAddressesJSON(fd.Addresses) }
	>
		if !isNew {
			<input type="hidden" name="_method" value="PUT"/>
		}
		<div class="detail-fields">
			<div class="detail-field">
				<div class="detail-field-label">{ t(ctx, "contacts.name") }</div>
				<div class="detail-field-value">
					<input type="text" name="display_name" class="form-input" value={ fd.DisplayName } required/>
				</div>
			</div>
			<div class="detail-field">
				<div class="detail-field-label">{ t(ctx, "contacts.email") }</div>
				<div class="detail-field-value">
					<template x-for="(em, i) in emails" :key="i">
						<div class="contact-multi-row">
							<input type="email" name="email" x-bind:value="em.value" @input="setRow('emails', i, 'value', $event.target.value)" class="form-input" placeholder={ t(ctx, "contacts.email") }/>
							<select name="email_type" @change="setRow('emails', i, 'type', $event.target.value)" class="form-input contact-type-select">
								<template x-if="em.type && em.type !== 'home' && em.type !== 'work' && em.type !== 'cell' && em.type !== 'other'">
									<option :value="em.type" x-text="em.type" selected></option>
								</template>
								<option value="" x-bind:selected="!em.type">&#8212;</option>
								<option value="home" x-bind:selected="em.type === 'home'">{ t(ctx, "contacts.typeHome") }</option>
								<option value="work" x-bind:selected="em.type === 'work'">{ t(ctx, "contacts.typeWork") }</option>
								<option value="cell" x-bind:selected="em.type === 'cell'">{ t(ctx, "contacts.typeCell") }</option>
								<option value="other" x-bind:selected="em.type === 'other'">{ t(ctx, "contacts.typeOther") }</option>
							</select>
							<button type="button" class="btn-flush contact-row-remove" @click="removeRow('emails', i)" aria-label={ t(ctx, "contacts.remove") }>&#10005;</button>
						</div>
					</template>
					<button type="button" class="btn-outline btn-sm" @click="addRow('emails')">{ t(ctx, "contacts.addEmail") }</button>
				</div>
			</div>
			<div class="detail-field">
				<div class="detail-field-label">{ t(ctx, "contacts.phone") }</div>
				<div class="detail-field-value">
					<template x-for="(ph, i) in phones" :key="i">
						<div class="contact-multi-row">
							<input type="tel" name="phone" x-bind:value="ph.value" @input="setRow('phones', i, 'value', $event.target.value)" class="form-input" placeholder={ t(ctx, "contacts.phone") }/>
							<select name="phone_type" @change="setRow('phones', i, 'type', $event.target.value)" class="form-input contact-type-select">
								<template x-if="ph.type && ph.type !== 'home' && ph.type !== 'work' && ph.type !== 'cell' && ph.type !== 'other'">
									<option :value="ph.type" x-text="ph.type" selected></option>
								</template>
								<option value="" x-bind:selected="!ph.type">&#8212;</option>
								<option value="home" x-bind:selected="ph.type === 'home'">{ t(ctx, "contacts.typeHome") }</option>
								<option value="work" x-bind:selected="ph.type === 'work'">{ t(ctx, "contacts.typeWork") }</option>
								<option value="cell" x-bind:selected="ph.type === 'cell'">{ t(ctx, "contacts.typeCell") }</option>
								<option value="other" x-bind:selected="ph.type === 'other'">{ t(ctx, "contacts.typeOther") }</option>
							</select>
							<button type="button" class="btn-flush contact-row-remove" @click="removeRow('phones', i)" aria-label={ t(ctx, "contacts.remove") }>&#10005;</button>
						</div>
					</template>
					<button type="button" class="btn-outline btn-sm" @click="addRow('phones')">{ t(ctx, "contacts.addPhone") }</button>
				</div>
			</div>
			@contactTextField("company", "contacts.company", fd.Company)
			@contactTextField("title", "contacts.title", fd.Title)
			<div class="detail-field">
				<div class="detail-field-label">{ t(ctx, "contacts.address") }</div>
				<div class="detail-field-value">
					<template x-for="(ad, i) in addresses" :key="i">
						<div class="contact-address-block">
							<div class="contact-address-head">
								<select name="adr_type" @change="setRow('addresses', i, 'type', $event.target.value)" class="form-input contact-type-select">
									<template x-if="ad.type && ad.type !== 'home' && ad.type !== 'work' && ad.type !== 'other'">
										<option :value="ad.type" x-text="ad.type" selected></option>
									</template>
									<option value="" x-bind:selected="!ad.type">&#8212;</option>
									<option value="home" x-bind:selected="ad.type === 'home'">{ t(ctx, "contacts.typeHome") }</option>
									<option value="work" x-bind:selected="ad.type === 'work'">{ t(ctx, "contacts.typeWork") }</option>
									<option value="other" x-bind:selected="ad.type === 'other'">{ t(ctx, "contacts.typeOther") }</option>
								</select>
								<button type="button" class="btn-flush contact-row-remove" @click="removeRow('addresses', i)" aria-label={ t(ctx, "contacts.remove") }>&#10005;</button>
							</div>
							<div class="contact-address-grid">
								<input type="text" name="adr_street" x-bind:value="ad.street" @input="setRow('addresses', i, 'street', $event.target.value)" class="form-input" placeholder={ t(ctx, "contacts.street") }/>
								<input type="text" name="adr_city" x-bind:value="ad.city" @input="setRow('addresses', i, 'city', $event.target.value)" class="form-input" placeholder={ t(ctx, "contacts.city") }/>
								<input type="text" name="adr_region" x-bind:value="ad.region" @input="setRow('addresses', i, 'region', $event.target.value)" class="form-input" placeholder={ t(ctx, "contacts.region") }/>
								<input type="text" name="adr_postal" x-bind:value="ad.postal" @input="setRow('addresses', i, 'postal', $event.target.value)" class="form-input" placeholder={ t(ctx, "contacts.postalCode") }/>
								<input type="text" name="adr_country" x-bind:value="ad.country" @input="setRow('addresses', i, 'country', $event.target.value)" class="form-input" placeholder={ t(ctx, "contacts.country") }/>
							</div>
						</div>
					</template>
					<button type="button" class="btn-outline btn-sm" @click="addRow('addresses')">{ t(ctx, "contacts.addAddress") }</button>
				</div>
			</div>
			<div class="detail-field">
				<div class="detail-field-label">{ t(ctx, "contacts.birthday") }</div>
				<div class="detail-field-value">
					<input type="date" name="birthday" class="form-input" value={ fd.Birthday }/>
				</div>
			</div>
			@contactTextField("website", "contacts.website", fd.Website)
			@contactTextField("nickname", "contacts.nickname", fd.Nickname)
			<div class="detail-field">
				<div class="detail-field-label">{ t(ctx, "contacts.timezone") }</div>
				<div class="detail-field-value">
					<select name="timezone" class="form-input">
						<option value="">&#8212;</option>
						if fd.Timezone != "" && !timezoneInList(fd.Timezone) {
							<option value={ fd.Timezone } selected>{ fd.Timezone }</option>
						}
						for _, tz := range commonTimezones() {
							<option value={ tz } selected?={ tz == fd.Timezone }>{ tz }</option>
						}
					</select>
				</div>
			</div>
			<div class="detail-field">
				<div class="detail-field-label">{ t(ctx, "contacts.notes") }</div>
				<div class="detail-field-value">
					<textarea name="notes" rows="3" class="form-input u-w-full">{ fd.Notes }</textarea>
				</div>
			</div>
		</div>
		<div class="detail-actions">
			<button type="submit" class="btn-primary">{ t(ctx, "contacts.save") }</button>
			if !isNew {
				<span class="detail-spacer u-flex-1"></span>
				<button
					type="button"
					class="btn-flush u-text-danger"
					hx-delete={ "/contacts/" + fd.Guid }
					hx-confirm={ t(ctx, "contacts.confirmDelete") }
					hx-target="#contacts-panes"
					hx-swap="outerHTML"
				>
					{ t(ctx, "contacts.delete") }
				</button>
			}
		</div>
	</form>
}

templ contactTextField(name, labelKey, value string) {
	<div class="detail-field">
		<div class="detail-field-label">{ t(ctx, labelKey) }</div>
		<div class="detail-field-value">
			<input type="text" name={ name } class="form-input" value={ value }/>
		</div>
	</div>
}

templ ContactDetailPartial(c *bongov1.Contact) {
	@contactCard(c, false)
}

// contactCard is the read-only detail card with the editor beneath it. The
// editor is open on the full page (works without JS) and closed in the HTMX
// pane until Edit is pressed.
templ contactCard(c *bongov1.Contact, editorOpen bool) {
	<div class="contact-detail-card">
		<div class="contact-detail-header">
			<div class={ "contact-avatar", "contact-avatar-lg", avatarClass(c.DisplayName, c.Email) } aria-hidden="true">
				{ avatarInitials(c.DisplayName, c.Email) }
			</div>
			<div class="contact-detail-meta">
				<h2>{ c.DisplayName }</h2>
				if c.Company != "" {
					<div class="sub">{ c.Company }</div>
				}
			</div>
			<div class="contact-detail-actions">
				<button
					type="button"
					class="tool-btn outline"
					data-contact-edit-toggle="toggle"
					aria-controls={ "contact-editor-" + c.Guid }
					aria-expanded={ fmt.Sprint(editorOpen) }
				>{ t(ctx, "contacts.edit") }</button>
				if c.Email != "" {
					<a class="tool-btn primary" href={ templ.URL("/compose?to=" + url.QueryEscape(c.Email)) }>{ t(ctx, "contacts.emailAction") }</a>
				}
			</div>
		</div>
		if fields := contactDetailFields(c); len(fields) > 0 {
			<dl class="contact-fields">
				for _, f := range fields {
					<dt>{ t(ctx, f.LabelKey) }</dt>
					<dd>{ f.Value }</dd>
				}
			</dl>
		}
		<div class="contact-editor" id={ "contact-editor-" + c.Guid } hidden?={ !editorOpen }>
			@ContactEditForm(newContactFormData(c), false)
		</div>
		<div class="contact-dates">
			<span>{ t(ctx, "contacts.created") }: { formatContactDate(c.CreatedAt) }</span>
			<span>{ t(ctx, "contacts.updated") }: { formatContactDate(c.UpdatedAt) }</span>
		</div>
	</div>
}

templ ContactsSidebar() {
	<nav aria-label={ t(ctx, "contacts.contactsNav") }>
		<div class="sidebar-group">
			<div class="sidebar-label">{ t(ctx, "nav.contacts") }</div>
			<ul class="nav-list">
				<li class="nav-item">
					<a href="/contacts" class="active">
						<span class="nav-icon" aria-hidden="true">@Icon("users", "")</span>
						<span>{ t(ctx, "nav.allContacts") }</span>
					</a>
				</li>
			</ul>
		</div>
		<div class="sidebar-group">
			<div class="sidebar-label">{ t(ctx, "contacts.navigation") }</div>
			<ul class="nav-list">
				<li class="nav-item">
					<a href="/mail/INBOX">
						<span class="nav-icon" aria-hidden="true">@Icon("inbox", "")</span>
						<span>{ t(ctx, "nav.backToMail") }</span>
					</a>
				</li>
			</ul>
		</div>
	</nav>
}

func formatContactDate(unix int64) string {
	if unix == 0 {
		return "-"
	}
	return time.Unix(unix, 0).Format("Jan 2, 2006")
}
