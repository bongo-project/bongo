package templates

import "fmt"

templ ComposePageFull(mode string, to string, cc string, subject string, body string, replyMailbox string, replyUID uint32, mailboxes []MailboxInfo, tags []SidebarTagInfo, email string, fromOptions []string, selectedFrom string, htmlBody string) {
	@LayoutWithContent(t(ctx, "compose.compose"), email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@Sidebar(mailboxes, tags, "")
		</aside>
		<main class="content" id="main-content">
			@ComposePage(mode, to, cc, subject, body, replyMailbox, replyUID, fromOptions, selectedFrom, htmlBody)
		</main>
	}
}

templ ComposePage(mode string, to string, cc string, subject string, body string, replyMailbox string, replyUID uint32, fromOptions []string, selectedFrom string, htmlBody string) {
	<div class="compose-area">
		<div class="compose-card">
			<div class="compose-header">
				<span>
					switch mode {
						case "reply":
							{ t(ctx, "compose.reply") }
						case "forward":
							{ t(ctx, "compose.forward") }
						case "draft":
							{ t(ctx, "compose.editDraft") }
						default:
							{ t(ctx, "compose.newMessage") }
					}
				</span>
				<a href="/mail/INBOX" class="compose-close" title={ t(ctx, "compose.discard") }>&times;</a>
			</div>
			<form method="post" action="/compose/send" enctype="multipart/form-data" class="compose-form">
				<input type="hidden" name="_csrf" value={ csrfToken(ctx) }/>
				if mode == "reply" || mode == "forward" {
					<input type="hidden" name="reply_mailbox" value={ replyMailbox }/>
					<input type="hidden" name="reply_uid" value={ uintToStr(replyUID) }/>
					<input type="hidden" name="mode" value={ mode }/>
				}
				<div class="compose-body">
					if len(fromOptions) > 1 {
						<div class="field-row">
							<span class="field-label">{ t(ctx, "compose.from") }</span>
							<div class="field-content">
								<select name="from" aria-label={ t(ctx, "compose.from") }>
									for _, opt := range fromOptions {
										if opt == selectedFrom {
											<option value={ opt } selected>{ opt }</option>
										} else {
											<option value={ opt }>{ opt }</option>
										}
									}
								</select>
							</div>
						</div>
					}
					<div class="field-row">
						<span class="field-label">{ t(ctx, "compose.to") }</span>
						<div class="field-content">
							<input
								type="text"
								id="to"
								name="to"
								value={ to }
								required
								placeholder="recipient@example.com"
								x-data="galAutocomplete"
								:value="query"
								@input.debounce.300ms="query = $el.value; search()"
								@keydown="onKeydown($event)"
								aria-label={ t(ctx, "compose.to") }
							/>
						</div>
					</div>
					<div class="field-row" x-data="{ showCc: false, showBcc: false }">
						<span class="field-label">{ t(ctx, "compose.cc") }</span>
						<div class="field-content">
							<input
								type="text"
								id="cc"
								name="cc"
								value={ cc }
								placeholder="cc@example.com"
								x-data="galAutocomplete"
								:value="query"
								@input.debounce.300ms="query = $el.value; search()"
								@keydown="onKeydown($event)"
								aria-label={ t(ctx, "compose.cc") }
							/>
						</div>
					</div>
					<div class="field-row">
						<span class="field-label">{ t(ctx, "compose.bcc") }</span>
						<div class="field-content">
							<input
								type="text"
								id="bcc"
								name="bcc"
								placeholder="bcc@example.com"
								x-data="galAutocomplete"
								:value="query"
								@input.debounce.300ms="query = $el.value; search()"
								@keydown="onKeydown($event)"
								aria-label={ t(ctx, "compose.bcc") }
							/>
						</div>
					</div>
					<div class="field-row">
						<span class="field-label">{ t(ctx, "compose.subject") }</span>
						<div class="field-content">
							<input
								type="text"
								id="subject"
								name="subject"
								value={ subject }
								required
								aria-label={ t(ctx, "compose.subject") }
							/>
						</div>
					</div>
					<div x-data={ `{"bodyMode":"` + composeDefaultBodyMode(mode, htmlBody) + `"}` }>
						<div class="compose-mode-toggle">
							<button
								type="button"
								class="format-btn"
								x-bind:class="{'active': bodyMode === 'rich'}"
								x-on:click="bodyMode = 'rich'"
								aria-label={ t(ctx, "compose.bodyModeRich") }
							>{ t(ctx, "compose.bodyModeRich") }</button>
							<button
								type="button"
								class="format-btn"
								x-bind:class="{'active': bodyMode === 'plain'}"
								x-on:click="bodyMode = 'plain'"
								aria-label={ t(ctx, "compose.bodyModePlain") }
							>{ t(ctx, "compose.bodyModePlain") }</button>
						</div>
						<input type="hidden" name="body_mode" x-bind:value="bodyMode"/>
						<!-- Plain mode: a real <textarea> is in the DOM only when bodyMode==='plain'.
						     Using x-if (not x-show) ensures the element is completely removed from
						     the DOM in rich mode, so it is not submitted — no HTML entities or tags
						     can leak into the text/plain MIME part. Reply/forward default to plain so
						     the quoted body (with '>' markers) is submitted as literal plain text. -->
						<template x-if="bodyMode === 'plain'">
							<textarea
								name="body"
								class="compose-plain-body"
								aria-label={ t(ctx, "compose.body") }
							>{ composeInitialBody(mode, body) }</textarea>
						</template>
						<!-- Rich mode: the richEditor component is in the DOM only when
						     bodyMode==='rich'. Its hidden <input name="body"> is populated by
						     richEditor._syncHidden() (bongo.js) with editor.innerHTML on submit.
						     New messages default to rich mode and start with an empty editor;
						     the HTML signature is appended server-side in buildRichMessage so
						     that it appears exactly once in the sent mail. -->
						<template x-if="bodyMode === 'rich'">
							@RichEditorField("body", htmlBody, "compose")
						</template>
					</div>
					<div
						class="drop-zone"
						x-data="dropZone"
					>
						<input
							type="file"
							id="attachments"
							name="attachments"
							multiple
							aria-label={ t(ctx, "compose.attachments") }
							x-on:change="updateFiles($el)"
						/>
						<template x-if="files.length > 0">
							<div class="u-mt-05 u-font-085" aria-live="polite">
								<template x-for="(f, i) in files" :key="i">
									<div class="u-file-row">
										<span x-text="f.name"></span>
										<small x-text="'(' + formatBytes(f.size) + ')'"></small>
									</div>
								</template>
								<div class="u-mt-025 u-text-muted">
									<span x-text="files.length + ' file(s), total: ' + formatBytes(totalSize)"></span>
								</div>
							</div>
						</template>
					</div>
				</div>
				<div class="compose-footer">
					<button type="submit" class="btn-send">{ t(ctx, "compose.send") }</button>
					<button type="submit" formaction="/compose/draft" class="btn-secondary">{ t(ctx, "compose.saveDraft") }</button>
					<span class="reply-spacer"></span>
					<a href="/mail/INBOX" class="btn-secondary">{ t(ctx, "compose.discard") }</a>
				</div>
			</form>
		</div>
	</div>
}

func uintToStr(v uint32) string {
	if v == 0 {
		return ""
	}
	return fmt.Sprintf("%d", v)
}

// composeDefaultBodyMode returns "plain" for reply/forward modes and "rich" for
// new messages. This is rendered into the Alpine x-data initial state so that
// the body_mode form field defaults correctly without requiring JavaScript logic.
func composeDefaultBodyMode(mode, htmlBody string) string {
	// A draft carrying HTML reopens in rich mode; a plain draft (and
	// reply/forward) default to plain so quoted/plain text is submitted as-is.
	if htmlBody != "" {
		return "rich"
	}
	if mode == "reply" || mode == "forward" || mode == "draft" {
		return "plain"
	}
	return "rich"
}

// composeInitialBody returns the body text used to seed the plain-text
// <textarea> for all compose modes. For reply/forward this is the quoted text
// with the plain signature; for new messages it is the plain signature so that
// the plain-mode textarea is pre-filled.
//
// No double-signature risk: the plain and rich editors are mutually-exclusive
// x-if branches. New messages default to rich mode, which starts with an empty
// editor and receives the HTML signature server-side in buildRichMessage. The
// plain Send path uses the posted body as-is and never appends a signature.
func composeInitialBody(mode, body string) string {
	return body
}
