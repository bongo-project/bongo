package templates

import "fmt"

templ ComposePageFull(mode string, to string, cc string, subject string, body string, replyMailbox string, replyUID uint32, mailboxes []MailboxInfo, tags []SidebarTagInfo, email string) {
	@LayoutWithContent("Compose", email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@Sidebar(mailboxes, tags, "")
		</aside>
		<main class="content" id="main-content">
			@ComposePage(mode, to, cc, subject, body, replyMailbox, replyUID)
		</main>
	}
}

templ ComposePage(mode string, to string, cc string, subject string, body string, replyMailbox string, replyUID uint32) {
	<div class="compose-area">
		<div class="compose-card">
			<div class="compose-header">
				<span>
					switch mode {
						case "reply":
							{ t(ctx, "compose.reply") }
						case "forward":
							{ t(ctx, "compose.forward") }
						default:
							{ t(ctx, "compose.newMessage") }
					}
				</span>
				<a href="/mail/INBOX" class="compose-close" title={ t(ctx, "compose.discard") }>&times;</a>
			</div>
			<form method="post" action="/compose/send" enctype="multipart/form-data" class="compose-form">
				if mode == "reply" || mode == "forward" {
					<input type="hidden" name="reply_mailbox" value={ replyMailbox }/>
					<input type="hidden" name="reply_uid" value={ uintToStr(replyUID) }/>
					<input type="hidden" name="mode" value={ mode }/>
				}
				<div class="compose-body">
					<div class="field-row">
						<span class="field-label">{ t(ctx, "compose.to") }</span>
						<div class="field-content">
							<input
								type="text"
								id="to"
								name="to"
								value={ to }
								required
								placeholder="recipient@example.com"
								x-data="galAutocomplete"
								:value="query"
								@input.debounce.300ms="query = $el.value; search()"
								@keydown="onKeydown($event)"
								aria-label={ t(ctx, "compose.to") }
							/>
						</div>
					</div>
					<div class="field-row" x-data="{ showCc: false, showBcc: false }">
						<span class="field-label">{ t(ctx, "compose.cc") }</span>
						<div class="field-content">
							<input
								type="text"
								id="cc"
								name="cc"
								value={ cc }
								placeholder="cc@example.com"
								x-data="galAutocomplete"
								:value="query"
								@input.debounce.300ms="query = $el.value; search()"
								@keydown="onKeydown($event)"
								aria-label={ t(ctx, "compose.cc") }
							/>
						</div>
					</div>
					<div class="field-row">
						<span class="field-label">{ t(ctx, "compose.bcc") }</span>
						<div class="field-content">
							<input
								type="text"
								id="bcc"
								name="bcc"
								placeholder="bcc@example.com"
								x-data="galAutocomplete"
								:value="query"
								@input.debounce.300ms="query = $el.value; search()"
								@keydown="onKeydown($event)"
								aria-label={ t(ctx, "compose.bcc") }
							/>
						</div>
					</div>
					<div class="field-row">
						<span class="field-label">{ t(ctx, "compose.subject") }</span>
						<div class="field-content">
							<input
								type="text"
								id="subject"
								name="subject"
								value={ subject }
								required
								aria-label={ t(ctx, "compose.subject") }
							/>
						</div>
					</div>
					<textarea
						id="body"
						name="body"
						class="compose-textarea"
						placeholder={ t(ctx, "compose.body") }
						aria-label={ t(ctx, "compose.body") }
					>{ body }</textarea>
					<div
						class="drop-zone"
						x-data="dropZone"
					>
						<input
							type="file"
							id="attachments"
							name="attachments"
							multiple
							aria-label={ t(ctx, "compose.attachments") }
							x-on:change="updateFiles($el)"
						/>
						<template x-if="files.length > 0">
							<div class="u-mt-05 u-font-085" aria-live="polite">
								<template x-for="(f, i) in files" :key="i">
									<div class="u-file-row">
										<span x-text="f.name"></span>
										<small x-text="'(' + formatBytes(f.size) + ')'"></small>
									</div>
								</template>
								<div class="u-mt-025 u-text-muted">
									<span x-text="files.length + ' file(s), total: ' + formatBytes(totalSize)"></span>
								</div>
							</div>
						</template>
					</div>
				</div>
				<div class="compose-footer">
					<button type="submit" class="btn-send">{ t(ctx, "compose.send") }</button>
					<button type="submit" formaction="/compose/draft" class="btn-secondary">{ t(ctx, "compose.saveDraft") }</button>
					<span class="reply-spacer"></span>
					<a href="/mail/INBOX" class="btn-secondary">{ t(ctx, "compose.discard") }</a>
				</div>
			</form>
		</div>
	</div>
}

func uintToStr(v uint32) string {
	if v == 0 {
		return ""
	}
	return fmt.Sprintf("%d", v)
}
