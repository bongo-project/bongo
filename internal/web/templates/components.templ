package templates

import (
	"fmt"

	"github.com/bongo-go/bongo-go/internal/web/middleware"
)

// MailboxInfo holds data needed to render a sidebar mailbox link.
// Supports hierarchy via Children for nested folder trees.
type MailboxInfo struct {
	Name        string         // Full path, e.g. "Projects/Client-A"
	Label       string         // Display name (last segment), e.g. "Client-A"
	Unread      int
	Selected    bool
	Children    []MailboxInfo
	HasChildren bool
	Icon        string // HTML entity for folder-specific icon
}

templ Sidebar(mailboxes []MailboxInfo, selected string) {
	<a href="/compose" class="compose-btn" hx-get="/compose" hx-target="#main-content" hx-push-url="true">+ { t(ctx, "mail.compose") }</a>
	<nav aria-label="Mailboxes">
		<div class="sidebar-group">
			<div class="sidebar-label">{ t(ctx, "nav.mailboxes") }</div>
			<ul class="nav-list" id="mailbox-drop-targets">
				for _, mb := range mailboxes {
					@MailboxTreeNode(mb, selected)
				}
			</ul>
		</div>
		<div class="sidebar-group">
			<div class="sidebar-label">{ t(ctx, "nav.views") }</div>
			<ul class="nav-list">
				<li class="nav-item">
					<a
						href="/mail/unread"
						if selected == "unread" {
							class="active"
						}
						hx-get="/mail/unread"
						hx-target="#main-content"
						hx-push-url="true"
					>
						<span class="nav-icon" aria-hidden="true">&#9993;</span>
						<span>{ t(ctx, "nav.unread") }</span>
						<span id="unread-badge" class="nav-badge"></span>
					</a>
				</li>
				<li class="nav-item">
					<a
						href="/mail/starred"
						if selected == "starred" {
							class="active"
						}
						hx-get="/mail/starred"
						hx-target="#main-content"
						hx-push-url="true"
					>
						<span class="nav-icon" aria-hidden="true">&#9733;</span>
						<span>{ t(ctx, "nav.starred") }</span>
					</a>
				</li>
				<li class="nav-item">
					<a
						href="/mail/all-mail"
						if selected == "all-mail" {
							class="active"
						}
						hx-get="/mail/all-mail"
						hx-target="#main-content"
						hx-push-url="true"
					>
						<span class="nav-icon" aria-hidden="true">&#128229;</span>
						<span>{ t(ctx, "nav.allMail") }</span>
					</a>
				</li>
			</ul>
		</div>
		<div class="sidebar-group">
			<div class="sidebar-label">{ t(ctx, "nav.quickLinks") }</div>
			<ul class="nav-list" aria-label="Applications">
				<li class="nav-item">
					<a href="/contacts">
						<span class="nav-icon" aria-hidden="true">&#128101;</span>
						<span>{ t(ctx, "nav.contacts") }</span>
					</a>
				</li>
				<li class="nav-item">
					<a href="/calendar">
						<span class="nav-icon" aria-hidden="true">&#128197;</span>
						<span>{ t(ctx, "nav.calendar") }</span>
					</a>
				</li>
				if middleware.AdminFromContext(ctx) {
					<li class="nav-item">
						<a href="/admin">
							<span class="nav-icon" aria-hidden="true">&#9881;</span>
							<span>{ t(ctx, "nav.admin") }</span>
						</a>
					</li>
				}
			</ul>
		</div>
	</nav>
}

templ MailboxTreeNode(mb MailboxInfo, selected string) {
	if mb.HasChildren {
		<li class="nav-item nav-has-children">
			<div class="nav-folder-row">
				<button
					type="button"
					class="folder-toggle"
					onclick="event.stopPropagation(); var li = this.closest('.nav-has-children'); li.classList.toggle('collapsed'); this.setAttribute('aria-expanded', !li.classList.contains('collapsed'));"
					aria-expanded="true"
					aria-label="Toggle subfolder"
				>
					<span class="toggle-icon expanded">&#9654;</span>
				</button>
				<a
					href={ templ.SafeURL(mailboxURL(mb.Name)) }
					if mb.Name == selected {
						class="active"
					}
					hx-get={ mailboxURL(mb.Name) }
					hx-target="#main-content"
					hx-push-url="true"
					data-folder={ mb.Name }
				>
					<span class="nav-icon" aria-hidden="true">@templ.Raw(mb.Icon)</span>
					<span>{ mb.Label }</span>
					if mb.Unread > 0 {
						<span class="nav-badge" aria-label={ fmt.Sprintf("%d unread messages", mb.Unread) }>{ fmt.Sprint(mb.Unread) }</span>
					}
				</a>
			</div>
			<ul class="nav-list nav-children">
				for _, child := range mb.Children {
					@MailboxTreeNode(child, selected)
				}
			</ul>
		</li>
	} else {
		<li class="nav-item">
			<a
				href={ templ.SafeURL(mailboxURL(mb.Name)) }
				if mb.Name == selected {
					class="active"
				}
				hx-get={ mailboxURL(mb.Name) }
				hx-target="#main-content"
				hx-push-url="true"
				data-folder={ mb.Name }
			>
				<span class="nav-icon" aria-hidden="true">@templ.Raw(mb.Icon)</span>
				<span>{ mb.Label }</span>
				if mb.Unread > 0 {
					<span class="nav-badge" aria-label={ fmt.Sprintf("%d unread messages", mb.Unread) }>{ fmt.Sprint(mb.Unread) }</span>
				}
			</a>
		</li>
	}
}

templ Pagination(page, totalPages int, baseURL string) {
	if totalPages > 1 {
		<nav class="pagination" aria-label="Pagination">
			if page > 1 {
				<a
					class="page-btn"
					href={ templ.SafeURL(fmt.Sprintf("%s?page=%d", baseURL, page-1)) }
					hx-get={ fmt.Sprintf("%s?page=%d", baseURL, page-1) }
					hx-target="#message-list"
					hx-push-url="true"
					aria-label="Previous page"
				>
					{ t(ctx, "common.previous") }
				</a>
			}
			for i := 1; i <= totalPages; i++ {
				if i == page {
					<span class="page-btn active" aria-current="page">{ fmt.Sprint(i) }</span>
				} else {
					<a
						class="page-btn"
						href={ templ.SafeURL(fmt.Sprintf("%s?page=%d", baseURL, i)) }
						hx-get={ fmt.Sprintf("%s?page=%d", baseURL, i) }
						hx-target="#message-list"
						hx-push-url="true"
						aria-label={ fmt.Sprintf("Page %d", i) }
					>
						{ fmt.Sprint(i) }
					</a>
				}
			}
			if page < totalPages {
				<a
					class="page-btn"
					href={ templ.SafeURL(fmt.Sprintf("%s?page=%d", baseURL, page+1)) }
					hx-get={ fmt.Sprintf("%s?page=%d", baseURL, page+1) }
					hx-target="#message-list"
					hx-push-url="true"
					aria-label="Next page"
				>
					{ t(ctx, "common.next") }
				</a>
			}
		</nav>
	}
}

templ FlashMessage(msg, level string) {
	<div class={ "flash", "flash-" + level } role="alert" aria-live="assertive">
		{ msg }
	</div>
}

templ ContextMenu() {
	<div
		x-data="contextMenu"
		x-show="visible"
		x-on:click.away="close()"
		x-on:keydown.escape.window="close()"
		x-on:keydown="onKeydown($event)"
		x-on:ctx-menu.window="openAt($event.detail.x, $event.detail.y, $event.detail.uid, $event.detail.mailbox)"
		x-bind:style="'left:' + x + 'px;top:' + y + 'px'"
		class="context-menu"
		role="menu"
		x-cloak=""
	>
		<a x-on:click="action('open')" role="menuitem">{ t(ctx, "mail.open") }</a>
		<a x-on:click="action('reply')" role="menuitem">{ t(ctx, "mail.reply") }</a>
		<a x-on:click="action('reply-all')" role="menuitem">{ t(ctx, "mail.replyAll") }</a>
		<a x-on:click="action('forward')" role="menuitem">{ t(ctx, "mail.forward") }</a>
		<hr/>
		<a x-on:click="action('mark-read')" role="menuitem">{ t(ctx, "mail.markRead") }</a>
		<a x-on:click="action('mark-unread')" role="menuitem">{ t(ctx, "mail.markUnread") }</a>
		<a x-on:click="action('flag')" role="menuitem">{ t(ctx, "mail.flag") }</a>
		<a x-on:click="action('unflag')" role="menuitem">{ t(ctx, "mail.unflag") }</a>
		<hr/>
		<a x-on:click="action('spam')" role="menuitem">{ t(ctx, "mail.markAsSpam") }</a>
		<a x-on:click="action('not-spam')" role="menuitem">{ t(ctx, "mail.notSpam") }</a>
		<hr/>
		<a x-on:click="action('delete')" class="danger" role="menuitem">{ t(ctx, "mail.delete") }</a>
	</div>
}

templ EmptyState(title, subtitle string) {
	<div class="empty-state">
		<div class="empty-icon">&#9993;</div>
		<h3 class="empty-title">{ title }</h3>
		<p class="empty-text">{ subtitle }</p>
	</div>
}
