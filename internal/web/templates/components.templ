package templates

import "fmt"

// MailboxInfo holds data needed to render a sidebar mailbox link.
type MailboxInfo struct {
	Name     string
	Unread   int
	Selected bool
}

templ Sidebar(mailboxes []MailboxInfo, selected string) {
	<nav>
		<ul class="mailbox-list">
			<li>
				<a
					href="/mail/unread"
					if selected == "unread" {
						class="active"
					}
					hx-get="/mail/unread"
					hx-target="#main-content"
					hx-push-url="true"
				>
					<span>Unread</span>
					<span id="unread-badge" class="unread-badge"></span>
				</a>
			</li>
			<li>
				<a
					href="/mail/starred"
					if selected == "starred" {
						class="active"
					}
					hx-get="/mail/starred"
					hx-target="#main-content"
					hx-push-url="true"
				>
					<span>Starred</span>
				</a>
			</li>
			<li>
				<a
					href="/mail/all-mail"
					if selected == "all-mail" {
						class="active"
					}
					hx-get="/mail/all-mail"
					hx-target="#main-content"
					hx-push-url="true"
				>
					<span>All Mail</span>
				</a>
			</li>
		</ul>
		<hr style="margin:0.5rem 0"/>
		<ul class="mailbox-list" id="mailbox-drop-targets">
			for _, mb := range mailboxes {
				<li>
					<a
						href={ templ.SafeURL("/mail/" + mb.Name) }
						if mb.Name == selected {
							class="active"
						}
						hx-get={ "/mail/" + mb.Name }
						hx-target="#main-content"
						hx-push-url="true"
						data-folder={ mb.Name }
					>
						<span>{ mb.Name }</span>
						if mb.Unread > 0 {
							<span class="unread-badge">{ fmt.Sprint(mb.Unread) }</span>
						}
					</a>
				</li>
			}
		</ul>
	</nav>
}

templ Pagination(page, totalPages int, baseURL string) {
	if totalPages > 1 {
		<div class="pagination">
			if page > 1 {
				<a
					href={ templ.SafeURL(fmt.Sprintf("%s?page=%d", baseURL, page-1)) }
					hx-get={ fmt.Sprintf("%s?page=%d", baseURL, page-1) }
					hx-target="#message-list"
					hx-push-url="true"
				>
					Prev
				</a>
			}
			for i := 1; i <= totalPages; i++ {
				if i == page {
					<span class="current">{ fmt.Sprint(i) }</span>
				} else {
					<a
						href={ templ.SafeURL(fmt.Sprintf("%s?page=%d", baseURL, i)) }
						hx-get={ fmt.Sprintf("%s?page=%d", baseURL, i) }
						hx-target="#message-list"
						hx-push-url="true"
					>
						{ fmt.Sprint(i) }
					</a>
				}
			}
			if page < totalPages {
				<a
					href={ templ.SafeURL(fmt.Sprintf("%s?page=%d", baseURL, page+1)) }
					hx-get={ fmt.Sprintf("%s?page=%d", baseURL, page+1) }
					hx-target="#message-list"
					hx-push-url="true"
				>
					Next
				</a>
			}
		</div>
	}
}

templ FlashMessage(msg, level string) {
	<div class={ "flash", "flash-" + level }>
		{ msg }
	</div>
}

templ ContextMenu() {
	<div
		x-data="contextMenu"
		x-show="visible"
		x-on:click.away="close()"
		x-on:keydown.escape.window="close()"
		x-on:ctx-menu.window="open($event.detail.event, $event.detail.uid, $event.detail.mailbox)"
		x-bind:style="'left:' + x + 'px;top:' + y + 'px'"
		class="context-menu"
		x-cloak=""
	>
		<a x-on:click="action('open')">Open</a>
		<a x-on:click="action('reply')">Reply</a>
		<a x-on:click="action('reply-all')">Reply All</a>
		<a x-on:click="action('forward')">Forward</a>
		<hr/>
		<a x-on:click="action('mark-read')">Mark Read</a>
		<a x-on:click="action('mark-unread')">Mark Unread</a>
		<a x-on:click="action('flag')">Flag</a>
		<a x-on:click="action('unflag')">Unflag</a>
		<hr/>
		<a x-on:click="action('delete')" class="danger">Delete</a>
	</div>
}

templ EmptyState(title, subtitle string) {
	<div class="empty-state">
		<div class="icon">&#9993;</div>
		<h3>{ title }</h3>
		<p>{ subtitle }</p>
	</div>
}
