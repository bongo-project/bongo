package templates

import (
	"fmt"

	"github.com/bongo-project/bongo/internal/web/middleware"
)

// MailboxInfo holds data needed to render a sidebar mailbox link.
// Supports hierarchy via Children for nested folder trees.
type MailboxInfo struct {
	Name        string         // Full path, e.g. "Projects/Client-A"
	Label       string         // Display name (last segment), e.g. "Client-A"
	Unread      int
	Selected    bool
	Children    []MailboxInfo
	HasChildren bool
	Icon        string // Icon() set name for the folder-specific icon
}

// SidebarTagInfo holds display data for a single tag in the sidebar.
type SidebarTagInfo struct {
	Name        string // Tag name
	ColourIndex int32  // Palette index from the tag palette
	Count       int    // Number of messages bearing this tag
	Selected    bool   // True when the current view is this tag
}

// isSystemMailbox reports whether a top-level mailbox belongs in the Mail
// group of the sidebar rather than the Folders group.
func isSystemMailbox(name string) bool {
	switch name {
	case "INBOX", "Sent", "Drafts", "Trash", "Junk", "Archive":
		return true
	}
	return false
}

func hasCustomFolders(mailboxes []MailboxInfo) bool {
	for _, mb := range mailboxes {
		if !isSystemMailbox(mb.Name) {
			return true
		}
	}
	return false
}

// AppSwitcher is the stable application-level navigation shared by every
// authenticated sidebar. Contextual navigation scrolls above it, so a long
// folder tree never hides the other Bongo applications.
templ AppSwitcher(active string) {
	<nav class="sidebar-apps" aria-label={ t(ctx, "nav.applications") }>
		<a href="/summary" class={ "sidebar-app", templ.KV("active", active == "summary") } aria-current?={ active == "summary" } title={ t(ctx, "nav.summary") }>
			@Icon("bell", "")
			<span>{ t(ctx, "nav.summary") }</span>
		</a>
		<a href="/mail/INBOX" class={ "sidebar-app", templ.KV("active", active == "mail") } aria-current?={ active == "mail" } title={ t(ctx, "nav.mail") }>
			@Icon("inbox", "")
			<span>{ t(ctx, "nav.mail") }</span>
		</a>
		<a href="/calendar" class={ "sidebar-app", templ.KV("active", active == "calendar") } aria-current?={ active == "calendar" } title={ t(ctx, "nav.calendar") }>
			@Icon("calendar", "")
			<span>{ t(ctx, "nav.calendar") }</span>
		</a>
		<a href="/tasks" class={ "sidebar-app", templ.KV("active", active == "tasks") } aria-current?={ active == "tasks" } title={ t(ctx, "nav.tasks") }>
			@Icon("check", "")
			<span>{ t(ctx, "nav.tasks") }</span>
		</a>
		<a href="/contacts" class={ "sidebar-app", templ.KV("active", active == "contacts") } aria-current?={ active == "contacts" } title={ t(ctx, "nav.contacts") }>
			@Icon("users", "")
			<span>{ t(ctx, "nav.contacts") }</span>
		</a>
		<a href="/settings" class={ "sidebar-app", templ.KV("active", active == "settings") } aria-current?={ active == "settings" } title={ t(ctx, "nav.settings") }>
			@Icon("settings", "")
			<span>{ t(ctx, "nav.settings") }</span>
		</a>
		if middleware.AdminFromContext(ctx) {
			<a href="/admin" class={ "sidebar-app", templ.KV("active", active == "admin") } aria-current?={ active == "admin" } title={ t(ctx, "nav.admin") }>
				@Icon("shield", "")
				<span>{ t(ctx, "nav.admin") }</span>
			</a>
		}
	</nav>
}

// SettingsSidebar keeps settings destinations consistent across preferences,
// rules, vacation, tags, addresses and security sub-pages.
templ SettingsSidebar(active string) {
	<nav class="sidebar-scroll" aria-label={ t(ctx, "settings.navAriaLabel") }>
		<div class="sidebar-group">
			<div class="sidebar-label">{ t(ctx, "settings.navigation") }</div>
			<ul class="nav-list">
				<li class="nav-item"><a href="/settings" class={ templ.KV("active", active == "settings") } aria-current?={ active == "settings" }><span class="nav-icon" aria-hidden="true">@Icon("settings", "")</span><span>{ t(ctx, "nav.settings") }</span></a></li>
				<li class="nav-item"><a href="/settings/rules" class={ templ.KV("active", active == "rules") } aria-current?={ active == "rules" }><span class="nav-icon" aria-hidden="true">@Icon("sliders", "")</span><span>{ t(ctx, "settings.filterRules") }</span></a></li>
				<li class="nav-item"><a href="/settings/vacation" class={ templ.KV("active", active == "vacation") } aria-current?={ active == "vacation" }><span class="nav-icon" aria-hidden="true">@Icon("reply", "")</span><span>{ t(ctx, "settings.vacation") }</span></a></li>
				<li class="nav-item"><a href="/settings/tags" class={ templ.KV("active", active == "tags") } aria-current?={ active == "tags" }><span class="nav-icon" aria-hidden="true">@Icon("tag", "")</span><span>{ t(ctx, "nav.tags") }</span></a></li>
				<li class="nav-item"><a href="/settings/addresses" class={ templ.KV("active", active == "addresses") } aria-current?={ active == "addresses" }><span class="nav-icon" aria-hidden="true">@Icon("send", "")</span><span>{ t(ctx, "settings.sendAsAddresses") }</span></a></li>
				<li class="nav-item"><a href="/settings/security" class={ templ.KV("active", active == "security") } aria-current?={ active == "security" }><span class="nav-icon" aria-hidden="true">@Icon("shield", "")</span><span>{ t(ctx, "settings.security") }</span></a></li>
			</ul>
		</div>
	</nav>
	@AppSwitcher("settings")
}

templ Sidebar(mailboxes []MailboxInfo, tags []SidebarTagInfo, selected string) {
	<div class="sidebar-top">
		<a href="/compose" class="compose-btn" hx-get="/compose" hx-target="#main-content" hx-push-url="true">
			@Icon("plus_sm", "")
			<span>{ t(ctx, "mail.compose") }</span>
		</a>
	</div>
	<nav class="sidebar-scroll" aria-label={ t(ctx, "nav.mailboxes") }>
		<div class="sidebar-group" data-group="mail">
			<div class="sidebar-label">{ t(ctx, "nav.mail") }</div>
			<ul class="nav-list" id="mailbox-drop-targets" aria-label={ t(ctx, "nav.mail") }>
				for _, mb := range mailboxes {
					if mb.Name == "INBOX" || mb.Name == "Sent" || mb.Name == "Drafts" {
						@MailboxTreeNode(mb, selected)
					}
				}
				<li class="nav-item">
					<a
						href="/mail/starred"
						if selected == "starred" {
							class="active"
						}
						hx-get="/mail/starred"
						hx-target="#main-content"
						hx-push-url="true"
					>
						<span class="nav-icon" aria-hidden="true">@Icon("star", "")</span>
						<span>{ t(ctx, "nav.starred") }</span>
					</a>
				</li>
			</ul>
		</div>
		<div class="sidebar-group" data-group="more" x-data="sidebarSection('more', false)">
			<button type="button" class="sidebar-label sidebar-label-toggle" x-on:click="toggle()" x-bind:aria-expanded="open">
				<span>{ t(ctx, "nav.more") }</span>
				<span class="sidebar-chevron" x-bind:class="{'collapsed': !open}" aria-hidden="true">&#9660;</span>
			</button>
			<ul class="nav-list" x-bind:hidden="!open" aria-label={ t(ctx, "nav.more") }>
				for _, mb := range mailboxes {
					if mb.Name == "Archive" || mb.Name == "Junk" || mb.Name == "Trash" {
						@MailboxTreeNode(mb, selected)
					}
				}
				<li class="nav-item">
					<a
						href="/mail/all-mail"
						if selected == "all-mail" {
							class="active"
						}
						hx-get="/mail/all-mail"
						hx-target="#main-content"
						hx-push-url="true"
					>
						<span class="nav-icon" aria-hidden="true">@Icon("archive", "")</span>
						<span>{ t(ctx, "nav.allMail") }</span>
					</a>
				</li>
			</ul>
		</div>
		<div class="sidebar-group" data-group="views" x-data="sidebarSection('views', false)">
			<button type="button" class="sidebar-label sidebar-label-toggle" x-on:click="toggle()" x-bind:aria-expanded="open">
				<span>{ t(ctx, "nav.views") }</span>
				<span class="sidebar-chevron" x-bind:class="{'collapsed': !open}" aria-hidden="true">&#9660;</span>
			</button>
			<ul class="nav-list" x-bind:hidden="!open" aria-label={ t(ctx, "nav.views") }>
				<li class="nav-item">
					<a
						href="/mail/unread"
						if selected == "unread" {
							class="active"
						}
						hx-get="/mail/unread"
						hx-target="#main-content"
						hx-push-url="true"
					>
						<span class="nav-icon" aria-hidden="true">@Icon("inbox", "")</span>
						<span>{ t(ctx, "nav.unread") }</span>
						<span id="unread-badge" class="unread-badge"></span>
					</a>
				</li>
				<li class="nav-item">
					<a
						href="/mail/view/to-me"
						if selected == "/mail/view/to-me" {
							class="active"
						}
						hx-get="/mail/view/to-me"
						hx-target="#main-content"
						hx-push-url="true"
					>
						<span class="nav-icon" aria-hidden="true">@Icon("inbox", "")</span>
						<span>{ t(ctx, "nav.toMe") }</span>
					</a>
				</li>
				<li class="nav-item">
					<a
						href="/mail/view/from-contacts"
						if selected == "/mail/view/from-contacts" {
							class="active"
						}
						hx-get="/mail/view/from-contacts"
						hx-target="#main-content"
						hx-push-url="true"
					>
						<span class="nav-icon" aria-hidden="true">@Icon("users", "")</span>
						<span>{ t(ctx, "nav.fromContacts") }</span>
					</a>
				</li>
				<li class="nav-item">
					<a
						href="/mail/view/lists"
						if isListsSelected(selected) {
							class="active"
						}
						hx-get="/mail/view/lists"
						hx-target="#main-content"
						hx-push-url="true"
					>
						<span class="nav-icon" aria-hidden="true">@Icon("folder", "")</span>
						<span>{ t(ctx, "nav.mailingLists") }</span>
					</a>
				</li>
			</ul>
		</div>
		if hasCustomFolders(mailboxes) {
			<div class="sidebar-group" data-group="folders" x-data="sidebarSection('folders', true)">
				<button type="button" class="sidebar-label sidebar-label-toggle" x-on:click="toggle()" x-bind:aria-expanded="open">
					<span>{ t(ctx, "nav.folders") }</span>
					<span class="sidebar-chevron" x-bind:class="{'collapsed': !open}" aria-hidden="true">&#9660;</span>
				</button>
				<ul class="nav-list" x-bind:hidden="!open">
					for _, mb := range mailboxes {
						if !isSystemMailbox(mb.Name) {
							@MailboxTreeNode(mb, selected)
						}
					}
				</ul>
			</div>
		}
		if len(tags) > 0 {
			<div class="sidebar-group" data-group="tags" x-data="sidebarSection('tags', true)">
				<button type="button" class="sidebar-label sidebar-label-toggle" x-on:click="toggle()" x-bind:aria-expanded="open">
					<span>{ t(ctx, "nav.tags") }</span>
					<span class="sidebar-chevron" x-bind:class="{'collapsed': !open}" aria-hidden="true">&#9660;</span>
				</button>
				<ul class="nav-list" x-bind:hidden="!open" aria-label={ t(ctx, "nav.tags") }>
					for i, tag := range tags {
						if i < 20 {
							<li class="nav-item">
								<a
									href={ templ.SafeURL("/mail/tag/" + tag.Name) }
									if tag.Selected {
										class="active"
									}
									hx-get={ "/mail/tag/" + tag.Name }
									hx-target="#main-content"
									hx-push-url="true"
								>
									<span class={ "nav-tag-dot", tagPaletteBGClass(tag.ColourIndex) } aria-hidden="true"></span>
									<span>{ tag.Name }</span>
									if tag.Count > 0 {
										<span class="count" aria-label={ fmt.Sprintf("%d messages", tag.Count) }>{ fmt.Sprint(tag.Count) }</span>
									}
								</a>
							</li>
						}
					}
					if len(tags) > 20 {
						<li class="nav-item">
							<a href="/settings/tags">
								<span class="nav-icon" aria-hidden="true">&#8230;</span>
								<span>{ t(ctx, "nav.showAllTags") }</span>
							</a>
						</li>
					}
				</ul>
			</div>
		}
	</nav>
	if selected == "summary" {
		@AppSwitcher("summary")
	} else {
		@AppSwitcher("mail")
	}
}

// mailboxCount is always rendered, hidden at zero, so the live refresh in
// bongo.js (refreshUnreadCounts) can fill it in when a folder gains unread mail.
templ mailboxCount(mb MailboxInfo) {
	<span
		class={ mailboxCountClass(mb.Name) }
		data-unread-for={ mb.Name }
		data-unread-label={ t(ctx, "mail.unreadCount") }
		aria-label={ fmt.Sprintf(t(ctx, "mail.unreadCount"), mb.Unread) }
		hidden?={ mb.Unread == 0 }
	>
		if mb.Unread > 0 {
			{ fmt.Sprint(mb.Unread) }
		}
	</span>
}

// mailboxCountClass gives INBOX the accent pill and other folders the muted count.
func mailboxCountClass(name string) string {
	if name == "INBOX" {
		return "unread"
	}
	return "count"
}

templ MailboxTreeNode(mb MailboxInfo, selected string) {
	if mb.HasChildren {
		<li class="nav-item nav-has-children">
			<div class="nav-folder-row">
				<button
					type="button"
					class="folder-toggle"
					data-folder-toggle="true"
					aria-expanded="true"
					aria-label={ t(ctx, "nav.toggleSubfolder") }
				>
					<span class="toggle-icon expanded">@Icon("chevron_right", "")</span>
				</button>
				<a
					href={ templ.SafeURL(mailboxURL(mb.Name)) }
					if mb.Name == selected {
						class="active"
					}
					hx-get={ mailboxURL(mb.Name) }
					hx-target="#main-content"
					hx-push-url="true"
					data-folder={ mb.Name }
				>
					<span class="nav-icon" aria-hidden="true">@Icon(mb.Icon, "")</span>
					<span>{ mb.Label }</span>
					@mailboxCount(mb)
				</a>
			</div>
			<ul class="nav-list nav-children">
				for _, child := range mb.Children {
					@MailboxTreeNode(child, selected)
				}
			</ul>
		</li>
	} else {
		<li class="nav-item">
			<a
				href={ templ.SafeURL(mailboxURL(mb.Name)) }
				if mb.Name == selected {
					class="active"
				}
				hx-get={ mailboxURL(mb.Name) }
				hx-target="#main-content"
				hx-push-url="true"
				data-folder={ mb.Name }
			>
				<span class="nav-icon" aria-hidden="true">@Icon(mb.Icon, "")</span>
				<span>{ mb.Label }</span>
				@mailboxCount(mb)
			</a>
		</li>
	}
}

templ Pagination(page, totalPages int, baseURL string) {
	if totalPages > 1 {
		<nav class="pagination" aria-label={ t(ctx, "common.pagination") }>
			if page > 1 {
				<a
					class="page-btn"
					href={ templ.SafeURL(pageURL(baseURL, page-1)) }
					hx-get={ pageURL(baseURL, page-1) }
					hx-target="#message-list"
					hx-push-url="true"
					aria-label={ t(ctx, "common.previousPage") }
				>
					{ t(ctx, "common.previous") }
				</a>
			}
			for _, i := range pageWindow(page, totalPages) {
				if i == 0 {
					<span class="page-ellipsis">...</span>
				} else if i == page {
					<span class="page-btn active" aria-current="page">{ fmt.Sprint(i) }</span>
				} else {
					<a
						class="page-btn"
						href={ templ.SafeURL(pageURL(baseURL, i)) }
						hx-get={ pageURL(baseURL, i) }
						hx-target="#message-list"
						hx-push-url="true"
						aria-label={ fmt.Sprintf("Page %d", i) }
					>
						{ fmt.Sprint(i) }
					</a>
				}
			}
			if page < totalPages {
				<a
					class="page-btn"
					href={ templ.SafeURL(pageURL(baseURL, page+1)) }
					hx-get={ pageURL(baseURL, page+1) }
					hx-target="#message-list"
					hx-push-url="true"
					aria-label={ t(ctx, "common.nextPage") }
				>
					{ t(ctx, "common.next") }
				</a>
			}
		</nav>
	}
}

templ FlashMessage(msg, level string) {
	<div class={ "flash", "flash-" + level } role="alert" aria-live="assertive">
		{ msg }
	</div>
}

templ ContextMenu() {
	<div
		x-data="contextMenu"
		x-bind:hidden="!visible"
		x-on:click.away="close()"
		x-on:keydown.escape.window="close()"
		x-on:keydown="onKeydown($event)"
		x-on:ctx-menu.window="openAt($event.detail.x, $event.detail.y, $event.detail.uid, $event.detail.mailbox, $event.detail.real)"
		class="context-menu"
		role="menu"
		x-cloak=""
	>
		<a x-on:click="action('open')" role="menuitem">{ t(ctx, "mail.open") }</a>
		<a x-on:click="action('reply')" role="menuitem">{ t(ctx, "mail.reply") }</a>
		<a x-on:click="action('reply-all')" role="menuitem">{ t(ctx, "mail.replyAll") }</a>
		<a x-on:click="action('forward')" role="menuitem">{ t(ctx, "mail.forward") }</a>
		<a x-on:click="action('create-filter')" role="menuitem">{ t(ctx, "mail.createFilter") }</a>
		<hr/>
		<a x-on:click="action('mark-read')" role="menuitem">{ t(ctx, "mail.markRead") }</a>
		<a x-on:click="action('mark-unread')" role="menuitem">{ t(ctx, "mail.markUnread") }</a>
		<a x-on:click="action('flag')" role="menuitem">{ t(ctx, "mail.flag") }</a>
		<a x-on:click="action('unflag')" role="menuitem">{ t(ctx, "mail.unflag") }</a>
		<hr/>
		<div class="ctx-tag-submenu">
			<a role="menuitem" class="ctx-tag-toggle" x-on:click.stop="toggleTag()">{ t(ctx, "tag.applyMenu") }</a>
			<div x-bind:hidden="!tagOpen" x-cloak="" class="ctx-tag-input-row">
				<input
					type="text"
					x-model="tagInput"
					placeholder={ t(ctx, "tag.namePlaceholder") }
					aria-label={ t(ctx, "tag.namePlaceholder") }
					x-on:keydown.enter.prevent="tagSubmit('add')"
					x-on:click.stop=""
				/>
				<button type="button" class="tool-btn" x-on:click.stop="tagSubmit('add')" x-bind:disabled="tagEmpty()">{ t(ctx, "action.add") }</button>
				<button type="button" class="tool-btn" x-on:click.stop="tagSubmit('remove')" x-bind:disabled="tagEmpty()">{ t(ctx, "action.remove") }</button>
			</div>
		</div>
		<hr/>
		<a x-on:click="action('spam')" role="menuitem">{ t(ctx, "mail.markAsSpam") }</a>
		<a x-on:click="action('not-spam')" role="menuitem">{ t(ctx, "mail.notSpam") }</a>
		<hr/>
		<a x-on:click="action('delete')" class="danger" role="menuitem">{ t(ctx, "mail.delete") }</a>
	</div>
}

templ EmptyState(title, subtitle string) {
	<div class="empty-state">
		<div class="empty-icon" aria-hidden="true">@Icon("inbox", "")</div>
		<h3 class="empty-title">{ title }</h3>
		<p class="empty-text">{ subtitle }</p>
	</div>
}
