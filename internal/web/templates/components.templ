package templates

import (
	"fmt"

	"github.com/bongo-project/bongo/internal/web/middleware"
)

// MailboxInfo holds data needed to render a sidebar mailbox link.
// Supports hierarchy via Children for nested folder trees.
type MailboxInfo struct {
	Name        string         // Full path, e.g. "Projects/Client-A"
	Label       string         // Display name (last segment), e.g. "Client-A"
	Unread      int
	Selected    bool
	Children    []MailboxInfo
	HasChildren bool
	Icon        string // HTML entity for folder-specific icon
}

// SidebarTagInfo holds display data for a single tag in the sidebar.
type SidebarTagInfo struct {
	Name        string // Tag name
	ColourIndex int32  // Palette index from the tag palette
	Count       int    // Number of messages bearing this tag
	Selected    bool   // True when the current view is this tag
}

templ Sidebar(mailboxes []MailboxInfo, tags []SidebarTagInfo, selected string) {
	<a href="/compose" class="compose-btn" hx-get="/compose" hx-target="#main-content" hx-push-url="true">+ { t(ctx, "mail.compose") }</a>
	<nav aria-label={ t(ctx, "nav.mailboxes") }>
		<div class="sidebar-group">
			<div class="sidebar-label">{ t(ctx, "nav.mailboxes") }</div>
			<ul class="nav-list" id="mailbox-drop-targets">
				for _, mb := range mailboxes {
					@MailboxTreeNode(mb, selected)
				}
			</ul>
		</div>
		if len(tags) > 0 {
			<div class="sidebar-group" x-data="sidebarSection('tags')">
				<div class="sidebar-label sidebar-label-toggle" x-on:click="toggle()">
					<span>{ t(ctx, "nav.tags") }</span>
					<span class="sidebar-chevron" x-bind:class="{'collapsed': !open}">&#9660;</span>
				</div>
				<ul class="nav-list" x-bind:hidden="!open" aria-label={ t(ctx, "nav.tags") }>
					for i, tag := range tags {
						if i < 20 {
							<li class="nav-item">
								<a
									href={ templ.SafeURL("/mail/tag/" + tag.Name) }
									if tag.Selected {
										class="active"
									}
									hx-get={ "/mail/tag/" + tag.Name }
									hx-target="#main-content"
									hx-push-url="true"
								>
									<span class={ "nav-tag-dot", tagPaletteBGClass(tag.ColourIndex) } aria-hidden="true"></span>
									<span>{ tag.Name }</span>
									if tag.Count > 0 {
										<span class="nav-badge" aria-label={ fmt.Sprintf("%d messages", tag.Count) }>{ fmt.Sprint(tag.Count) }</span>
									}
								</a>
							</li>
						}
					}
					if len(tags) > 20 {
						<li class="nav-item">
							<a href="/settings/tags">
								<span class="nav-icon" aria-hidden="true">&#8230;</span>
								<span>{ t(ctx, "nav.showAllTags") }</span>
							</a>
						</li>
					}
				</ul>
			</div>
		}
		<div class="sidebar-group" x-data="sidebarSection('views')">
			<div class="sidebar-label sidebar-label-toggle" x-on:click="toggle()">
				<span>{ t(ctx, "nav.views") }</span>
				<span class="sidebar-chevron" x-bind:class="{'collapsed': !open}">&#9660;</span>
			</div>
			<ul class="nav-list" x-bind:hidden="!open">
				<li class="nav-item">
					<a
						href="/mail/unread"
						if selected == "unread" {
							class="active"
						}
						hx-get="/mail/unread"
						hx-target="#main-content"
						hx-push-url="true"
					>
						<span class="nav-icon" aria-hidden="true">&#9993;</span>
						<span>{ t(ctx, "nav.unread") }</span>
						<span id="unread-badge" class="nav-badge"></span>
					</a>
				</li>
				<li class="nav-item">
					<a
						href="/mail/starred"
						if selected == "starred" {
							class="active"
						}
						hx-get="/mail/starred"
						hx-target="#main-content"
						hx-push-url="true"
					>
						<span class="nav-icon" aria-hidden="true">&#9733;</span>
						<span>{ t(ctx, "nav.starred") }</span>
					</a>
				</li>
				<li class="nav-item">
					<a
						href="/mail/all-mail"
						if selected == "all-mail" {
							class="active"
						}
						hx-get="/mail/all-mail"
						hx-target="#main-content"
						hx-push-url="true"
					>
						<span class="nav-icon" aria-hidden="true">&#128229;</span>
						<span>{ t(ctx, "nav.allMail") }</span>
					</a>
				</li>
			</ul>
		</div>
		<div class="sidebar-group" x-data="sidebarSection('quicklinks')">
			<div class="sidebar-label sidebar-label-toggle" x-on:click="toggle()">
				<span>{ t(ctx, "nav.quickLinks") }</span>
				<span class="sidebar-chevron" x-bind:class="{'collapsed': !open}">&#9660;</span>
			</div>
			<ul class="nav-list" x-bind:hidden="!open" aria-label={ t(ctx, "nav.applications") }>
				<li class="nav-item">
					<a href="/contacts">
						<span class="nav-icon" aria-hidden="true">&#128101;</span>
						<span>{ t(ctx, "nav.contacts") }</span>
					</a>
				</li>
				<li class="nav-item">
					<a href="/calendar">
						<span class="nav-icon" aria-hidden="true">&#128197;</span>
						<span>{ t(ctx, "nav.calendar") }</span>
					</a>
				</li>
				if middleware.AdminFromContext(ctx) {
					<li class="nav-item">
						<a href="/admin">
							<span class="nav-icon" aria-hidden="true">&#9881;</span>
							<span>{ t(ctx, "nav.admin") }</span>
						</a>
					</li>
				}
			</ul>
		</div>
	</nav>
}

templ MailboxTreeNode(mb MailboxInfo, selected string) {
	if mb.HasChildren {
		<li class="nav-item nav-has-children">
			<div class="nav-folder-row">
				<button
					type="button"
					class="folder-toggle"
					data-folder-toggle="true"
					aria-expanded="true"
					aria-label={ t(ctx, "nav.toggleSubfolder") }
				>
					<span class="toggle-icon expanded">&#9654;</span>
				</button>
				<a
					href={ templ.SafeURL(mailboxURL(mb.Name)) }
					if mb.Name == selected {
						class="active"
					}
					hx-get={ mailboxURL(mb.Name) }
					hx-target="#main-content"
					hx-push-url="true"
					data-folder={ mb.Name }
				>
					<span class="nav-icon" aria-hidden="true">@templ.Raw(mb.Icon)</span>
					<span>{ mb.Label }</span>
					if mb.Unread > 0 {
						<span class="nav-badge" aria-label={ fmt.Sprintf("%d unread messages", mb.Unread) }>{ fmt.Sprint(mb.Unread) }</span>
					}
				</a>
			</div>
			<ul class="nav-list nav-children">
				for _, child := range mb.Children {
					@MailboxTreeNode(child, selected)
				}
			</ul>
		</li>
	} else {
		<li class="nav-item">
			<a
				href={ templ.SafeURL(mailboxURL(mb.Name)) }
				if mb.Name == selected {
					class="active"
				}
				hx-get={ mailboxURL(mb.Name) }
				hx-target="#main-content"
				hx-push-url="true"
				data-folder={ mb.Name }
			>
				<span class="nav-icon" aria-hidden="true">@templ.Raw(mb.Icon)</span>
				<span>{ mb.Label }</span>
				if mb.Unread > 0 {
					<span class="nav-badge" aria-label={ fmt.Sprintf("%d unread messages", mb.Unread) }>{ fmt.Sprint(mb.Unread) }</span>
				}
			</a>
		</li>
	}
}

templ Pagination(page, totalPages int, baseURL string) {
	if totalPages > 1 {
		<nav class="pagination" aria-label={ t(ctx, "common.pagination") }>
			if page > 1 {
				<a
					class="page-btn"
					href={ templ.SafeURL(fmt.Sprintf("%s?page=%d", baseURL, page-1)) }
					hx-get={ fmt.Sprintf("%s?page=%d", baseURL, page-1) }
					hx-target="#message-list"
					hx-push-url="true"
					aria-label={ t(ctx, "common.previousPage") }
				>
					{ t(ctx, "common.previous") }
				</a>
			}
			for _, i := range pageWindow(page, totalPages) {
				if i == 0 {
					<span class="page-ellipsis">...</span>
				} else if i == page {
					<span class="page-btn active" aria-current="page">{ fmt.Sprint(i) }</span>
				} else {
					<a
						class="page-btn"
						href={ templ.SafeURL(fmt.Sprintf("%s?page=%d", baseURL, i)) }
						hx-get={ fmt.Sprintf("%s?page=%d", baseURL, i) }
						hx-target="#message-list"
						hx-push-url="true"
						aria-label={ fmt.Sprintf("Page %d", i) }
					>
						{ fmt.Sprint(i) }
					</a>
				}
			}
			if page < totalPages {
				<a
					class="page-btn"
					href={ templ.SafeURL(fmt.Sprintf("%s?page=%d", baseURL, page+1)) }
					hx-get={ fmt.Sprintf("%s?page=%d", baseURL, page+1) }
					hx-target="#message-list"
					hx-push-url="true"
					aria-label={ t(ctx, "common.nextPage") }
				>
					{ t(ctx, "common.next") }
				</a>
			}
		</nav>
	}
}

templ FlashMessage(msg, level string) {
	<div class={ "flash", "flash-" + level } role="alert" aria-live="assertive">
		{ msg }
	</div>
}

templ ContextMenu() {
	<div
		x-data="contextMenu"
		x-bind:hidden="!visible"
		x-on:click.away="close()"
		x-on:keydown.escape.window="close()"
		x-on:keydown="onKeydown($event)"
		x-on:ctx-menu.window="openAt($event.detail.x, $event.detail.y, $event.detail.uid, $event.detail.mailbox)"
		class="context-menu"
		role="menu"
		x-cloak=""
	>
		<a x-on:click="action('open')" role="menuitem">{ t(ctx, "mail.open") }</a>
		<a x-on:click="action('reply')" role="menuitem">{ t(ctx, "mail.reply") }</a>
		<a x-on:click="action('reply-all')" role="menuitem">{ t(ctx, "mail.replyAll") }</a>
		<a x-on:click="action('forward')" role="menuitem">{ t(ctx, "mail.forward") }</a>
		<hr/>
		<a x-on:click="action('mark-read')" role="menuitem">{ t(ctx, "mail.markRead") }</a>
		<a x-on:click="action('mark-unread')" role="menuitem">{ t(ctx, "mail.markUnread") }</a>
		<a x-on:click="action('flag')" role="menuitem">{ t(ctx, "mail.flag") }</a>
		<a x-on:click="action('unflag')" role="menuitem">{ t(ctx, "mail.unflag") }</a>
		<hr/>
		<div class="ctx-tag-submenu" x-data="{ tagOpen: false, tagInput: '' }">
			<a role="menuitem" class="ctx-tag-toggle" x-on:click.stop="tagOpen = !tagOpen">{ t(ctx, "tag.applyMenu") }</a>
			<div x-bind:hidden="!tagOpen" x-cloak="" class="ctx-tag-input-row">
				<input
					type="text"
					x-model="tagInput"
					placeholder={ t(ctx, "tag.namePlaceholder") }
					aria-label={ t(ctx, "tag.namePlaceholder") }
					x-on:keydown.enter.prevent="action('tag-add:' + tagInput); tagInput = ''; tagOpen = false"
					x-on:click.stop=""
				/>
				<button type="button" class="tool-btn" x-on:click.stop="action('tag-add:' + tagInput); tagInput = ''; tagOpen = false" x-bind:disabled="tagInput.trim() === ''">{ t(ctx, "action.add") }</button>
				<button type="button" class="tool-btn" x-on:click.stop="action('tag-remove:' + tagInput); tagInput = ''; tagOpen = false" x-bind:disabled="tagInput.trim() === ''">{ t(ctx, "action.remove") }</button>
			</div>
		</div>
		<hr/>
		<a x-on:click="action('spam')" role="menuitem">{ t(ctx, "mail.markAsSpam") }</a>
		<a x-on:click="action('not-spam')" role="menuitem">{ t(ctx, "mail.notSpam") }</a>
		<hr/>
		<a x-on:click="action('delete')" class="danger" role="menuitem">{ t(ctx, "mail.delete") }</a>
	</div>
}

templ EmptyState(title, subtitle string) {
	<div class="empty-state">
		<div class="empty-icon">&#9993;</div>
		<h3 class="empty-title">{ title }</h3>
		<p class="empty-text">{ subtitle }</p>
	</div>
}
