package templates

templ SecuritySettings(totpEnabled bool, email string, flash string) {
	@LayoutWithContent("Security", email) {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="nav-list">
					<li><a href="/mail/INBOX" hx-get="/mail/INBOX" hx-target="#main-content" hx-push-url="true">{ t(ctx, "nav.backToMail") }</a></li>
					<li><a href="/settings/rules" hx-get="/settings/rules" hx-target="#main-content" hx-push-url="true">{ t(ctx, "settings.filterRules") }</a></li>
					<li><a href="/settings" hx-get="/settings" hx-target="#main-content" hx-push-url="true">{ t(ctx, "nav.settings") }</a></li>
					<li><a href="/settings/security" class="active">{ t(ctx, "settings.security") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container">
					if require2FAFromCtx(ctx) {
						@FlashMessage(t(ctx, "security.require2FABanner"), "warning")
					} else if flash != "" {
						@FlashMessage(flash, "success")
					}
					<h2 class="settings-section-title" style="font-size:1.2rem; margin-bottom:20px">{ t(ctx, "settings.security") }</h2>
					<div class="settings-card" style="margin-bottom:24px">
						<div style="padding:20px">
							<h3 class="settings-section-title">{ t(ctx, "settings.changePassword") }</h3>
							<form method="post" action="/settings/security/password">
								<div class="form-group" style="margin-bottom:12px">
									<label class="form-label" for="current_password">{ t(ctx, "settings.currentPassword") }</label>
									<input type="password" name="current_password" id="current_password" class="form-input" required/>
								</div>
								<div class="form-group" style="margin-bottom:12px">
									<label class="form-label" for="new_password">{ t(ctx, "settings.newPassword") }</label>
									<input type="password" name="new_password" id="new_password" class="form-input" required minlength="8"/>
									<small style="color:var(--text-muted); font-size:0.78rem">{ t(ctx, "security.minPassword") }</small>
								</div>
								<div class="form-group" style="margin-bottom:16px">
									<label class="form-label" for="confirm_password">{ t(ctx, "settings.confirmPassword") }</label>
									<input type="password" name="confirm_password" id="confirm_password" class="form-input" required minlength="8"/>
								</div>
								<button type="submit" class="btn-primary">{ t(ctx, "settings.changePassword") }</button>
							</form>
						</div>
					</div>
					<div class="settings-card">
						<div style="padding:20px">
							<h3 class="settings-section-title">{ t(ctx, "settings.twoFactorAuth") }</h3>
							if totpEnabled {
								<div class="tfa-status">
									<div class="tfa-status-text">
										<div style="margin-bottom:8px">
											<span class="badge badge-active">{ t(ctx, "common.active") }</span>
										</div>
										<p>{ t(ctx, "security.twoFactorEnabled") }</p>
									</div>
								</div>
								<details>
									<summary>{ t(ctx, "security.disableTwoFactor") }</summary>
									<form method="post" action="/settings/security/totp/disable" style="margin-top:1rem">
										<div class="form-group" style="margin-bottom:12px">
											<label class="form-label" for="disable_password">{ t(ctx, "security.enterPasswordToDisable") }</label>
											<input type="password" name="password" id="disable_password" class="form-input" required/>
										</div>
										<button type="submit" class="btn-secondary">{ t(ctx, "security.disableTwoFactor") }</button>
									</form>
								</details>
							} else {
								<div class="tfa-status">
									<div class="tfa-status-text">
										<div style="margin-bottom:8px">
											<span class="badge badge-disabled">{ t(ctx, "common.inactive") }</span>
										</div>
										<p>{ t(ctx, "security.twoFactorDescription") }</p>
									</div>
								</div>
								<form method="post" action="/settings/security/totp/setup">
									<button type="submit" class="btn-primary">{ t(ctx, "security.setupTwoFactor") }</button>
								</form>
							}
						</div>
					</div>
				</div>
			</div>
		</main>
	}
}

templ TOTPSetup(qrCodeBase64, manualKey, errMsg string) {
	@LayoutWithContent("Setup 2FA", "") {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="nav-list">
					<li><a href="/settings/security">{ t(ctx, "nav.security") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container">
					if errMsg != "" {
						@FlashMessage(errMsg, "error")
					}
					<h2 class="settings-section-title" style="font-size:1.2rem;margin-bottom:20px">{ t(ctx, "security.setupTwoFactor") }</h2>
					<div class="settings-card">
						<div style="padding:20px">
							<p>{ t(ctx, "security.scanQrCode") }</p>
							<div style="text-align:center;margin:2rem 0">
								<img src={ "data:image/png;base64," + qrCodeBase64 } alt="TOTP QR Code" width="200" height="200"/>
							</div>
							<p style="text-align:center;margin-top:12px;color:var(--text-muted)">{ t(ctx, "security.manualKeyPrompt") }</p>
							<div class="manual-key" id="totp-key">
								<span>{ manualKey }</span>
								<button type="button" class="btn-copy" onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent.trim())" title={ t(ctx, "common.copy") } aria-label={ t(ctx, "common.copy") }>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
								</button>
							</div>
							<form method="post" action="/settings/security/totp/confirm" style="margin-top:2rem;max-width:320px;margin-left:auto;margin-right:auto">
								<div class="form-group" style="margin-bottom:16px">
									<label class="form-label" for="code">{ t(ctx, "security.verificationCode") }</label>
									<input type="text" name="code" id="code" class="form-input" placeholder="Enter 6-digit code" required autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" aria-label="TOTP verification code" style="font-size:18px;letter-spacing:4px;text-align:center;font-weight:600"/>
								</div>
								<div style="display:flex;gap:0.75rem;align-items:center">
									<button type="submit" class="btn-primary">{ t(ctx, "auth.verifyAndEnable") }</button>
									<a href="/settings/security">{ t(ctx, "common.cancel") }</a>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</main>
	}
}

templ TOTPRecoveryCodes(codes []string) {
	@LayoutWithContent("Recovery Codes", "") {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="nav-list">
					<li><a href="/settings/security">{ t(ctx, "nav.security") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<h2>{ t(ctx, "security.recoveryCodes") }</h2>
			<div class="flash flash-warning" style="margin-bottom:1.5rem">
				<div class="flash-icon">&#9888;</div>
				<div class="flash-content">
					<strong>{ t(ctx, "security.saveCodesWarning") }</strong> { t(ctx, "security.saveCodesDescription") }
				</div>
			</div>
			<fieldset>
				<legend>{ t(ctx, "security.recoveryCodes") }</legend>
				<p class="description">{ t(ctx, "security.saveCodesDescription") }</p>
				<div class="recovery-codes">
					for _, code := range codes {
						<div class="recovery-code">{ code }</div>
					}
				</div>
				<a href="/settings/security" class="btn-primary" style="display:inline-block;text-align:center;text-decoration:none">{ t(ctx, "security.savedCodes") }</a>
			</fieldset>
		</main>
	}
}
