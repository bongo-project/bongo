package templates

templ SecuritySettings(totpEnabled bool, email string, flash string) {
	@LayoutWithContent("Security", email) {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="mailbox-list">
					<li><a href="/mail/INBOX" hx-get="/mail/INBOX" hx-target="#main-content" hx-push-url="true">{ t(ctx, "nav.backToMail") }</a></li>
					<li><a href="/settings/rules" hx-get="/settings/rules" hx-target="#main-content" hx-push-url="true">{ t(ctx, "settings.filterRules") }</a></li>
					<li><a href="/settings" hx-get="/settings" hx-target="#main-content" hx-push-url="true">{ t(ctx, "nav.settings") }</a></li>
					<li><a href="/settings/security" class="active">{ t(ctx, "settings.security") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="main-content" id="main-content">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<h2>{ t(ctx, "settings.security") }</h2>
			<fieldset>
				<legend>{ t(ctx, "settings.changePassword") }</legend>
				<form method="post" action="/settings/security/password">
					<label for="current_password">{ t(ctx, "settings.currentPassword") }</label>
					<input type="password" name="current_password" id="current_password" required/>
					<label for="new_password">{ t(ctx, "settings.newPassword") }</label>
					<input type="password" name="new_password" id="new_password" required minlength="8"/>
					<small>{ t(ctx, "security.minPassword") }</small>
					<label for="confirm_password">{ t(ctx, "settings.confirmPassword") }</label>
					<input type="password" name="confirm_password" id="confirm_password" required minlength="8"/>
					<div>
						<button type="submit">{ t(ctx, "settings.changePassword") }</button>
					</div>
				</form>
			</fieldset>
			<fieldset>
				<legend>{ t(ctx, "settings.twoFactorAuth") }</legend>
				if totpEnabled {
					<p>
						<strong>{ t(ctx, "security.status") }</strong>
						<span class="badge badge-active">{ t(ctx, "common.enabled") }</span>
					</p>
					<p>{ t(ctx, "security.twoFactorEnabled") }</p>
					<details>
						<summary>{ t(ctx, "security.disableTwoFactor") }</summary>
						<form method="post" action="/settings/security/totp/disable" style="margin-top:1rem">
							<label for="disable_password">{ t(ctx, "security.enterPasswordToDisable") }</label>
							<input type="password" name="password" id="disable_password" required/>
							<button type="submit" class="secondary">{ t(ctx, "security.disableTwoFactor") }</button>
						</form>
					</details>
				} else {
					<p>
						<strong>{ t(ctx, "security.status") }</strong>
						<span class="badge badge-disabled">{ t(ctx, "common.disabled") }</span>
					</p>
					<p>{ t(ctx, "security.twoFactorDescription") }</p>
					<form method="post" action="/settings/security/totp/setup">
						<button type="submit">{ t(ctx, "security.setupTwoFactor") }</button>
					</form>
				}
			</fieldset>
		</main>
	}
}

templ TOTPSetup(qrCodeBase64, manualKey, errMsg string) {
	@LayoutWithContent("Setup 2FA", "") {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="mailbox-list">
					<li><a href="/settings/security">{ t(ctx, "nav.security") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="main-content" id="main-content">
			if errMsg != "" {
				@FlashMessage(errMsg, "error")
			}
			<h2>{ t(ctx, "security.setupTwoFactor") }</h2>
			<p>{ t(ctx, "security.scanQrCode") }</p>
			<div style="text-align:center;margin:2rem 0">
				<img src={ "data:image/png;base64," + qrCodeBase64 } alt="TOTP QR Code" width="200" height="200"/>
			</div>
			<p>{ t(ctx, "security.manualKeyPrompt") }</p>
			<pre style="user-select:all;font-size:1rem;padding:1rem;background:var(--pico-muted-border-color);border-radius:4px;text-align:center;letter-spacing:0.1em">{ manualKey }</pre>
			<form method="post" action="/settings/security/totp/confirm" style="margin-top:2rem">
				<label for="code">{ t(ctx, "security.verificationCode") }</label>
				<input type="text" name="code" id="code" placeholder="Enter 6-digit code" required autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" aria-label="TOTP verification code"/>
				<div>
					<button type="submit">{ t(ctx, "auth.verifyAndEnable") }</button>
					<a href="/settings/security" role="button" class="outline secondary">{ t(ctx, "common.cancel") }</a>
				</div>
			</form>
		</main>
	}
}

templ TOTPRecoveryCodes(codes []string) {
	@LayoutWithContent("Recovery Codes", "") {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="mailbox-list">
					<li><a href="/settings/security">{ t(ctx, "nav.security") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="main-content" id="main-content">
			<h2>{ t(ctx, "security.recoveryCodes") }</h2>
			<div class="flash flash-warning" style="margin-bottom:1.5rem">
				<strong>{ t(ctx, "security.saveCodesWarning") }</strong> { t(ctx, "security.saveCodesDescription") }
			</div>
			<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem 2rem;max-width:24rem;margin:1.5rem auto;font-family:monospace;font-size:1.1rem">
				for _, code := range codes {
					<div style="padding:0.4rem 0.8rem;background:var(--pico-muted-border-color);border-radius:4px;text-align:center">{ code }</div>
				}
			</div>
			<div style="text-align:center;margin-top:2rem">
				<a href="/settings/security" role="button">{ t(ctx, "security.savedCodes") }</a>
			</div>
		</main>
	}
}
