package templates

// AppPasswordRow is one credential in the Security page list. Dates are
// formatted by the handler, as dates only; LastUsed is empty for never.
type AppPasswordRow struct {
	ID       string
	Masked   string
	Label    string
	Created  string
	LastUsed string
}

// AppPasswordView is the App passwords card. Plaintext is set only on the
// response to a create, which is the one place it is ever shown.
type AppPasswordView struct {
	// Available is false when the node has no app password service.
	Available  bool
	Rows       []AppPasswordRow
	ListFailed bool
	Plaintext  string
	// Error is a translated failure shown in the card as an error banner.
	Error string
	// FlashLevel is the banner level: "error", "warning" or "success".
	FlashLevel string
	// TotpEnabled asks for a second factor on the create form.
	TotpEnabled bool
	// RequireAppPasswords is true when the account password is refused in
	// mail clients (the switch is on and 2FA is on).
	RequireAppPasswords bool
	// Count is the number of app passwords the user holds.
	Count int
}

// DeviceChoice is one thing the Add a device page can set up.
type DeviceChoice struct {
	Key   string
	Title string
	Help  string
}

// SettingRow is one server setting; Value is what the copy button copies.
type SettingRow struct {
	Label string
	Value string
}

// SettingGroup is a titled set of rows, such as the IMAP settings.
type SettingGroup struct {
	Title string
	Rows  []SettingRow
}

// DeviceView is the Add a device page. Plaintext and Groups are set only on
// the response to a create, which is the one place the password is shown.
type DeviceView struct {
	// Setup is true when the page is the last step of 2FA enrolment.
	Setup       bool
	Choices     []DeviceChoice
	TotpEnabled bool
	Flash       string
	FlashLevel  string
	Error       string
	Plaintext   string
	Groups      []SettingGroup
	// Count is the number of app passwords the user holds, counting a new one.
	Count int
}

templ SecuritySettings(totpEnabled bool, email string, flash string, apps AppPasswordView) {
	@LayoutWithContent(t(ctx, "settings.security"), email) {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="nav-list">
					<li><a href="/mail/INBOX">{ t(ctx, "nav.backToMail") }</a></li>
					<li><a href="/settings/rules">{ t(ctx, "settings.filterRules") }</a></li>
					<li><a href="/settings/vacation">{ t(ctx, "settings.vacation") }</a></li>
					<li><a href="/settings">{ t(ctx, "nav.settings") }</a></li>
					<li><a href="/settings/security" class="active">{ t(ctx, "settings.security") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container">
					if require2FAFromCtx(ctx) {
						@FlashMessage(t(ctx, "security.require2FABanner"), "warning")
					}
					if flash != "" {
						@FlashMessage(flash, flashLevelOr(apps.FlashLevel))
					}
					<h2 class="settings-section-title u-font-12 u-mb-20px">{ t(ctx, "settings.security") }</h2>
					<div class="settings-card u-mb-24px">
						<div class="settings-card-pad">
							<h3 class="settings-section-title">{ t(ctx, "settings.changePassword") }</h3>
							<form method="post" action="/settings/security/password">
								<div class="form-group u-mb-12px">
									<label class="form-label" for="current_password">{ t(ctx, "settings.currentPassword") }</label>
									<input type="password" name="current_password" id="current_password" class="form-input" required/>
								</div>
								<div class="form-group u-mb-12px">
									<label class="form-label" for="new_password">{ t(ctx, "settings.newPassword") }</label>
									<input type="password" name="new_password" id="new_password" class="form-input" required minlength="8"/>
									<small class="u-text-muted u-font-078">{ t(ctx, "security.minPassword") }</small>
								</div>
								<div class="form-group u-mb-16px">
									<label class="form-label" for="confirm_password">{ t(ctx, "settings.confirmPassword") }</label>
									<input type="password" name="confirm_password" id="confirm_password" class="form-input" required minlength="8"/>
								</div>
								if totpEnabled {
									<div class="form-group u-mb-16px">
										<label class="form-label" for="change_totp_code">{ t(ctx, "security.reauthCode") }</label>
										<input type="text" name="totp_code" id="change_totp_code" class="form-input" autocomplete="one-time-code" required/>
									</div>
								}
								if apps.Available {
									<div class="form-group u-mb-16px">
										<label class="form-check">
											<input type="checkbox" name="revoke_app_passwords" value="1" checked/>
											{ t(ctx, "security.revokeAppPasswordsOption") }
										</label>
										<small class="u-text-muted u-font-078">{ t(ctx, "security.revokeAppPasswordsHelp") }</small>
									</div>
								}
								<button type="submit" class="btn-primary">{ t(ctx, "settings.changePassword") }</button>
							</form>
						</div>
					</div>
					if apps.Available {
						if totpEnabled {
							@requireAppPasswordsCard(apps)
						}
						@appPasswordsCard(apps)
					}
					<div class="settings-card">
						<div class="settings-card-pad">
							<h3 class="settings-section-title">{ t(ctx, "settings.twoFactorAuth") }</h3>
							if totpEnabled {
								<div class="tfa-status">
									<div class="tfa-status-text">
										<div class="u-mb-12px">
											<span class="badge badge-active">{ t(ctx, "common.active") }</span>
										</div>
										<p>{ t(ctx, "security.twoFactorEnabled") }</p>
									</div>
								</div>
								<details>
									<summary>{ t(ctx, "security.disableTwoFactor") }</summary>
									if apps.RequireAppPasswords {
										<p class="u-text-muted u-mt-1">{ t(ctx, "security.disableTwoFactorMailWarning") }</p>
									}
									<form method="post" action="/settings/security/totp/disable" class="u-mt-1">
										<div class="form-group u-mb-12px">
											<label class="form-label" for="disable_password">{ t(ctx, "security.enterPasswordToDisable") }</label>
											<input type="password" name="password" id="disable_password" class="form-input" required/>
										</div>
										<div class="form-group u-mb-12px">
											<label class="form-label" for="disable_totp_code">{ t(ctx, "security.reauthCode") }</label>
											<input type="text" name="totp_code" id="disable_totp_code" class="form-input" autocomplete="one-time-code" required/>
										</div>
										<button type="submit" class="btn-secondary">{ t(ctx, "security.disableTwoFactor") }</button>
									</form>
								</details>
							} else {
								<div class="tfa-status">
									<div class="tfa-status-text">
										<div class="u-mb-12px">
											<span class="badge badge-disabled">{ t(ctx, "common.inactive") }</span>
										</div>
										<p>{ t(ctx, "security.twoFactorDescription") }</p>
									</div>
								</div>
								<form method="post" action="/settings/security/totp/setup">
									<button type="submit" class="btn-primary">{ t(ctx, "security.setupTwoFactor") }</button>
								</form>
							}
						</div>
					</div>
				</div>
			</div>
		</main>
	}
}

templ appPasswordsCard(apps AppPasswordView) {
	<div class="settings-card u-mb-24px">
		<div class="settings-card-pad">
			<h3 class="settings-section-title">{ t(ctx, "security.appPasswords") }</h3>
			<p class="u-text-muted">{ t(ctx, "security.appPasswordsHelp") }</p>
			if apps.Error != "" {
				@FlashMessage(apps.Error, "error")
			}
			if apps.Plaintext != "" {
				<div class="flash flash-warning u-mb-15" hx-history="false">
					<div class="flash-icon" aria-hidden="true">@Icon("alert", "")</div>
					<div class="flash-content">
						<strong>{ t(ctx, "security.appPasswordShownOnce") }</strong> { t(ctx, "security.appPasswordShownOnceHelp") }
					</div>
				</div>
				<div class="manual-key" id="app-password-new">
					<span>{ apps.Plaintext }</span>
					<button type="button" class="btn-copy" data-copy-previous="true" title={ t(ctx, "common.copy") } aria-label={ t(ctx, "common.copy") }>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
					</button>
				</div>
			}
			if apps.ListFailed {
				@FlashMessage(t(ctx, "security.appPasswordsListFailed"), "error")
			} else if len(apps.Rows) == 0 {
				<p class="u-text-muted">{ t(ctx, "security.appPasswordsNone") }</p>
			} else {
				<div class="table-scroll u-mb-1">
					<table class="admin-table data-table" aria-label={ t(ctx, "security.appPasswords") }>
						<thead>
							<tr>
								<th>{ t(ctx, "security.appPasswordLabel") }</th>
								<th>{ t(ctx, "security.appPasswordCredential") }</th>
								<th>{ t(ctx, "security.appPasswordCreated") }</th>
								<th>{ t(ctx, "security.appPasswordLastUsed") }</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, row := range apps.Rows {
								<tr>
									<td class="app-password-label">{ row.Label }</td>
									<td><code>{ row.Masked }</code></td>
									<td>{ row.Created }</td>
									<td>
										if row.LastUsed == "" {
											{ t(ctx, "security.appPasswordNever") }
										} else {
											{ row.LastUsed }
										}
									</td>
									<td>
										<form hx-post="/settings/security/app-passwords/revoke" hx-confirm={ t(ctx, "security.appPasswordRevokeConfirm") } hx-target="next .app-password-status" hx-swap="innerHTML">
											<input type="hidden" name="id" value={ row.ID }/>
											<button type="submit" class="btn-danger">{ t(ctx, "security.appPasswordRevoke") }</button>
										</form>
										<div class="app-password-status" data-form-status aria-live="polite"></div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			if !require2FAFromCtx(ctx) {
				<form method="post" action="/settings/security/app-passwords">
					<div class="form-group u-mb-12px">
						<label class="form-label" for="app_password_label">{ t(ctx, "security.appPasswordLabelPrompt") }</label>
						<input type="text" name="label" id="app_password_label" class="form-input" required maxlength="64" autocomplete="off"/>
					</div>
					@reauthFields("app_password", apps.TotpEnabled)
					<div class="u-flex u-gap-075 u-items-center">
						<button type="submit" class="btn-primary">{ t(ctx, "security.appPasswordCreate") }</button>
						<a href="/settings/security/devices">{ t(ctx, "security.appPasswordAddDevice") }</a>
					</div>
				</form>
			}
		</div>
	</div>
}

// reauthFields asks for the account password and, with 2FA, a code. prefix
// keeps the element ids unique when a page holds several such forms.
templ reauthFields(prefix string, totp bool) {
	<div class="form-group u-mb-12px">
		<label class="form-label" for={ prefix + "_password" }>{ t(ctx, "security.appPasswordAccountPassword") }</label>
		<input type="password" name="password" id={ prefix + "_password" } class="form-input" required autocomplete="current-password"/>
	</div>
	if totp {
		<div class="form-group u-mb-12px">
			<label class="form-label" for={ prefix + "_totp_code" }>{ t(ctx, "security.reauthCode") }</label>
			<input type="text" name="totp_code" id={ prefix + "_totp_code" } class="form-input" autocomplete="one-time-code" required/>
		</div>
	}
}

// requireAppPasswordsCard is the per-account switch: a notice offering to turn
// it on, or the state with a way to turn it off. It is shown only with 2FA.
templ requireAppPasswordsCard(apps AppPasswordView) {
	<div class="settings-card u-mb-24px">
		<div class="settings-card-pad">
			<h3 class="settings-section-title">{ t(ctx, "security.requireTitle") }</h3>
			if apps.RequireAppPasswords {
				<div class="u-mb-12px">
					<span class="badge badge-active">{ t(ctx, "common.active") }</span>
				</div>
				<p>{ t(ctx, "security.requireOn") }</p>
				<details>
					<summary>{ t(ctx, "security.requireTurnOff") }</summary>
					<form method="post" action="/settings/security/require-app-passwords/off" class="u-mt-1">
						<p class="u-text-muted">{ t(ctx, "security.requireTurnOffHelp") }</p>
						@reauthFields("require_off", true)
						<button type="submit" class="btn-secondary">{ t(ctx, "security.requireTurnOff") }</button>
					</form>
				</details>
			} else {
				<p>{ t(ctx, "security.requireOffNotice") }</p>
				if !require2FAFromCtx(ctx) {
					if apps.Count > 0 {
						<form method="post" action="/settings/security/require-app-passwords/on">
							<button type="submit" class="btn-primary">{ t(ctx, "security.requireTurnOn") }</button>
						</form>
					} else {
						<p class="u-text-muted">{ t(ctx, "security.requireNeedDevice") }</p>
						<a href="/settings/security/devices">{ t(ctx, "security.appPasswordAddDevice") }</a>
					}
				}
			}
		</div>
	</div>
}

templ TOTPSetup(qrCodeBase64, manualKey, errMsg string) {
	@LayoutWithContent(t(ctx, "security.setupTwoFactor"), "") {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="nav-list">
					<li><a href="/settings/security">{ t(ctx, "nav.security") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container">
					if errMsg != "" {
						@FlashMessage(errMsg, "error")
					}
					<h2 class="settings-section-title u-font-12 u-mb-20px">{ t(ctx, "security.setupTwoFactor") }</h2>
					<div class="settings-card">
						<div class="settings-card-pad">
							<p>{ t(ctx, "security.scanQrCode") }</p>
							<div class="u-text-center u-mt-2 u-mb-2">
								<img src={ "data:image/png;base64," + qrCodeBase64 } alt={ t(ctx, "security.qrCodeAlt") } width="200" height="200"/>
							</div>
							<p class="u-text-center u-mb-12px u-text-muted">{ t(ctx, "security.manualKeyPrompt") }</p>
							<div class="manual-key" id="totp-key">
								<span>{ manualKey }</span>
								<button type="button" class="btn-copy" data-copy-previous="true" title={ t(ctx, "common.copy") } aria-label={ t(ctx, "common.copy") }>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
								</button>
							</div>
							<form method="post" action="/settings/security/totp/confirm" class="u-mt-2 u-max-w-320 u-mx-auto">
								<div class="form-group u-mb-16px">
									<label class="form-label" for="code">{ t(ctx, "security.verificationCode") }</label>
									<input type="text" name="code" id="code" class="form-input manual-code-input" placeholder={ t(ctx, "security.enterCode") } required autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" aria-label={ t(ctx, "security.verificationCode") }/>
								</div>
								<div class="u-flex u-gap-075 u-items-center">
									<button type="submit" class="btn-primary">{ t(ctx, "auth.verifyAndEnable") }</button>
									<a href="/settings/security">{ t(ctx, "common.cancel") }</a>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</main>
	}
}

templ TOTPRecoveryCodes(codes []string, continueHref string) {
	@LayoutWithContent(t(ctx, "security.recoveryCodes"), "") {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="nav-list">
					<li><a href="/settings/security">{ t(ctx, "nav.security") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container">
					<h2 class="settings-section-title u-font-12 u-mb-20px">{ t(ctx, "security.recoveryCodes") }</h2>
					<div class="flash flash-warning u-mb-15">
						<div class="flash-icon" aria-hidden="true">@Icon("alert", "")</div>
						<div class="flash-content">
							<strong>{ t(ctx, "security.saveCodesWarning") }</strong> { t(ctx, "security.saveCodesDescription") }
						</div>
					</div>
					<div class="settings-card">
						<div class="settings-card-pad">
							<fieldset>
								<legend>{ t(ctx, "security.recoveryCodes") }</legend>
								<p class="description">{ t(ctx, "security.saveCodesDescription") }</p>
								<div class="recovery-codes">
									for _, code := range codes {
										<div class="recovery-code">{ code }</div>
									}
								</div>
								<a href={ templ.SafeURL(continueHref) } class="btn-primary u-inline-block u-text-center u-text-decoration-none">{ t(ctx, "security.savedCodes") }</a>
							</fieldset>
						</div>
					</div>
				</div>
			</div>
		</main>
	}
}

// AddDevice is the Add a device page: a list of things to set up, and for a
// create the password shown once beside the server settings.
templ AddDevice(email string, v DeviceView) {
	@LayoutWithContent(t(ctx, "security.appPasswordAddDevice"), email) {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="nav-list">
					<li><a href="/settings/security">{ t(ctx, "nav.security") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container">
					if v.Flash != "" {
						@FlashMessage(v.Flash, flashLevelOr(v.FlashLevel))
					}
					if v.Error != "" {
						@FlashMessage(v.Error, "error")
					}
					<h2 class="settings-section-title u-font-12 u-mb-20px">{ t(ctx, "security.appPasswordAddDevice") }</h2>
					if v.Setup {
						<p>{ t(ctx, "security.setupIntro") }</p>
					}
					if v.Plaintext != "" {
						@deviceReveal(v)
					} else {
						<p class="u-text-muted">{ t(ctx, "security.addDeviceIntro") }</p>
						for _, choice := range v.Choices {
							<div class="settings-card u-mb-24px">
								<div class="settings-card-pad">
									<h3 class="settings-section-title">{ choice.Title }</h3>
									<p class="u-text-muted">{ choice.Help }</p>
									if choice.Key == "apple" {
										@appleDeviceCard(choice, v)
									} else {
										@deviceForm(choice, v)
									}
								</div>
							</div>
						}
					}
					if v.Setup {
						<div class="settings-card">
							<div class="settings-card-pad">
								if v.Count > 0 {
									<form method="post" action="/settings/security/require-app-passwords/on" class="u-mb-12px">
										<input type="hidden" name="setup" value="1"/>
										<button type="submit" class="btn-primary">{ t(ctx, "security.setupFinish") }</button>
									</form>
								} else {
									<p class="u-text-muted" data-apple-stale>{ t(ctx, "security.setupNeedOne") }</p>
								}
								<a href="/settings/security">{ t(ctx, "security.setupSkip") }</a>
							</div>
						</div>
					}
				</div>
			</div>
		</main>
	}
}

// deviceForm is the create form for one choice.
templ deviceForm(choice DeviceChoice, v DeviceView) {
	<form method="post" action="/settings/security/devices">
		<input type="hidden" name="kind" value={ choice.Key }/>
		if v.Setup {
			<input type="hidden" name="setup" value="1"/>
		}
		<div class="form-group u-mb-12px">
			<label class="form-label" for={ "device_label_" + choice.Key }>{ t(ctx, "security.appPasswordLabelPrompt") }</label>
			<input type="text" name="label" id={ "device_label_" + choice.Key } class="form-input" required maxlength="64" autocomplete="off"/>
		</div>
		@reauthFields("device_"+choice.Key, v.TotpEnabled)
		if v.TotpEnabled {
			<p class="u-text-muted u-font-078">{ t(ctx, "security.deviceCodeWait") }</p>
		}
		<button type="submit" class="btn-primary">{ t(ctx, "security.appPasswordCreate") }</button>
	</form>
}

// appleDeviceCard is the Apple choice. The install guidance is static so it
// does not depend on JavaScript. The appleDevice component (bongo.js) swaps
// the form for a panel when the form is submitted: the response is a file
// download, which leaves this page as it was, so the panel says what to do
// next and links to the page that shows the new device. A refusal navigates
// away and a success does not, so the panel is worded for "if the download
// started".
templ appleDeviceCard(choice DeviceChoice, v DeviceView) {
	<ul class="u-text-muted u-font-078 u-mb-12px">
		<li>{ t(ctx, "security.appleStepSafari") }</li>
		<li>{ t(ctx, "security.appleStepInstall") }</li>
		<li>{ t(ctx, "security.appleStepNotVerified") }</li>
		<li>{ t(ctx, "security.appleStepMac") }</li>
		<li>{ t(ctx, "security.appleStepIgnore") }</li>
		<li>{ t(ctx, "security.appleStepReinstall") }</li>
	</ul>
	<div x-data="appleDevice">
		<div x-show="idle" @submit="submit">
			@deviceForm(choice, v)
		</div>
		<div x-show="done" x-cloak role="status">
			<p><strong>{ t(ctx, "security.appleDoneTitle") }</strong></p>
			if v.Setup {
				<p class="u-text-muted">{ t(ctx, "security.appleDoneSetup") }</p>
				<a href="/settings/security/devices?setup=1" class="btn-primary u-text-decoration-none">{ t(ctx, "security.appleContinue") }</a>
			} else {
				<p class="u-text-muted">{ t(ctx, "security.appleDoneHelp") }</p>
				<a href="/settings/security" class="btn-primary u-text-decoration-none">{ t(ctx, "security.appleContinue") }</a>
			}
		</div>
	</div>
}

// deviceReveal shows the new password once, then each server setting with its
// own copy button. bongo.js copies the element just before the button, so a
// value must sit directly before its button.
templ deviceReveal(v DeviceView) {
	<div class="flash flash-warning u-mb-15" hx-history="false">
		<div class="flash-icon" aria-hidden="true">@Icon("alert", "")</div>
		<div class="flash-content">
			<strong>{ t(ctx, "security.appPasswordShownOnce") }</strong> { t(ctx, "security.appPasswordShownOnceHelp") }
		</div>
	</div>
	<div class="settings-card u-mb-24px" hx-history="false">
		<div class="settings-card-pad">
			<h3 class="settings-section-title">{ t(ctx, "security.deviceSettings") }</h3>
			<p class="u-mb-12px u-text-muted">{ t(ctx, "security.appPasswordCredential") }</p>
			<div class="manual-key" id="app-password-new">
				<span>{ v.Plaintext }</span>
				@copyButton()
			</div>
			for _, group := range v.Groups {
				<h4 class="u-mt-2 u-mb-12px">{ group.Title }</h4>
				for _, row := range group.Rows {
					<p class="u-mb-12px u-text-muted u-font-078">{ row.Label }</p>
					<div class="manual-key">
						<span>{ row.Value }</span>
						@copyButton()
					</div>
				}
			}
		</div>
	</div>
	if v.Setup {
		<p class="u-mb-12px"><a href="/settings/security/devices?setup=1" class="btn-secondary u-text-decoration-none">{ t(ctx, "security.deviceAnother") }</a></p>
	} else {
		<div class="u-flex u-gap-075 u-items-center">
			<a href="/settings/security/devices" class="btn-secondary u-text-decoration-none">{ t(ctx, "security.deviceAnother") }</a>
			<a href="/settings/security" class="btn-primary u-text-decoration-none">{ t(ctx, "security.deviceDone") }</a>
		</div>
	}
}

templ copyButton() {
	<button type="button" class="btn-copy" data-copy-previous="true" title={ t(ctx, "common.copy") } aria-label={ t(ctx, "common.copy") }>
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
	</button>
}
