package templates

import (
	"context"
	"slices"
	"strconv"
	"strings"

	bongov1 "github.com/bongo-project/bongo/proto/bongo/v1"
)

// PendingShare is one grant of any kind shown on the shares page.
type PendingShare struct {
	Kind         string // calendar, mailbox or addressbook
	Owner        string // user ID, posted back
	OwnerLabel   string // address shown
	Resource     string // calendar guid or mailbox id, posted back
	ResourceName string // calendar or folder name; empty for an address book
	Level        string // calendar and address-book permission
	Rights       string // mailbox rights letters
	// Via names the groups that give a joined share when the user holds no
	// grant of their own. Such a share cannot be left from here, so the row
	// shows the group instead of the Leave button.
	Via string
}

type pendingShareCountKey struct{}

// WithPendingShareCount records how many invitations wait for the viewer.
func WithPendingShareCount(ctx context.Context, n int) context.Context {
	return context.WithValue(ctx, pendingShareCountKey{}, n)
}

func pendingShareCount(ctx context.Context) int {
	n, _ := ctx.Value(pendingShareCountKey{}).(int)
	return n
}

templ SharesPage(rows []PendingShare, joined []PendingShare, calendars []*bongov1.Calendar, email string) {
	@LayoutWithContent(t(ctx, "share.title"), email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@CalendarSidebar(calendars)
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container">
					<div class="page-head">
						<h1>{ t(ctx, "share.title") }</h1>
						<span class="spacer"></span>
						<a href="/calendar" class="btn-secondary">&larr; { t(ctx, "calendar.backToCalendar") }</a>
					</div>
					<section class="card">
						<div class="settings-card-pad">
							if len(rows) == 0 {
								<p class="meta">{ t(ctx, "share.none") }</p>
							}
							<ul class="share-list">
								for _, row := range rows {
									<li class="share-item">
										<span class="share-target">{ row.OwnerLabel } &middot; { shareKindLabel(ctx, row.Kind) } { shareResourceLabel(row) } &middot; { sharePermissionLabel(ctx, row) }</span>
										<form hx-post="/shares/accept" hx-swap="none" class="share-accept-form">
											<input type="hidden" name="_csrf" value={ csrfToken(ctx) }/>
											<input type="hidden" name="kind" value={ row.Kind }/>
											<input type="hidden" name="owner" value={ row.Owner }/>
											<input type="hidden" name="resource" value={ row.Resource }/>
											<button type="submit" class="btn-primary">{ t(ctx, "calendar.shareAccept") }</button>
										</form>
										<form hx-post="/shares/decline" hx-swap="none" class="share-decline-form">
											<input type="hidden" name="_csrf" value={ csrfToken(ctx) }/>
											<input type="hidden" name="kind" value={ row.Kind }/>
											<input type="hidden" name="owner" value={ row.Owner }/>
											<input type="hidden" name="resource" value={ row.Resource }/>
											<button type="submit" class="tool-btn">{ t(ctx, "calendar.shareDecline") }</button>
										</form>
									</li>
								}
							</ul>
						</div>
					</section>
					if len(joined) > 0 {
						<section class="card">
							<div class="settings-card-pad">
								<h3>{ t(ctx, "share.joined") }</h3>
								<ul class="share-list">
									for _, row := range joined {
										<li class="share-item">
											<span class="share-target">{ row.OwnerLabel } &middot; { shareKindLabel(ctx, row.Kind) } { shareResourceLabel(row) } &middot; { sharePermissionLabel(ctx, row) }</span>
											if row.Via != "" {
												<span class="share-state meta">{ shareViaLabel(ctx, row) }</span>
											} else {
												<form hx-post="/shares/leave" hx-swap="none" class="share-decline-form">
													<input type="hidden" name="_csrf" value={ csrfToken(ctx) }/>
													<input type="hidden" name="kind" value={ row.Kind }/>
													<input type="hidden" name="owner" value={ row.Owner }/>
													<input type="hidden" name="resource" value={ row.Resource }/>
													<button type="submit" class="tool-btn">{ t(ctx, "calendar.shareLeave") }</button>
												</form>
											}
										</li>
									}
								</ul>
							</div>
						</section>
					}
				</div>
			</div>
		</main>
	}
}

// SharesLink is the sidebar entry for the invitations page, with the number of
// pending invitations when there are any.
templ SharesLink() {
	<a href="/shares" class="tool-btn calendar-sidebar-btn">
		{ t(ctx, "share.sidebarLabel") }
		if n := pendingShareCount(ctx); n > 0 {
			<span class="badge" aria-label={ t(ctx, "share.pendingCount") + " " + strconv.Itoa(n) }>{ strconv.Itoa(n) }</span>
		}
	</a>
}

// shareKindLabel names the kind of thing shared.
func shareKindLabel(ctx context.Context, kind string) string {
	switch kind {
	case "mailbox":
		return t(ctx, "share.kindMailbox")
	case "addressbook":
		return t(ctx, "share.kindAddressBook")
	default:
		return t(ctx, "share.kindCalendar")
	}
}

// shareResourceLabel is the name of what is shared. Address books do not exist
// yet, so one shows its id; the kind label in front already says what it is.
func shareResourceLabel(row PendingShare) string {
	if row.Kind == "addressbook" {
		return row.Resource
	}
	return row.ResourceName
}

// sharePermissionLabel says in plain words what the grant allows.
func sharePermissionLabel(ctx context.Context, row PendingShare) string {
	switch row.Kind {
	case "mailbox":
		return mailboxRightsLabel(ctx, row.Rights)
	case "addressbook":
		if row.Level == "write" {
			return t(ctx, "calendar.levelWrite")
		}
		return t(ctx, "calendar.levelRead")
	default:
		return shareLevelLabel(ctx, row.Level)
	}
}

// mailboxRightsLabel maps the rights of the usual presets to a word and anything
// else to the letters. The letter "a" adds the right to share.
func mailboxRightsLabel(ctx context.Context, rights string) string {
	base := strings.Replace(rights, "a", "", 1)
	share := base != rights
	letters := []rune(base)
	slices.Sort(letters)
	var label string
	switch string(letters) {
	case "lrs":
		label = t(ctx, "share.rightsRead")
	case "eilrstw":
		label = t(ctx, "share.rightsWrite")
	case "eiklprstwx":
		label = t(ctx, "share.rightsFull")
	default:
		return t(ctx, "share.rightsCustom") + " (" + rights + ")"
	}
	if share {
		label += ", " + t(ctx, "share.rightsCanShare")
	}
	return label
}

// shareLevelLabel translates a grant level.
func shareLevelLabel(ctx context.Context, level string) string {
	switch level {
	case "read":
		return t(ctx, "calendar.levelRead")
	case "write":
		return t(ctx, "calendar.levelWrite")
	default:
		return t(ctx, "calendar.levelFreebusy")
	}
}

// shareStateLabel translates a grant state.
func shareStateLabel(ctx context.Context, state string) string {
	if state == "pending" {
		return t(ctx, "calendar.shareStatePending")
	}
	return t(ctx, "calendar.shareStateAccepted")
}
