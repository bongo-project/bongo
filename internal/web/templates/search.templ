package templates

import "fmt"

// SearchResult holds data for a single search hit.
type SearchResult struct {
	UID     uint32
	Mailbox string
	From    string
	Subject string
	Date    string
	Snippet string
}

templ SearchPageFull(query string, results []SearchResult, page, totalPages int, mailboxes []MailboxInfo, tags []SidebarTagInfo, email string) {
	@LayoutWithContent(t(ctx, "common.search"), email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@Sidebar(mailboxes, tags, "")
		</aside>
		<main class="content" id="main-content">
			@SearchPage(query, results, page, totalPages)
		</main>
	}
}

templ SearchPage(query string, results []SearchResult, page, totalPages int) {
	<div class="page-head search-head">
		<h1>{ t(ctx, "search.results") }</h1>
		if query != "" {
			<span class="meta">
				{ fmt.Sprintf("%d", len(results)) } { t(ctx, "search.resultsForCount") } <span class="results-query">"{ query }"</span>
			</span>
		}
	</div>
	if query != "" && len(results) == 0 {
		@EmptyState(t(ctx, "search.noResults"), t(ctx, "search.noMatches"))
	}
	if len(results) > 0 {
		<div class="results-list" id="search-results">
			for _, r := range results {
				<a
					class="search-result msg-row msg-row-grid no-select"
					href={ templ.SafeURL(fmt.Sprintf("/mail/%s/%d", encMailbox(r.Mailbox), r.UID)) }
					hx-get={ fmt.Sprintf("/mail/%s/%d", encMailbox(r.Mailbox), r.UID) }
					hx-target="#main-content"
					hx-push-url="true"
					tabindex="0"
				>
					<div class="msg-main">
						<div class="msg-line">
							<span class="msg-from result-from">{ r.From }</span>
							<span class="result-mailbox">{ r.Mailbox }</span>
							<span class="msg-date">{ r.Date }</span>
						</div>
						<div class="msg-line">
							<span class="msg-subject result-subject">{ r.Subject }</span>
						</div>
						if r.Snippet != "" {
							<div class="msg-preview result-snippet">{ r.Snippet }</div>
						}
					</div>
				</a>
			}
		</div>
		@Pagination(page, totalPages, "/search?q="+query)
	}
}
