package templates

import "fmt"

// SearchResult holds data for a single search hit.
type SearchResult struct {
	UID     uint32
	Mailbox string
	From    string
	Subject string
	Date    string
	Snippet string
}

templ SearchPage(query string, results []SearchResult, page, totalPages int) {
	<div class="results-header">
		<div class="results-title">{ t(ctx, "search.results") }</div>
		if query != "" {
			<div class="results-count">
				{ fmt.Sprintf("%d", len(results)) } results for <span class="results-query">"{ query }"</span>
			</div>
		}
	</div>
	if query != "" && len(results) == 0 {
		@EmptyState(t(ctx, "search.noResults"), t(ctx, "search.noMatches"))
	}
	if len(results) > 0 {
		<div class="results-list" id="search-results">
			for _, r := range results {
				<a
					class="search-result"
					href={ templ.SafeURL(fmt.Sprintf("/mail/%s/%d", r.Mailbox, r.UID)) }
					hx-get={ fmt.Sprintf("/mail/%s/%d", r.Mailbox, r.UID) }
					hx-target="#main-content"
					hx-push-url="true"
					tabindex="0"
				>
					<div class="result-subject">{ r.Subject }</div>
					<div class="result-meta">
						<span class="result-from">{ r.From }</span>
						<span>&middot;</span>
						<span>{ r.Date }</span>
						<span class="result-mailbox">{ r.Mailbox }</span>
					</div>
					if r.Snippet != "" {
						<div class="result-snippet">{ r.Snippet }</div>
					}
				</a>
			}
		</div>
		@Pagination(page, totalPages, "/search?q="+query)
	}
}
