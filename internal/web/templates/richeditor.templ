package templates

// RichEditorField renders the rich-editor component: toolbar, contenteditable
// region, and HTML-source textarea. It is the single authoritative copy of the
// editor markup used by both the compose page and the settings signature editor.
//
// Parameters:
//   - fieldName:   Name of the <input type="hidden"> synced by richeditor.js
//                 (e.g. "body" or "signature_html"). Also set as data-field-name
//                 on the root element; "body" is the default in the JS fallback
//                 so passing "body" is semantically identical to omitting it.
//   - initialHTML: Pre-sanitized HTML to seed the editor (e.g. stored signature).
//                 Pass "" for new-compose — the JS checks for truthy value so an
//                 empty attribute has no effect, but we omit it when empty to
//                 preserve the documented new-message semantics.
//   - variant:    "signature" for the shorter, full-width settings editor;
//                 anything else (e.g. "compose") for the taller compose body.
//
// All presentation is via CSS classes in bongo.css — NOT inline style="" —
// because the app CSP is `style-src 'self'` (no unsafe-inline), so inline style
// attributes are blocked by the browser (the editable area would collapse to
// zero height and be untypable). See the rich-editor* rules in bongo.css.
templ RichEditorField(fieldName string, initialHTML string, variant string) {
	<div
		x-data="richEditor"
		data-field-name={ fieldName }
		if initialHTML != "" {
			data-initial-html={ initialHTML }
		}
		class={ "rich-editor", templ.KV("rich-editor--block", variant == "signature") }
	>
		<div class="format-toolbar" x-show="!isSourceMode">
			<button type="button" class="format-btn" aria-label={ t(ctx, "editor.bold") } x-on:click="format('bold')"><b>B</b></button>
			<button type="button" class="format-btn" aria-label={ t(ctx, "editor.italic") } x-on:click="format('italic')"><i>I</i></button>
			<span class="format-sep"></span>
			<button type="button" class="format-btn" aria-label={ t(ctx, "editor.insertLink") } x-on:click="promptLink()">&#128279;</button>
			<input type="color" class="rich-editor-colour" aria-label={ t(ctx, "editor.textColour") } x-on:change="setColor($event.target.value)"/>
			<button type="button" class="format-btn" aria-label={ t(ctx, "editor.insertImage") } x-on:click="triggerImagePicker()">&#128247;</button>
			<span class="format-sep"></span>
			<button type="button" class="format-btn" aria-label={ t(ctx, "editor.toggleSource") } x-on:click="toggleSource()">HTML</button>
		</div>
		<div class="format-toolbar" x-show="isSourceMode">
			<button type="button" class="format-btn" aria-label={ t(ctx, "editor.toggleVisual") } x-on:click="toggleSource()">Visual</button>
		</div>
		<div
			data-editor
			contenteditable="true"
			role="textbox"
			aria-multiline="true"
			x-show="!isSourceMode"
			x-on:input="onInput()"
			aria-label={ t(ctx, "editor.editorLabel") }
			class={ "rich-editor-area", templ.KV("rich-editor-area--sm", variant == "signature") }
		></div>
		<textarea
			data-source
			aria-label={ t(ctx, "editor.sourceLabel") }
			x-show="isSourceMode"
			class={ "rich-editor-source", templ.KV("rich-editor-source--sm", variant == "signature") }
		></textarea>
		<input type="file" data-img-input accept="image/*" class="rich-editor-file" x-on:change="handleImageFile($event)"/>
		<input type="hidden" name={ fieldName }/>
	</div>
}
