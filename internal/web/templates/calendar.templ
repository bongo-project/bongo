package templates

import (
	"fmt"
	"time"

	bongov1 "github.com/bongo-go/bongo-go/proto/bongo/v1"
)

// DayCell holds data for a single day in the calendar grid.
type DayCell struct {
	Date           time.Time
	Events         []*bongov1.Event
	IsCurrentMonth bool
	IsToday        bool
}

templ CalendarPage(year, month int, days []DayCell, calendars []*bongov1.Calendar, email string, flash string) {
	@LayoutWithContent("Calendar", email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@CalendarSidebar(calendars)
		</aside>
		<main class="main-content" id="main-content">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			@CalendarMonthGrid(year, month, days, calendars)
		</main>
	}
}

templ CalendarMonthGrid(year, month int, days []DayCell, calendars []*bongov1.Calendar) {
	<div class="calendar-toolbar">
		<a
			href={ templ.SafeURL(prevMonthPath(year, month)) }
			hx-get={ prevMonthPath(year, month) }
			hx-target="#main-content"
			hx-push-url="true"
			role="button"
			class="outline secondary calendar-nav-btn"
		>
			Prev
		</a>
		<h2 class="calendar-month-title">{ monthName(month) } { fmt.Sprint(year) }</h2>
		<a
			href={ templ.SafeURL(nextMonthPath(year, month)) }
			hx-get={ nextMonthPath(year, month) }
			hx-target="#main-content"
			hx-push-url="true"
			role="button"
			class="outline secondary calendar-nav-btn"
		>
			Next
		</a>
	</div>
	<div class="calendar-grid">
		<div class="calendar-header">Mon</div>
		<div class="calendar-header">Tue</div>
		<div class="calendar-header">Wed</div>
		<div class="calendar-header">Thu</div>
		<div class="calendar-header">Fri</div>
		<div class="calendar-header">Sat</div>
		<div class="calendar-header">Sun</div>
		for _, day := range days {
			<div class={ dayCellClass(day) }>
				<a
					href={ templ.SafeURL("/calendar/event/new?date=" + day.Date.Format("2006-01-02")) }
					class="day-number"
				>
					{ fmt.Sprint(day.Date.Day()) }
				</a>
				for _, e := range day.Events {
					<a
						href={ templ.SafeURL("/calendar/event/" + e.Guid) }
						class="event-chip"
						title={ e.Title }
					>
						if !e.AllDay {
							<span class="event-time">{ formatEventTime(e.StartTime) }</span>
						}
						{ truncateTitle(e.Title, 20) }
					</a>
				}
			</div>
		}
	</div>
}

templ CalendarSidebar(calendars []*bongov1.Calendar) {
	<nav>
		<ul class="mailbox-list">
			<li>
				<a href="/calendar" class="active">
					<span>Calendar</span>
				</a>
			</li>
		</ul>
		<hr style="margin:0.5rem 0"/>
		<div class="toolbar" style="padding:0 0.75rem">
			<a href="/calendar/export" role="button" class="outline secondary" style="font-size:0.8rem;padding:0.2rem 0.5rem;width:100%;text-align:center">Export .ics</a>
		</div>
		<form method="post" action="/calendar/import" enctype="multipart/form-data" style="padding:0.5rem 0.75rem">
			<input type="file" name="ics" accept=".ics" style="font-size:0.75rem;padding:0.2rem;margin-bottom:0.25rem"/>
			<button type="submit" class="outline secondary" style="font-size:0.8rem;padding:0.2rem 0.5rem;width:100%">Import .ics</button>
		</form>
		<hr style="margin:0.5rem 0"/>
		<form action="/calendar/search" method="get" style="padding:0 0.75rem">
			<input type="search" name="q" placeholder="Search events..." style="font-size:0.85rem;padding:0.3rem 0.5rem"/>
		</form>
		<hr style="margin:0.5rem 0"/>
		<ul class="mailbox-list">
			<li>
				<a href="/mail/INBOX">
					<span>Back to Mail</span>
				</a>
			</li>
			<li>
				<a href="/contacts">
					<span>Contacts</span>
				</a>
			</li>
		</ul>
	</nav>
}

templ EventFormPage(event *bongov1.Event, calendars []*bongov1.Calendar, isNew bool, date string, email string) {
	@LayoutWithContent("Event", email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@CalendarSidebar(calendars)
		</aside>
		<main class="main-content" id="main-content">
			<div class="toolbar">
				<a href="/calendar" role="button" class="outline secondary">Back to Calendar</a>
			</div>
			if isNew {
				<h3>New Event</h3>
			} else {
				<h3>Edit Event</h3>
			}
			<form
				if isNew {
					method="post"
					action="/calendar/event"
				} else {
					method="post"
					action={ templ.SafeURL("/calendar/event/" + event.Guid) }
				}
				style="max-width:600px"
				x-data={ eventFormData(event, isNew, date) }
			>
				if !isNew {
					<input type="hidden" name="_method" value="PUT"/>
				}
				<label>
					Title
					<input type="text" name="title" value={ eventTitle(event) } required/>
				</label>
				<label>
					Description
					<textarea name="description" rows="3">{ eventDescription(event) }</textarea>
				</label>
				<label>
					Location
					<input type="text" name="location" value={ eventLocation(event) }/>
				</label>
				<label>
					Calendar
					<select name="calendar_id">
						for _, cal := range calendars {
							<option
								value={ cal.Guid }
								if event != nil && event.CalendarId == cal.Guid {
									selected
								}
							>
								{ cal.Name }
							</option>
						}
					</select>
				</label>
				<label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer">
					<input
						type="checkbox"
						name="all_day"
						x-model="allDay"
						if event != nil && event.AllDay {
							checked
						}
						style="width:auto"
					/>
					All day
				</label>
				<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem">
					<label>
						Start Date
						<input type="date" name="start_date" value={ eventStartDate(event, date) } required/>
					</label>
					<label x-show="!allDay">
						Start Time
						<input type="time" name="start_time" value={ eventStartTime(event) }/>
					</label>
				</div>
				<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem">
					<label>
						End Date
						<input type="date" name="end_date" value={ eventEndDate(event, date) }/>
					</label>
					<label x-show="!allDay">
						End Time
						<input type="time" name="end_time" value={ eventEndTime(event) }/>
					</label>
				</div>
				if !isNew {
					<div class="meta" style="margin-bottom:1rem;font-size:0.8rem">
						<span>Created: { formatEventDate(event.CreatedAt) }</span>
						<span style="margin-left:1rem">Updated: { formatEventDate(event.UpdatedAt) }</span>
					</div>
				}
				<div style="display:flex;gap:0.5rem">
					<button type="submit">
						if isNew {
							Create Event
						} else {
							Save
						}
					</button>
					<a href="/calendar" role="button" class="outline secondary">Cancel</a>
					if !isNew {
						<button
							type="button"
							class="outline contrast"
							hx-delete={ "/calendar/event/" + event.Guid }
							hx-confirm="Delete this event?"
						>
							Delete
						</button>
					}
				</div>
			</form>
		</main>
	}
}

templ CalendarSearchResults(events []*bongov1.Event, query string, email string) {
	@LayoutWithContent("Search", email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@CalendarSidebar(nil)
		</aside>
		<main class="main-content" id="main-content">
			<div class="toolbar">
				<a href="/calendar" role="button" class="outline secondary">Back to Calendar</a>
			</div>
			<h3>Search results for "{ query }"</h3>
			if len(events) == 0 {
				@EmptyState("No results", "No events matched your search.")
			} else {
				<table class="message-list">
					<thead>
						<tr>
							<th>Title</th>
							<th>Date</th>
							<th>Location</th>
						</tr>
					</thead>
					<tbody>
						for _, e := range events {
							<tr>
								<td>
									<a href={ templ.SafeURL("/calendar/event/" + e.Guid) } style="text-decoration:none;color:inherit">
										{ e.Title }
									</a>
								</td>
								<td>{ formatEventDate(e.StartTime) }</td>
								<td>{ e.Location }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</main>
	}
}

func prevMonthPath(year, month int) string {
	if month == 1 {
		return fmt.Sprintf("/calendar/%d/12", year-1)
	}
	return fmt.Sprintf("/calendar/%d/%d", year, month-1)
}

func nextMonthPath(year, month int) string {
	if month == 12 {
		return fmt.Sprintf("/calendar/%d/1", year+1)
	}
	return fmt.Sprintf("/calendar/%d/%d", year, month+1)
}

func monthName(month int) string {
	return time.Month(month).String()
}

func dayCellClass(day DayCell) string {
	cls := "day-cell"
	if !day.IsCurrentMonth {
		cls += " other-month"
	}
	if day.IsToday {
		cls += " today"
	}
	return cls
}

func formatEventTime(unix int64) string {
	return time.Unix(unix, 0).Format("15:04")
}

func formatEventDate(unix int64) string {
	if unix == 0 {
		return "-"
	}
	return time.Unix(unix, 0).Format("Jan 2, 2006")
}

func truncateTitle(s string, maxLen int) string {
	if len(s) <= maxLen {
		return s
	}
	return s[:maxLen-1] + "..."
}

func eventTitle(e *bongov1.Event) string {
	if e == nil {
		return ""
	}
	return e.Title
}

func eventDescription(e *bongov1.Event) string {
	if e == nil {
		return ""
	}
	return e.Description
}

func eventLocation(e *bongov1.Event) string {
	if e == nil {
		return ""
	}
	return e.Location
}

func eventStartDate(e *bongov1.Event, date string) string {
	if e != nil && e.StartTime > 0 {
		return time.Unix(e.StartTime, 0).Format("2006-01-02")
	}
	if date != "" {
		return date
	}
	return time.Now().Format("2006-01-02")
}

func eventStartTime(e *bongov1.Event) string {
	if e != nil && e.StartTime > 0 && !e.AllDay {
		return time.Unix(e.StartTime, 0).Format("15:04")
	}
	return "09:00"
}

func eventEndDate(e *bongov1.Event, date string) string {
	if e != nil && e.EndTime > 0 {
		t := time.Unix(e.EndTime, 0)
		if e.AllDay {
			t = t.AddDate(0, 0, -1)
		}
		return t.Format("2006-01-02")
	}
	if date != "" {
		return date
	}
	return time.Now().Format("2006-01-02")
}

func eventEndTime(e *bongov1.Event) string {
	if e != nil && e.EndTime > 0 && !e.AllDay {
		return time.Unix(e.EndTime, 0).Format("15:04")
	}
	return "10:00"
}

func eventFormData(e *bongov1.Event, isNew bool, date string) string {
	allDay := "false"
	if e != nil && e.AllDay {
		allDay = "true"
	}
	return fmt.Sprintf("{allDay: %s}", allDay)
}
