package templates

import (
	"fmt"
	"time"

	bongov1 "github.com/bongo-go/bongo-go/proto/bongo/v1"
)

// DayCell holds data for a single day in the calendar grid.
type DayCell struct {
	Date           time.Time
	Events         []*bongov1.Event
	IsCurrentMonth bool
	IsToday        bool
}

// DayColumn holds events for a single day in week/day views.
type DayColumn struct {
	Date    time.Time
	IsToday bool
	AllDay  []*bongov1.Event
	Blocks  []EventBlock
	DateStr string
}

// EventBlock is a positioned event within an hour grid.
type EventBlock struct {
	Event     *bongov1.Event
	TopPct    float64
	HeightPct float64
	Color     string
}

templ CalendarPage(year, month int, days []DayCell, calendars []*bongov1.Calendar, email string, flash string) {
	@LayoutWithContent("Calendar", email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@CalendarSidebar(calendars)
		</aside>
		<main class="main-content" id="main-content">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			@CalendarMonthGrid(year, month, days, calendars)
		</main>
	}
}

templ CalendarMonthGrid(year, month int, days []DayCell, calendars []*bongov1.Calendar) {
	<div class="calendar-toolbar">
		<a
			href={ templ.SafeURL(prevMonthPath(year, month)) }
			hx-get={ prevMonthPath(year, month) }
			hx-target="#main-content"
			hx-push-url="true"
			role="button"
			class="outline secondary calendar-nav-btn"
			aria-label="Previous month"
		>
			Prev
		</a>
		<h2 class="calendar-month-title">{ monthName(month) } { fmt.Sprint(year) }</h2>
		<a
			href={ templ.SafeURL(nextMonthPath(year, month)) }
			hx-get={ nextMonthPath(year, month) }
			hx-target="#main-content"
			hx-push-url="true"
			role="button"
			class="outline secondary calendar-nav-btn"
			aria-label="Next month"
		>
			Next
		</a>
	</div>
	<div class="calendar-grid">
		<div class="calendar-header">Mon</div>
		<div class="calendar-header">Tue</div>
		<div class="calendar-header">Wed</div>
		<div class="calendar-header">Thu</div>
		<div class="calendar-header">Fri</div>
		<div class="calendar-header">Sat</div>
		<div class="calendar-header">Sun</div>
		for _, day := range days {
			<div class={ dayCellClass(day) } aria-label={ day.Date.Format("Monday, January 2") }>
				<a
					href={ templ.SafeURL("/calendar/event/new?date=" + day.Date.Format("2006-01-02")) }
					class="day-number"
				>
					{ fmt.Sprint(day.Date.Day()) }
				</a>
				for _, e := range day.Events {
					<a
						href={ templ.SafeURL("/calendar/event/" + e.Guid) }
						class="event-chip"
						title={ e.Title }
					>
						if !e.AllDay {
							<span class="event-time">{ formatEventTime(e.StartTime) }</span>
						}
						{ truncateTitle(e.Title, 20) }
					</a>
				}
			</div>
		}
	</div>
}

templ CalendarSidebar(calendars []*bongov1.Calendar) {
	<nav>
		<ul class="mailbox-list">
			<li>
				<a href="/calendar" class="active">
					<span>Calendar</span>
				</a>
			</li>
		</ul>
		<hr style="margin:0.5rem 0"/>
		@MiniCalendar(time.Now().Year(), int(time.Now().Month()), time.Now().Day())
		<hr style="margin:0.5rem 0"/>
		if len(calendars) > 0 {
			@CalendarListPanel(calendars)
			<hr style="margin:0.5rem 0"/>
		}
		<div class="toolbar" style="padding:0 0.75rem">
			<a href="/calendar/export" role="button" class="outline secondary" style="font-size:0.8rem;padding:0.2rem 0.5rem;width:100%;text-align:center">Export .ics</a>
		</div>
		<form method="post" action="/calendar/import" enctype="multipart/form-data" style="padding:0.5rem 0.75rem">
			<input type="file" name="ics" accept=".ics" style="font-size:0.75rem;padding:0.2rem;margin-bottom:0.25rem"/>
			<button type="submit" class="outline secondary" style="font-size:0.8rem;padding:0.2rem 0.5rem;width:100%">Import .ics</button>
		</form>
		<hr style="margin:0.5rem 0"/>
		<form action="/calendar/search" method="get" style="padding:0 0.75rem">
			<input type="search" name="q" placeholder="Search events..." style="font-size:0.85rem;padding:0.3rem 0.5rem"/>
		</form>
		<hr style="margin:0.5rem 0"/>
		<ul class="mailbox-list">
			<li>
				<a href="/mail/INBOX">
					<span>Back to Mail</span>
				</a>
			</li>
			<li>
				<a href="/contacts">
					<span>Contacts</span>
				</a>
			</li>
		</ul>
	</nav>
}

templ EventFormPage(event *bongov1.Event, calendars []*bongov1.Calendar, isNew bool, date string, email string) {
	@LayoutWithContent("Event", email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@CalendarSidebar(calendars)
		</aside>
		<main class="main-content" id="main-content">
			<div class="toolbar">
				<a href="/calendar" role="button" class="outline secondary">Back to Calendar</a>
			</div>
			if isNew {
				<h3>New Event</h3>
			} else {
				<h3>Edit Event</h3>
			}
			<form
				if isNew {
					method="post"
					action="/calendar/event"
				} else {
					method="post"
					action={ templ.SafeURL("/calendar/event/" + event.Guid) }
				}
				style="max-width:600px"
				x-data={ eventFormData(event, isNew, date) }
			>
				if !isNew {
					<input type="hidden" name="_method" value="PUT"/>
				}
				<label>
					Title
					<input type="text" name="title" value={ eventTitle(event) } required/>
				</label>
				<label>
					Description
					<textarea name="description" rows="3">{ eventDescription(event) }</textarea>
				</label>
				<label>
					Location
					<input type="text" name="location" value={ eventLocation(event) }/>
				</label>
				<label>
					Calendar
					<select name="calendar_id">
						for _, cal := range calendars {
							<option
								value={ cal.Guid }
								if event != nil && event.CalendarId == cal.Guid {
									selected
								}
							>
								{ cal.Name }
							</option>
						}
					</select>
				</label>
				<label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer">
					<input
						type="checkbox"
						name="all_day"
						x-model="allDay"
						if event != nil && event.AllDay {
							checked
						}
						style="width:auto"
					/>
					All day
				</label>
				<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem">
					<label>
						Start Date
						<input type="date" name="start_date" value={ eventStartDate(event, date) } required/>
					</label>
					<label x-show="!allDay">
						Start Time
						<input type="time" name="start_time" value={ eventStartTime(event) }/>
					</label>
				</div>
				<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem">
					<label>
						End Date
						<input type="date" name="end_date" value={ eventEndDate(event, date) }/>
					</label>
					<label x-show="!allDay">
						End Time
						<input type="time" name="end_time" value={ eventEndTime(event) }/>
					</label>
				</div>
				<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem">
					<label>
						Repeat
						<select name="rrule">
							<option value="">None</option>
							<option value="FREQ=DAILY" if eventRrule(event) == "FREQ=DAILY" { selected }>Daily</option>
							<option value="FREQ=WEEKLY" if eventRrule(event) == "FREQ=WEEKLY" { selected }>Weekly</option>
							<option value="FREQ=MONTHLY" if eventRrule(event) == "FREQ=MONTHLY" { selected }>Monthly</option>
							<option value="FREQ=YEARLY" if eventRrule(event) == "FREQ=YEARLY" { selected }>Yearly</option>
						</select>
					</label>
					<label>
						Reminder
						<select name="reminder_minutes">
							<option value="0" if eventReminderMinutes(event) == "0" { selected }>None</option>
							<option value="5" if eventReminderMinutes(event) == "5" { selected }>5 min before</option>
							<option value="10" if eventReminderMinutes(event) == "10" { selected }>10 min before</option>
							<option value="15" if eventReminderMinutes(event) == "15" { selected }>15 min before</option>
							<option value="30" if eventReminderMinutes(event) == "30" { selected }>30 min before</option>
							<option value="60" if eventReminderMinutes(event) == "60" { selected }>1 hour before</option>
						</select>
					</label>
				</div>
				if !isNew {
					<div class="meta" style="margin-bottom:1rem;font-size:0.8rem">
						<span>Created: { formatEventDate(event.CreatedAt) }</span>
						<span style="margin-left:1rem">Updated: { formatEventDate(event.UpdatedAt) }</span>
					</div>
				}
				<div style="display:flex;gap:0.5rem">
					<button type="submit">
						if isNew {
							Create Event
						} else {
							Save
						}
					</button>
					<a href="/calendar" role="button" class="outline secondary">Cancel</a>
					if !isNew {
						<button
							type="button"
							class="outline contrast"
							hx-delete={ "/calendar/event/" + event.Guid }
							hx-confirm="Delete this event?"
						>
							Delete
						</button>
					}
				</div>
			</form>
		</main>
	}
}

templ WeekViewPage(year, week int, days []DayColumn, calendars []*bongov1.Calendar, calColors map[string]string, email string, flash string) {
	@LayoutWithContent("Calendar", email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@CalendarSidebar(calendars)
		</aside>
		<main class="main-content" id="main-content">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			@WeekViewGrid(year, week, days, calendars, calColors)
		</main>
	}
}

templ WeekViewGrid(year, week int, days []DayColumn, calendars []*bongov1.Calendar, calColors map[string]string) {
	<div class="calendar-toolbar">
		<a
			href={ templ.SafeURL(fmt.Sprintf("/calendar/week/%d/%d", prevWeekYear(year, week), prevWeekNum(year, week))) }
			hx-get={ fmt.Sprintf("/calendar/week/%d/%d", prevWeekYear(year, week), prevWeekNum(year, week)) }
			hx-target="#main-content"
			hx-push-url="true"
			role="button"
			class="outline secondary calendar-nav-btn"
			aria-label="Previous week"
		>
			Prev
		</a>
		<h2 class="calendar-month-title">Week { fmt.Sprint(week) }, { fmt.Sprint(year) }</h2>
		<a
			href={ templ.SafeURL(fmt.Sprintf("/calendar/week/%d/%d", nextWeekYear(year, week), nextWeekNum(year, week))) }
			hx-get={ fmt.Sprintf("/calendar/week/%d/%d", nextWeekYear(year, week), nextWeekNum(year, week)) }
			hx-target="#main-content"
			hx-push-url="true"
			role="button"
			class="outline secondary calendar-nav-btn"
			aria-label="Next week"
		>
			Next
		</a>
	</div>
	@ViewSwitcher("week", year, week, days)
	<div class="all-day-header">
		<div class="time-gutter-header"></div>
		for _, day := range days {
			<div class={ "all-day-cell", templ.KV("today", day.IsToday) }>
				for _, e := range day.AllDay {
					<a
						href={ templ.SafeURL("/calendar/event/" + e.Guid) }
						class="event-chip"
						style={ "background-color:" + eventBlockColor(e, calColors) }
					>
						{ truncateTitle(e.Title, 16) }
					</a>
				}
			</div>
		}
	</div>
	<div class="week-grid">
		<div class="time-gutter">
			for h := 0; h < 24; h++ {
				<div class="hour-label">{ fmt.Sprintf("%02d:00", h) }</div>
			}
		</div>
		for _, day := range days {
			<div class={ "day-column", templ.KV("today", day.IsToday) } data-date={ day.DateStr }>
				for h := 0; h < 24; h++ {
					<div
						class="hour-row"
						data-hour={ fmt.Sprint(h) }
					>
						<a
							href={ templ.SafeURL(fmt.Sprintf("/calendar/event/new?date=%s&time=%02d:00", day.DateStr, h)) }
							class="hour-row-link"
						></a>
					</div>
				}
				for _, block := range day.Blocks {
					<a
						href={ templ.SafeURL("/calendar/event/" + block.Event.Guid) }
						class="event-block"
						style={ fmt.Sprintf("top:%.2f%%;height:%.2f%%;background-color:%s", block.TopPct, block.HeightPct, block.Color) }
						data-guid={ block.Event.Guid }
						data-start={ fmt.Sprint(block.Event.StartTime) }
						data-end={ fmt.Sprint(block.Event.EndTime) }
					>
						<span class="event-block-time">{ formatEventTime(block.Event.StartTime) }</span>
						<span class="event-block-title">{ truncateTitle(block.Event.Title, 24) }</span>
					</a>
				}
			</div>
		}
	</div>
}

templ DayViewPage(date time.Time, col DayColumn, calendars []*bongov1.Calendar, calColors map[string]string, email string, flash string) {
	@LayoutWithContent("Calendar", email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@CalendarSidebar(calendars)
		</aside>
		<main class="main-content" id="main-content">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			@DayViewGrid(date, col, calendars, calColors)
		</main>
	}
}

templ DayViewGrid(date time.Time, col DayColumn, calendars []*bongov1.Calendar, calColors map[string]string) {
	<div class="calendar-toolbar">
		<a
			href={ templ.SafeURL(prevDayPath(date)) }
			hx-get={ prevDayPath(date) }
			hx-target="#main-content"
			hx-push-url="true"
			role="button"
			class="outline secondary calendar-nav-btn"
			aria-label="Previous day"
		>
			Prev
		</a>
		<h2 class="calendar-month-title">{ date.Format("Monday, January 2, 2006") }</h2>
		<a
			href={ templ.SafeURL(nextDayPath(date)) }
			hx-get={ nextDayPath(date) }
			hx-target="#main-content"
			hx-push-url="true"
			role="button"
			class="outline secondary calendar-nav-btn"
			aria-label="Next day"
		>
			Next
		</a>
	</div>
	@ViewSwitcherDay("day", date)
	if len(col.AllDay) > 0 {
		<div class="all-day-header day-view-allday">
			<div class="time-gutter-header"></div>
			<div class={ "all-day-cell", templ.KV("today", col.IsToday) }>
				for _, e := range col.AllDay {
					<a
						href={ templ.SafeURL("/calendar/event/" + e.Guid) }
						class="event-chip"
						style={ "background-color:" + eventBlockColor(e, calColors) }
					>
						{ truncateTitle(e.Title, 30) }
					</a>
				}
			</div>
		</div>
	}
	<div class="day-grid">
		<div class="time-gutter">
			for h := 0; h < 24; h++ {
				<div class="hour-label">{ fmt.Sprintf("%02d:00", h) }</div>
			}
		</div>
		<div class={ "day-column", templ.KV("today", col.IsToday) } data-date={ col.DateStr }>
			for h := 0; h < 24; h++ {
				<div
					class="hour-row"
					data-hour={ fmt.Sprint(h) }
				>
					<a
						href={ templ.SafeURL(fmt.Sprintf("/calendar/event/new?date=%s&time=%02d:00", col.DateStr, h)) }
						class="hour-row-link"
					></a>
				</div>
			}
			for _, block := range col.Blocks {
				<a
					href={ templ.SafeURL("/calendar/event/" + block.Event.Guid) }
					class="event-block"
					style={ fmt.Sprintf("top:%.2f%%;height:%.2f%%;background-color:%s", block.TopPct, block.HeightPct, block.Color) }
					data-guid={ block.Event.Guid }
					data-start={ fmt.Sprint(block.Event.StartTime) }
					data-end={ fmt.Sprint(block.Event.EndTime) }
				>
					<span class="event-block-time">{ formatEventTime(block.Event.StartTime) }</span>
					<span class="event-block-title">{ block.Event.Title }</span>
				</a>
			}
		</div>
	</div>
}

templ ViewSwitcher(activeView string, year, week int, days []DayColumn) {
	<div class="view-switcher">
		if len(days) > 0 {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/calendar/%d/%d", days[0].Date.Year(), int(days[0].Date.Month()))) }
				role="button"
				class={ "outline", templ.KV("secondary", activeView != "month") }
				if activeView == "month" {
					aria-current="page"
				}
			>
				Month
			</a>
		}
		<a
			href={ templ.SafeURL(fmt.Sprintf("/calendar/week/%d/%d", year, week)) }
			role="button"
			class={ templ.KV("outline", true), templ.KV("secondary", activeView != "week") }
			if activeView == "week" {
				aria-current="page"
			}
		>
			Week
		</a>
		if len(days) > 0 {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/calendar/day/%d/%d/%d", days[0].Date.Year(), int(days[0].Date.Month()), days[0].Date.Day())) }
				role="button"
				class={ "outline", templ.KV("secondary", activeView != "day") }
				if activeView == "day" {
					aria-current="page"
				}
			>
				Day
			</a>
		}
	</div>
}

templ ViewSwitcherDay(activeView string, date time.Time) {
	<div class="view-switcher">
		<a
			href={ templ.SafeURL(fmt.Sprintf("/calendar/%d/%d", date.Year(), int(date.Month()))) }
			role="button"
			class={ "outline", templ.KV("secondary", activeView != "month") }
			if activeView == "month" {
				aria-current="page"
			}
		>
			Month
		</a>
		<a
			href={ templ.SafeURL(fmt.Sprintf("/calendar/week/%d/%d", dateISOYear(date), dateISOWeek(date))) }
			role="button"
			class={ "outline", templ.KV("secondary", activeView != "week") }
			if activeView == "week" {
				aria-current="page"
			}
		>
			Week
		</a>
		<a
			href={ templ.SafeURL(fmt.Sprintf("/calendar/day/%d/%d/%d", date.Year(), int(date.Month()), date.Day())) }
			role="button"
			class={ templ.KV("outline", true), templ.KV("secondary", activeView != "day") }
			if activeView == "day" {
				aria-current="page"
			}
		>
			Day
		</a>
	</div>
}

templ MiniCalendar(year, month, selectedDay int) {
	<div class="mini-calendar" id="mini-calendar">
		<div class="mini-calendar-nav">
			<button
				class="outline secondary mini-cal-btn"
				hx-get={ fmt.Sprintf("/calendar/mini?year=%d&month=%d", miniPrevYear(year, month), miniPrevMonth(month)) }
				hx-target="#mini-calendar"
				hx-swap="outerHTML"
				aria-label="Previous month"
			>
				&lt;
			</button>
			<span class="mini-cal-title">{ monthName(month) } { fmt.Sprint(year) }</span>
			<button
				class="outline secondary mini-cal-btn"
				hx-get={ fmt.Sprintf("/calendar/mini?year=%d&month=%d", miniNextYear(year, month), miniNextMonth(month)) }
				hx-target="#mini-calendar"
				hx-swap="outerHTML"
				aria-label="Next month"
			>
				&gt;
			</button>
		</div>
		<div class="mini-cal-grid">
			<span class="mini-cal-hdr">M</span>
			<span class="mini-cal-hdr">T</span>
			<span class="mini-cal-hdr">W</span>
			<span class="mini-cal-hdr">T</span>
			<span class="mini-cal-hdr">F</span>
			<span class="mini-cal-hdr">S</span>
			<span class="mini-cal-hdr">S</span>
			for _, d := range miniCalDays(year, month, selectedDay) {
				if d.Day == 0 {
					<span class="mini-cal-day empty"></span>
				} else {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/calendar/day/%d/%d/%d", year, month, d.Day)) }
						hx-get={ fmt.Sprintf("/calendar/day/%d/%d/%d", year, month, d.Day) }
						hx-target="#main-content"
						hx-push-url="true"
						class={ "mini-cal-day", templ.KV("today", d.IsToday), templ.KV("selected", d.IsSelected), templ.KV("other-month", !d.InMonth) }
					>
						{ fmt.Sprint(d.Day) }
					</a>
				}
			}
		</div>
	</div>
}

templ CalendarListPanel(calendars []*bongov1.Calendar) {
	<div class="calendar-list-panel" x-data="{ hiddenCals: {} }">
		for _, cal := range calendars {
			<div class="calendar-list-item">
				<label style="display:flex;align-items:center;gap:0.4rem;cursor:pointer;font-size:0.85rem">
					<input
						type="checkbox"
						checked
						x-on:change={ fmt.Sprintf("hiddenCals['%s'] = !$el.checked; document.querySelectorAll('[data-cal-id=\"%s\"]').forEach(el => el.style.display = $el.checked ? '' : 'none')", cal.Guid, cal.Guid) }
						style="width:auto;margin:0"
					/>
					<span class="cal-color-dot" style={ "background-color:" + cal.Color }></span>
					{ cal.Name }
				</label>
			</div>
		}
	</div>
}

templ CalendarSearchResults(events []*bongov1.Event, query string, email string) {
	@LayoutWithContent("Search", email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@CalendarSidebar(nil)
		</aside>
		<main class="main-content" id="main-content">
			<div class="toolbar">
				<a href="/calendar" role="button" class="outline secondary">Back to Calendar</a>
			</div>
			<h3>Search results for "{ query }"</h3>
			if len(events) == 0 {
				@EmptyState("No results", "No events matched your search.")
			} else {
				<table class="message-list">
					<thead>
						<tr>
							<th>Title</th>
							<th>Date</th>
							<th>Location</th>
						</tr>
					</thead>
					<tbody>
						for _, e := range events {
							<tr>
								<td>
									<a href={ templ.SafeURL("/calendar/event/" + e.Guid) } style="text-decoration:none;color:inherit">
										{ e.Title }
									</a>
								</td>
								<td>{ formatEventDate(e.StartTime) }</td>
								<td>{ e.Location }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</main>
	}
}

func prevMonthPath(year, month int) string {
	if month == 1 {
		return fmt.Sprintf("/calendar/%d/12", year-1)
	}
	return fmt.Sprintf("/calendar/%d/%d", year, month-1)
}

func nextMonthPath(year, month int) string {
	if month == 12 {
		return fmt.Sprintf("/calendar/%d/1", year+1)
	}
	return fmt.Sprintf("/calendar/%d/%d", year, month+1)
}

func monthName(month int) string {
	return time.Month(month).String()
}

func dayCellClass(day DayCell) string {
	cls := "day-cell"
	if !day.IsCurrentMonth {
		cls += " other-month"
	}
	if day.IsToday {
		cls += " today"
	}
	return cls
}

func formatEventTime(unix int64) string {
	return time.Unix(unix, 0).Format("15:04")
}

func formatEventDate(unix int64) string {
	if unix == 0 {
		return "-"
	}
	return time.Unix(unix, 0).Format("Jan 2, 2006")
}

func truncateTitle(s string, maxLen int) string {
	if len(s) <= maxLen {
		return s
	}
	return s[:maxLen-1] + "..."
}

func eventTitle(e *bongov1.Event) string {
	if e == nil {
		return ""
	}
	return e.Title
}

func eventDescription(e *bongov1.Event) string {
	if e == nil {
		return ""
	}
	return e.Description
}

func eventLocation(e *bongov1.Event) string {
	if e == nil {
		return ""
	}
	return e.Location
}

func eventStartDate(e *bongov1.Event, date string) string {
	if e != nil && e.StartTime > 0 {
		return time.Unix(e.StartTime, 0).Format("2006-01-02")
	}
	if date != "" {
		return date
	}
	return time.Now().Format("2006-01-02")
}

func eventStartTime(e *bongov1.Event) string {
	if e != nil && e.StartTime > 0 && !e.AllDay {
		return time.Unix(e.StartTime, 0).Format("15:04")
	}
	return "09:00"
}

func eventEndDate(e *bongov1.Event, date string) string {
	if e != nil && e.EndTime > 0 {
		t := time.Unix(e.EndTime, 0)
		if e.AllDay {
			t = t.AddDate(0, 0, -1)
		}
		return t.Format("2006-01-02")
	}
	if date != "" {
		return date
	}
	return time.Now().Format("2006-01-02")
}

func eventEndTime(e *bongov1.Event) string {
	if e != nil && e.EndTime > 0 && !e.AllDay {
		return time.Unix(e.EndTime, 0).Format("15:04")
	}
	return "10:00"
}

func eventFormData(e *bongov1.Event, isNew bool, date string) string {
	allDay := "false"
	if e != nil && e.AllDay {
		allDay = "true"
	}
	return fmt.Sprintf("{allDay: %s}", allDay)
}

func prevWeekYear(year, week int) int {
	if week <= 1 {
		return year - 1
	}
	return year
}

func prevWeekNum(year, week int) int {
	if week <= 1 {
		return 52
	}
	return week - 1
}

func nextWeekYear(year, week int) int {
	if week >= 52 {
		return year + 1
	}
	return year
}

func nextWeekNum(year, week int) int {
	if week >= 52 {
		return 1
	}
	return week + 1
}

func prevDayPath(date time.Time) string {
	d := date.AddDate(0, 0, -1)
	return fmt.Sprintf("/calendar/day/%d/%d/%d", d.Year(), int(d.Month()), d.Day())
}

func nextDayPath(date time.Time) string {
	d := date.AddDate(0, 0, 1)
	return fmt.Sprintf("/calendar/day/%d/%d/%d", d.Year(), int(d.Month()), d.Day())
}

func dateISOYear(date time.Time) int {
	y, _ := date.ISOWeek()
	return y
}

func dateISOWeek(date time.Time) int {
	_, w := date.ISOWeek()
	return w
}

func eventBlockColor(e *bongov1.Event, calColors map[string]string) string {
	if c, ok := calColors[e.CalendarId]; ok && c != "" {
		return c
	}
	return "#4A90D9"
}

func eventRrule(e *bongov1.Event) string {
	if e == nil {
		return ""
	}
	return e.Rrule
}

func eventReminderMinutes(e *bongov1.Event) string {
	if e == nil || e.ReminderMinutes == 0 {
		return "0"
	}
	return fmt.Sprint(e.ReminderMinutes)
}

// MiniCalDay holds data for one day in the mini calendar.
type MiniCalDay struct {
	Day        int
	IsToday    bool
	IsSelected bool
	InMonth    bool
}

func miniCalDays(year, month, selectedDay int) []MiniCalDay {
	firstDay := time.Date(year, time.Month(month), 1, 0, 0, 0, 0, time.Now().Location())
	lastDay := firstDay.AddDate(0, 1, -1).Day()

	weekday := int(firstDay.Weekday())
	if weekday == 0 {
		weekday = 7
	}

	today := time.Now()
	todayYear, todayMonth, todayDay := today.Date()

	var days []MiniCalDay

	// Padding for days before month start.
	for i := 1; i < weekday; i++ {
		days = append(days, MiniCalDay{Day: 0})
	}

	for d := 1; d <= lastDay; d++ {
		days = append(days, MiniCalDay{
			Day:        d,
			IsToday:    year == todayYear && time.Month(month) == todayMonth && d == todayDay,
			IsSelected: d == selectedDay,
			InMonth:    true,
		})
	}

	return days
}

func miniPrevYear(year, month int) int {
	if month <= 1 {
		return year - 1
	}
	return year
}

func miniPrevMonth(month int) int {
	if month <= 1 {
		return 12
	}
	return month - 1
}

func miniNextYear(year, month int) int {
	if month >= 12 {
		return year + 1
	}
	return year
}

func miniNextMonth(month int) int {
	if month >= 12 {
		return 1
	}
	return month + 1
}
