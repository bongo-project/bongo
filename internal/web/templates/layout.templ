package templates

templ Layout(title string, email string) {
	<!DOCTYPE html>
	<html lang={ localeFromCtx(ctx) } x-data="appState()" x-bind:data-theme="resolvedTheme()">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - Bongo</title>
			<link rel="icon" type="image/png" href="/static/img/bongo-favicon.png"/>
			<link rel="stylesheet" href="/static/css/pico.min.css"/>
			<link rel="stylesheet" href="/static/css/open-props.min.css"/>
			<link rel="stylesheet" href="/static/css/bongo.css"/>
		</head>
		<body>
			<a href="#main-content" class="skip-link">{ t(ctx, "nav.skipToContent") }</a>
			<header role="banner" class="top-bar">
				<div style="display:flex;align-items:center;gap:0.75rem">
					<button type="button" class="hamburger-btn" x-on:click="toggleSidebar()" aria-label="Toggle sidebar">&#9776;</button>
					<a href="/mail/INBOX" class="brand">Bongo<span class="brand-accent">Mail</span></a>
				</div>
				<nav aria-label="Quick actions">
					<input
						type="search"
						name="q"
						placeholder={ t(ctx, "nav.searchPlaceholder") }
						class="search-input"
						aria-label={ t(ctx, "nav.searchPlaceholder") }
						hx-get="/search"
						hx-trigger="keyup changed delay:300ms"
						hx-target="#main-content"
						hx-push-url="true"
					/>
					<button
						type="button"
						class="theme-toggle"
						x-on:click="toggleTheme()"
						x-text="themeIcon"
						aria-label={ t(ctx, "nav.toggleTheme") }
						title={ t(ctx, "nav.toggleTheme") }
					></button>
					<a href="/settings" style="font-size:0.88rem;text-decoration:none">{ t(ctx, "nav.settings") }</a>
					<span style="font-size:0.88rem;color:var(--text-secondary)">{ email }</span>
					<form method="post" action="/logout" style="margin:0">
						<button type="submit" class="outline secondary" style="padding:0.3rem 0.7rem;font-size:0.85rem">{ t(ctx, "auth.logout") }</button>
					</form>
				</nav>
			</header>
			<div x-on:click="sidebarOpen = false" class="sidebar-overlay" x-bind:class="{'active': sidebarOpen}"></div>
			<div class="app-layout">
				<aside class="sidebar" id="sidebar" aria-label="Mailbox navigation" x-bind:class="{'open': sidebarOpen}">
					{ children... }
				</aside>
				<main class="main-content" id="main-content" role="main">
				</main>
			</div>
			<div id="aria-announcements" aria-live="polite" class="sr-only"></div>
			<div x-data="notifications" x-init="init()">
				<button
					type="button"
					class="notification-prompt outline secondary"
					x-show="permission === 'default'"
					x-on:click="requestPermission()"
					x-cloak=""
				>
					{ t(ctx, "settings.enableNotifications") }
				</button>
			</div>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/sortable.min.js"></script>
			<script src="/static/js/alpine.min.js" defer></script>
			<script src="/static/js/bongo.js"></script>
		</body>
	</html>
}

