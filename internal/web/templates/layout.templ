package templates

templ Layout(title string, email string) {
	<!DOCTYPE html>
	<html lang={ localeFromCtx(ctx) } x-data="appState()" x-bind:data-theme="resolvedTheme()" data-accent="bongo" data-sidebar="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<!-- Do not let HTMX inject inline indicator styles (blocked by our CSP); they live in bongo.css instead. -->
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<title>{ title } - Bongo</title>
			<link rel="icon" type="image/png" href="/static/img/bongo-favicon.png"/>
			<link rel="stylesheet" href="/static/css/componentlib/colors_and_type.css"/>
			<link rel="stylesheet" href="/static/css/bongo.css"/>
			<link rel="stylesheet" href="/static/css/generated_geometry.css"/>
		</head>
		<body>
			<!-- Translation strings needed by bongo.js. CSP forbids inline
			scripts, so they are passed as a JSON data island (templ escapes it,
			the browser decodes it, bongo.js parses it from dataset.messages). -->
			<span id="i18n-data" hidden data-messages={ i18nJSON(ctx) }></span>
			<a href="#main-content" class="skip-link">{ t(ctx, "nav.skipToContent") }</a>
			<header class="topbar" role="banner">
				<div class="topbar-left">
					<button type="button" class="hamburger" x-on:click="toggleSidebar()" aria-label={ t(ctx, "nav.toggleNavMenu") } aria-expanded="false" aria-controls="sidebar">&#9776;</button>
					<a href="/mail/INBOX" class="brand" aria-label="BongoMail">Bongo<span>Mail</span></a>
				</div>
				<div class="topbar-center">
					<div class="search-box" role="search">
						<span class="search-icon" aria-hidden="true">&#128269;</span>
						<input
							type="search"
							name="q"
							placeholder={ t(ctx, "nav.searchPlaceholder") }
							aria-label={ t(ctx, "nav.searchPlaceholder") }
							hx-get="/search"
							hx-trigger="keyup changed delay:300ms"
							hx-target="#main-content"
							hx-push-url="true"
						/>
					</div>
				</div>
				<div class="topbar-right">
					<button
						type="button"
						class="topbar-btn"
						x-on:click="toggleTheme()"
						x-text="themeIcon"
						aria-label={ t(ctx, "nav.toggleTheme") }
						title={ t(ctx, "nav.toggleTheme") }
					></button>
					<a href="/settings" class="topbar-link">{ t(ctx, "nav.settings") }</a>
					<span class="user-email" aria-label={ t(ctx, "nav.loggedInAs") + " " + email }>{ email }</span>
					<form method="post" action="/logout" class="u-m0">
						<button type="submit" class="topbar-link hide-mobile">{ t(ctx, "auth.logout") }</button>
					</form>
				</div>
			</header>
			if require2FAFromCtx(ctx) {
				<div class="flash flash-warning banner-2fa" role="alert">
					<div class="flash-icon">&#9888;</div>
					<div class="flash-content">
						{ t(ctx, "security.require2FABanner") }
						<a href="/settings/security" class="u-ml-05 u-fw-600">{ t(ctx, "security.setupTwoFactor") }</a>
					</div>
				</div>
			}
			<div class="layout">
				<div class="sidebar-overlay" x-on:click="sidebarOpen = false" x-bind:class="{'open': sidebarOpen}" aria-hidden="true"></div>
				<aside class="sidebar" id="sidebar" aria-label={ t(ctx, "nav.mailboxNav") } x-bind:class="{'open': sidebarOpen}">
					{ children... }
				</aside>
				<main class="content" id="main-content" role="main">
				</main>
			</div>
			<div id="aria-announcements" aria-live="polite" class="sr-only"></div>
			<div x-data="notifications" x-init="init()">
				<button
					type="button"
					class="notification-prompt outline secondary"
					x-bind:hidden="permission !== 'default'"
					x-on:click="requestPermission()"
					x-cloak=""
				>
					{ t(ctx, "settings.enableNotifications") }
				</button>
			</div>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/sortable.min.js"></script>
			<script src="/static/js/alpine-csp.min.js" defer></script>
			<script src="/static/js/bongo.js"></script>
		</body>
	</html>
}

templ LayoutWithContent(title string, email string) {
	<!DOCTYPE html>
	<html lang={ localeFromCtx(ctx) } x-data="appState()" x-bind:data-theme="resolvedTheme()">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<!-- Do not let HTMX inject inline indicator styles (blocked by our CSP); they live in bongo.css instead. -->
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<title>{ title } - Bongo</title>
			<link rel="icon" type="image/png" href="/static/img/bongo-favicon.png"/>
			<link rel="stylesheet" href="/static/css/componentlib/colors_and_type.css"/>
			<link rel="stylesheet" href="/static/css/bongo.css"/>
			<link rel="stylesheet" href="/static/css/generated_geometry.css"/>
		</head>
		<body>
			<!-- Translation strings needed by bongo.js. CSP forbids inline
			scripts, so they are passed as a JSON data island (templ escapes it,
			the browser decodes it, bongo.js parses it from dataset.messages). -->
			<span id="i18n-data" hidden data-messages={ i18nJSON(ctx) }></span>
			<a href="#main-content" class="skip-link">{ t(ctx, "nav.skipToContent") }</a>
			<header class="topbar" role="banner">
				<div class="topbar-left">
					<button type="button" class="hamburger" x-on:click="toggleSidebar()" aria-label={ t(ctx, "nav.toggleNavMenu") } aria-expanded="false" aria-controls="sidebar">&#9776;</button>
					<a href="/mail/INBOX" class="brand" aria-label="BongoMail">Bongo<span>Mail</span></a>
				</div>
				<div class="topbar-center">
					<div class="search-box" role="search">
						<span class="search-icon" aria-hidden="true">&#128269;</span>
						<input
							type="search"
							name="q"
							placeholder={ t(ctx, "nav.searchPlaceholder") }
							aria-label={ t(ctx, "nav.searchPlaceholder") }
							hx-get="/search"
							hx-trigger="keyup changed delay:300ms"
							hx-target="#main-content"
							hx-push-url="true"
						/>
					</div>
				</div>
				<div class="topbar-right">
					<button
						type="button"
						class="topbar-btn"
						x-on:click="toggleTheme()"
						x-text="themeIcon"
						aria-label={ t(ctx, "nav.toggleTheme") }
						title={ t(ctx, "nav.toggleTheme") }
					></button>
					<a href="/settings" class="topbar-link">{ t(ctx, "nav.settings") }</a>
					<span class="user-email" aria-label={ t(ctx, "nav.loggedInAs") + " " + email }>{ email }</span>
					<form method="post" action="/logout" class="u-m0">
						<button type="submit" class="topbar-link hide-mobile">{ t(ctx, "auth.logout") }</button>
					</form>
				</div>
			</header>
			if require2FAFromCtx(ctx) {
				<div class="flash flash-warning banner-2fa" role="alert">
					<div class="flash-icon">&#9888;</div>
					<div class="flash-content">
						{ t(ctx, "security.require2FABanner") }
						<a href="/settings/security" class="u-ml-05 u-fw-600">{ t(ctx, "security.setupTwoFactor") }</a>
					</div>
				</div>
			}
			<div class="layout">
				<div class="sidebar-overlay" x-on:click="sidebarOpen = false" x-bind:class="{'open': sidebarOpen}" aria-hidden="true"></div>
				{ children... }
			</div>
			<div id="aria-announcements" aria-live="polite" class="sr-only"></div>
			<div x-data="notifications" x-init="init()">
				<button
					type="button"
					class="notification-prompt outline secondary"
					x-bind:hidden="permission !== 'default'"
					x-on:click="requestPermission()"
					x-cloak=""
				>
					{ t(ctx, "settings.enableNotifications") }
				</button>
			</div>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/sortable.min.js"></script>
			<script src="/static/js/alpine-csp.min.js" defer></script>
			<script src="/static/js/bongo.js"></script>
		</body>
	</html>
}

templ LoginLayout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="auto">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<!-- Do not let HTMX inject inline indicator styles (blocked by our CSP); they live in bongo.css instead. -->
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<title>{ title } - Bongo</title>
			<link rel="icon" type="image/png" href="/static/img/bongo-favicon.png"/>
			<link rel="stylesheet" href="/static/css/componentlib/colors_and_type.css"/>
			<link rel="stylesheet" href="/static/css/bongo.css"/>
		</head>
		<body class="login-page">
			{ children... }
		</body>
	</html>
}
