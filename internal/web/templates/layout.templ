						x-text="themeIcon"
						aria-label={ t(ctx, "nav.toggleTheme") }
						title={ t(ctx, "nav.toggleTheme") }
					></button>
					<a href="/settings" style="font-size:0.88rem;text-decoration:none">{ t(ctx, "nav.settings") }</a>
					<span style="font-size:0.88rem;color:var(--text-secondary)">{ email }</span>
					<form method="post" action="/logout" style="margin:0">
						<button type="submit" class="outline secondary" style="padding:0.3rem 0.7rem;font-size:0.85rem">{ t(ctx, "auth.logout") }</button>
					</form>
				</nav>
