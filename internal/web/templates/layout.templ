package templates

// Topbar is the three-column application header shared by Layout and
// LayoutWithContent: brand, search pill, and theme toggle plus account menu.
templ Topbar(email string) {
	<header class="topbar" role="banner">
		<div class="topbar-left">
			<button type="button" class="hamburger" x-on:click="toggleSidebar()" aria-label={ t(ctx, "nav.toggleNavMenu") } aria-expanded="false" aria-controls="sidebar">&#9776;</button>
			<a href="/mail/INBOX" class="brand" aria-label="BongoMail">
				@Icon("logo", "brand-glyph")
				<span class="wordmark">Bongo<em>&middot;</em>mail</span>
			</a>
		</div>
		<div class="topbar-center">
			<div class="search-box" role="search">
				@Icon("search", "search-icon")
				<input
					id="global-search"
					type="search"
					name="q"
					placeholder={ t(ctx, "nav.searchPlaceholder") }
					aria-label={ t(ctx, "nav.searchPlaceholder") }
					hx-get="/search"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#main-content"
					hx-push-url="true"
				/>
				<kbd class="search-hint" aria-hidden="true" x-text="searchHint">&#8984;K</kbd>
			</div>
		</div>
		<div class="topbar-right">
			<button
				type="button"
				class="icon-btn"
				x-on:click="toggleTheme()"
				x-text="themeIcon"
				aria-label={ t(ctx, "nav.toggleTheme") }
				title={ t(ctx, "nav.toggleTheme") }
			></button>
			<div class="account-menu" x-data="accountMenu" x-on:keydown.escape="close()" x-on:click.outside="dismiss()">
				<button
					type="button"
					class="avatar-chip"
					x-ref="button"
					aria-haspopup="true"
					aria-expanded="false"
					x-bind:aria-expanded="open"
					aria-controls="account-dropdown"
					aria-label={ accountMenuLabel(ctx, email) }
					x-on:click="toggle()"
				>
					<span class="avatar" aria-hidden="true">{ accountInitials(email) }</span>
					<span class="name">{ email }</span>
				</button>
				<div class="account-dropdown" id="account-dropdown" hidden x-bind:hidden="!open" x-cloak="">
					if email != "" {
						<div class="account-dropdown-head"><span class="sr-only">{ t(ctx, "nav.loggedInAs") }</span> { email }</div>
					}
					<a href="/settings" class="account-item">{ t(ctx, "nav.settings") }</a>
					<a href={ sourceURL(ctx) } class="account-item" rel="noopener">{ t(ctx, "nav.sourceCode") }</a>
					<form method="post" action="/logout" class="u-m0">
						<button type="submit" class="account-item">{ t(ctx, "auth.logout") }</button>
					</form>
				</div>
			</div>
		</div>
	</header>
}

templ Layout(title string, email string) {
	<!DOCTYPE html>
	<html lang={ localeFromCtx(ctx) } x-data="appState()" x-bind:data-theme="resolvedTheme()" data-accent="bongo" data-sidebar="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<!-- Do not let HTMX inject inline indicator styles (blocked by our CSP); they live in bongo.css instead. -->
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<title>{ title } - Bongo</title>
			<link rel="icon" type="image/png" href="/static/img/bongo-favicon.png"/>
			<link rel="apple-touch-icon" href="/static/img/bongo-favicon.png"/>
			<link rel="stylesheet" href="/static/css/componentlib/colors_and_type.css"/>
			<link rel="stylesheet" href={ "/static/css/bongo.css?v=" + assetVersion() }/>
			<link rel="stylesheet" href={ "/static/css/generated_geometry.css?v=" + assetVersion() }/>
		</head>
		<body hx-headers={ csrfHeaders(ctx) }>
			<!-- Translation strings needed by bongo.js. CSP forbids inline
			scripts, so they are passed as a JSON data island (templ escapes it,
			the browser decodes it, bongo.js parses it from dataset.messages).
			hx-headers on <body> makes every HTMX mutation send the CSRF token. -->
			<span id="i18n-data" hidden data-messages={ i18nJSON(ctx) }></span>
			<a href="#main-content" class="skip-link">{ t(ctx, "nav.skipToContent") }</a>
			@Topbar(email)
			if require2FAFromCtx(ctx) {
				<div class="flash flash-warning banner-2fa" role="alert">
					<div class="flash-icon" aria-hidden="true">@Icon("alert", "")</div>
					<div class="flash-content">
						{ t(ctx, "security.require2FABanner") }
						<a href="/settings/security" class="u-ml-05 u-fw-600">{ t(ctx, "security.setupTwoFactor") }</a>
					</div>
				</div>
			}
			<div class="layout">
				<div class="sidebar-overlay" x-on:click="sidebarOpen = false" x-bind:class="{'open': sidebarOpen}" aria-hidden="true"></div>
				<aside class="sidebar" id="sidebar" aria-label={ t(ctx, "nav.mailboxNav") } x-bind:class="{'open': sidebarOpen}">
					{ children... }
				</aside>
				<main class="content" id="main-content" role="main">
				</main>
			</div>
			<div id="aria-announcements" aria-live="polite" class="sr-only"></div>
			<div x-data="notifications" x-init="init()">
				<button
					type="button"
					class="notification-prompt outline secondary"
					x-bind:hidden="permission !== 'default'"
					x-on:click="requestPermission()"
					x-cloak=""
				>
					{ t(ctx, "settings.enableNotifications") }
				</button>
			</div>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/sortable.min.js"></script>
			<script src={ "/static/js/richeditor.js?v=" + assetVersion() }></script>
			<script src="/static/js/alpine-csp.min.js" defer></script>
			<script src={ "/static/js/bongo.js?v=" + assetVersion() }></script>
		</body>
	</html>
}

templ LayoutWithContent(title string, email string) {
	<!DOCTYPE html>
	<html lang={ localeFromCtx(ctx) } x-data="appState()" x-bind:data-theme="resolvedTheme()" data-accent="bongo" data-sidebar="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<!-- Do not let HTMX inject inline indicator styles (blocked by our CSP); they live in bongo.css instead. -->
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<title>{ title } - Bongo</title>
			<link rel="icon" type="image/png" href="/static/img/bongo-favicon.png"/>
			<link rel="apple-touch-icon" href="/static/img/bongo-favicon.png"/>
			<link rel="stylesheet" href="/static/css/componentlib/colors_and_type.css"/>
			<link rel="stylesheet" href={ "/static/css/bongo.css?v=" + assetVersion() }/>
			<link rel="stylesheet" href={ "/static/css/generated_geometry.css?v=" + assetVersion() }/>
		</head>
		<body hx-headers={ csrfHeaders(ctx) }>
			<!-- Translation strings needed by bongo.js. CSP forbids inline
			scripts, so they are passed as a JSON data island (templ escapes it,
			the browser decodes it, bongo.js parses it from dataset.messages).
			hx-headers on <body> makes every HTMX mutation send the CSRF token. -->
			<span id="i18n-data" hidden data-messages={ i18nJSON(ctx) }></span>
			<a href="#main-content" class="skip-link">{ t(ctx, "nav.skipToContent") }</a>
			@Topbar(email)
			if require2FAFromCtx(ctx) {
				<div class="flash flash-warning banner-2fa" role="alert">
					<div class="flash-icon" aria-hidden="true">@Icon("alert", "")</div>
					<div class="flash-content">
						{ t(ctx, "security.require2FABanner") }
						<a href="/settings/security" class="u-ml-05 u-fw-600">{ t(ctx, "security.setupTwoFactor") }</a>
					</div>
				</div>
			}
			<div class="layout">
				<div class="sidebar-overlay" x-on:click="sidebarOpen = false" x-bind:class="{'open': sidebarOpen}" aria-hidden="true"></div>
				{ children... }
			</div>
			<div id="aria-announcements" aria-live="polite" class="sr-only"></div>
			<div x-data="notifications" x-init="init()">
				<button
					type="button"
					class="notification-prompt outline secondary"
					x-bind:hidden="permission !== 'default'"
					x-on:click="requestPermission()"
					x-cloak=""
				>
					{ t(ctx, "settings.enableNotifications") }
				</button>
			</div>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/sortable.min.js"></script>
			<script src={ "/static/js/richeditor.js?v=" + assetVersion() }></script>
			<script src="/static/js/alpine-csp.min.js" defer></script>
			<script src={ "/static/js/bongo.js?v=" + assetVersion() }></script>
		</body>
	</html>
}

templ LoginLayout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="auto" data-accent="bongo" data-sidebar="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<!-- Do not let HTMX inject inline indicator styles (blocked by our CSP); they live in bongo.css instead. -->
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<title>{ title } - Bongo</title>
			<link rel="icon" type="image/png" href="/static/img/bongo-favicon.png"/>
			<link rel="apple-touch-icon" href="/static/img/bongo-favicon.png"/>
			<link rel="stylesheet" href="/static/css/componentlib/colors_and_type.css"/>
			<link rel="stylesheet" href={ "/static/css/bongo.css?v=" + assetVersion() }/>
		</head>
		<body class="login-page">
			{ children... }
			<p class="login-source"><a href={ sourceURL(ctx) } rel="noopener">{ t(ctx, "nav.sourceCode") }</a></p>
		</body>
	</html>
}
