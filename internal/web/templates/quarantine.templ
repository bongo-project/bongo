package templates

import (
	"fmt"
	"time"
)

// QuarantineEntry holds display data for a quarantined message.
type QuarantineEntry struct {
	ID         string
	Sender     string
	Recipients string
	Subject    string
	Reason     string
	Stage      string
	Score      float32
	ReceivedAt time.Time
}

templ AdminQuarantine(msgs []QuarantineEntry, email, flash string) {
	@AdminLayout(t(ctx, "quarantine.title"), email, "quarantine") {
		<div class="admin-scroll" x-data="quarantineBulk()">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<h1 class="admin-title">{ t(ctx, "quarantine.title") }</h1>
			<p class="admin-subtitle">{ t(ctx, "quarantine.subtitle") }</p>
			<!-- Bulk action toolbar -->
			<div class="bulk-bar" x-bind:hidden="selected.length === 0" x-cloak>
				<span class="bulk-label" x-text="selected.length + ' selected'"></span>
				<form method="post" action="/admin/quarantine/bulk" class="u-m0 u-flex u-gap-05" @submit="appendIds">
					<input type="hidden" name="action" value="release"/>
					<div id="bulk-ids-release"></div>
					<button type="submit" class="btn-outline">{ t(ctx, "quarantine.releaseSelected") }</button>
				</form>
				<form method="post" action="/admin/quarantine/bulk" class="u-m0 u-flex u-gap-05" @submit="appendIds">
					<input type="hidden" name="action" value="rescan"/>
					<div id="bulk-ids-rescan"></div>
					<button type="submit" class="btn-outline">{ t(ctx, "quarantine.rescanSelected") }</button>
				</form>
				<form method="post" action="/admin/quarantine/bulk" class="u-m0 u-flex u-gap-05" @submit="appendIds">
					<input type="hidden" name="action" value="delete"/>
					<div id="bulk-ids-delete"></div>
					<button type="submit" class="btn-flush">{ t(ctx, "quarantine.deleteSelected") }</button>
				</form>
			</div>
			<div class="admin-table-card">
				<table class="admin-table" aria-label={ t(ctx, "quarantine.tableLabel") }>
					<thead>
						<tr>
							<th class="u-width-36px">
								<input type="checkbox" aria-label={ t(ctx, "mail.selectAll") } @change="toggleAll($event)" :checked="allSelected()"/>
							</th>
							<th scope="col">{ t(ctx, "mail.date") }</th>
							<th scope="col">{ t(ctx, "quarantine.sender") }</th>
							<th scope="col">{ t(ctx, "mail.subject") }</th>
							<th scope="col">{ t(ctx, "quarantine.reason") }</th>
							<th scope="col" class="u-width-60px">{ t(ctx, "quarantine.score") }</th>
							<th scope="col" class="u-width-160px">{ t(ctx, "rules.colActions") }</th>
						</tr>
					</thead>
					<tbody>
						for _, m := range msgs {
							<tr>
								<td>
									<input
										type="checkbox"
										:value={ fmt.Sprintf("%q", m.ID) }
										x-model="selected"
										aria-label={ t(ctx, "quarantine.selectMessage") + " " + m.ID }
									/>
								</td>
								<td class="u-white-space-nowrap u-font-082 u-text-muted">{ m.ReceivedAt.Format("2006-01-02 15:04") }</td>
								<td class="u-font-088">
									<code class="u-font-082">{ m.Sender }</code>
								</td>
								<td class="u-font-088">
									if m.Subject != "" {
										{ m.Subject }
									} else {
										<span class="u-text-muted">{ t(ctx, "quarantine.noSubject") }</span>
									}
								</td>
								<td class="u-font-082 u-text-muted">
									if m.Stage != "" {
										<span class="badge badge-disabled u-mr-03">{ m.Stage }</span>
									}
									{ truncate(m.Reason, 80) }
								</td>
								<td>
									<span class={ quarantineScoreClass(m.Score) }>
										{ fmt.Sprintf("%.2f", m.Score) }
									</span>
								</td>
								<td>
									<div class="row-actions">
										<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/quarantine/%s/release", m.ID)) }>
											<button type="submit" class="btn-outline">{ t(ctx, "quarantine.release") }</button>
										</form>
										<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/quarantine/%s/delete", m.ID)) }>
											<button type="submit" class="btn-flush">{ t(ctx, "common.delete") }</button>
										</form>
									</div>
								</td>
							</tr>
						}
						if len(msgs) == 0 {
							<tr>
								<td colspan="7" class="u-text-center u-text-muted u-p-2rem">
									{ t(ctx, "quarantine.noMessages") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if len(msgs) > 0 {
				<p class="u-font-082 u-text-muted u-mt-05">
					{ fmt.Sprint(len(msgs)) } { t(ctx, "quarantine.messagesInQuarantine") }
				</p>
			}
		</div>
	}
}

// quarantineScoreClass returns a CSS class based on the spam score.
func quarantineScoreClass(score float32) string {
	switch {
	case score >= 0.8:
		return "badge badge-disabled"
	case score >= 0.5:
		return "badge badge-pending"
	default:
		return "badge"
	}
}

// truncate shortens s to at most n runes, appending "..." if truncated.
func truncate(s string, n int) string {
	runes := []rune(s)
	if len(runes) <= n {
		return s
	}
	return string(runes[:n]) + "..."
}

// quarantineScorePct formats a 0..1 score as a percentage string.
func quarantineScorePct(score float32) string {
	return fmt.Sprintf("%.0f%%", score*100)
}
