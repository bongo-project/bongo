package templates

import (
	"fmt"
	"time"
)

// QuarantineEntry holds display data for a quarantined message.
type QuarantineEntry struct {
	ID         string
	Sender     string
	Recipients string
	Subject    string
	Reason     string
	Stage      string
	Score      float32
	ReceivedAt time.Time
}

templ AdminQuarantine(msgs []QuarantineEntry, email, flash string) {
	@AdminLayout("Quarantine", email, "quarantine") {
		<div class="admin-scroll" x-data="quarantineBulk()">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<h1 class="admin-title">Quarantine</h1>
			<p class="admin-subtitle">Messages held for review — release to deliver or delete to discard</p>
			<!-- Bulk action toolbar -->
			<div class="bulk-bar" x-show="selected.length > 0" x-cloak>
				<span class="bulk-label" x-text="selected.length + ' selected'"></span>
				<form method="post" action="/admin/quarantine/bulk" style="margin:0;display:flex;gap:0.5rem" @submit="appendIds">
					<input type="hidden" name="action" value="release"/>
					<div id="bulk-ids-release"></div>
					<button type="submit" class="btn-outline">Release Selected</button>
				</form>
				<form method="post" action="/admin/quarantine/bulk" style="margin:0;display:flex;gap:0.5rem" @submit="appendIds">
					<input type="hidden" name="action" value="delete"/>
					<div id="bulk-ids-delete"></div>
					<button type="submit" class="btn-flush">Delete Selected</button>
				</form>
			</div>
			<div class="admin-table-card">
				<table class="admin-table" aria-label="Quarantined messages">
					<thead>
						<tr>
							<th style="width:36px">
								<input type="checkbox" aria-label="Select all" @change="toggleAll($event)" :checked="allSelected()"/>
							</th>
							<th scope="col">Date</th>
							<th scope="col">Sender</th>
							<th scope="col">Subject</th>
							<th scope="col">Reason</th>
							<th scope="col" style="width:60px">Score</th>
							<th scope="col" style="width:160px">Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, m := range msgs {
							<tr>
								<td>
									<input
										type="checkbox"
										:value={ fmt.Sprintf("%q", m.ID) }
										x-model="selected"
										aria-label={ "Select " + m.ID }
									/>
								</td>
								<td style="white-space:nowrap;font-size:0.82rem;color:var(--text-muted)">{ m.ReceivedAt.Format("2006-01-02 15:04") }</td>
								<td style="font-size:0.88rem">
									<code style="font-size:0.82rem">{ m.Sender }</code>
								</td>
								<td style="font-size:0.88rem">
									if m.Subject != "" {
										{ m.Subject }
									} else {
										<span style="color:var(--text-muted)">(no subject)</span>
									}
								</td>
								<td style="font-size:0.82rem;color:var(--text-muted)">
									if m.Stage != "" {
										<span class="badge badge-disabled" style="margin-right:0.3rem">{ m.Stage }</span>
									}
									{ truncate(m.Reason, 80) }
								</td>
								<td>
									<span class={ quarantineScoreClass(m.Score) }>
										{ fmt.Sprintf("%.2f", m.Score) }
									</span>
								</td>
								<td>
									<div class="row-actions">
										<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/quarantine/%s/release", m.ID)) }>
											<button type="submit" class="btn-outline">Release</button>
										</form>
										<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/quarantine/%s/delete", m.ID)) }>
											<button type="submit" class="btn-flush">Delete</button>
										</form>
									</div>
								</td>
							</tr>
						}
						if len(msgs) == 0 {
							<tr>
								<td colspan="7" style="text-align:center;color:var(--text-muted);padding:2rem">
									No quarantined messages.
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if len(msgs) > 0 {
				<p style="font-size:0.82rem;color:var(--text-muted);margin-top:0.5rem">
					{ fmt.Sprint(len(msgs)) } message(s) in quarantine
				</p>
			}
		</div>
		<script>
			function quarantineBulk() {
				return {
					selected: [],
					allIds: Array.from(document.querySelectorAll('tbody input[type=checkbox]')).map(el => el.value),
					toggleAll(event) {
						this.selected = event.target.checked ? [...this.allIds] : [];
					},
					allSelected() {
						return this.allIds.length > 0 && this.selected.length === this.allIds.length;
					},
					appendIds(event) {
						var form = event.target;
						var container = form.querySelector('div[id^="bulk-ids"]');
						if (!container) return;
						container.innerHTML = '';
						this.selected.forEach(function(id) {
							var input = document.createElement('input');
							input.type = 'hidden';
							input.name = 'ids';
							input.value = id;
							container.appendChild(input);
						});
					}
				}
			}
		</script>
	}
}

// quarantineScoreClass returns a CSS class based on the spam score.
func quarantineScoreClass(score float32) string {
	switch {
	case score >= 0.8:
		return "badge badge-disabled"
	case score >= 0.5:
		return "badge badge-pending"
	default:
		return "badge"
	}
}

// truncate shortens s to at most n runes, appending "..." if truncated.
func truncate(s string, n int) string {
	runes := []rune(s)
	if len(runes) <= n {
		return s
	}
	return string(runes[:n]) + "..."
}

// quarantineScorePct formats a 0..1 score as a percentage string.
func quarantineScorePct(score float32) string {
	return fmt.Sprintf("%.0f%%", score*100)
}
