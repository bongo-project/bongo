package templates

import "fmt"

templ ImportPage(mailboxes []string) {
	<h2>{ t(ctx, "import.importMessages") }</h2>
	<p>{ t(ctx, "import.uploadDescription") }</p>
	<form method="post" action="/import" enctype="multipart/form-data">
		<label for="mbox">{ t(ctx, "import.mboxFile") }</label>
		<input type="file" id="mbox" name="mbox" accept=".mbox,.mbx" required/>
		<label for="mailbox">{ t(ctx, "import.targetMailbox") }</label>
		<select id="mailbox" name="mailbox">
			for _, mb := range mailboxes {
				<option value={ mb }>{ mb }</option>
			}
			<option value="">{ t(ctx, "import.newMailboxOption") }</option>
		</select>
		<input type="text" name="new_mailbox" placeholder={ t(ctx, "import.newMailboxPlaceholder") } class="u-mt-05"/>
		<button type="submit" class="u-mt-1">{ t(ctx, "import.import") }</button>
	</form>
}

templ ImportResult(imported int, failed int, mailbox string) {
	<h2>{ t(ctx, "import.importComplete") }</h2>
	<p>
		{ fmt.Sprintf("%d", imported) } { t(ctx, "import.messagesImportedTo") } { mailbox }.
		if failed > 0 {
			{ fmt.Sprintf("%d", failed) } { t(ctx, "import.messagesFailed") }
		}
	</p>
	<a href={ templ.SafeURL(mailboxURL(mailbox)) } role="button">{ t(ctx, "import.goToMailbox") } { mailbox }</a>
	<a href="/import" role="button" class="outline secondary u-ml-05">{ t(ctx, "import.importMore") }</a>
}
