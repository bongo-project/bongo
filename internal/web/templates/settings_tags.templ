package templates

import (
	"context"
	"encoding/json"
	"fmt"
)

// TagSettingItem is the template data for a single tag on the settings page.
type TagSettingItem struct {
	Name        string
	ColourIndex int32
	Count       int
}

// TagSettingsData is the template data for the tag settings page.
type TagSettingsData struct {
	Tags  []TagSettingItem
	Email string
	Flash string
}

// tagColourNamesJSON is a JSON array of the translated palette colour names,
// indexed like tagColourPalette, so swatches are announced as "Colour blue"
// rather than "Colour 0".
func tagColourNamesJSON(ctx context.Context) string {
	names := make([]string, len(tagColourPalette))
	for i := range names {
		names[i] = t(ctx, fmt.Sprintf("tag.colourName.%d", i))
	}
	b, _ := json.Marshal(names)
	return string(b)
}

// tagSettingsPalette is a JS array literal of the 16 tag palette colours,
// used to hydrate Alpine.js state on the client side.
func tagSettingsPaletteJS() string {
	b := make([]byte, 0, 256)
	b = append(b, '[')
	for i, c := range tagColourPalette {
		if i > 0 {
			b = append(b, ',')
		}
		b = append(b, '"')
		b = append(b, c...)
		b = append(b, '"')
	}
	b = append(b, ']')
	return string(b)
}

templ TagSettingsPage(data TagSettingsData) {
	@LayoutWithContent(t(ctx, "nav.tags"), data.Email) {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="nav-list">
					<li><a href="/settings">{ t(ctx, "nav.settings") }</a></li>
					<li><a href="/settings/vacation">{ t(ctx, "settings.vacation") }</a></li>
					<li><a href="/mail/INBOX">{ t(ctx, "nav.backToMail") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container u-max-w-960">
					if data.Flash != "" {
						@FlashMessage(data.Flash, "success")
					}
					<div class="page-header page-header-row">
						<h2 class="u-m0">{ t(ctx, "nav.tags") }</h2>
					</div>
					<div
						id="tag-settings"
						x-data={ fmt.Sprintf(`tagSettings(%s)`, tagSettingsPaletteJS()) }
						data-count-label={ t(ctx, "tag.countTitle") }
						data-colour-label={ t(ctx, "tag.colourLabel") }
						data-colour-names={ tagColourNamesJSON(ctx) }
						data-edit-tag-label={ t(ctx, "tag.editLabel") }
						data-delete-tag-label={ t(ctx, "tag.deleteLabel") }
					>
						<!-- Tag list -->
						<div class="settings-card u-mb-24px">
							<template x-if="tags.length === 0">
								<p class="secondary-text u-m0 u-py-16 u-px-20">{ t(ctx, "tag.noTagsYet") }</p>
							</template>
							<template x-for="tag in tags" :key="tag.name">
								<div class="settings-row tag-settings-row">
									<!-- Colour swatch -->
									<span
										class="tag-swatch tag-settings-swatch tag-swatch-md"
										:class="tagPaletteBGClass(tag.colourIndex)"
										:title="tagPaletteHex(tag.colourIndex)"
									></span>
									<!-- Name / inline edit -->
									<div class="settings-row-label u-flex-1 u-min-w-0">
										<template x-if="editingTag !== tag.name">
											<span class="settings-row-title" x-text="tag.name"></span>
										</template>
										<template x-if="editingTag === tag.name">
											<input
												type="text"
												class="settings-input u-max-w-280"
												x-model="editName"
												x-on:keydown.enter.prevent="saveTag(tag)"
												x-on:keydown.escape="cancelEdit()"
												x-ref="editInput"
												aria-label={ t(ctx, "tag.namePlaceholder") }
											/>
										</template>
									</div>
									<!-- Message count -->
									<span
										class="nav-badge"
										x-text="tag.count"
										:title="countTitle(tag)"
									></span>
									<!-- Colour picker (shown in edit mode) -->
									<template x-if="editingTag === tag.name">
										<div class="tag-colour-picker" role="group" aria-label={ t(ctx, "tag.chooseColour") }>
											<template x-for="(colour, idx) in palette" :key="idx">
												<button
													type="button"
													class="tag-colour-swatch-btn"
													:class="[tagPaletteBGClass(idx), editColourIndex === idx ? 'tag-colour-swatch-btn--selected' : '']"
													:aria-label="colourLabel(idx)"
													:aria-pressed="editColourIndex === idx"
													x-on:click="editColourIndex = idx"
												></button>
											</template>
										</div>
									</template>
									<!-- Action buttons -->
									<div class="tag-settings-actions u-flex u-gap-6px u-flex-shrink-0">
										<template x-if="editingTag !== tag.name && confirmDeleteTag !== tag.name">
											<button
												type="button"
												class="btn-icon"
												:aria-label="editLabel(tag)"
												x-on:click="startEdit(tag)"
												title={ t(ctx, "common.edit") }
											>&#9998;</button>
										</template>
										<template x-if="editingTag === tag.name">
											<button
												type="button"
												class="btn-sm btn-primary"
												x-on:click="saveTag(tag)"
												:disabled="savingTag"
											>{ t(ctx, "common.save") }</button>
										</template>
										<template x-if="editingTag === tag.name">
											<button
												type="button"
												class="btn-sm btn-ghost"
												x-on:click="cancelEdit()"
											>{ t(ctx, "common.cancel") }</button>
										</template>
										<template x-if="editingTag !== tag.name && confirmDeleteTag !== tag.name">
											<button
												type="button"
												class="btn-icon btn-icon--danger"
												:aria-label="deleteLabel(tag)"
												x-on:click="confirmDeleteTag = tag.name"
												title={ t(ctx, "common.delete") }
											>&#x2715;</button>
										</template>
										<template x-if="confirmDeleteTag === tag.name">
											<span class="u-flex u-items-center u-gap-6px u-font-082 u-text-muted">
												{ t(ctx, "tag.deletePrompt") }
												<button
													type="button"
													class="btn-sm btn-danger"
													x-on:click="deleteTag(tag)"
													:disabled="deletingTag"
												>{ t(ctx, "tag.yesDelete") }</button>
												<button
													type="button"
													class="btn-sm btn-ghost"
													x-on:click="confirmDeleteTag = null"
												>{ t(ctx, "common.cancel") }</button>
											</span>
										</template>
									</div>
								</div>
							</template>
						</div>
						<!-- Error message -->
						<template x-if="errorMsg">
							<div role="alert" class="flash flash-error u-mb-1" x-text="errorMsg"></div>
						</template>
						<!-- Create new tag -->
						<div class="settings-card">
							<div class="settings-section-title u-font-09 u-fw-600 u-pt-14 u-px-18">{ t(ctx, "tag.addNewTag") }</div>
							<div class="settings-row u-flex-wrap u-gap-10px u-items-start">
								<div class="u-flex u-flex-col u-flex-1 u-min-w-180 u-gap-4px">
									<label for="new-tag-name" class="settings-row-title u-font-082">{ t(ctx, "tag.name") }</label>
									<input
										id="new-tag-name"
										type="text"
										class="settings-input"
										x-model="newTagName"
										placeholder={ t(ctx, "tag.namePlaceholderExample") }
										maxlength="50"
										x-on:keydown.enter.prevent="createTag()"
										aria-label={ t(ctx, "tag.newTagNameAria") }
									/>
								</div>
								<div class="u-flex u-flex-col u-gap-4px">
									<span class="settings-row-title u-font-082" id="new-colour-label">{ t(ctx, "tag.colour") }</span>
									<div class="tag-colour-picker" role="group" aria-labelledby="new-colour-label">
										<template x-for="(colour, idx) in palette" :key="idx">
											<button
												type="button"
												class="tag-colour-swatch-btn"
												:class="[tagPaletteBGClass(idx), newTagColourIndex === idx ? 'tag-colour-swatch-btn--selected' : '']"
												:aria-label="colourLabel(idx)"
												:aria-pressed="newTagColourIndex === idx"
												x-on:click="newTagColourIndex = idx"
											></button>
										</template>
									</div>
								</div>
								<div class="u-flex u-items-end u-pb-2">
									<button
										type="button"
										class="btn-primary"
										x-on:click="createTag()"
										:disabled="creatingTag || !newTagName.trim()"
									>{ t(ctx, "tag.addTag") }</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</main>
	}
}
