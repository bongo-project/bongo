package templates

import bongov1 "github.com/bongo-go/bongo-go/proto/bongo/v1"

templ SettingsPage(prefs *bongov1.UserPreferences, email string, flash string) {
	@LayoutWithContent("Settings", email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			<nav aria-label="Settings navigation">
				<div class="sidebar-group">
					<div class="sidebar-label">Navigation</div>
					<ul class="nav-list">
						<li class="nav-item"><a href="/mail/INBOX" hx-get="/mail/INBOX" hx-target="#main-content" hx-push-url="true"><span class="nav-icon" aria-hidden="true">&#9993;</span> { t(ctx, "nav.backToMail") }</a></li>
						<li class="nav-item"><a href="/settings/rules" hx-get="/settings/rules" hx-target="#main-content" hx-push-url="true"><span class="nav-icon" aria-hidden="true">&#128295;</span> { t(ctx, "settings.filterRules") }</a></li>
						<li class="nav-item"><a href="/settings/security" hx-get="/settings/security" hx-target="#main-content" hx-push-url="true"><span class="nav-icon" aria-hidden="true">&#128274;</span> { t(ctx, "settings.security") }</a></li>
					</ul>
				</div>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container" x-data="{ activeTab: 0 }">
					if flash != "" {
						@FlashMessage(flash, "success")
					}
					<div class="settings-tabs" role="tablist" aria-label="Settings sections">
						<button type="button" class="settings-tab" role="tab"
							x-bind:class="{ 'active': activeTab === 0 }" x-bind:aria-selected="activeTab === 0"
							x-on:click="activeTab = 0">{ t(ctx, "settings.appearance") }</button>
						<button type="button" class="settings-tab" role="tab"
							x-bind:class="{ 'active': activeTab === 1 }" x-bind:aria-selected="activeTab === 1"
							x-on:click="activeTab = 1">{ t(ctx, "settings.display") }</button>
						<button type="button" class="settings-tab" role="tab"
							x-bind:class="{ 'active': activeTab === 2 }" x-bind:aria-selected="activeTab === 2"
							x-on:click="activeTab = 2">{ t(ctx, "settings.composition") }</button>
						<button type="button" class="settings-tab" role="tab"
							x-bind:class="{ 'active': activeTab === 3 }" x-bind:aria-selected="activeTab === 3"
							x-on:click="activeTab = 3">{ t(ctx, "settings.localization") }</button>
					</div>
					<form method="post" action="/settings">
						<!-- Appearance -->
						<div class="settings-section" x-show="activeTab === 0">
							<h2 class="settings-section-title">{ t(ctx, "settings.appearance") }</h2>
							<p class="settings-section-desc">Theme, layout, and density preferences.</p>
							<div class="settings-card">
								<div class="settings-row">
									<div class="settings-row-label">
										<div class="settings-row-title">{ t(ctx, "settings.theme") }</div>
									</div>
									<select name="theme" id="theme" class="settings-select">
										<option value="auto" selected?={ prefs.Theme == bongov1.Theme_THEME_AUTO || prefs.Theme == bongov1.Theme_THEME_UNSPECIFIED }>{ t(ctx, "settings.themeAuto") }</option>
										<option value="light" selected?={ prefs.Theme == bongov1.Theme_THEME_LIGHT }>{ t(ctx, "settings.themeLight") }</option>
										<option value="dark" selected?={ prefs.Theme == bongov1.Theme_THEME_DARK }>{ t(ctx, "settings.themeDark") }</option>
									</select>
								</div>
								<div class="settings-row">
									<div class="settings-row-label">
										<div class="settings-row-title">{ t(ctx, "settings.layout") }</div>
									</div>
									<select name="layout_mode" id="layout_mode" class="settings-select">
										<option value="list" selected?={ prefs.LayoutMode == bongov1.LayoutMode_LAYOUT_LIST || prefs.LayoutMode == bongov1.LayoutMode_LAYOUT_UNSPECIFIED }>{ t(ctx, "settings.layoutList") }</option>
										<option value="two-pane" selected?={ prefs.LayoutMode == bongov1.LayoutMode_LAYOUT_TWO_PANE }>{ t(ctx, "settings.layoutTwoPane") }</option>
										<option value="three-pane" selected?={ prefs.LayoutMode == bongov1.LayoutMode_LAYOUT_THREE_PANE }>{ t(ctx, "settings.layoutThreePane") }</option>
									</select>
								</div>
								<div class="settings-row">
									<div class="settings-row-label">
										<div class="settings-row-title">{ t(ctx, "settings.density") }</div>
									</div>
									<select name="density" id="density" class="settings-select">
										<option value="compact" selected?={ prefs.Density == bongov1.DisplayDensity_DENSITY_COMPACT }>{ t(ctx, "settings.densityCompact") }</option>
										<option value="comfortable" selected?={ prefs.Density == bongov1.DisplayDensity_DENSITY_COMFORTABLE || prefs.Density == bongov1.DisplayDensity_DENSITY_UNSPECIFIED }>{ t(ctx, "settings.densityComfortable") }</option>
										<option value="spacious" selected?={ prefs.Density == bongov1.DisplayDensity_DENSITY_SPACIOUS }>{ t(ctx, "settings.densitySpacious") }</option>
									</select>
								</div>
							</div>
						</div>
						<!-- Display -->
						<div class="settings-section" x-show="activeTab === 1">
							<h2 class="settings-section-title">{ t(ctx, "settings.display") }</h2>
							<p class="settings-section-desc">How messages are displayed.</p>
							<div class="settings-card">
								<div class="settings-row">
									<div class="settings-row-label">
										<div class="settings-row-title">{ t(ctx, "settings.messagesPerPage") }</div>
									</div>
									<select name="messages_per_page" id="messages_per_page" class="settings-select">
										<option value="10" selected?={ prefs.MessagesPerPage == 10 }>10</option>
										<option value="25" selected?={ prefs.MessagesPerPage == 25 || prefs.MessagesPerPage == 0 }>25</option>
										<option value="50" selected?={ prefs.MessagesPerPage == 50 }>50</option>
										<option value="100" selected?={ prefs.MessagesPerPage == 100 }>100</option>
									</select>
								</div>
								<div class="settings-row">
									<div class="settings-row-label">
										<div class="settings-row-title">{ t(ctx, "settings.infiniteScroll") }</div>
										<div class="settings-row-desc">Load more messages as you scroll down.</div>
									</div>
									<label class="toggle">
										<input type="checkbox" name="infinite_scroll" value="1" checked?={ prefs.InfiniteScroll }/>
										<span class="toggle-slider"></span>
									</label>
								</div>
							</div>
						</div>
						<!-- Composition -->
						<div class="settings-section" x-show="activeTab === 2">
							<h2 class="settings-section-title">{ t(ctx, "settings.composition") }</h2>
							<p class="settings-section-desc">Compose and reply preferences.</p>
							<div class="settings-card">
								<div class="settings-row">
									<div class="settings-row-label">
										<div class="settings-row-title">{ t(ctx, "settings.defaultReply") }</div>
									</div>
									<select name="default_reply" id="default_reply" class="settings-select">
										<option value="sender" selected?={ prefs.DefaultReply == bongov1.DefaultReplyMode_REPLY_MODE_SENDER || prefs.DefaultReply == bongov1.DefaultReplyMode_REPLY_MODE_UNSPECIFIED }>{ t(ctx, "settings.replySender") }</option>
										<option value="all" selected?={ prefs.DefaultReply == bongov1.DefaultReplyMode_REPLY_MODE_ALL }>{ t(ctx, "settings.replyAll") }</option>
									</select>
								</div>
								<div class="settings-row">
									<div class="settings-row-label">
										<div class="settings-row-title">{ t(ctx, "settings.signature") }</div>
									</div>
									<textarea name="signature" id="signature" rows="4" class="settings-input" style="width:100%">{ prefs.Signature }</textarea>
								</div>
							</div>
						</div>
						<!-- Localization -->
						<div class="settings-section" x-show="activeTab === 3">
							<h2 class="settings-section-title">{ t(ctx, "settings.localization") }</h2>
							<p class="settings-section-desc">Language and timezone.</p>
							<div class="settings-card">
								<div class="settings-row">
									<div class="settings-row-label">
										<div class="settings-row-title">{ t(ctx, "settings.language") }</div>
									</div>
									<select name="locale" id="locale" class="settings-select">
										<option value="en" selected?={ prefs.Locale == "en" || prefs.Locale == "" }>{ t(ctx, "settings.langEn") }</option>
										<option value="fr" selected?={ prefs.Locale == "fr" }>{ t(ctx, "settings.langFr") }</option>
										<option value="de" selected?={ prefs.Locale == "de" }>{ t(ctx, "settings.langDe") }</option>
										<option value="es" selected?={ prefs.Locale == "es" }>{ t(ctx, "settings.langEs") }</option>
									</select>
								</div>
								<div class="settings-row">
									<div class="settings-row-label">
										<div class="settings-row-title">{ t(ctx, "settings.timezone") }</div>
									</div>
									<select name="timezone" id="timezone" class="settings-select">
										@timezoneOptions(prefs.Timezone)
									</select>
								</div>
							</div>
						</div>
						<div class="settings-save">
							<button type="submit" class="btn-save">{ t(ctx, "settings.save") }</button>
							<a href="/mail/INBOX" class="btn-cancel">{ t(ctx, "settings.cancel") }</a>
						</div>
					</form>
				</div>
			</div>
		</main>
	}
}

templ timezoneOptions(selected string) {
	for _, tz := range commonTimezones() {
		<option value={ tz } selected?={ tz == selected }>{ tz }</option>
	}
}

func commonTimezones() []string {
	return []string{
		"UTC",
		"America/New_York",
		"America/Chicago",
		"America/Denver",
		"America/Los_Angeles",
		"America/Sao_Paulo",
		"Europe/London",
		"Europe/Paris",
		"Europe/Berlin",
		"Europe/Amsterdam",
		"Europe/Moscow",
		"Asia/Tokyo",
		"Asia/Shanghai",
		"Asia/Kolkata",
		"Asia/Singapore",
		"Australia/Sydney",
		"Pacific/Auckland",
	}
}
