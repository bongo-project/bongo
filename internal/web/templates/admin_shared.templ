package templates

import "fmt"

// AdminSharedForm is the create form for a shared inbox. There is no password:
// the account cannot sign in. Members are optional here and can be changed on
// the account's page.
templ AdminSharedForm(domains []DomainInfo, email string) {
	@AdminLayout(t(ctx, "admin.createShared"), email, "users") {
		<div class="admin-scroll">
			<h1 class="admin-title">{ t(ctx, "admin.createShared") }</h1>
			<div class="form-card">
				<form method="post" action="/admin/users">
					<input type="hidden" name="kind" value="shared"/>
					if len(domains) > 0 {
						<div class="admin-inline-form">
							<div class="u-flex-1">
								<label for="shr_username" class="admin-inline-label">{ t(ctx, "admin.username") }</label>
								<input type="text" name="username" id="shr_username" required pattern="[^@]+" class="form-input u-m0"/>
							</div>
							<div class="u-flex-1">
								<label for="shr_domain" class="admin-inline-label">{ t(ctx, "admin.domain") }</label>
								<select name="domain" id="shr_domain" required class="form-select u-m0">
									for _, domain := range domains {
										<option value={ domain.Name }>{ domain.Name }</option>
									}
								</select>
							</div>
						</div>
					} else {
						<label for="shr_email">{ t(ctx, "auth.email") }</label>
						<input type="email" name="email" id="shr_email" class="form-input" required/>
					}
					<label for="shr_name" class="form-label">{ t(ctx, "common.name") }</label>
					<input type="text" name="display_name" id="shr_name" class="form-input" required maxlength="100"/>
					<label for="shr_members" class="form-label">{ t(ctx, "admin.sharedMembersField") }</label>
					<textarea name="members" id="shr_members" class="form-input" rows="4"></textarea>
					<p class="u-text-muted u-font-082">{ t(ctx, "admin.sharedMembersFormHelp") }</p>
					<p class="u-text-muted u-font-082">{ t(ctx, "admin.sharedNoLogin") }</p>
					<div class="u-flex u-gap-05 u-mt-1">
						<button type="submit" class="btn-primary">{ t(ctx, "common.create") }</button>
						<a href="/admin/users" class="btn-outline">{ t(ctx, "common.cancel") }</a>
					</div>
				</form>
			</div>
		</div>
	}
}

// adminSharedMembers is the members card on the detail page of a shared inbox.
templ adminSharedMembers(user *AdminUserInfo) {
	<div class="form-card">
		<h3>{ t(ctx, "admin.sharedMembers") }</h3>
		<p class="u-text-muted u-font-082">{ t(ctx, "admin.sharedMembersHelp") }</p>
		if len(user.Members) > 0 {
			<div class="table-scroll u-mb-1">
				<table class="admin-table data-table" aria-label={ t(ctx, "admin.sharedMembers") }>
					<thead>
						<tr>
							<th scope="col">{ t(ctx, "admin.addressLabel") }</th>
							<th scope="col" class="u-width-100px">{ t(ctx, "common.actions") }</th>
						</tr>
					</thead>
					<tbody>
						for _, m := range user.Members {
							<tr>
								<td>
									if m.Live {
										<code class="u-font-088">{ m.Label }</code>
										if m.Group {
											<span class="badge badge-user">{ t(ctx, "admin.sharedMemberGroup") }</span>
										}
									} else {
										<span class="u-text-muted">{ t(ctx, "admin.sharedMemberGone") }</span>
									}
								</td>
								<td>
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%s/members/remove", user.UserID)) }>
										<input type="hidden" name="principal" value={ m.Principal }/>
										<button type="submit" class="btn-flush">{ t(ctx, "common.remove") }</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			<p class="u-text-muted u-font-082">{ t(ctx, "admin.sharedNoMembers") }</p>
		}
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%s/members", user.UserID)) } class="admin-inline-form">
			<input type="email" name="address" class="form-input" required aria-label={ t(ctx, "admin.sharedAddMember") }/>
			<button type="submit" class="btn-primary">{ t(ctx, "admin.sharedAddMember") }</button>
		</form>
	</div>
}
