package templates

import "fmt"
import "strings"

// RuleInfo is the template data for a filter rule.
type RuleInfo struct {
	ID               string
	Name             string
	Priority         int
	Enabled          bool
	StopProcessing   bool
	Conditions       []ConditionInfo
	Action           ActionInfo
	ConditionSummary string
	ActionSummary    string
}

// ConditionInfo is the template data for a rule condition.
type ConditionInfo struct {
	Field    string
	Operator string
	Value    string
}

// ActionInfo is the template data for a rule action.
type ActionInfo struct {
	Type   string
	Target string
	Tags   []string
}

// MailSample is a summary of a matched message for rule testing.
type MailSample struct {
	Subject string
	From    string
	Date    string
}

templ RulesListPage(rules []RuleInfo, email string, flash string) {
	@LayoutWithContent("Filter Rules", email) {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="nav-list">
					<li><a href="/settings" hx-get="/settings" hx-target="#main-content" hx-push-url="true">{ t(ctx, "nav.settings") }</a></li>
					<li><a href="/mail/INBOX" hx-get="/mail/INBOX" hx-target="#main-content" hx-push-url="true">{ t(ctx, "nav.backToMail") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container" style="max-width:960px">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<div class="page-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem">
				<h2 style="margin:0">{ t(ctx, "nav.filterRules") }</h2>
				<a href="/settings/rules/new" class="btn-outline">{ t(ctx, "rules.newRule") }</a>
			</div>
			if len(rules) == 0 {
				<p class="secondary-text">{ t(ctx, "rules.noRulesYet") }</p>
			} else {
				<div id="rules-list" x-data="{ reorder(evt) { const ids = Array.from(evt.target.closest('tbody').querySelectorAll('tr[data-id]')).map(r => r.dataset.id); fetch('/settings/rules/reorder', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(ids)}); } }">
					<table role="grid">
						<thead>
							<tr>
								<th style="width:2rem"></th>
								<th style="width:2rem">#</th>
								<th>{ t(ctx, "rules.colName") }</th>
								<th>{ t(ctx, "rules.colConditions") }</th>
								<th>{ t(ctx, "rules.colAction") }</th>
								<th style="width:4rem">{ t(ctx, "rules.colActive") }</th>
								<th style="width:10rem">{ t(ctx, "rules.colActions") }</th>
							</tr>
						</thead>
						<tbody id="sortable-rules">
							for i, rule := range rules {
								<tr data-id={ rule.ID }>
									<td class="drag-handle" style="cursor:grab;display:flex;align-items:center;gap:0.15rem">
										&#x2801;
										<span style="display:flex;flex-direction:column">
											if i > 0 {
												<button type="button" class="rule-move-btn" aria-label="Move rule up" data-move-dir="up" data-move-id={ rule.ID }>&#x25B2;</button>
											}
											if i < len(rules)-1 {
												<button type="button" class="rule-move-btn" aria-label="Move rule down" data-move-dir="down" data-move-id={ rule.ID }>&#x25BC;</button>
											}
										</span>
									</td>
									<td>{ fmt.Sprintf("%d", rule.Priority) }</td>
									<td><a href={ templ.SafeURL("/settings/rules/" + rule.ID) } class="rule-name">{ rule.Name }</a></td>
									<td><div class="rule-summary">{ rule.ConditionSummary }</div></td>
									<td><div class="rule-summary">{ rule.ActionSummary }</div></td>
									<td>
										if rule.Enabled {
											<span class="rule-status active">&#10003; { t(ctx, "common.yes") }</span>
										} else {
											<span class="rule-status inactive">&#9675; { t(ctx, "common.no") }</span>
										}
									</td>
									<td>
										<div class="rule-actions">
											<a href={ templ.SafeURL("/settings/rules/" + rule.ID) } class="btn-outline btn-sm" style="padding:0.25rem 0.5rem; font-size:0.8rem">{ t(ctx, "common.edit") }</a>
											<button
												hx-post={ "/settings/rules/" + rule.ID + "/test" }
												hx-target={ "#test-results-" + rule.ID }
												hx-swap="innerHTML"
												class="btn-outline btn-sm" style="padding:0.25rem 0.5rem; font-size:0.8rem">{ t(ctx, "rules.test") }</button>
											<button
												hx-delete={ "/settings/rules/" + rule.ID }
												hx-target="closest tr"
												hx-swap="outerHTML"
												hx-confirm="Delete this rule?"
												class="btn-flush btn-sm" style="padding:0.25rem 0.5rem; font-size:0.8rem">Del</button>
										</div>
									</td>
								</tr>
								<tr id={ "test-results-" + rule.ID } style="display:none"></tr>
							}
						</tbody>
					</table>
				</div>
				<script>
					if (typeof Sortable !== 'undefined') {
						document.addEventListener('DOMContentLoaded', function() {
							var el = document.getElementById('sortable-rules');
							if (el) {
								Sortable.create(el, {
									handle: '.drag-handle',
									animation: 150,
									onEnd: function(evt) {
										var ids = Array.from(el.querySelectorAll('tr[data-id]')).map(function(r) { return r.dataset.id; });
										fetch('/settings/rules/reorder', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(ids)});
									}
								});
							}
						});
					}
				</script>
			}
				</div>
			</div>
		</main>
	}
}

templ RuleFormPage(rule RuleInfo, mailboxes []string, isNew bool, email string, flash string) {
	@LayoutWithContent(ruleFormTitle(isNew), email) {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="nav-list">
					<li><a href="/settings/rules" hx-get="/settings/rules" hx-target="#main-content" hx-push-url="true">{ t(ctx, "rules.backToRules") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container" style="max-width:720px">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<h2>
				if isNew {
					{ t(ctx, "rules.newRule") }
				} else {
					{ t(ctx, "rules.editRule") }
				}
			</h2>
			<form method="post" action={ ruleFormAction(rule.ID, isNew) }
				x-data={ conditionsAlpineData(rule.Conditions) }>
				<div class="form-section">
					<div class="form-section-title">{ t(ctx, "rules.ruleSettings") }</div>
					<div class="form-group">
						<label for="name">{ t(ctx, "rules.colName") }</label>
						<input type="text" name="name" id="name" class="form-input" value={ rule.Name } placeholder="e.g. Newsletters to Updates" required/>
					</div>
					<div class="checkbox-wrapper">
						<input type="checkbox" name="enabled" id="rule_enabled" checked?={ rule.Enabled }/>
						<label for="rule_enabled">{ t(ctx, "common.enabled") }</label>
					</div>
					<div class="checkbox-wrapper">
						<input type="checkbox" name="stop_processing" id="rule_stop" checked?={ rule.StopProcessing }/>
						<label for="rule_stop">Stop processing further rules when matched</label>
					</div>
				</div>
				<div class="form-section">
					<div class="form-section-title">{ t(ctx, "rules.conditionsHeader") }</div>
					<template x-for="(cond, i) in conditions" :key="i">
						<div class="condition-row">
							<select :name="'cond_field'" x-model="cond.field" @change="updateOperators(cond)">
								<option value="from">{ t(ctx, "rules.fieldFrom") }</option>
								<option value="to">{ t(ctx, "rules.fieldTo") }</option>
								<option value="cc">{ t(ctx, "rules.fieldCc") }</option>
								<option value="subject">{ t(ctx, "rules.fieldSubject") }</option>
								<option value="body">{ t(ctx, "rules.fieldBody") }</option>
								<option value="has_attachment">{ t(ctx, "rules.fieldHasAttachment") }</option>
								<option value="size">{ t(ctx, "rules.fieldSize") }</option>
							</select>
							<select :name="'cond_operator'" x-model="cond.operator">
								<template x-if="cond.field === 'size'">
									<template x-for="op in ['greater_than', 'less_than']">
										<option :value="op" x-text="op.replace('_', ' ')" :selected="cond.operator === op"></option>
									</template>
								</template>
								<template x-if="cond.field === 'has_attachment'">
									<option value="equals" selected>{ t(ctx, "rules.opEquals") }</option>
								</template>
								<template x-if="cond.field !== 'size' && cond.field !== 'has_attachment'">
									<template x-for="op in ['contains', 'not_contains', 'equals', 'matches']">
										<option :value="op" x-text="op.replace('_', ' ')" :selected="cond.operator === op"></option>
									</template>
								</template>
							</select>
							<template x-if="cond.field === 'has_attachment'">
								<select :name="'cond_value'" x-model="cond.value">
									<option value="true">{ t(ctx, "common.yes") }</option>
									<option value="false">{ t(ctx, "common.no") }</option>
								</select>
							</template>
							<template x-if="cond.field !== 'has_attachment'">
								<input type="text" :name="'cond_value'" x-model="cond.value" placeholder="Value"/>
							</template>
							<button type="button" @click="conditions.splice(i, 1)" class="condition-row-remove" x-show="conditions.length > 1">&#10005;</button>
						</div>
					</template>
					<button type="button" @click="conditions.push({field:'from', operator:'contains', value:''})" class="btn-outline btn-sm">{ t(ctx, "rules.addCondition") }</button>
				</div>
				<div class="form-section">
					<div class="form-section-title">{ t(ctx, "rules.actionHeader") }</div>
					<div x-data={ actionTypeData(rule.Action.Type, rule.Action.Tags) }>
						<div class="form-row two-col">
							<div class="form-group">
								<label for="action_type">{ t(ctx, "rules.whenMatched") }</label>
								<select name="action_type" id="action_type" x-model="actionType">
									<option value="move">Move to folder</option>
									<option value="copy">Copy to folder</option>
									<option value="flag">Flag as starred</option>
									<option value="mark_read">Mark as read</option>
									<option value="delete">Delete (move to Trash)</option>
									<option value="tag">Add tag</option>
								</select>
							</div>
							<div class="form-group" x-show="actionType === 'move' || actionType === 'copy'">
								<label for="action_target">{ t(ctx, "rules.targetFolder") }</label>
								<select name="action_target" id="action_target">
									for _, mb := range mailboxes {
										<option value={ mb } selected?={ mb == rule.Action.Target }>{ mb }</option>
									}
								</select>
							</div>
						</div>
						<div class="form-group" x-show="actionType === 'tag'">
							<label>Tags to apply</label>
							<div class="tag-input-wrapper" style="border:1px solid var(--form-element-border-color,#ccc); border-radius:4px; padding:0.35rem 0.5rem; display:flex; flex-wrap:wrap; gap:0.35rem; align-items:center; background:var(--form-element-background-color,#fff); min-height:2.5rem">
								<template x-for="(tag, idx) in selectedTags" :key="idx">
									<span style="display:inline-flex; align-items:center; gap:0.25rem; background:var(--primary,#1095c1); color:#fff; border-radius:3px; padding:0.15rem 0.4rem; font-size:0.85rem">
										<span x-text="tag"></span>
										<input type="hidden" name="action_tag" :value="tag"/>
										<button type="button" @click="selectedTags.splice(idx,1)" style="background:none; border:none; color:inherit; cursor:pointer; padding:0; font-size:0.9rem; line-height:1" aria-label="Remove tag">&#10005;</button>
									</span>
								</template>
								<input
									type="text"
									x-model="tagInput"
									@keydown.enter.prevent="addTag()"
									@keydown.comma.prevent="addTag()"
									placeholder="Type a tag and press Enter"
									style="border:none; outline:none; flex:1; min-width:10rem; background:transparent; font-size:inherit; padding:0.1rem 0"
									aria-label="Tag name input"
								/>
							</div>
							<p style="font-size:0.8rem; color:var(--muted-color,#888); margin-top:0.25rem">Press Enter or comma to add each tag. You can add multiple tags.</p>
						</div>
					</div>
				</div>
				<div class="form-actions">
					<button type="submit" class="btn-primary">
						if isNew {
							{ t(ctx, "rules.createRule") }
						} else {
							{ t(ctx, "rules.saveChanges") }
						}
					</button>
					<a href="/settings/rules" class="form-link">{ t(ctx, "common.cancel") }</a>
				</div>
			</form>
				</div>
			</div>
		</main>
	}
}

templ RuleTestResults(matches int, total int, samples []MailSample) {
	<td colspan="7" style="background:var(--bg-subtle); padding:0.75rem">
		<p style="margin-bottom:0.5rem">
			<strong>{ fmt.Sprintf("Matched %d of %d", matches, total) }</strong> recent messages
		</p>
		if len(samples) > 0 {
			<ul style="margin:0; padding-left:1.5rem; font-size:0.85rem">
				for _, s := range samples {
					<li>{ s.Date } - { s.From } - { s.Subject }</li>
				}
			</ul>
		}
	</td>
	<script>
		// Show the test results row.
		var row = document.currentScript.closest('tr');
		if (row) row.style.display = '';
	</script>
}

func ruleFormTitle(isNew bool) string {
	if isNew {
		return "New Filter Rule"
	}
	return "Edit Filter Rule"
}

func ruleFormAction(id string, isNew bool) templ.SafeURL {
	if isNew {
		return "/settings/rules"
	}
	return templ.SafeURL("/settings/rules/" + id)
}

func conditionsAlpineData(conditions []ConditionInfo) string {
	if len(conditions) == 0 {
		return "{ conditions: [{field:'from', operator:'contains', value:''}], updateOperators(c) { if(c.field==='size'){c.operator='greater_than'} else if(c.field==='has_attachment'){c.operator='equals';c.value='true'} else if(['greater_than','less_than'].includes(c.operator)){c.operator='contains'} } }"
	}
	var parts []string
	for _, c := range conditions {
		parts = append(parts, fmt.Sprintf("{field:'%s', operator:'%s', value:'%s'}",
			strings.ReplaceAll(c.Field, "'", "\\'"),
			strings.ReplaceAll(c.Operator, "'", "\\'"),
			strings.ReplaceAll(c.Value, "'", "\\'"),
		))
	}
	return fmt.Sprintf("{ conditions: [%s], updateOperators(c) { if(c.field==='size'){c.operator='greater_than'} else if(c.field==='has_attachment'){c.operator='equals';c.value='true'} else if(['greater_than','less_than'].includes(c.operator)){c.operator='contains'} } }", strings.Join(parts, ", "))
}

func actionTypeData(actionType string, tags []string) string {
	if actionType == "" {
		actionType = "move"
	}
	// Build JS array literal of existing tags.
	var tagParts []string
	for _, tag := range tags {
		tagParts = append(tagParts, fmt.Sprintf("'%s'", strings.ReplaceAll(tag, "'", "\\'")))
	}
	tagsJS := "[" + strings.Join(tagParts, ",") + "]"
	return fmt.Sprintf("{ actionType: '%s', selectedTags: %s, tagInput: '', addTag() { const v = this.tagInput.trim().replace(/,$/, ''); if (v && !this.selectedTags.includes(v)) { this.selectedTags.push(v); } this.tagInput = ''; } }", actionType, tagsJS)
}
