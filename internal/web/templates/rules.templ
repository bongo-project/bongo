package templates

import "fmt"
import "strings"

// RuleInfo is the template data for a filter rule.
type RuleInfo struct {
	ID               string
	Name             string
	Priority         int
	Enabled          bool
	StopProcessing   bool
	Conditions       []ConditionInfo
	Action           ActionInfo
	ConditionSummary string
	ActionSummary    string
}

// ConditionInfo is the template data for a rule condition.
type ConditionInfo struct {
	Field    string
	Operator string
	Value    string
}

// ActionInfo is the template data for a rule action.
type ActionInfo struct {
	Type   string
	Target string
}

// MailSample is a summary of a matched message for rule testing.
type MailSample struct {
	Subject string
	From    string
	Date    string
}

templ RulesListPage(rules []RuleInfo, email string, flash string) {
	@LayoutWithContent("Filter Rules", email) {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="mailbox-list">
					<li><a href="/settings" hx-get="/settings" hx-target="#main-content" hx-push-url="true">Back to Settings</a></li>
					<li><a href="/mail/INBOX" hx-get="/mail/INBOX" hx-target="#main-content" hx-push-url="true">Back to Mail</a></li>
				</ul>
			</nav>
		</aside>
		<main class="main-content" id="main-content">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem">
				<h2 style="margin:0">Filter Rules</h2>
				<a href="/settings/rules/new" role="button" class="outline">New Rule</a>
			</div>
			if len(rules) == 0 {
				<p class="secondary-text">No filter rules yet. Create one to automatically organize incoming mail.</p>
			} else {
				<div id="rules-list" x-data="{ reorder(evt) { const ids = Array.from(evt.target.closest('tbody').querySelectorAll('tr[data-id]')).map(r => r.dataset.id); fetch('/settings/rules/reorder', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(ids)}); } }">
					<table role="grid">
						<thead>
							<tr>
								<th style="width:2rem"></th>
								<th style="width:2rem">#</th>
								<th>Name</th>
								<th>Conditions</th>
								<th>Action</th>
								<th style="width:4rem">Active</th>
								<th style="width:10rem">Actions</th>
							</tr>
						</thead>
						<tbody id="sortable-rules">
							for i, rule := range rules {
								<tr data-id={ rule.ID }>
									<td class="drag-handle" style="cursor:grab;display:flex;align-items:center;gap:0.15rem">
										&#x2801;
										<span style="display:flex;flex-direction:column">
											if i > 0 {
												<button type="button" class="rule-move-btn" aria-label="Move rule up" data-move-dir="up" data-move-id={ rule.ID }>&#x25B2;</button>
											}
											if i < len(rules)-1 {
												<button type="button" class="rule-move-btn" aria-label="Move rule down" data-move-dir="down" data-move-id={ rule.ID }>&#x25BC;</button>
											}
										</span>
									</td>
									<td>{ fmt.Sprintf("%d", rule.Priority) }</td>
									<td><a href={ templ.SafeURL("/settings/rules/" + rule.ID) }>{ rule.Name }</a></td>
									<td><small>{ rule.ConditionSummary }</small></td>
									<td><small>{ rule.ActionSummary }</small></td>
									<td>
										if rule.Enabled {
											<span style="color:var(--pico-color-green-500)">Yes</span>
										} else {
											<span class="secondary-text">No</span>
										}
									</td>
									<td>
										<div style="display:flex; gap:0.25rem">
											<a href={ templ.SafeURL("/settings/rules/" + rule.ID) } role="button" class="outline secondary" style="padding:0.25rem 0.5rem; font-size:0.8rem">Edit</a>
											<button
												hx-post={ "/settings/rules/" + rule.ID + "/test" }
												hx-target={ "#test-results-" + rule.ID }
												hx-swap="innerHTML"
												class="outline" style="padding:0.25rem 0.5rem; font-size:0.8rem">Test</button>
											<button
												hx-delete={ "/settings/rules/" + rule.ID }
												hx-target="closest tr"
												hx-swap="outerHTML"
												hx-confirm="Delete this rule?"
												class="outline secondary" style="padding:0.25rem 0.5rem; font-size:0.8rem; color:var(--pico-color-red-500)">Del</button>
										</div>
									</td>
								</tr>
								<tr id={ "test-results-" + rule.ID } style="display:none"></tr>
							}
						</tbody>
					</table>
				</div>
				<script>
					if (typeof Sortable !== 'undefined') {
						document.addEventListener('DOMContentLoaded', function() {
							var el = document.getElementById('sortable-rules');
							if (el) {
								Sortable.create(el, {
									handle: '.drag-handle',
									animation: 150,
									onEnd: function(evt) {
										var ids = Array.from(el.querySelectorAll('tr[data-id]')).map(function(r) { return r.dataset.id; });
										fetch('/settings/rules/reorder', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(ids)});
									}
								});
							}
						});
					}
				</script>
			}
		</main>
	}
}

templ RuleFormPage(rule RuleInfo, mailboxes []string, isNew bool, email string, flash string) {
	@LayoutWithContent(ruleFormTitle(isNew), email) {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="mailbox-list">
					<li><a href="/settings/rules" hx-get="/settings/rules" hx-target="#main-content" hx-push-url="true">Back to Rules</a></li>
				</ul>
			</nav>
		</aside>
		<main class="main-content" id="main-content">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<h2>
				if isNew {
					New Filter Rule
				} else {
					Edit Filter Rule
				}
			</h2>
			<form method="post" action={ ruleFormAction(rule.ID, isNew) }
				x-data={ conditionsAlpineData(rule.Conditions) }>
				<fieldset>
					<legend>Rule Settings</legend>
					<label for="name">Name</label>
					<input type="text" name="name" id="name" value={ rule.Name } placeholder="e.g. Newsletters to Updates" required/>
					<label>
						<input type="checkbox" name="enabled" checked?={ rule.Enabled }/>
						Enabled
					</label>
					<label>
						<input type="checkbox" name="stop_processing" checked?={ rule.StopProcessing }/>
						Stop processing further rules when matched
					</label>
				</fieldset>
				<fieldset>
					<legend>Conditions (all must match)</legend>
					<template x-for="(cond, i) in conditions" :key="i">
						<div style="display:grid; grid-template-columns:1fr 1fr 2fr auto; gap:0.5rem; margin-bottom:0.5rem; align-items:start">
							<select :name="'cond_field'" x-model="cond.field" @change="updateOperators(cond)">
								<option value="from">From</option>
								<option value="to">To</option>
								<option value="cc">CC</option>
								<option value="subject">Subject</option>
								<option value="body">Body</option>
								<option value="has_attachment">Has Attachment</option>
								<option value="size">Size (bytes)</option>
							</select>
							<select :name="'cond_operator'" x-model="cond.operator">
								<template x-if="cond.field === 'size'">
									<template x-for="op in ['greater_than', 'less_than']">
										<option :value="op" x-text="op.replace('_', ' ')" :selected="cond.operator === op"></option>
									</template>
								</template>
								<template x-if="cond.field === 'has_attachment'">
									<option value="equals" selected>equals</option>
								</template>
								<template x-if="cond.field !== 'size' && cond.field !== 'has_attachment'">
									<template x-for="op in ['contains', 'not_contains', 'equals', 'matches']">
										<option :value="op" x-text="op.replace('_', ' ')" :selected="cond.operator === op"></option>
									</template>
								</template>
							</select>
							<template x-if="cond.field === 'has_attachment'">
								<select :name="'cond_value'" x-model="cond.value">
									<option value="true">Yes</option>
									<option value="false">No</option>
								</select>
							</template>
							<template x-if="cond.field !== 'has_attachment'">
								<input type="text" :name="'cond_value'" x-model="cond.value" placeholder="Value"/>
							</template>
							<button type="button" @click="conditions.splice(i, 1)" class="outline secondary" style="padding:0.5rem" x-show="conditions.length > 1">X</button>
						</div>
					</template>
					<button type="button" @click="conditions.push({field:'from', operator:'contains', value:''})" class="outline" style="font-size:0.85rem">+ Add Condition</button>
				</fieldset>
				<fieldset>
					<legend>Action</legend>
					<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem">
						<div>
							<label for="action_type">When matched</label>
							<select name="action_type" id="action_type" x-data={ actionTypeData(rule.Action.Type) } x-model="actionType">
								<option value="move">Move to folder</option>
								<option value="copy">Copy to folder</option>
								<option value="flag">Flag as starred</option>
								<option value="mark_read">Mark as read</option>
								<option value="delete">Delete (move to Trash)</option>
							</select>
						</div>
						<div>
							<label for="action_target">Target folder</label>
							<select name="action_target" id="action_target">
								for _, mb := range mailboxes {
									<option value={ mb } selected?={ mb == rule.Action.Target }>{ mb }</option>
								}
							</select>
						</div>
					</div>
				</fieldset>
				<div>
					<button type="submit">
						if isNew {
							Create Rule
						} else {
							Save Changes
						}
					</button>
					<a href="/settings/rules" role="button" class="outline secondary">Cancel</a>
				</div>
			</form>
		</main>
	}
}

templ RuleTestResults(matches int, total int, samples []MailSample) {
	<td colspan="7" style="background:var(--pico-card-background-color); padding:0.75rem">
		<p style="margin-bottom:0.5rem">
			<strong>{ fmt.Sprintf("Matched %d of %d", matches, total) }</strong> recent messages
		</p>
		if len(samples) > 0 {
			<ul style="margin:0; padding-left:1.5rem; font-size:0.85rem">
				for _, s := range samples {
					<li>{ s.Date } - { s.From } - { s.Subject }</li>
				}
			</ul>
		}
	</td>
	<script>
		// Show the test results row.
		var row = document.currentScript.closest('tr');
		if (row) row.style.display = '';
	</script>
}

func ruleFormTitle(isNew bool) string {
	if isNew {
		return "New Filter Rule"
	}
	return "Edit Filter Rule"
}

func ruleFormAction(id string, isNew bool) templ.SafeURL {
	if isNew {
		return "/settings/rules"
	}
	return templ.SafeURL("/settings/rules/" + id)
}

func conditionsAlpineData(conditions []ConditionInfo) string {
	if len(conditions) == 0 {
		return "{ conditions: [{field:'from', operator:'contains', value:''}], updateOperators(c) { if(c.field==='size'){c.operator='greater_than'} else if(c.field==='has_attachment'){c.operator='equals';c.value='true'} else if(['greater_than','less_than'].includes(c.operator)){c.operator='contains'} } }"
	}
	var parts []string
	for _, c := range conditions {
		parts = append(parts, fmt.Sprintf("{field:'%s', operator:'%s', value:'%s'}",
			strings.ReplaceAll(c.Field, "'", "\\'"),
			strings.ReplaceAll(c.Operator, "'", "\\'"),
			strings.ReplaceAll(c.Value, "'", "\\'"),
		))
	}
	return fmt.Sprintf("{ conditions: [%s], updateOperators(c) { if(c.field==='size'){c.operator='greater_than'} else if(c.field==='has_attachment'){c.operator='equals';c.value='true'} else if(['greater_than','less_than'].includes(c.operator)){c.operator='contains'} } }", strings.Join(parts, ", "))
}

func actionTypeData(actionType string) string {
	if actionType == "" {
		actionType = "move"
	}
	return fmt.Sprintf("{ actionType: '%s' }", actionType)
}

