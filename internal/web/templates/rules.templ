package templates

import (
	"context"
	"encoding/json"
)
import "fmt"
import "slices"

// RuleInfo is the template data for a filter rule.
type RuleInfo struct {
	ID               string
	Name             string
	Priority         int
	Enabled          bool
	StopProcessing   bool
	Match            string // "all" (also empty) or "any"
	Conditions       []ConditionInfo
	Actions          []ActionInfo
}

// ConditionInfo is the template data for a rule condition.
type ConditionInfo struct {
	Field    string
	Operator string
	Value    string
}

// ActionInfo is the template data for a rule action.
type ActionInfo struct {
	Type   string
	Target string
	Tags   []string
}

// MailSample is a summary of a matched message for rule testing.
type MailSample struct {
	Subject string
	From    string
	Date    string
}

templ RulesListPage(rules []RuleInfo, email string, flash string) {
	@LayoutWithContent(t(ctx, "nav.filterRules"), email) {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="nav-list">
					<li><a href="/settings">{ t(ctx, "nav.settings") }</a></li>
					<li><a href="/mail/INBOX">{ t(ctx, "nav.backToMail") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container u-max-w-960">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<div class="page-head">
				<h1>{ t(ctx, "nav.filterRules") }</h1>
				<div class="spacer"></div>
				<a href="/settings/rules/new" class="btn-outline">{ t(ctx, "rules.newRule") }</a>
			</div>
			<p class="rules-intro">{ t(ctx, "rules.intro") }</p>
			if len(rules) == 0 {
				<p class="secondary-text">{ t(ctx, "rules.noRulesYet") }</p>
			} else {
				<div class="card rules-card">
					<div class="card-head">
						<h3>{ t(ctx, "rules.cardTitle") }</h3>
						<div class="spacer"></div>
						<small class="muted">{ t(ctx, "rules.dragHint") }</small>
					</div>
					<div class="card-body flush" id="rules-list">
						<div id="sortable-rules">
							for i, rule := range rules {
								<div class="rule-item" data-id={ rule.ID }>
									<div class="rule">
										<span class="drag-handle rule-handle u-cursor-grab">
											<span aria-hidden="true">&#x2630;</span>
											<span class="rule-move">
												if i > 0 {
													<button type="button" class="rule-move-btn" aria-label={ t(ctx, "rules.moveUp") } data-move-dir="up" data-move-id={ rule.ID }>&#x25B2;</button>
												}
												if i < len(rules)-1 {
													<button type="button" class="rule-move-btn" aria-label={ t(ctx, "rules.moveDown") } data-move-dir="down" data-move-id={ rule.ID }>&#x25BC;</button>
												}
											</span>
										</span>
										if rule.Enabled {
											<span class="rule-state on" title={ t(ctx, "common.enabled") }><span class="sr-only">{ t(ctx, "common.enabled") }</span></span>
										} else {
											<span class="rule-state" title={ t(ctx, "rules.stateDisabled") }><span class="sr-only">{ t(ctx, "rules.stateDisabled") }</span></span>
										}
										<a href={ templ.SafeURL("/settings/rules/" + rule.ID) } class="rule-name">{ rule.Name }</a>
										<span class="rule-when">{ t(ctx, "rules.when") }</span>
										for j, cond := range rule.Conditions {
											if j > 0 {
												if rule.Match == "any" {
													<span class="rule-and">{ t(ctx, "rules.or") }</span>
												} else {
													<span class="rule-and">{ t(ctx, "rules.and") }</span>
												}
											}
											<span class="condition">{ ruleConditionText(ctx, cond) }</span>
										}
										<span class="arrow" aria-hidden="true">&rarr;</span>
										<span class="action">{ ruleActionsText(ctx, rule.Actions) }</span>
										<span class="spacer"></span>
										<div class="rule-more" x-data="messageMore" x-on:keydown.escape="close()" x-on:click.outside="dismiss()">
											<button
												type="button"
												class="msg-act"
												x-ref="button"
												aria-haspopup="true"
												aria-expanded="false"
												x-bind:aria-expanded="open"
												aria-controls={ "rule-menu-" + rule.ID }
												aria-label={ t(ctx, "rules.more") }
												title={ t(ctx, "rules.more") }
												x-on:click="toggle()"
											>
												@Icon("more", "")
											</button>
											<div class="msg-more-menu rule-more-menu" id={ "rule-menu-" + rule.ID } hidden x-bind:hidden="!open" x-cloak="">
												<a href={ templ.SafeURL("/settings/rules/" + rule.ID) } class="msg-more-item">{ t(ctx, "common.edit") }</a>
												<button
													type="button"
													hx-post={ "/settings/rules/" + rule.ID + "/test" }
													hx-target={ "#test-results-" + rule.ID }
													hx-swap="outerHTML"
													x-on:click="dismiss()"
													class="msg-more-item">{ t(ctx, "rules.test") }</button>
												<button
													type="button"
													hx-delete={ "/settings/rules/" + rule.ID }
													hx-target="closest .rule-item"
													hx-swap="outerHTML"
													hx-confirm={ t(ctx, "rules.deleteConfirm") }
													class="msg-more-item rule-delete">{ t(ctx, "common.delete") }</button>
											</div>
										</div>
									</div>
									<div id={ "test-results-" + rule.ID } hidden></div>
								</div>
							}
						</div>
					</div>
				</div>
			}
				</div>
			</div>
		</main>
	}
}

templ RuleFormPage(rule RuleInfo, mailboxes []string, isNew bool, email string, flash string) {
	@LayoutWithContent(ruleFormTitle(ctx, isNew), email) {
		<aside class="sidebar" id="sidebar">
			<nav>
				<ul class="nav-list">
					<li><a href="/settings/rules">{ t(ctx, "rules.backToRules") }</a></li>
				</ul>
			</nav>
		</aside>
		<main class="content" id="main-content">
			<div class="settings-scroll">
				<div class="settings-container u-max-w-720">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<h2>
				if isNew {
					{ t(ctx, "rules.newRule") }
				} else {
					{ t(ctx, "rules.editRule") }
				}
			</h2>
			<form method="post" action={ ruleFormAction(rule.ID, isNew) }
				x-data="ruleConditions"
				data-conditions={ ruleConditionsJSON(rule.Conditions) }
				data-op-labels={ ruleOperatorLabelsJSON(ctx) }>
				<div class="form-section">
					<div class="form-section-title">{ t(ctx, "rules.ruleSettings") }</div>
					<div class="form-group">
						<label for="name">{ t(ctx, "rules.colName") }</label>
						<input type="text" name="name" id="name" class="form-input" value={ rule.Name } placeholder={ t(ctx, "rules.namePlaceholder") } required/>
					</div>
					<div class="checkbox-wrapper">
						<input type="checkbox" name="enabled" id="rule_enabled" checked?={ rule.Enabled }/>
						<label for="rule_enabled">{ t(ctx, "common.enabled") }</label>
					</div>
					<div class="checkbox-wrapper">
						<input type="checkbox" name="stop_processing" id="rule_stop" checked?={ rule.StopProcessing }/>
						<label for="rule_stop">{ t(ctx, "rules.stopProcessing") }</label>
					</div>
				</div>
				<div class="form-section">
					<div class="form-section-title">{ t(ctx, "rules.conditionsHeader") }</div>
					<div class="form-group">
						<label for="rule_match">{ t(ctx, "rules.matchLabel") }</label>
						<select name="match" id="rule_match">
							<option value="all" selected?={ rule.Match != "any" }>{ t(ctx, "rules.matchAll") }</option>
							<option value="any" selected?={ rule.Match == "any" }>{ t(ctx, "rules.matchAny") }</option>
						</select>
					</div>
					<template x-for="(cond, i) in conditions" :key="i">
						<div class="condition-row">
							<select name="cond_field" x-bind:value="cond.field" @change="setField(i, $event.target.value)">
								<option value="from">{ t(ctx, "rules.fieldFrom") }</option>
								<option value="to">{ t(ctx, "rules.fieldTo") }</option>
								<option value="cc">{ t(ctx, "rules.fieldCc") }</option>
								<option value="subject">{ t(ctx, "rules.fieldSubject") }</option>
								<option value="body">{ t(ctx, "rules.fieldBody") }</option>
								<option value="has_attachment">{ t(ctx, "rules.fieldHasAttachment") }</option>
								<option value="size">{ t(ctx, "rules.fieldSize") }</option>
							</select>
							<select name="cond_operator" @change="setOperator(i, $event.target.value)">
								<template x-for="op in operatorsFor(cond)" :key="op">
									<option :value="op" x-text="operatorLabel(op)" :selected="cond.operator === op"></option>
								</template>
							</select>
							<template x-if="isAttachment(cond)">
								<select name="cond_value" @change="setValue(i, $event.target.value)">
									<option value="true" x-bind:selected="cond.value !== 'false'">{ t(ctx, "common.yes") }</option>
									<option value="false" x-bind:selected="cond.value === 'false'">{ t(ctx, "common.no") }</option>
								</select>
							</template>
							<template x-if="!isAttachment(cond)">
								<input type="text" name="cond_value" x-bind:value="cond.value" @input="setValue(i, $event.target.value)" placeholder={ t(ctx, "rules.valuePlaceholder") }/>
							</template>
							<button type="button" @click="removeCondition(i)" class="condition-row-remove" x-bind:hidden="!canRemove()" aria-label={ t(ctx, "rules.removeCondition") }>&#10005;</button>
						</div>
					</template>
					<button type="button" @click="addCondition()" class="btn-outline btn-sm">{ t(ctx, "rules.addCondition") }</button>
				</div>
				<div class="form-section" x-data="ruleActions" data-actions={ ruleActionsJSON(rule.Actions) } data-default-folder={ ruleDefaultFolder(mailboxes) }>
					<div class="form-section-title">{ t(ctx, "rules.actionHeader") }</div>
					<p class="tag-input-help">{ t(ctx, "rules.actionsHelp") }</p>
					<template x-for="(action, i) in actions" :key="i">
						<div class="action-row">
							<div class="form-row two-col">
								<div class="form-group">
									<select name="action_type" aria-label={ t(ctx, "rules.whenMatched") } x-bind:value="action.type" @change="setType(i, $event.target.value)">
										<option value="move">{ t(ctx, "rules.actionMove") }</option>
										<option value="copy">{ t(ctx, "rules.actionCopy") }</option>
										<option value="forward">{ t(ctx, "rules.actionForward") }</option>
										<option value="flag">{ t(ctx, "rules.actionFlag") }</option>
										<option value="mark_read">{ t(ctx, "rules.actionMarkRead") }</option>
										<option value="delete">{ t(ctx, "rules.actionDelete") }</option>
										<option value="tag">{ t(ctx, "rules.actionTag") }</option>
									</select>
								</div>
								<div class="form-group" x-bind:hidden="!needsFolder(action)">
									<select name="action_target" aria-label={ t(ctx, "rules.targetFolder") } x-bind:value="action.target" @change="setTarget(i, $event.target.value)">
										for _, mb := range ruleFolderOptions(mailboxes, rule.Actions) {
											<option value={ mb }>{ mb }</option>
										}
									</select>
								</div>
							</div>
							<div class="form-group" x-bind:hidden="!isForward(action)">
								<input type="email" name="action_target_forward" class="form-input" aria-label={ t(ctx, "rules.forwardToEmail") } placeholder="user@example.com" x-bind:value="action.forward" @input="setForward(i, $event.target.value)"/>
							</div>
							<div class="form-group" x-bind:hidden="!isTag(action)">
								<label>{ t(ctx, "rules.tagsToApply") }</label>
								<div class="tag-input-wrapper">
									<template x-for="(tag, idx) in action.tags" :key="idx">
										<span class="tag-pill">
											<span x-text="tag"></span>
											<button type="button" class="tag-pill-remove" @click="removeTag(i, idx)" aria-label={ t(ctx, "rules.removeTag") }>&#10005;</button>
										</span>
									</template>
									<input
										type="text"
										x-bind:value="action.tagInput"
										@input="setTagInput(i, $event.target.value)"
										@keydown.enter.prevent="addTag(i)"
										@keydown.comma.prevent="addTag(i)"
										placeholder={ t(ctx, "rules.tagInputPlaceholder") }
										class="tag-input-field"
										aria-label={ t(ctx, "tag.namePlaceholder") }
									/>
								</div>
								<p class="tag-input-help">{ t(ctx, "rules.tagInputHelp") }</p>
							</div>
							<input type="hidden" name="action_tags" x-bind:value="tagsValue(action)"/>
							<button type="button" @click="removeAction(i)" class="condition-row-remove" x-bind:hidden="!canRemove()" aria-label={ t(ctx, "rules.removeAction") }>&#10005;</button>
						</div>
					</template>
					<button type="button" @click="addAction()" class="btn-outline btn-sm" x-bind:hidden="!canAdd()">{ t(ctx, "rules.addAction") }</button>
				</div>
				<div class="form-actions">
					<button type="submit" class="btn-primary">
						if isNew {
							{ t(ctx, "rules.createRule") }
						} else {
							{ t(ctx, "rules.saveChanges") }
						}
					</button>
					<a href="/settings/rules" class="form-link">{ t(ctx, "common.cancel") }</a>
				</div>
			</form>
				</div>
			</div>
		</main>
	}
}

templ RuleTestResults(ruleID string, matches int, total int, samples []MailSample, actions []ActionInfo) {
	<div id={ "test-results-" + ruleID } class="rule-results">
		<p class="u-mb-05">
			<strong>{ fmt.Sprintf("%d / %d", matches, total) }</strong> { t(ctx, "rules.recentMessagesMatched") }
		</p>
		<p class="u-mb-05">
			<strong>{ t(ctx, "rules.actionsLabel") }:</strong> { ruleActionsText(ctx, actions) }
		</p>
		if len(samples) > 0 {
			<ul class="u-m0 u-font-085 u-pl-15">
				for _, s := range samples {
					<li>{ s.Date } - { s.From } - { s.Subject }</li>
				}
			</ul>
		}
	</div>
}

func ruleFormTitle(ctx context.Context, isNew bool) string {
	if isNew {
		return t(ctx, "rules.newRule")
	}
	return t(ctx, "rules.editRule")
}

func ruleFormAction(id string, isNew bool) templ.SafeURL {
	if isNew {
		return "/settings/rules"
	}
	return templ.SafeURL("/settings/rules/" + id)
}

// ruleConditionsJSON is the editor's initial condition list for the
// ruleConditions component, as JSON in a data attribute: the Alpine CSP build
// cannot evaluate an inline object with methods.
func ruleConditionsJSON(conditions []ConditionInfo) string {
	type cond struct {
		Field    string `json:"field"`
		Operator string `json:"operator"`
		Value    string `json:"value"`
	}
	out := []cond{}
	for _, c := range conditions {
		out = append(out, cond{c.Field, c.Operator, c.Value})
	}
	if len(out) == 0 {
		out = append(out, cond{"from", "contains", ""})
	}
	b, _ := json.Marshal(out)
	return string(b)
}

// ruleOperatorLabelsJSON maps each condition operator to its translated label.
func ruleOperatorLabelsJSON(ctx context.Context) string {
	b, _ := json.Marshal(map[string]string{
		"contains":     t(ctx, "rules.opContains"),
		"not_contains": t(ctx, "rules.opNotContains"),
		"equals":       t(ctx, "rules.opEquals"),
		"matches":      t(ctx, "rules.opMatches"),
		"greater_than": t(ctx, "rules.opGreaterThan"),
		"less_than":    t(ctx, "rules.opLessThan"),
	})
	return string(b)
}

// ruleActionRow is one action row of the editor, as JSON for the ruleActions
// component. The forward address and the folder are kept apart so that
// switching the type does not leave a stale folder in the email field.
type ruleActionRow struct {
	Type     string   `json:"type"`
	Target   string   `json:"target"`
	Forward  string   `json:"forward"`
	Tags     []string `json:"tags"`
	TagInput string   `json:"tagInput"`
}

// ruleActionsJSON is the editor's initial action list, as JSON in a data
// attribute (the Alpine CSP build cannot evaluate an inline object). A rule
// without actions gets one empty move row.
func ruleActionsJSON(actions []ActionInfo) string {
	out := []ruleActionRow{}
	for _, a := range actions {
		row := ruleActionRow{Type: ruleActionType(a.Type), Tags: a.Tags}
		if row.Tags == nil {
			row.Tags = []string{}
		}
		switch row.Type {
		case "forward":
			row.Forward = a.Target
		case "move", "copy":
			row.Target = a.Target
		}
		out = append(out, row)
	}
	if len(out) == 0 {
		out = append(out, ruleActionRow{Type: "move", Tags: []string{}})
	}
	b, _ := json.Marshal(out)
	return string(b)
}

func ruleActionType(actionType string) string {
	if actionType == "" {
		return "move"
	}
	return actionType
}

// ruleDefaultFolder is the folder a new move or copy row starts on: INBOX when
// the user has it, otherwise their first folder.
func ruleDefaultFolder(mailboxes []string) string {
	if slices.Contains(mailboxes, "INBOX") || len(mailboxes) == 0 {
		return "INBOX"
	}
	return mailboxes[0]
}

// ruleFolderOptions is the folder list for the editor's selects, plus any
// folder a saved move or copy action names that no longer exists. Without it
// the select would have no matching option, post nothing and shift the
// positional action fields.
func ruleFolderOptions(mailboxes []string, actions []ActionInfo) []string {
	out := slices.Clone(mailboxes)
	for _, a := range actions {
		if (a.Type == "move" || a.Type == "copy") && a.Target != "" && !slices.Contains(out, a.Target) {
			out = append(out, a.Target)
		}
	}
	return out
}
