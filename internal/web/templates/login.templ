package templates

templ LoginPage(errMsg string) {
	@LoginLayout("Login") {
		<div class="login-container">
			<h1 style="text-align:center">Bongo</h1>
			<form method="post" action="/login">
				if errMsg != "" {
					@FlashMessage(errMsg, "error")
				}
				<label for="email">{ t(ctx, "auth.email") }</label>
				<input type="email" id="email" name="email" placeholder="admin@localhost" required autofocus/>
				<label for="password">{ t(ctx, "auth.password") }</label>
				<input type="password" id="password" name="password" required/>
				<label>
					<input type="checkbox" name="remember" value="1"/>
					{ t(ctx, "auth.rememberMe") }
				</label>
				<button type="submit">{ t(ctx, "auth.login") }</button>
			</form>
		</div>
	}
}

templ TwoFactorPage(errMsg string, recoveryWarning string) {
	@LoginLayout("Two-Factor Authentication") {
		<div class="login-container">
			<h1 style="text-align:center">Bongo</h1>
			<h2 style="text-align:center;font-size:1.1rem;margin-bottom:1.5rem">{ t(ctx, "auth.twoFactorAuth") }</h2>
			<form method="post" action="/login/2fa">
				if errMsg != "" {
					@FlashMessage(errMsg, "error")
				}
				if recoveryWarning != "" {
					@FlashMessage(recoveryWarning, "warning")
				}
				<label for="code">{ t(ctx, "auth.authCode") }</label>
				<input
					type="text"
					id="code"
					name="code"
					placeholder="000000"
					required
					autofocus
					autocomplete="one-time-code"
					inputmode="numeric"
					maxlength="9"
					aria-label={ t(ctx, "auth.twoFactorCode") }
				/>
				<small style="display:block;margin-bottom:1rem;color:var(--pico-muted-color)">
					{ t(ctx, "auth.enterCodeHint") }
				</small>
				<button type="submit">{ t(ctx, "auth.verify") }</button>
			</form>
			<p style="text-align:center;margin-top:1rem">
				<a href="/login">{ t(ctx, "auth.backToLogin") }</a>
			</p>
		</div>
	}
}
