package templates

// authBrand is the drum glyph and wordmark at the top of every public card.
templ authBrand() {
	<div class="brand-mark">
		@Icon("logo", "brand-glyph")
		<span class="wordmark">Bongo<em>&middot;</em>mail</span>
	</div>
}

templ LoginPage(errMsg string) {
	@LoginLayout(t(ctx, "auth.login")) {
		<div class="login-wrap">
			<div class="login-card">
				@authBrand()
				<h1>{ t(ctx, "auth.welcomeBack") }</h1>
				<p class="sub">{ t(ctx, "auth.signInSubtitle") }</p>
				if errMsg != "" {
					@FlashMessage(errMsg, "error")
				}
				<form method="post" action="/login" aria-label={ t(ctx, "auth.signIn") }>
					<div class="login-field">
						<label for="email">{ t(ctx, "auth.email") }</label>
						<input type="email" id="email" name="email" placeholder="admin@localhost" required autofocus autocomplete="email"/>
					</div>
					<div class="login-field">
						<label for="password">{ t(ctx, "auth.password") }</label>
						<input type="password" id="password" name="password" required autocomplete="current-password"/>
					</div>
					<label class="login-remember">
						<input type="checkbox" name="remember" value="1"/>
						{ t(ctx, "auth.rememberMe") }
					</label>
					<button type="submit" class="login-submit">{ t(ctx, "auth.signIn") }</button>
				</form>
				<p class="login-foot">{ t(ctx, "auth.tagline") }</p>
			</div>
		</div>
	}
}

templ TwoFactorPage(errMsg string, recoveryWarning string) {
	@LoginLayout(t(ctx, "auth.twoFactorAuth")) {
		<div class="login-wrap">
			<div class="login-card">
				@authBrand()
				<h1>{ t(ctx, "auth.twoFactorAuth") }</h1>
				<p class="sub">{ t(ctx, "auth.enterCodeHint") }</p>
				if errMsg != "" {
					@FlashMessage(errMsg, "error")
				}
				if recoveryWarning != "" {
					@FlashMessage(recoveryWarning, "warning")
				}
				<form method="post" action="/login/2fa" aria-label={ t(ctx, "auth.twoFactorAuth") }>
					<div class="login-field">
						<label for="code">{ t(ctx, "auth.authCode") }</label>
						<input
							type="text"
							id="code"
							name="code"
							class="code-input"
							placeholder="000000"
							required
							autofocus
							autocomplete="one-time-code"
							inputmode="numeric"
							maxlength="9"
							aria-label={ t(ctx, "auth.twoFactorCode") }
						/>
					</div>
					<button type="submit" class="login-submit">{ t(ctx, "auth.verify") }</button>
				</form>
				<a href="/login" class="back-link">{ t(ctx, "auth.backToLogin") }</a>
			</div>
		</div>
	}
}
