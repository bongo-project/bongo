package templates

import (
	"fmt"
	"time"
)

// MessageSummary holds data for a single row in the message list.
type MessageSummary struct {
	UID         uint32
	From        string
	Subject     string
	Date        time.Time
	Size        int64
	Seen        bool
	Flagged     bool
	ThreadCount int
	ThreadRoot  string
	MailGUID    string
	SpamScore   float32
}

// ThreadChild holds data for a child message in a thread expansion.
type ThreadChild struct {
	GUID    string
	From    string
	Subject string
	Date    time.Time
	Depth   int
	Mailbox string
}

templ MailboxPage(mailbox string, mailboxes []MailboxInfo, messages []MessageSummary, page, totalPages int, email string, flash string) {
	@LayoutWithContent(mailbox, email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@Sidebar(mailboxes, mailbox)
		</aside>
		<main class="main-content" id="main-content" data-selected-mailbox={ mailbox }>
			@MailboxContent(mailbox, messages, page, totalPages, flash)
		</main>
	}
}

templ MailboxContent(mailbox string, messages []MessageSummary, page, totalPages int, flash string) {
	if flash != "" {
		@FlashMessage(flash, "success")
	}
	<div class="toolbar">
		<a href="/compose" role="button" class="outline">Compose</a>
		<button class="outline secondary" hx-get={ "/mail/" + mailbox } hx-target="#main-content">Refresh</button>
		<span class="toolbar-spacer"></span>
		<span class="layout-toggle">
			<button type="button" class="outline secondary layout-btn" x-on:click="setLayout('list')" x-bind:class="{'active': layoutMode === 'list'}" title="List view">&#9776;</button>
			<button type="button" class="outline secondary layout-btn" x-on:click="setLayout('two-pane')" x-bind:class="{'active': layoutMode === 'two-pane'}" title="Two-pane view">&#9707;</button>
			<button type="button" class="outline secondary layout-btn" x-on:click="setLayout('three-pane')" x-bind:class="{'active': layoutMode === 'three-pane'}" title="Three-pane view">&#9701;</button>
		</span>
	</div>
	<div class="mail-layout" x-bind:class="'layout-' + layoutMode">
	<div class="message-list-pane">
	<div id="message-list" x-data="{ ...messageSelect(), ...swipeHandler() }">
		<div class="bulk-toolbar" x-show="count > 0" x-cloak="">
			<span x-text="count + ' selected'"></span>
			<button type="button" class="outline secondary" x-on:click="selectAll()">Select All</button>
			<button type="button" class="outline secondary" x-on:click="deselectAll()">Deselect</button>
			<button type="button" class="outline" x-on:click={ "bulkAction('" + mailbox + "', 'mark-read')" }>Mark Read</button>
			<button type="button" class="outline" x-on:click={ "bulkAction('" + mailbox + "', 'mark-unread')" }>Mark Unread</button>
			<button type="button" class="outline" x-on:click={ "bulkAction('" + mailbox + "', 'flag')" }>Flag</button>
			<button type="button" class="outline" x-on:click={ "bulkAction('" + mailbox + "', 'unflag')" }>Unflag</button>
			if mailbox == "Junk" {
				<button type="button" class="outline" x-on:click={ "bulkAction('" + mailbox + "', 'not-spam')" }>Not Spam</button>
			} else {
				<button type="button" class="outline" x-on:click={ "bulkAction('" + mailbox + "', 'spam')" }>Mark Spam</button>
			}
			<button type="button" class="outline contrast" x-on:click={ "bulkAction('" + mailbox + "', 'delete')" }>Delete</button>
		</div>
		if len(messages) == 0 {
			@EmptyState("No messages", "This mailbox is empty.")
		} else {
			<table class="message-list">
				<thead>
					<tr>
						<th style="width:2rem"><input type="checkbox" x-on:change="$event.target.checked ? selectAll() : deselectAll()"/></th>
						<th style="width:30px"></th>
						<th>From</th>
						<th>Subject</th>
						<th>Date</th>
					</tr>
				</thead>
				<tbody>
					for _, msg := range messages {
						<tr
							if !msg.Seen {
								class="unread"
							}
							data-uid={ fmt.Sprint(msg.UID) }
							x-on:contextmenu={ fmt.Sprintf("$dispatch('ctx-menu', {event: $event, uid: %d, mailbox: '%s'})", msg.UID, mailbox) }
							x-on:touchstart={ fmt.Sprintf("start($event, %d)", msg.UID) }
							x-on:touchmove="move($event)"
							x-on:touchend={ fmt.Sprintf("end($event, %d, '%s')", msg.UID, mailbox) }
						>
							<td>
								<input
									type="checkbox"
									x-on:change={ fmt.Sprintf("toggle(%d, $event)", msg.UID) }
									x-bind:checked={ fmt.Sprintf("isSelected(%d)", msg.UID) }
								/>
							</td>
							<td>
								<span
									class={ "flag-star", templ.KV("flagged", msg.Flagged) }
									hx-post={ fmt.Sprintf("/mail/%s/%d/flags", mailbox, msg.UID) }
									hx-vals={ flagToggleVals(msg.Flagged) }
									hx-swap="outerHTML"
								>
									if msg.Flagged {
										&#9733;
									} else {
										&#9734;
									}
								</span>
							</td>
							<td class="from-col">
								<a
									href={ templ.SafeURL(fmt.Sprintf("/mail/%s/%d", mailbox, msg.UID)) }
									data-message-link="true"
									data-pane-url={ fmt.Sprintf("/mail/%s/%d?pane=1", mailbox, msg.UID) }
									hx-get={ fmt.Sprintf("/mail/%s/%d", mailbox, msg.UID) }
									hx-target="#main-content"
									hx-push-url="true"
									style="text-decoration:none;color:inherit"
								>
									{ msg.From }
								</a>
							</td>
							<td class="subject-col">
								<a
									href={ templ.SafeURL(fmt.Sprintf("/mail/%s/%d", mailbox, msg.UID)) }
									data-message-link="true"
									data-pane-url={ fmt.Sprintf("/mail/%s/%d?pane=1", mailbox, msg.UID) }
									hx-get={ fmt.Sprintf("/mail/%s/%d", mailbox, msg.UID) }
									hx-target="#main-content"
									hx-push-url="true"
									style="text-decoration:none;color:inherit"
								>
									{ msg.Subject }
								</a>
								if mailbox == "Junk" && msg.SpamScore > 0 {
									<span class="spam-badge" title="Spam score">{ fmt.Sprintf("%.0f%%", msg.SpamScore*100) }</span>
								}
								if msg.ThreadCount > 1 {
									<span
										class="thread-badge"
										hx-get={ fmt.Sprintf("/mail/%s/thread/%s", mailbox, msg.ThreadRoot) }
										hx-target={ fmt.Sprintf("#thread-%s", msg.ThreadRoot) }
										hx-swap="innerHTML"
									>
										{ fmt.Sprint(msg.ThreadCount) }
									</span>
								}
							</td>
							<td>{ formatDate(msg.Date) }</td>
						</tr>
						if msg.ThreadCount > 1 {
							<tr>
								<td colspan="4" style="padding:0">
									<div id={ fmt.Sprintf("thread-%s", msg.ThreadRoot) } class="thread-children"></div>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
			@Pagination(page, totalPages, "/mail/"+mailbox)
		}
	</div>
	</div>
	<div class="reading-pane" id="reading-pane" x-show="layoutMode !== 'list'">
		<div class="empty-state">
			<p>Select a message to read</p>
		</div>
	</div>
	</div>
	@ContextMenu()
}

templ ThreadChildren(children []ThreadChild, mailbox string) {
	<table class="message-list" style="margin:0">
		<tbody>
			for _, child := range children {
				<tr class="thread-child" style={ fmt.Sprintf("padding-left:%drem", child.Depth*2) }>
					<td style="width:30px"></td>
					<td class="from-col">
						<span class="thread-reply-arrow">&#8627;</span>
						{ child.From }
					</td>
					<td class="subject-col">{ child.Subject }</td>
					<td>{ formatDate(child.Date) }</td>
				</tr>
			}
		</tbody>
	</table>
}

func formatDate(t time.Time) string {
	now := time.Now()
	if t.Year() == now.Year() && t.YearDay() == now.YearDay() {
		return t.Format("3:04 PM")
	}
	if t.Year() == now.Year() {
		return t.Format("Jan 2")
	}
	return t.Format("Jan 2, 2006")
}

func flagToggleVals(flagged bool) string {
	if flagged {
		return `{"action":"remove","flag":"flagged"}`
	}
	return `{"action":"add","flag":"flagged"}`
}
