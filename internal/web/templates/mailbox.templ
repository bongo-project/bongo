package templates

import (
	"fmt"
	"time"
)

// tagColourPalette maps a ColourIndex (0-15) to a CSS hex colour.
// Must stay in sync with the 16-colour palette in store/tag_store.go.
var tagColourPalette = [16]string{
	"#517faf", // 0 blue
	"#5aad4a", // 1 green
	"#ee8d03", // 2 orange
	"#8a6fb8", // 3 purple
	"#e15e50", // 4 red
	"#d4a60a", // 5 gold
	"#729fcf", // 6 sky blue
	"#3bada8", // 7 teal
	"#e06c9f", // 8 pink
	"#70b8a8", // 9 sage
	"#c07d40", // 10 brown
	"#8c9e6b", // 11 olive
	"#a07ab8", // 12 lavender
	"#4e9a8f", // 13 cyan
	"#c96464", // 14 rose
	"#7a8fa8", // 15 slate
}

// TagDotColour returns a CSS colour string for the given palette index.
// Falls back to the first palette colour if index is out of range.
func TagDotColour(index int32) string {
	if index < 0 || int(index) >= len(tagColourPalette) {
		return tagColourPalette[0]
	}
	return tagColourPalette[index]
}

// TagDot holds the display data for a single tag dot in the message list.
type TagDot struct {
	Name        string
	ColourIndex int32
}

// MessageSummary holds data for a single row in the message list.
type MessageSummary struct {
	UID          uint32
	From         string
	Subject      string
	Date         time.Time
	Size         int64
	Seen         bool
	Flagged      bool
	ThreadCount  int
	ThreadRoot   string
	MailGUID     string
	SpamScore    float32
	Tags         []TagDot // up to 3 visible dots
	OverflowTags int      // number of tags beyond the first 3
	// Preview is plain text; templ escapes it, never render it as HTML.
	Preview        string
	HasAttachments bool
}

// ThreadChild holds data for a child message in a thread expansion.
type ThreadChild struct {
	GUID    string
	From    string
	Subject string
	Date    time.Time
	Depth   int
	Mailbox string
}

templ MailboxPage(mailbox string, mailboxes []MailboxInfo, tags []SidebarTagInfo, messages []MessageSummary, page, totalPages int, email string, flash string, infiniteScroll bool) {
	@LayoutWithContent(mailbox, email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@Sidebar(mailboxes, tags, mailbox)
		</aside>
		<main class="content" id="main-content" data-selected-mailbox={ mailbox }>
			@MailboxContent(mailbox, messages, page, totalPages, flash, infiniteScroll)
		</main>
	}
}

templ MailboxContent(mailbox string, messages []MessageSummary, page, totalPages int, flash string, infiniteScroll bool) {
	if flash != "" {
		@FlashMessage(flash, "success")
	}
	<div x-data="messageList">
		<div class="toolbar" role="toolbar" aria-label={ t(ctx, "mail.messageActions") }>
			<input type="checkbox" class="tool-check" title={ t(ctx, "mail.selectAll") } aria-label={ t(ctx, "mail.selectAllMessages") } x-on:change="$event.target.checked ? selectAll() : deselectAll()"/>
			<a href="/compose" class="tool-btn">{ t(ctx, "mail.compose") }</a>
			<button class="tool-btn" hx-get={ mailboxURL(mailbox) } hx-target="#main-content">{ t(ctx, "mail.refresh") }</button>
			if mailbox == "Trash" {
				<button
					type="button"
					class="tool-btn danger"
					hx-post="/mail/Trash/empty-trash"
					hx-confirm={ t(ctx, "mail.emptyTrashConfirm") }
				>
					{ t(ctx, "mail.emptyTrash") }
				</button>
			}
			<div
				x-data={ fmt.Sprintf("spamScan('%s')", mailbox) }
				class="u-inline-flex u-items-center u-gap-05"
			>
				<button
					type="button"
					class="tool-btn"
					x-on:click="startScan()"
					x-bind:disabled="scanning"
					title={ t(ctx, "mailbox.scanTitle") }
				>
					<span x-bind:hidden="scanning">{ t(ctx, "mailbox.scanForSpam") }</span>
					<span x-bind:hidden="!scanning" x-cloak>{ t(ctx, "mailbox.scanning") }</span>
				</button>
				<span x-bind:hidden="!scanning" x-cloak class="u-font-082 u-text-muted">
					<span x-text="progress.total > 0 ? progress.scanned + '/' + progress.total : ''"></span>
					<span x-bind:hidden="progress.spam <= 0" x-text="' (' + progress.spam + ' spam)'"></span>
				</span>
				<span
					x-bind:hidden="!(result !== null && !scanning)"
					x-cloak
					x-text="result"
					class="u-font-082 u-text-muted"
				></span>
			</div>
			<div class="tool-spacer"></div>
			<span class="page-info">
				if page > 0 && totalPages > 0 {
					{ fmt.Sprintf("%d of %d", page, totalPages) }
				}
			</span>
			<span class="layout-toggle">
				<button type="button" class="layout-opt" x-on:click="setLayout('list')" x-bind:class="{'active': layoutMode === 'list'}" title={ t(ctx, "mail.listView") }>&#9776;</button>
				<button type="button" class="layout-opt" x-on:click="setLayout('two-pane')" x-bind:class="{'active': layoutMode === 'two-pane'}" title={ t(ctx, "mail.twoPaneView") }>&#9707;</button>
				<button type="button" class="layout-opt" x-on:click="setLayout('three-pane')" x-bind:class="{'active': layoutMode === 'three-pane'}" title={ t(ctx, "mail.threePaneView") }>&#9701;</button>
			</span>
		</div>
		<div class="mail-layout" x-bind:class="'layout-' + layoutMode">
		<div class="message-list-pane">
		<div id="message-list">
			<div class="bulk-toolbar" x-bind:hidden="count === 0" x-cloak="" aria-live="polite">
				<span x-text="count + ' selected'"></span>
				<button type="button" class="tool-btn" x-on:click="selectAll()">{ t(ctx, "mail.selectAll") }</button>
				<button type="button" class="tool-btn" x-on:click="deselectAll()">{ t(ctx, "mail.deselect") }</button>
				<button type="button" class="tool-btn" x-on:click={ "bulkAction('" + mailbox + "', 'mark-read')" }>{ t(ctx, "mail.markRead") }</button>
				<button type="button" class="tool-btn" x-on:click={ "bulkAction('" + mailbox + "', 'mark-unread')" }>{ t(ctx, "mail.markUnread") }</button>
				<button type="button" class="tool-btn" x-on:click={ "bulkAction('" + mailbox + "', 'flag')" }>{ t(ctx, "mail.flag") }</button>
				<button type="button" class="tool-btn" x-on:click={ "bulkAction('" + mailbox + "', 'unflag')" }>{ t(ctx, "mail.unflag") }</button>
				if mailbox == "Junk" {
					<button type="button" class="tool-btn" x-on:click={ "bulkAction('" + mailbox + "', 'not-spam')" }>{ t(ctx, "mail.notSpam") }</button>
				} else {
					<button type="button" class="tool-btn" x-on:click={ "bulkAction('" + mailbox + "', 'spam')" }>{ t(ctx, "mail.markAsSpam") }</button>
				}
				<div class="bulk-tag-dropdown u-relative u-inline-block" x-data="{ open: false, tagInput: '' }">
				<button type="button" class="tool-btn" x-on:click="open = !open" aria-haspopup="true" x-bind:aria-expanded="open">{ t(ctx, "tag.applyMenu") }</button>
				<div
					x-bind:hidden="!open"
					x-on:click.away="open = false"
					x-on:keydown.escape.window="open = false"
					x-cloak=""
					class="bulk-tag-panel"
					role="dialog"
					aria-label={ t(ctx, "mail.tagSelectedMessages") }
				>
					<input
						type="text"
						class="bulk-tag-input"
						x-model="tagInput"
						placeholder={ t(ctx, "tag.namePlaceholder") }
						aria-label={ t(ctx, "tag.namePlaceholder") }
						x-on:keydown.enter.prevent={ fmt.Sprintf("bulkTagAction('%s', 'add', tagInput); open = false; tagInput = ''", mailbox) }
					/>
					<div class="bulk-tag-actions">
						<button
							type="button"
							class="tool-btn"
							x-on:click={ fmt.Sprintf("bulkTagAction('%s', 'add', tagInput); open = false; tagInput = ''", mailbox) }
							x-bind:disabled="tagInput.trim() === ''"
						>{ t(ctx, "action.add") }</button>
						<button
							type="button"
							class="tool-btn"
							x-on:click={ fmt.Sprintf("bulkTagAction('%s', 'remove', tagInput); open = false; tagInput = ''", mailbox) }
							x-bind:disabled="tagInput.trim() === ''"
						>{ t(ctx, "action.remove") }</button>
					</div>
				</div>
			</div>
			<button type="button" class="tool-btn danger" x-on:click={ "bulkAction('" + mailbox + "', 'delete')" }>{ t(ctx, "mail.delete") }</button>
			</div>
			if len(messages) == 0 {
				@EmptyState(t(ctx, "mail.noMessages"), t(ctx, "mail.emptyMailbox"))
			} else {
				<div class="msg-list" role="list" aria-label={ t(ctx, "mail.messages") }>
					@MessageRows(messages, mailbox)
					if infiniteScroll && page < totalPages {
						@InfiniteScrollSentinel(mailbox, page+1)
					}
				</div>
				if !infiniteScroll {
					@Pagination(page, totalPages, mailboxURL(mailbox))
				}
			}
		</div>
		</div>
		<div class="reading-pane" id="reading-pane" x-bind:hidden="layoutMode === 'list'">
			<div class="empty-state">
				<p>{ t(ctx, "mail.selectToRead") }</p>
			</div>
		</div>
		</div>
	</div>
	@ContextMenu()
}

// MessageRows renders the flex-based rows for a list of messages (used by both full page and partial responses).
templ MessageRows(messages []MessageSummary, mailbox string) {
	for _, msg := range messages {
		<div
			class={ "msg-row", templ.KV("unread", !msg.Seen) }
			role="listitem"
			tabindex="0"
			data-uid={ fmt.Sprint(msg.UID) }
			x-on:contextmenu={ fmt.Sprintf("openContextMenu($event, %d, '%s')", msg.UID, mailbox) }
			x-on:touchstart={ fmt.Sprintf("start($event, %d)", msg.UID) }
			x-on:touchmove="move($event)"
			x-on:touchend={ fmt.Sprintf("end($event, %d, '%s')", msg.UID, mailbox) }
		>
			<input
				type="checkbox"
				class="msg-check"
				aria-label={ t(ctx, "mail.selectMessage") }
				x-on:change={ fmt.Sprintf("toggle(%d, $event)", msg.UID) }
				x-bind:checked={ fmt.Sprintf("isSelected(%d)", msg.UID) }
			/>
			<button
				type="button"
				class={ "msg-star", templ.KV("flagged", msg.Flagged) }
				hx-post={ fmt.Sprintf("/mail/%s/%d/flags", encMailbox(mailbox), msg.UID) }
				hx-vals={ flagToggleVals(msg.Flagged) }
				hx-swap="outerHTML"
				if msg.Flagged {
					aria-label={ t(ctx, "mail.unstarMessage") }
				} else {
					aria-label={ t(ctx, "mail.starMessage") }
				}
			>
				if msg.Flagged {
					&#9733;
				} else {
					&#9734;
				}
			</button>
			<span class="msg-from">
				@msgRowLink(mailbox, msg.UID) {
					{ msg.From }
				}
			</span>
			<span class="msg-subject">
				@msgRowLink(mailbox, msg.UID) {
					{ msg.Subject }
				}
				if mailbox == "Junk" && msg.SpamScore > 0 {
					<span class="spam-badge" title={ t(ctx, "mail.spamScore") }>{ fmt.Sprintf("%.0f%%", msg.SpamScore*100) }</span>
				}
				if msg.ThreadCount > 1 {
					<span
						class="msg-thread-count"
						hx-get={ fmt.Sprintf("/mail/%s/thread/%s", encMailbox(mailbox), msg.ThreadRoot) }
						hx-target={ fmt.Sprintf("#thread-%s", msg.ThreadRoot) }
						hx-swap="innerHTML"
					>
						{ fmt.Sprint(msg.ThreadCount) }
					</span>
				}
				if len(msg.Tags) > 0 {
					<span class="tag-dots" aria-hidden="true">
						for _, dot := range msg.Tags {
							<span class={ "tag-dot", tagPaletteBGClass(dot.ColourIndex) } title={ dot.Name }></span>
						}
						if msg.OverflowTags > 0 {
							<span class="tag-dot-overflow" title={ fmt.Sprintf("+%d more tags", msg.OverflowTags) }>+{ fmt.Sprint(msg.OverflowTags) }</span>
						}
					</span>
				}
			</span>
			<span class="msg-date">{ formatDate(msg.Date) }</span>
			<div class="msg-mobile-row2">
				{ msg.Subject }
			</div>
		</div>
		if msg.ThreadCount > 1 {
			<div id={ fmt.Sprintf("thread-%s", msg.ThreadRoot) } class="thread-children"></div>
		}
	}
}

// InfiniteScrollSentinel renders a sentinel element that triggers loading the next page when revealed.
templ InfiniteScrollSentinel(mailbox string, nextPage int) {
	<div
		class="msg-row"
		hx-get={ fmt.Sprintf("/mail/%s?page=%d&partial=1", encMailbox(mailbox), nextPage) }
		hx-trigger="revealed"
		hx-swap="outerHTML"
		hx-indicator=".load-more-spinner"
	>
		<span class="load-more-spinner htmx-indicator u-text-center u-mb-0 u-p-1rem u-w-full">
			{ t(ctx, "common.loading") }...
		</span>
	</div>
}

// MessageRowsPartial renders just the rows for use in infinite scroll partial responses.
// If there are more pages, it appends a new sentinel row.
templ MessageRowsPartial(messages []MessageSummary, mailbox string, page int, totalPages int) {
	@MessageRows(messages, mailbox)
	if page < totalPages {
		@InfiniteScrollSentinel(mailbox, page+1)
	}
}

templ ThreadChildren(children []ThreadChild, mailbox string) {
	for _, child := range children {
		<div class={ "msg-row", "thread-child", threadDepthClass(child.Depth) }>
			<span class="msg-from">
				<span class="thread-reply-arrow">&#8627;</span>
				{ child.From }
			</span>
			<span class="msg-subject">{ child.Subject }</span>
			<span class="msg-date">{ formatDate(child.Date) }</span>
		</div>
	}
}

func formatDate(t time.Time) string {
	now := time.Now()
	if t.Year() == now.Year() && t.YearDay() == now.YearDay() {
		return t.Format("3:04 PM")
	}
	if t.Year() == now.Year() {
		return t.Format("Jan 2")
	}
	return t.Format("Jan 2, 2006")
}

func tagPaletteSafeIndex(index int32) int32 {
	if index < 0 || int(index) >= len(tagColourPalette) {
		return 0
	}
	return index
}

func tagPaletteBGClass(index int32) string {
	return fmt.Sprintf("tag-palette-bg-%d", tagPaletteSafeIndex(index))
}

func threadDepthClass(depth int) string {
	if depth < 0 {
		depth = 0
	}
	if depth > 12 {
		depth = 12
	}
	return fmt.Sprintf("thread-depth-%d", depth)
}

func flagToggleVals(flagged bool) string {
	if flagged {
		return `{"action":"remove","flag":"flagged"}`
	}
	return `{"action":"add","flag":"flagged"}`
}

// msgRowLink renders a message-row link. In the Drafts mailbox it opens the
// draft in the compose editor (full-page navigation); elsewhere it opens the
// read-only message view with the HTMX pane/preview behaviour.
templ msgRowLink(mailbox string, uid uint32) {
	if mailbox == "Drafts" {
		<a
			href={ templ.SafeURL(fmt.Sprintf("/compose/draft/%s/%d", encMailbox(mailbox), uid)) }
			class="u-text-decoration-none"
		>
			{ children... }
		</a>
	} else {
		<a
			href={ templ.SafeURL(fmt.Sprintf("/mail/%s/%d", encMailbox(mailbox), uid)) }
			data-message-link="true"
			data-pane-url={ fmt.Sprintf("/mail/%s/%d?pane=1", encMailbox(mailbox), uid) }
			hx-get={ fmt.Sprintf("/mail/%s/%d", encMailbox(mailbox), uid) }
			hx-target="#main-content"
			hx-push-url="true"
			class="u-text-decoration-none"
		>
			{ children... }
		</a>
	}
}
