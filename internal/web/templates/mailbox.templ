package templates

import (
	"fmt"
	"time"
)

// MessageSummary holds data for a single row in the message list.
type MessageSummary struct {
	UID         uint32
	From        string
	Subject     string
	Date        time.Time
	Size        int64
	Seen        bool
	Flagged     bool
	ThreadCount int
	ThreadRoot  string
	MailGUID    string
	SpamScore   float32
}

// ThreadChild holds data for a child message in a thread expansion.
type ThreadChild struct {
	GUID    string
	From    string
	Subject string
	Date    time.Time
	Depth   int
	Mailbox string
}

templ MailboxPage(mailbox string, mailboxes []MailboxInfo, messages []MessageSummary, page, totalPages int, email string, flash string, infiniteScroll bool) {
	@LayoutWithContent(mailbox, email) {
		<aside class="sidebar" id="sidebar" x-bind:class="{'open': sidebarOpen}">
			@Sidebar(mailboxes, mailbox)
		</aside>
		<main class="content" id="main-content" data-selected-mailbox={ mailbox }>
			@MailboxContent(mailbox, messages, page, totalPages, flash, infiniteScroll)
		</main>
	}
}

templ MailboxContent(mailbox string, messages []MessageSummary, page, totalPages int, flash string, infiniteScroll bool) {
	if flash != "" {
		@FlashMessage(flash, "success")
	}
	<div x-data="messageList">
		<div class="toolbar" role="toolbar" aria-label="Message actions">
			<input type="checkbox" class="tool-check" title="Select all" aria-label="Select all messages" x-on:change="$event.target.checked ? selectAll() : deselectAll()"/>
			<a href="/compose" class="tool-btn">{ t(ctx, "mail.compose") }</a>
			<button class="tool-btn" hx-get={ mailboxURL(mailbox) } hx-target="#main-content">{ t(ctx, "mail.refresh") }</button>
			<div class="tool-spacer"></div>
			<span class="page-info">
				if page > 0 && totalPages > 0 {
					{ fmt.Sprintf("%d of %d", page, totalPages) }
				}
			</span>
			<span class="layout-toggle">
				<button type="button" class="layout-opt" x-on:click="setLayout('list')" x-bind:class="{'active': layoutMode === 'list'}" title="List view">&#9776;</button>
				<button type="button" class="layout-opt" x-on:click="setLayout('two-pane')" x-bind:class="{'active': layoutMode === 'two-pane'}" title="Two-pane view">&#9707;</button>
				<button type="button" class="layout-opt" x-on:click="setLayout('three-pane')" x-bind:class="{'active': layoutMode === 'three-pane'}" title="Three-pane view">&#9701;</button>
			</span>
		</div>
		<div class="mail-layout" x-bind:class="'layout-' + layoutMode">
		<div class="message-list-pane">
		<div id="message-list">
			<div class="bulk-toolbar" x-show="count > 0" x-cloak="" aria-live="polite">
				<span x-text="count + ' selected'"></span>
				<button type="button" class="tool-btn" x-on:click="selectAll()">{ t(ctx, "mail.selectAll") }</button>
				<button type="button" class="tool-btn" x-on:click="deselectAll()">{ t(ctx, "mail.deselect") }</button>
				<button type="button" class="tool-btn" x-on:click={ "bulkAction('" + mailbox + "', 'mark-read')" }>{ t(ctx, "mail.markRead") }</button>
				<button type="button" class="tool-btn" x-on:click={ "bulkAction('" + mailbox + "', 'mark-unread')" }>{ t(ctx, "mail.markUnread") }</button>
				<button type="button" class="tool-btn" x-on:click={ "bulkAction('" + mailbox + "', 'flag')" }>{ t(ctx, "mail.flag") }</button>
				<button type="button" class="tool-btn" x-on:click={ "bulkAction('" + mailbox + "', 'unflag')" }>{ t(ctx, "mail.unflag") }</button>
				if mailbox == "Junk" {
					<button type="button" class="tool-btn" x-on:click={ "bulkAction('" + mailbox + "', 'not-spam')" }>{ t(ctx, "mail.notSpam") }</button>
				} else {
					<button type="button" class="tool-btn" x-on:click={ "bulkAction('" + mailbox + "', 'spam')" }>{ t(ctx, "mail.markAsSpam") }</button>
				}
				<button type="button" class="tool-btn danger" x-on:click={ "bulkAction('" + mailbox + "', 'delete')" }>{ t(ctx, "mail.delete") }</button>
			</div>
			if len(messages) == 0 {
				@EmptyState(t(ctx, "mail.noMessages"), t(ctx, "mail.emptyMailbox"))
			} else {
				<div class="msg-list" role="list" aria-label="Messages">
					@MessageRows(messages, mailbox)
					if infiniteScroll && page < totalPages {
						@InfiniteScrollSentinel(mailbox, page+1)
					}
				</div>
				if !infiniteScroll {
					@Pagination(page, totalPages, mailboxURL(mailbox))
				}
			}
		</div>
		</div>
		<div class="reading-pane" id="reading-pane" x-show="layoutMode !== 'list'">
			<div class="empty-state">
				<p>{ t(ctx, "mail.selectToRead") }</p>
			</div>
		</div>
		</div>
	</div>
	@ContextMenu()
}

// MessageRows renders the flex-based rows for a list of messages (used by both full page and partial responses).
templ MessageRows(messages []MessageSummary, mailbox string) {
	for _, msg := range messages {
		<div
			class={ "msg-row", templ.KV("unread", !msg.Seen) }
			role="listitem"
			tabindex="0"
			data-uid={ fmt.Sprint(msg.UID) }
			x-on:contextmenu={ fmt.Sprintf("$event.preventDefault(); $dispatch('ctx-menu', {x: $event.clientX, y: $event.clientY, uid: %d, mailbox: '%s'})", msg.UID, mailbox) }
			x-on:touchstart={ fmt.Sprintf("start($event, %d)", msg.UID) }
			x-on:touchmove="move($event)"
			x-on:touchend={ fmt.Sprintf("end($event, %d, '%s')", msg.UID, mailbox) }
		>
			<input
				type="checkbox"
				class="msg-check"
				aria-label="Select message"
				x-on:change={ fmt.Sprintf("toggle(%d, $event)", msg.UID) }
				x-bind:checked={ fmt.Sprintf("isSelected(%d)", msg.UID) }
			/>
			<button
				type="button"
				class={ "msg-star", templ.KV("flagged", msg.Flagged) }
				hx-post={ fmt.Sprintf("/mail/%s/%d/flags", encMailbox(mailbox), msg.UID) }
				hx-vals={ flagToggleVals(msg.Flagged) }
				hx-swap="outerHTML"
				if msg.Flagged {
					aria-label="Unstar message"
				} else {
					aria-label="Star message"
				}
			>
				if msg.Flagged {
					&#9733;
				} else {
					&#9734;
				}
			</button>
			<span class="msg-from">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/mail/%s/%d", encMailbox(mailbox), msg.UID)) }
					data-message-link="true"
					data-pane-url={ fmt.Sprintf("/mail/%s/%d?pane=1", encMailbox(mailbox), msg.UID) }
					hx-get={ fmt.Sprintf("/mail/%s/%d", encMailbox(mailbox), msg.UID) }
					hx-target="#main-content"
					hx-push-url="true"
					style="text-decoration:none;color:inherit"
				>
					{ msg.From }
				</a>
			</span>
			<span class="msg-subject">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/mail/%s/%d", encMailbox(mailbox), msg.UID)) }
					data-message-link="true"
					data-pane-url={ fmt.Sprintf("/mail/%s/%d?pane=1", encMailbox(mailbox), msg.UID) }
					hx-get={ fmt.Sprintf("/mail/%s/%d", encMailbox(mailbox), msg.UID) }
					hx-target="#main-content"
					hx-push-url="true"
					style="text-decoration:none;color:inherit"
				>
					{ msg.Subject }
				</a>
				if mailbox == "Junk" && msg.SpamScore > 0 {
					<span class="spam-badge" title="Spam score">{ fmt.Sprintf("%.0f%%", msg.SpamScore*100) }</span>
				}
				if msg.ThreadCount > 1 {
					<span
						class="msg-thread-count"
						hx-get={ fmt.Sprintf("/mail/%s/thread/%s", encMailbox(mailbox), msg.ThreadRoot) }
						hx-target={ fmt.Sprintf("#thread-%s", msg.ThreadRoot) }
						hx-swap="innerHTML"
					>
						{ fmt.Sprint(msg.ThreadCount) }
					</span>
				}
			</span>
			<span class="msg-date">{ formatDate(msg.Date) }</span>
			<div class="msg-mobile-row2">
				{ msg.Subject }
			</div>
		</div>
		if msg.ThreadCount > 1 {
			<div id={ fmt.Sprintf("thread-%s", msg.ThreadRoot) } class="thread-children"></div>
		}
	}
}

// InfiniteScrollSentinel renders a sentinel element that triggers loading the next page when revealed.
templ InfiniteScrollSentinel(mailbox string, nextPage int) {
	<div
		class="msg-row"
		hx-get={ fmt.Sprintf("/mail/%s?page=%d&partial=1", encMailbox(mailbox), nextPage) }
		hx-trigger="revealed"
		hx-swap="outerHTML"
		hx-indicator=".load-more-spinner"
	>
		<span class="load-more-spinner htmx-indicator" style="text-align:center;padding:1rem;width:100%">
			{ t(ctx, "common.loading") }...
		</span>
	</div>
}

// MessageRowsPartial renders just the rows for use in infinite scroll partial responses.
// If there are more pages, it appends a new sentinel row.
templ MessageRowsPartial(messages []MessageSummary, mailbox string, page int, totalPages int) {
	@MessageRows(messages, mailbox)
	if page < totalPages {
		@InfiniteScrollSentinel(mailbox, page+1)
	}
}

templ ThreadChildren(children []ThreadChild, mailbox string) {
	for _, child := range children {
		<div class="msg-row thread-child" style={ fmt.Sprintf("padding-left:%drem", child.Depth*2) }>
			<span class="msg-from">
				<span class="thread-reply-arrow">&#8627;</span>
				{ child.From }
			</span>
			<span class="msg-subject">{ child.Subject }</span>
			<span class="msg-date">{ formatDate(child.Date) }</span>
		</div>
	}
}

func formatDate(t time.Time) string {
	now := time.Now()
	if t.Year() == now.Year() && t.YearDay() == now.YearDay() {
		return t.Format("3:04 PM")
	}
	if t.Year() == now.Year() {
		return t.Format("Jan 2")
	}
	return t.Format("Jan 2, 2006")
}

func flagToggleVals(flagged bool) string {
	if flagged {
		return `{"action":"remove","flag":"flagged"}`
	}
	return `{"action":"add","flag":"flagged"}`
}
