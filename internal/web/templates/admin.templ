package templates

import (
	"fmt"
	"strings"
	"time"

	"github.com/bongo-go/bongo-go/internal/version"
	bongov1 "github.com/bongo-go/bongo-go/proto/bongo/v1"
)

// SystemHealth holds data for the admin dashboard.
type SystemHealth struct {
	RaftState   string
	LeaderAddr  string
	NodeCount   int
	Uptime      time.Duration
	PebbleSize  int64
	BlobCount   int
	BlobSize    int64
	UserCount   int
	MessageRate int
	Build       version.BuildInfo
}

// AdminAddressInfo holds display data for a single address in the admin user form.
type AdminAddressInfo struct {
	Address  string
	CanSend  bool
	Verified bool
}

// AdminUserInfo holds data for the user management list.
type AdminUserInfo struct {
	UserID       string
	Email        string
	DisplayName  string
	IsAdmin      bool
	Disabled     bool
	QuotaBytes   int64
	UsedBytes    int64
	MessageCount int
	// Addresses is the list of all addresses for this user (primary + added).
	// Populated only on the detail/edit page; empty on the list page.
	// Sourced from the SQLite derived index (best-effort; may be stale on followers).
	Addresses []AdminAddressInfo
	// PrimaryEmail is the user's primary email address (from profile).
	// Used by the remove-address guard to prevent deletion of the primary address.
	PrimaryEmail string
}

// DNSCheckRow holds one DNS verification row for the domain detail page.
// The slice is extensible: add SPF/DKIM/DMARC rows later without redesign.
//
// Status values:
//   - "ok"      – record exists and matches expected value
//   - "fail"    – record missing or does not match
//   - "neutral" – check not applicable (e.g. DKIM key not yet generated)
//   - "error"   – lookup failed; could not determine status
type DNSCheckRow struct {
	Label    string // e.g. "MX", "SPF", "DKIM", "DMARC"
	OK       bool   // true when Status == "ok" (kept for backwards compat)
	Status   string // "ok" | "fail" | "neutral" | "error"
	Expected string // value the operator should publish (hint; may be empty)
	Found    string // what was actually found (may be "-" if nothing)
}

// DNSGuideRow is one record in the domain-owner DNS setup guide (task 7.3).
// It describes a record the operator should publish, in provider-agnostic form.
type DNSGuideRow struct {
	Type  string // "A" | "AAAA" | "MX" | "TXT" | "SRV"
	Host  string // relative host label: "@", "mail", "_dmarc", "mail._domainkey", "_imaps._tcp"
	TTL   int    // record TTL in seconds
	Value string // record value (TXT values are unquoted here; the zone renderer quotes them)
}

// DomainInfo holds data for the domain management list and detail page.
type DomainInfo struct {
	Name            string
	Enabled         bool
	HasMX           bool
	DkimEnabled     bool
	DkimSelector    string
	DkimTXTRecord   string   // full DNS TXT record to publish, derived from public key only
	CatchAllOwnerID string   // user ID configured as catch-all target, empty if not set
	OwnerUserID     string   // user ID of the domain owner (tenant); empty if not set
	DomainAdmins    []string // user IDs granted as domain-admins; nil/empty if none
	// Quota fields (FR-10 / US-TENANT-3). 0 = unlimited.
	MaxUsers        int64        // per-domain user count limit
	MaxStorageBytes int64        // per-domain aggregate storage limit in bytes
	UsageBytes      int64        // last-recomputed aggregate usage in bytes
	DNSRows         []DNSCheckRow // extensible DNS check rows; populated only on detail page
	// DNS setup guide (task 7.3); populated only on the detail page.
	DNSGuide     []DNSGuideRow // records the owner should publish
	DKIMPending  bool          // true when no DKIM key exists yet (guide omits the DKIM record)
	MailHostname string        // shared server hostname the guide points MX/SRV at
}

// AliasInfo holds data for the alias management list.
type AliasInfo struct {
	Address    string
	TargetUser string
}

// NodeStatus holds data for the cluster overview.
type NodeStatus struct {
	Name     string
	Address  string
	Role     string
	Status   string
	RaftAddr string
	HTTPAddr string
}

templ AdminLayout(title, email, active string) {
	@LayoutWithContent(title, email) {
		<div data-admin-page="true" hidden></div>
		<aside class="sidebar admin-sidebar" id="sidebar" aria-label={ t(ctx, "admin.navigation") } x-bind:class="{'open': sidebarOpen}">
			@AdminSidebar(active)
		</aside>
		<main class="content" id="main-content" role="main">
			{ children... }
			<footer class="admin-footer">
				Bongo &mdash; { t(ctx, "admin.serverTagline") }
			</footer>
		</main>
	}
}

templ AdminSidebar(active string) {
	<nav class="admin-nav" aria-label={ t(ctx, "admin.navigation") }>
		<div class="admin-nav-section">{ t(ctx, "admin.sectionMain") }</div>
		<a href="/admin" class={ "admin-nav-item", templ.KV("active", active == "dashboard") } aria-current?={ active == "dashboard" }>
			<svg class="admin-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg>
			<span>{ t(ctx, "admin.dashboard") }</span>
		</a>
		<a href="/admin/users" class={ "admin-nav-item", templ.KV("active", active == "users") } aria-current?={ active == "users" }>
			<svg class="admin-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
			<span>{ t(ctx, "admin.users") }</span>
		</a>
		<a href="/admin/domains" class={ "admin-nav-item", templ.KV("active", active == "domains") } aria-current?={ active == "domains" }>
			<svg class="admin-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
			<span>{ t(ctx, "admin.domains") }</span>
		</a>
		<a href="/admin/aliases" class={ "admin-nav-item", templ.KV("active", active == "aliases") } aria-current?={ active == "aliases" }>
			<svg class="admin-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
			<span>{ t(ctx, "admin.aliases") }</span>
		</a>
		<div class="admin-nav-section">{ t(ctx, "admin.sectionSystem") }</div>
		<a href="/admin/quarantine" class={ "admin-nav-item", templ.KV("active", active == "quarantine") } aria-current?={ active == "quarantine" }>
			<svg class="admin-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
			<span>{ t(ctx, "admin.quarantine") }</span>
		</a>
		<a href="/admin/queue" class={ "admin-nav-item", templ.KV("active", active == "queue") } aria-current?={ active == "queue" }>
			<svg class="admin-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
			<span>{ t(ctx, "admin.queue") }</span>
		</a>
		<a href="/admin/cluster" class={ "admin-nav-item", templ.KV("active", active == "cluster") } aria-current?={ active == "cluster" }>
			<svg class="admin-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
			<span>{ t(ctx, "admin.cluster") }</span>
		</a>
		<a href="/admin/logs" class={ "admin-nav-item", templ.KV("active", active == "logs") } aria-current?={ active == "logs" }>
			<svg class="admin-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
			<span>{ t(ctx, "admin.logs") }</span>
		</a>
	</nav>
	<div class="admin-sidebar-footer">
		<a href="/mail/INBOX" class="admin-back-link">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
			{ t(ctx, "nav.backToMail") }
		</a>
	</div>
}

templ AdminDashboard(health SystemHealth, email string, require2FA bool, flash string) {
	@AdminLayout(t(ctx, "admin.dashboardTitle"), email, "dashboard") {
		<div class="admin-scroll">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<h1 class="admin-title">{ t(ctx, "admin.welcome") }</h1>
			<p class="admin-subtitle">{ t(ctx, "admin.systemDashboard") }</p>
			<!-- Health Cards -->
			<div class="stat-grid">
				<div class="stat-card" aria-label={ t(ctx, "admin.raftStatus") }>
					<div class="stat-label">{ t(ctx, "admin.raftStatus") }</div>
					<div class="stat-value">
						<span class={ "badge", raftBadgeClass(health.RaftState) }>{ health.RaftState }</span>
					</div>
					if health.LeaderAddr != "" {
						<div class="stat-change">{ health.LeaderAddr }</div>
					}
				</div>
				<div class="stat-card" aria-label={ t(ctx, "admin.uptime") }>
					<div class="stat-label">{ t(ctx, "admin.uptime") }</div>
					<div class="stat-value">{ formatDuration(health.Uptime) }</div>
				</div>
				<div class="stat-card" aria-label={ t(ctx, "admin.storage") }>
					<div class="stat-label">{ t(ctx, "admin.storage") }</div>
					<div class="stat-value">{ formatBytes(health.PebbleSize + health.BlobSize) }</div>
					<div class="stat-change">{ fmt.Sprint(health.BlobCount) } blobs</div>
				</div>
				<div class="stat-card" aria-label={ t(ctx, "admin.users") }>
					<div class="stat-label">{ t(ctx, "admin.users") }</div>
					<div class="stat-value">{ fmt.Sprint(health.UserCount) }</div>
					<div class="stat-change">{ fmt.Sprint(health.NodeCount) } { t(ctx, "admin.nodes") }</div>
				</div>
			</div>
			<!-- System Status Table -->
			<div class="admin-table-card">
				<div class="admin-table-header">{ t(ctx, "admin.systemStatus") }</div>
				<table>
					<tbody>
						<tr>
							<th>{ t(ctx, "admin.agentStatus") }</th>
							<td><span class="status-dot green"></span> { t(ctx, "admin.operationNormal") }</td>
						</tr>
						<tr>
							<th>{ t(ctx, "admin.version") }</th>
							<td>
								<strong>{ health.Build.Version }</strong>
								<span class="u-text-muted"> &middot; { health.Build.Commit } &middot; { health.Build.Date }</span>
							</td>
						</tr>
						<tr>
							<th>{ t(ctx, "admin.raftState") }</th>
							<td>{ health.RaftState }</td>
						</tr>
						<tr>
							<th>{ t(ctx, "admin.storage") }</th>
							<td>Pebble: { formatBytes(health.PebbleSize) }, Blobs: { fmt.Sprint(health.BlobCount) } ({ formatBytes(health.BlobSize) })</td>
						</tr>
						<tr>
							<th>{ t(ctx, "admin.cluster") }</th>
							<td>{ fmt.Sprint(health.NodeCount) } { t(ctx, "admin.nodes") }</td>
						</tr>
					</tbody>
				</table>
			</div>
			<!-- Security Policy -->
			<div class="form-card">
				<h3>{ t(ctx, "admin.securityPolicy") }</h3>
				<form method="post" action="/admin/settings/require-2fa">
					<label class="u-flex u-items-center u-gap-05">
						if require2FA {
							<input type="checkbox" name="enabled" value="1" checked class="u-width-auto"/>
						} else {
							<input type="checkbox" name="enabled" value="1" class="u-width-auto"/>
						}
						{ t(ctx, "admin.require2FA") }
					</label>
					<small class="u-block u-mt-025 u-mb-075 u-text-muted">{ t(ctx, "admin.require2FAHelp") }</small>
					<button type="submit" class="btn-primary">{ t(ctx, "admin.savePolicy") }</button>
				</form>
			</div>
		</div>
	}
}

templ AdminUserList(users []AdminUserInfo, query, email, flash string) {
	@AdminLayout(t(ctx, "admin.users"), email, "users") {
		<div class="admin-scroll">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<h1 class="admin-title">{ t(ctx, "admin.users") }</h1>
			<p class="admin-subtitle">{ t(ctx, "admin.usersSubtitle") }</p>
			<div class="admin-toolbar">
				<div class="admin-toolbar-group">
					<form method="get" action="/admin/users" class="u-m0">
						<input type="search" name="q" class="search-input" placeholder={ t(ctx, "admin.searchUsers") } value={ query } aria-label={ t(ctx, "admin.searchUsers") }/>
					</form>
				</div>
				<div class="admin-toolbar-group">
					<a href="/admin/users/new" class="btn-primary">{ t(ctx, "admin.createUser") }</a>
				</div>
			</div>
			<div class="admin-table-card">
				<table class="admin-table" aria-label={ t(ctx, "admin.userList") }>
					<thead>
						<tr>
							<th class="u-width-40px"></th>
							<th scope="col">{ t(ctx, "auth.email") }</th>
							<th scope="col">{ t(ctx, "common.name") }</th>
							<th scope="col">{ t(ctx, "admin.role") }</th>
							<th scope="col">{ t(ctx, "admin.quota") }</th>
							<th scope="col">{ t(ctx, "common.status") }</th>
							<th scope="col" class="u-width-100px">{ t(ctx, "common.actions") }</th>
						</tr>
					</thead>
					<tbody>
						for _, u := range users {
							<tr>
								<td>
									<div class={ "user-avatar", avatarClass(u.DisplayName, u.Email) }>
										{ avatarInitials(u.DisplayName, u.Email) }
									</div>
								</td>
								<td><a href={ templ.SafeURL("/admin/users/" + u.UserID) }><strong>{ u.Email }</strong></a></td>
								<td>{ u.DisplayName }</td>
								<td>
									if u.IsAdmin {
										<span class="badge badge-admin">{ t(ctx, "admin.roleAdmin") }</span>
									} else {
										<span class="badge badge-user">{ t(ctx, "admin.roleUser") }</span>
									}
								</td>
								<td>
									{ formatBytes(u.UsedBytes) }
									if u.QuotaBytes > 0 {
										/ { formatBytes(u.QuotaBytes) }
									}
								</td>
								<td>
									if u.Disabled {
										<span class="badge badge-disabled">{ t(ctx, "common.disabled") }</span>
									} else {
										<span class="badge badge-active"><span class="status-dot green"></span> { t(ctx, "common.active") }</span>
									}
								</td>
								<td>
									<div class="row-actions">
										<a href={ templ.SafeURL("/admin/users/" + u.UserID) } class="btn-outline">{ t(ctx, "common.edit") }</a>
									</div>
								</td>
							</tr>
						}
						if len(users) == 0 {
							<tr><td colspan="7" class="u-text-center u-text-muted u-p-2rem">{ t(ctx, "admin.noUsers") }</td></tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ AdminUserForm(user *AdminUserInfo, domains []DomainInfo, isNew bool, email, flash string) {
	@AdminLayout(t(ctx, "admin.user"), email, "users") {
		<div class="admin-scroll">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			if isNew {
				<h1 class="admin-title">{ t(ctx, "admin.createUser") }</h1>
			} else {
				<h1 class="admin-title">{ t(ctx, "admin.editUser") }: { user.Email }</h1>
			}
			<div class="form-card">
				<form method="post" action={ templ.SafeURL(userFormAction(user, isNew)) }>
					if isNew {
						if len(domains) > 0 {
							<div class="admin-inline-form">
								<div class="u-flex-1">
									<label for="user_username" class="admin-inline-label">{ t(ctx, "admin.username") }</label>
									<input type="text" name="username" id="user_username" required autocomplete="username" pattern="[^@]+" class="form-input u-m0"/>
								</div>
								<div class="u-flex-1">
									<label for="user_domain" class="admin-inline-label">{ t(ctx, "admin.domain") }</label>
									<select name="domain" id="user_domain" required class="form-select u-m0">
										for _, domain := range domains {
											<option value={ domain.Name }>{ domain.Name }</option>
										}
									</select>
								</div>
							</div>
						} else {
							<label for="user_email">{ t(ctx, "auth.email") }</label>
							<input type="email" name="email" id="user_email" class="form-input" required/>
						}
					}
					<label for="display_name" class="form-label">{ t(ctx, "admin.displayName") }</label>
					<input type="text" name="display_name" id="display_name" class="form-input" value={ userDisplayName(user) }/>
					if isNew {
						<label for="password" class="form-label">{ t(ctx, "auth.password") }</label>
						<input type="password" name="password" id="password" class="form-input" required minlength="4"/>
					}
					<label for="quota_bytes" class="form-label">{ t(ctx, "admin.quotaLabel") }</label>
					<input type="number" name="quota_bytes" id="quota_bytes" class="form-input" value={ fmt.Sprint(userQuota(user)) } min="0"/>
					<fieldset>
						<label class="form-check">
							<input type="checkbox" name="is_admin" value="1" checked?={ user != nil && user.IsAdmin }/>
							{ t(ctx, "admin.administrator") }
						</label>
					</fieldset>
					<div class="u-flex u-gap-05 u-mt-1">
						<button type="submit" class="btn-primary">
							if isNew {
								{ t(ctx, "common.create") }
							} else {
								{ t(ctx, "common.save") }
							}
						</button>
						<a href="/admin/users" class="btn-outline">{ t(ctx, "common.cancel") }</a>
					</div>
				</form>
			</div>
			if !isNew && user != nil {
				<div class="form-card">
					<h3>{ t(ctx, "common.actions") }</h3>
					<div class="u-flex u-gap-05">
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%s/toggle-disabled", user.UserID)) }>
							<button type="submit" class={ adminToggleClass(user.Disabled) }>
								if user.Disabled {
									{ t(ctx, "common.enable") }
								} else {
									{ t(ctx, "common.disable") }
								}
							</button>
						</form>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%s/reset-password", user.UserID)) }>
							<button type="submit" class="btn-outline">{ t(ctx, "admin.resetPassword") }</button>
						</form>
						<button
							type="button"
							class="btn-danger"
							hx-post={ fmt.Sprintf("/admin/users/%s/delete", user.UserID) }
							hx-confirm={ t(ctx, "admin.confirmDeleteUser") }
						>
							{ t(ctx, "admin.deleteUser") }
						</button>
					</div>
				</div>
				<div class="form-card">
					<h3>{ t(ctx, "admin.addresses") }</h3>
					<p class="u-text-muted u-font-082">{ t(ctx, "admin.addressesHelp") }</p>
					if len(user.Addresses) > 0 {
						<div class="admin-table-card u-mb-1">
							<table class="admin-table" aria-label={ t(ctx, "admin.addressList") }>
								<thead>
									<tr>
										<th scope="col">{ t(ctx, "admin.addressLabel") }</th>
										<th scope="col">{ t(ctx, "admin.sendStatus") }</th>
										<th scope="col" class="u-width-100px">{ t(ctx, "common.actions") }</th>
									</tr>
								</thead>
								<tbody>
									for _, ai := range user.Addresses {
										<tr>
											<td><code class="u-font-088">{ ai.Address }</code></td>
											<td>
												if ai.CanSend && ai.Verified {
													<span class="badge badge-active">{ t(ctx, "admin.sendCapable") }</span>
												} else {
													<span class="badge badge-user">{ t(ctx, "admin.notVerified") }</span>
												}
											</td>
											<td class="u-flex-gap-4">
												if ai.Address != user.PrimaryEmail && !(ai.CanSend && ai.Verified) {
													<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%s/addresses/grant-send", user.UserID)) }>
														<input type="hidden" name="address" value={ ai.Address }/>
														<button type="submit" class="btn-flush">{ t(ctx, "admin.grantSend") }</button>
													</form>
												}
												if ai.Address != user.PrimaryEmail {
													<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%s/addresses/delete", user.UserID)) }>
														<input type="hidden" name="address" value={ ai.Address }/>
														<button type="submit" class="btn-flush">{ t(ctx, "common.remove") }</button>
													</form>
												} else {
													<span class="badge badge-user">{ t(ctx, "admin.primary") }</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					} else {
						<p class="u-text-muted u-font-082">{ t(ctx, "admin.noAddresses") }</p>
					}
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%s/addresses", user.UserID)) } class="admin-inline-form">
						<div class="u-flex-1">
							<label for="new_address" class="admin-inline-label">{ t(ctx, "admin.addAddress") }</label>
							<input type="email" name="address" id="new_address" placeholder="extra@example.com" required class="form-input u-m0"/>
						</div>
						<button type="submit" class="btn-primary admin-btn-42">{ t(ctx, "action.add") }</button>
					</form>
				</div>
			}
		</div>
	}
}

templ AdminDomainList(domains []DomainInfo, email, flash string, isGlobalAdmin bool) {
	@AdminLayout(t(ctx, "admin.domains"), email, "domains") {
		<div class="admin-scroll">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<h1 class="admin-title">{ t(ctx, "admin.domains") }</h1>
			<p class="admin-subtitle">{ t(ctx, "admin.domainsSubtitle") }</p>
			if isGlobalAdmin {
				<div class="form-card">
					<h3>{ t(ctx, "admin.addDomain") }</h3>
					<form method="post" action="/admin/domains" class="admin-inline-form">
						<div class="u-flex-1">
							<label for="domain_name" class="admin-inline-label">{ t(ctx, "admin.domainName") }</label>
							<input type="text" name="domain" id="domain_name" placeholder="example.com" required class="form-input u-m0"/>
						</div>
						<button type="submit" class="btn-primary admin-btn-42">{ t(ctx, "admin.addDomain") }</button>
					</form>
				</div>
			}
			<div class="admin-table-card">
				<table class="admin-table" aria-label={ t(ctx, "admin.domainList") }>
					<thead>
						<tr>
							<th scope="col">{ t(ctx, "admin.domain") }</th>
							<th scope="col">{ t(ctx, "common.status") }</th>
							<th scope="col">{ t(ctx, "admin.mxRecord") }</th>
							<th scope="col" class="u-width-100px">{ t(ctx, "common.actions") }</th>
						</tr>
					</thead>
					<tbody>
						for _, d := range domains {
							<tr>
								<td><strong>{ d.Name }</strong></td>
								<td>
									if d.Enabled {
										<span class="badge badge-active"><span class="status-dot green"></span> { t(ctx, "common.enabled") }</span>
									} else {
										<span class="badge badge-disabled">{ t(ctx, "common.disabled") }</span>
									}
								</td>
								<td>
									if d.HasMX {
										<span class="dns-check">&#10003; { t(ctx, "admin.valid") }</span>
									} else {
										<span class="dns-fail">&#10007; { t(ctx, "admin.missing") }</span>
									}
								</td>
								<td>
									<a href={ templ.SafeURL("/admin/domains/" + d.Name) } class="btn-outline">{ t(ctx, "admin.manage") }</a>
								</td>
							</tr>
						}
						if len(domains) == 0 {
							<tr><td colspan="4" class="u-text-center u-text-muted u-p-2rem">{ t(ctx, "admin.noDomains") }</td></tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

// domainQuotaCell renders the per-domain quota cell.
// Global-admins see an editable form; domain-admins see read-only usage/limit.
// No inline styles — CSP-safe.
templ domainQuotaCell(d DomainInfo, isGlobalAdmin bool) {
	<div class="domain-quota-cell">
		<div class="u-text-small u-text-muted">
			{ t(ctx, "admin.quotaUsage") }: { fmt.Sprintf("%d", d.UsageBytes) } /
			if d.MaxStorageBytes > 0 {
				{ fmt.Sprintf("%d", d.MaxStorageBytes) } { t(ctx, "admin.quotaBytes") }
			} else {
				{ t(ctx, "admin.quotaUnlimited") }
			}
		</div>
		<div class="u-text-small u-text-muted">
			{ t(ctx, "admin.quotaMaxUsers") }:
			if d.MaxUsers > 0 {
				{ fmt.Sprintf("%d", d.MaxUsers) }
			} else {
				{ t(ctx, "admin.quotaUnlimited") }
			}
		</div>
		if isGlobalAdmin {
			<details class="quota-edit-details">
				<summary class="u-text-small">{ t(ctx, "admin.quotaEdit") }</summary>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/domains/%s/quota", d.Name)) } class="quota-edit-form">
					<label class="admin-inline-label">{ t(ctx, "admin.quotaMaxUsers") }</label>
					<input type="number" name="max_users" min="0" value={ fmt.Sprintf("%d", d.MaxUsers) } class="form-input u-m0"/>
					<label class="admin-inline-label">{ t(ctx, "admin.quotaMaxStorage") }</label>
					<input type="number" name="max_storage_bytes" min="0" value={ fmt.Sprintf("%d", d.MaxStorageBytes) } class="form-input u-m0"/>
					<button type="submit" class="btn-outline admin-btn-42">{ t(ctx, "admin.quotaSet") }</button>
				</form>
			</details>
		}
	</div>
}

// AdminDomainDetail renders the per-domain detail page.
// Domain-admins see all sections except those gated by isGlobalAdmin.
// Global-only sections (owner, quota-set, delete) are hidden for domain-admins
// because the backend handlers already enforce requireGlobalAdmin — hiding is UX only.
templ AdminDomainDetail(d DomainInfo, email, flash string, isGlobalAdmin bool) {
	@AdminLayout(t(ctx, "admin.domainDetail")+": "+d.Name, email, "domains") {
		<div class="admin-scroll">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<div class="admin-toolbar">
				<a href="/admin/domains" class="btn-outline">&#8592; { t(ctx, "admin.backToDomains") }</a>
			</div>
			<h1 class="admin-title">{ d.Name }</h1>
			<p class="admin-subtitle">{ t(ctx, "admin.domainDetailSubtitle") }</p>
			<!-- DNS Configuration -->
			<div class="form-card">
				<h3>{ t(ctx, "admin.dnsSectionTitle") }</h3>
				<small class="u-block u-mb-075 u-text-muted">{ t(ctx, "admin.dnsHelp") }</small>
				<table class="admin-table">
					<thead>
						<tr>
							<th scope="col">{ t(ctx, "admin.dnsRecord") }</th>
							<th scope="col">{ t(ctx, "common.status") }</th>
							<th scope="col">{ t(ctx, "admin.dnsExpected") }</th>
							<th scope="col">{ t(ctx, "admin.dnsFound") }</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range d.DNSRows {
							<tr>
								<td><strong>{ row.Label }</strong></td>
								<td>
									switch row.Status {
									case "ok":
										<span class="dns-check">&#10003; { t(ctx, "admin.valid") }</span>
									case "neutral":
										<span class="dns-neutral">&#8212; { t(ctx, "admin.dnsNotGenerated") }</span>
									case "error":
										<span class="dns-error">&#63; { t(ctx, "admin.dnsCheckError") }</span>
									default:
										<span class="dns-fail">&#10007; { t(ctx, "admin.missing") }</span>
									}
								</td>
								<td>
									if row.Expected != "" {
										if len(row.Expected) > 60 {
											<details>
												<summary class="u-font-088">{ t(ctx, "admin.dnsShowExpected") }</summary>
												<code class="u-font-088 u-block u-mt-025">{ row.Expected }</code>
											</details>
										} else {
											<code class="u-font-088">{ row.Expected }</code>
										}
									} else {
										<span class="u-text-muted">-</span>
									}
								</td>
								<td>
									if row.Found != "" && row.Found != "-" {
										if len(row.Found) > 60 {
											<details>
												<summary class="u-font-088">{ t(ctx, "admin.dnsShowFound") }</summary>
												<code class="u-font-088 u-block u-mt-025">{ row.Found }</code>
											</details>
										} else {
											<code class="u-font-088">{ row.Found }</code>
										}
									} else {
										<span class="u-text-muted">-</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
				<!-- Status legend (task 8.1): explain each check state. -->
				<div class="dns-legend u-mt-075">
					<p class="u-text-small u-mb-025"><span class="dns-check">&#10003; { t(ctx, "admin.valid") }</span> &#8212; { t(ctx, "admin.dnsLegendValid") }</p>
					<p class="u-text-small u-mb-025"><span class="dns-fail">&#10007; { t(ctx, "admin.missing") }</span> &#8212; { t(ctx, "admin.dnsLegendMissing") }</p>
					<p class="u-text-small u-mb-025"><span class="dns-neutral">&#8212; { t(ctx, "admin.dnsNotGenerated") }</span> &#8212; { t(ctx, "admin.dnsLegendNotGenerated") }</p>
					<p class="u-text-small u-mb-0"><span class="dns-error">&#63; { t(ctx, "admin.dnsCheckError") }</span> &#8212; { t(ctx, "admin.dnsLegendError") }</p>
				</div>
			</div>
			<!-- DNS Setup Guide (task 7.3): records the owner should publish -->
			<div class="form-card">
				<h3>{ t(ctx, "admin.dnsGuideTitle") }</h3>
				<small class="u-block u-mb-075 u-text-muted">{ t(ctx, "admin.dnsGuideHelp") }</small>
				if d.DKIMPending {
					<p class="dns-guide-notice u-mb-075">{ t(ctx, "admin.dnsGuideDKIMPending") }</p>
				}
				if len(d.DNSGuide) > 0 {
					<table class="admin-table dns-guide-table">
						<thead>
							<tr>
								<th scope="col">{ t(ctx, "admin.dnsGuideType") }</th>
								<th scope="col">{ t(ctx, "admin.dnsGuideHost") }</th>
								<th scope="col">{ t(ctx, "admin.dnsGuideTTL") }</th>
								<th scope="col">{ t(ctx, "admin.dnsGuideValue") }</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range d.DNSGuide {
								<tr>
									<td><strong>{ row.Type }</strong></td>
									<td><code class="u-font-088">{ row.Host }</code></td>
									<td class="u-text-muted">{ fmt.Sprintf("%d", row.TTL) }</td>
									<td class="dns-guide-value">
										<code class="u-font-088">{ row.Value }</code>
										<button type="button" class="btn-copy" data-copy-previous aria-label={ t(ctx, "admin.dnsGuideCopy") } title={ t(ctx, "admin.dnsGuideCopy") }>&#128203;</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
					<div class="admin-toolbar u-mt-075">
						<a href={ templ.SafeURL(fmt.Sprintf("/admin/domains/%s/dns.zone", d.Name)) } class="btn-outline" download>
							{ t(ctx, "admin.dnsGuideDownload") }
						</a>
					</div>
				}
			</div>
			<!-- Enable / Disable -->
			<div class="form-card">
				<h3>{ t(ctx, "common.status") }</h3>
				<div class="u-flex u-items-center u-gap-05 u-mb-075">
					if d.Enabled {
						<span class="badge badge-active"><span class="status-dot green"></span> { t(ctx, "common.enabled") }</span>
					} else {
						<span class="badge badge-disabled">{ t(ctx, "common.disabled") }</span>
					}
				</div>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/domains/%s/toggle", d.Name)) }>
					<button type="submit" class={ adminToggleClass(!d.Enabled) }>
						if d.Enabled {
							{ t(ctx, "common.disable") }
						} else {
							{ t(ctx, "common.enable") }
						}
					</button>
				</form>
			</div>
			<!-- DKIM Signing -->
			<div class="form-card">
				<h3>{ t(ctx, "admin.dkimSectionTitle") }</h3>
				<small class="u-block u-mb-075 u-text-muted">{ t(ctx, "admin.dkimHelp") }</small>
				if d.DkimEnabled && d.DkimTXTRecord != "" {
					<p class="u-text-small u-mb-05">
						{ t(ctx, "admin.dkimKey") }: <strong>{ d.DkimSelector }</strong>
					</p>
					<p class="u-text-small u-text-muted u-mb-025">{ t(ctx, "admin.dkimDNSRecord") }:</p>
					<pre class="dkim-txt-record">{ d.DkimTXTRecord }</pre>
				} else {
					<p class="u-text-muted u-text-small u-mb-075">{ t(ctx, "admin.dkimKeyNone") }</p>
				}
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/domains/%s/dkim/generate", d.Name)) } class="u-mt-05">
					<button type="submit" class="btn-primary">
						if d.DkimEnabled {
							{ t(ctx, "admin.rotateDKIMKey") }
						} else {
							{ t(ctx, "admin.generateDKIMKey") }
						}
					</button>
				</form>
				<small class="u-block u-mt-05 u-text-muted">{ t(ctx, "admin.dkimPublishNote") }</small>
			</div>
			<!-- Catch-All -->
			<div class="form-card">
				<h3>{ t(ctx, "admin.catchAllSectionTitle") }</h3>
				<small class="u-block u-mb-075 u-text-muted">{ t(ctx, "admin.catchAllHelp") }</small>
				if d.CatchAllOwnerID != "" {
					<p class="u-text-small u-mb-05">
						{ t(ctx, "admin.catchAll") }: <code class="u-font-088">{ d.CatchAllOwnerID }</code>
					</p>
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/domains/%s/catchall/delete", d.Name)) }>
						<button type="submit" class="btn-outline">{ t(ctx, "common.clear") }</button>
					</form>
				} else {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/domains/%s/catchall", d.Name)) } class="admin-inline-form">
						<div class="u-flex-1">
							<label for="catchall_owner" class="admin-inline-label">{ t(ctx, "admin.catchAllOwnerPlaceholder") }</label>
							<input type="text" name="owner_user_id" id="catchall_owner" placeholder={ t(ctx, "admin.catchAllOwnerPlaceholder") } class="form-input u-m0" required/>
						</div>
						<button type="submit" class="btn-outline admin-btn-42">{ t(ctx, "admin.setCatchAll") }</button>
					</form>
				}
			</div>
			<!-- Domain Administrators -->
			<div class="form-card">
				<h3>{ t(ctx, "admin.domainAdminsSectionTitle") }</h3>
				<small class="u-block u-mb-075 u-text-muted">{ t(ctx, "admin.domainAdminHelp") }</small>
				if len(d.DomainAdmins) > 0 {
					for _, uid := range d.DomainAdmins {
						<div class="admin-inline-form u-mb-05">
							<span class="u-text-small u-flex-1">{ uid }</span>
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/domains/%s/admins/revoke", d.Name)) }>
								<input type="hidden" name="user_id" value={ uid }/>
								<button type="submit" class="btn-flush">{ t(ctx, "common.revoke") }</button>
							</form>
						</div>
					}
				} else {
					<p class="u-text-muted u-text-small u-mb-075">{ t(ctx, "admin.noDomainAdmins") }</p>
				}
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/domains/%s/admins", d.Name)) } class="admin-inline-form u-mt-05">
					<div class="u-flex-1">
						<label for="grant_user_id" class="admin-inline-label">{ t(ctx, "admin.domainAdminPlaceholder") }</label>
						<input type="text" name="user_id" id="grant_user_id" placeholder={ t(ctx, "admin.domainAdminPlaceholder") } class="form-input u-m0"/>
					</div>
					<button type="submit" class="btn-outline admin-btn-42">{ t(ctx, "admin.grantAdmin") }</button>
				</form>
			</div>
			<!-- Domain Owner (global-admin only) -->
			if isGlobalAdmin {
				<div class="form-card">
					<h3>{ t(ctx, "admin.ownerSectionTitle") }</h3>
					<small class="u-block u-mb-075 u-text-muted">{ t(ctx, "admin.ownerHelp") }</small>
					if d.OwnerUserID != "" {
						<p class="u-text-small u-mb-05">
							{ t(ctx, "admin.domainOwner") }: <code class="u-font-088">{ d.OwnerUserID }</code>
						</p>
					}
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/domains/%s/owner", d.Name)) } class="admin-inline-form">
						<div class="u-flex-1">
							<label for="owner_user_id" class="admin-inline-label">{ t(ctx, "admin.domainOwnerPlaceholder") }</label>
							<input type="text" name="owner_user_id" id="owner_user_id" placeholder={ t(ctx, "admin.domainOwnerPlaceholder") } class="form-input u-m0"/>
						</div>
						<button type="submit" class="btn-outline admin-btn-42">{ t(ctx, "admin.setOwner") }</button>
					</form>
				</div>
			}
			<!-- Quota -->
			<div class="form-card">
				<h3>{ t(ctx, "admin.quotaSectionTitle") }</h3>
				<small class="u-block u-mb-075 u-text-muted">{ t(ctx, "admin.quotaHelp") }</small>
				@domainQuotaCell(d, isGlobalAdmin)
			</div>
			<!-- Danger Zone (global-admin only) -->
			if isGlobalAdmin {
				<div class="form-card domain-danger-zone">
					<h3>{ t(ctx, "admin.dangerZoneSectionTitle") }</h3>
					<button
						type="button"
						class="btn-danger"
						hx-post={ fmt.Sprintf("/admin/domains/%s/delete", d.Name) }
						hx-confirm={ t(ctx, "admin.confirmDeleteDomain") }
					>{ t(ctx, "admin.deleteDomain") }</button>
				</div>
			}
		</div>
	}
}

templ AdminAliasList(aliases []AliasInfo, users []string, email, flash string) {
	@AdminLayout(t(ctx, "admin.aliases"), email, "aliases") {
		<div class="admin-scroll">
			if flash != "" {
				@FlashMessage(flash, "success")
			}
			<h1 class="admin-title">{ t(ctx, "admin.aliases") }</h1>
			<p class="admin-subtitle">{ t(ctx, "admin.aliasesSubtitle") }</p>
			<div class="form-card">
				<h3>{ t(ctx, "admin.addAlias") }</h3>
				<form method="post" action="/admin/aliases" class="admin-inline-form u-flex-wrap">
					<div class="u-flex-1 u-min-w-200">
						<label for="alias_address" class="admin-inline-label">{ t(ctx, "admin.aliasAddress") }</label>
						<input type="email" name="address" id="alias_address" placeholder="info@example.com" required class="form-input u-m0"/>
					</div>
					<div class="u-flex-1 u-min-w-200">
						<label for="target_user" class="admin-inline-label">{ t(ctx, "admin.targetUser") }</label>
						<select name="target_user" id="target_user" required class="form-select u-m0">
							for _, u := range users {
								<option value={ u }>{ u }</option>
							}
						</select>
					</div>
					<button type="submit" class="btn-primary admin-btn-42">{ t(ctx, "action.add") }</button>
				</form>
			</div>
			<div class="admin-table-card">
				<table class="admin-table" aria-label={ t(ctx, "admin.aliasList") }>
					<thead>
						<tr>
							<th scope="col">{ t(ctx, "admin.aliasAddress") }</th>
							<th scope="col">{ t(ctx, "admin.targetUser") }</th>
							<th scope="col" class="u-width-100px">{ t(ctx, "common.actions") }</th>
						</tr>
					</thead>
					<tbody>
						for _, a := range aliases {
							<tr>
								<td><code class="u-font-088">{ a.Address }</code></td>
								<td>{ a.TargetUser }</td>
								<td>
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/aliases/%s/delete", a.Address)) }>
										<button type="submit" class="btn-flush">{ t(ctx, "common.delete") }</button>
									</form>
								</td>
							</tr>
						}
						if len(aliases) == 0 {
							<tr><td colspan="3" class="u-text-center u-text-muted u-p-2rem">{ t(ctx, "admin.noAliases") }</td></tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ AdminQueueDashboard(stats *bongov1.QueueStats, pending, bounced []*bongov1.OutboundMessage, email string) {
	@AdminLayout(t(ctx, "admin.queue"), email, "queue") {
		<div class="admin-scroll">
			<h1 class="admin-title">{ t(ctx, "admin.messageQueue") }</h1>
			<p class="admin-subtitle">{ t(ctx, "admin.queueSubtitle") }</p>
			<!-- Stat Cards -->
			<div class="stat-grid">
				<div class="stat-card">
					<div class="stat-number blue">{ fmt.Sprint(stats.PendingCount) }</div>
					<div class="stat-label">{ t(ctx, "admin.pending") }</div>
				</div>
				<div class="stat-card">
					<div class="stat-number red">{ fmt.Sprint(stats.FailedCount) }</div>
					<div class="stat-label">{ t(ctx, "admin.failed") }</div>
				</div>
				<div class="stat-card">
					<div class="stat-number orange">{ formatSeconds(stats.OldestPendingSeconds) }</div>
					<div class="stat-label">{ t(ctx, "admin.oldestPending") }</div>
				</div>
			</div>
			<!-- Bulk Actions -->
			<div class="bulk-bar">
				<span class="bulk-label">{ t(ctx, "admin.bulkActions") }:</span>
				<form method="post" action="/admin/queue/flush" class="u-m0">
					<button type="submit" class="btn-flush">{ t(ctx, "admin.flushQueue") }</button>
				</form>
			</div>
			if len(pending) > 0 {
				<h2 class="section-title">{ t(ctx, "admin.pendingMessages") }</h2>
				<div class="admin-table-card">
					<table class="admin-table" aria-label={ t(ctx, "admin.pendingMessages") }>
						<thead>
							<tr>
								<th>{ t(ctx, "admin.sender") }</th>
								<th>{ t(ctx, "admin.recipients") }</th>
								<th>{ t(ctx, "admin.attempts") }</th>
								<th>{ t(ctx, "admin.created") }</th>
								<th>{ t(ctx, "admin.nextRetry") }</th>
								<th class="u-width-130px">{ t(ctx, "common.actions") }</th>
							</tr>
						</thead>
						<tbody>
							for _, msg := range pending {
								<tr>
									<td>{ msg.SenderEmail }</td>
									<td>{ strings.Join(msg.Recipients, ", ") }</td>
									<td>{ fmt.Sprint(msg.AttemptCount) }</td>
									<td>{ formatUnix(msg.CreatedAt) }</td>
									<td>{ formatUnix(msg.NextRetryAt) }</td>
									<td>
										<div class="row-actions">
											<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/queue/%s/retry", msg.Id)) }>
												<button type="submit" class="btn-outline">{ t(ctx, "admin.retry") }</button>
											</form>
											<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/queue/%s/drop", msg.Id)) }>
												<button type="submit" class="btn-flush">{ t(ctx, "admin.drop") }</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			if len(bounced) > 0 {
				<h2 class="section-title">{ t(ctx, "admin.failedMessages") }</h2>
				<div class="admin-table-card">
					<table class="admin-table" aria-label={ t(ctx, "admin.failedMessages") }>
						<thead>
							<tr>
								<th>{ t(ctx, "admin.sender") }</th>
								<th>{ t(ctx, "admin.recipients") }</th>
								<th>{ t(ctx, "admin.reason") }</th>
								<th class="u-width-80px">{ t(ctx, "common.actions") }</th>
							</tr>
						</thead>
						<tbody>
							for _, msg := range bounced {
								<tr>
									<td>{ msg.SenderEmail }</td>
									<td>{ strings.Join(msg.Recipients, ", ") }</td>
									<td class="u-text-status-red u-font-082">{ msg.StatusReason }</td>
									<td>
										<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/queue/%s/drop", msg.Id)) }>
											<button type="submit" class="btn-flush">{ t(ctx, "admin.drop") }</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

templ AdminClusterOverview(nodes []NodeStatus, raftState, email string) {
	@AdminLayout(t(ctx, "admin.cluster"), email, "cluster") {
		<div class="admin-scroll">
			<h1 class="admin-title">{ t(ctx, "admin.cluster") }</h1>
			<p class="admin-subtitle">{ t(ctx, "admin.clusterSubtitle") }</p>
			<!-- Raft State Table -->
			<div class="admin-table-card">
				<div class="admin-table-header">{ t(ctx, "admin.raftState") }</div>
				<table>
					<tbody>
						<tr>
							<th>{ t(ctx, "admin.state") }</th>
							<td><span class={ "badge", raftBadgeClass(raftState) }>{ raftState }</span></td>
						</tr>
						<tr>
							<th>{ t(ctx, "admin.nodesLabel") }</th>
							<td>{ fmt.Sprint(len(nodes)) }</td>
						</tr>
					</tbody>
				</table>
			</div>
			<!-- Node Cards -->
			<h2 class="section-title">{ t(ctx, "admin.clusterNodes") }</h2>
			<div class="node-grid">
				for _, n := range nodes {
					<div class={ "node-card", templ.KV("leader", isLeader(n.Role)) }>
						<div class="node-card-header">
							<span class="node-name">
								<span class={ "status-dot", nodeStatusDotClass(n.Status) }></span>
								{ n.Name }
							</span>
							<span class={ "badge", raftBadgeClass(n.Role) }>{ n.Role }</span>
						</div>
						<div class="node-details">
							<div class="node-detail">
								<span class="node-detail-label">{ t(ctx, "admin.address") }</span>
								<span class="node-detail-value">{ n.Address }</span>
							</div>
							<div class="node-detail">
								<span class="node-detail-label">{ t(ctx, "common.status") }</span>
								<span class="node-detail-value">{ n.Status }</span>
							</div>
						</div>
					</div>
				}
			</div>
			if len(nodes) == 0 {
				<p class="u-text-center u-text-muted">{ t(ctx, "admin.noClusterMembers") }</p>
			}
		</div>
	}
}

templ AdminLogViewer(email string) {
	@AdminLayout(t(ctx, "admin.logs"), email, "logs") {
		<div class="admin-scroll admin-scroll-wide">
			<h1 class="admin-title">{ t(ctx, "admin.logs") }</h1>
			<p class="admin-subtitle">{ t(ctx, "admin.logsSubtitle") }</p>
			<div class="log-viewer">
				<div class="log-toolbar">
					<label class="admin-log-label">{ t(ctx, "admin.level") }:</label>
					<select id="log-level" class="form-select" aria-label={ t(ctx, "admin.logLevelFilter") }>
						<option value="">{ t(ctx, "common.all") }</option>
						<option value="debug">DEBUG</option>
						<option value="info" selected>INFO</option>
						<option value="warn">WARN</option>
						<option value="error">ERROR</option>
					</select>
					<label class="admin-log-label admin-log-label-spaced">{ t(ctx, "admin.component") }:</label>
					<select id="log-component" class="form-select" aria-label={ t(ctx, "admin.componentFilter") }>
						<option value="">{ t(ctx, "common.all") }</option>
						<option value="smtp">SMTP</option>
						<option value="imap">IMAP</option>
						<option value="raft">Raft</option>
						<option value="web">{ t(ctx, "admin.web") }</option>
						<option value="queue">{ t(ctx, "admin.queue") }</option>
					</select>
					<button type="button" id="log-connect" class="btn-outline admin-log-btn admin-log-btn-auto" data-log-action="connect">{ t(ctx, "admin.connect") }</button>
					<button type="button" id="log-clear" class="btn-outline admin-log-btn" data-log-action="clear">{ t(ctx, "admin.clear") }</button>
				</div>
				<div id="log-output" class="log-output" data-log-output="true" aria-live="polite" aria-label={ t(ctx, "admin.logOutput") }>
					{ t(ctx, "admin.connecting") }...
				</div>
			</div>
		</div>
	}
}

// Helper functions

func raftBadgeClass(state string) string {
	switch strings.ToLower(state) {
	case "leader":
		return "badge-leader"
	case "follower":
		return "badge-follower"
	default:
		return "badge-disabled"
	}
}

func statusBadgeClass(status string) string {
	switch strings.ToLower(status) {
	case "alive":
		return "badge-active"
	case "suspect":
		return "badge-pending"
	default:
		return "badge-disabled"
	}
}

func nodeStatusDotClass(status string) string {
	switch strings.ToLower(status) {
	case "alive":
		return "green"
	case "suspect":
		return "yellow"
	default:
		return "red"
	}
}

func isLeader(role string) bool {
	return strings.ToLower(role) == "leader"
}

func avatarInitials(name, email string) string {
	if name != "" {
		parts := strings.Fields(name)
		if len(parts) >= 2 {
			return strings.ToUpper(string([]rune(parts[0])[0:1]) + string([]rune(parts[len(parts)-1])[0:1]))
		}
		if len(parts) == 1 && len(parts[0]) >= 2 {
			return strings.ToUpper(parts[0][0:2])
		}
	}
	if len(email) >= 2 {
		return strings.ToUpper(email[0:2])
	}
	return "??"
}

func avatarClass(name, email string) string {
	s := name + email
	var hash uint32
	for _, c := range s {
		hash = hash*31 + uint32(c)
	}
	return fmt.Sprintf("avatar-colour-%d", hash%7)
}

func adminToggleClass(disabled bool) string {
	if disabled {
		return "btn-outline"
	}
	return "btn-flush"
}

func formatDuration(d time.Duration) string {
	hours := int(d.Hours())
	minutes := int(d.Minutes()) % 60
	if hours >= 24 {
		days := hours / 24
		hours = hours % 24
		return fmt.Sprintf("%dd %dh %dm", days, hours, minutes)
	}
	return fmt.Sprintf("%dh %dm", hours, minutes)
}

func formatBytes(b int64) string {
	const (
		KB = 1024
		MB = KB * 1024
		GB = MB * 1024
	)
	switch {
	case b >= GB:
		return fmt.Sprintf("%.1f GB", float64(b)/float64(GB))
	case b >= MB:
		return fmt.Sprintf("%.1f MB", float64(b)/float64(MB))
	case b >= KB:
		return fmt.Sprintf("%.1f KB", float64(b)/float64(KB))
	default:
		return fmt.Sprintf("%d B", b)
	}
}

func formatSeconds(s int64) string {
	if s <= 0 {
		return "-"
	}
	d := time.Duration(s) * time.Second
	return formatDuration(d)
}

func formatUnix(ts int64) string {
	if ts <= 0 {
		return "-"
	}
	return time.Unix(ts, 0).Format("2006-01-02 15:04")
}

func userFormAction(u *AdminUserInfo, isNew bool) string {
	if isNew {
		return "/admin/users"
	}
	return fmt.Sprintf("/admin/users/%s", u.UserID)
}

func userDisplayName(u *AdminUserInfo) string {
	if u == nil {
		return ""
	}
	return u.DisplayName
}

func userQuota(u *AdminUserInfo) int64 {
	if u == nil {
		return 0
	}
	return u.QuotaBytes
}

func disableButtonClass(disabled bool) string {
	if disabled {
		return "outline"
	}
	return "outline secondary"
}
