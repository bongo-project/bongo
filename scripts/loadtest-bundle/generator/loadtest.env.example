# Copy to generator/loadtest.env and edit. run.sh reads it.

# The server VM: the address the generator reaches it on, and how to ssh to it
# (a user with sudo; key-based login, as run.sh opens tunnels with it).
SERVER=10.0.0.1
SERVER_SSH=you@10.0.0.1

# The sink listens on this generator address. setup.sh on the server must have
# been given the same SINK_IP:SINK_PORT.
SINK_IP=10.0.0.2
SINK_PORT=2525

# Extra generator source addresses for the connection stage, comma-separated,
# already added to the interface (README.md). Empty uses the default address.
SOURCE_ADDRS=

# The state file from server/bulk-load.sh (or "run.sh seed"), copied here, mode 0600.
STATE_FILE=./bulk.state
# Must match the data on the server.
USERS=1500
MESSAGES_PER_USER=50
SEED=1

# Recorded in every report. Describe the VM, not the host.
VERSION=@VERSION@
MACHINE="Proxmox VM, 2 vCPU (Xeon Silver 4214), 4 GB"
DISK_TYPE="virtio disk on <storage type>"
FILE_SYSTEM=ext4

# Mail ramp: start:step:interval:max in messages a second. The first series
# found the limit at about 16/s on 2 vCPU, so start low.
RAMP=5:5:10m:200
STAGE_DURATION=4h
MESSAGE_SIZE=8192

# Mixed traffic, as a share of USERS (the first series' model):
# 50% IMAP IDLE, 5% active IMAP, 2% CalDAV/CardDAV, 1% POP3.
IDLE_PCT=50
ACTIVE_PCT=5
DAV_PCT=2
POP3_PCT=1
CLIENTS_RAMP=10m

# Connection stage: IMAP IDLE connections to hold.
CONNECTIONS=15000
CONNECTIONS_RAMP=15m
CONNECTIONS_DURATION=1h

# Soak: a fixed rate, 70 to 80% of the limit the ramps found.
SOAK_RATE=
SOAK_DURATION=24h
