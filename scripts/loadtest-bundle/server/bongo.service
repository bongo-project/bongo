[Unit]
Description=Bongo mail and calendar server (load test)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bongo
Group=bongo
ExecStart=/usr/local/bin/bongo serve --config /etc/bongo/bongo.hcl
ExecReload=/bin/kill -HUP $MAINPID

# Holds BONGO_WEB_SESSION_SECRET, root-only (mode 0600). setup.sh writes it.
EnvironmentFile=/etc/bongo/bongo.env

Restart=on-failure
RestartSec=5s

# The connection stage holds tens of thousands of sockets, and every open user
# database holds about three file descriptors.
LimitNOFILE=1048576
TasksMax=infinity

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bongo /var/log/bongo

[Install]
WantedBy=multi-user.target
